include <../shared/core>
include <../shared/lang>
include <../data/download_t>
include <../data/download_editions>
include <../data/docs_t>

let SOURCE_KEYS: List<Str> = ["sf", "mega", "drive", "transfer"]
let SOURCE_LABELS: List<Str> = ["btnSourceForge", "btnMega", "btnDrive", "btnTransfer"]

let dl_trans: Any = null
let dl_docs: Any = null
let dl_editions: Any = null

!! docsKey -> dodatkowy link "wiecej szczegolow" (jak editionDefs w doc-engine)
fun extra_docs_url(key: Str) -> Str [
    if key == "blue" [
        end "https://legendaryos-linux-system.github.io/website/"
    ]
    end ""
]

fun get_edition_description_html(docs_key: Any, lang: Str) -> Any [
    if not docs_key or dl_docs == null [
        end null
    ]
    let lang_data = jget(dl_docs, lang)
    let en_data = dl_docs.en
    let c = null
    if lang_data != null and lang_data.content and lang_data.content.editions [
        c = lang_data.content.editions
    ] elif en_data != null and en_data.content and en_data.content.editions [
        c = en_data.content.editions
    ]
    if c == null or not jget(c, docs_key) [
        end null
    ]
    let html = jget(c, docs_key)
    let extra_url = extra_docs_url(docs_key)
    if extra_url != "" [
        let more = "Więcej szczegółów:"
        let here = "tutaj"
        if lang == "en" [
            more = "More details:"
            here = "here"
        ]
        html = html + "<p style=\"margin-top:14px\">" + more + " <a href=\"" + extra_url + "\" target=\"_blank\">" + here + "</a></p>"
    ]
    end html
]

fun open_edition_info(ed: Any) [
    let lang = get_lang()
    let html = get_edition_description_html(ed.docsKey, lang)
    if not html [
        end
    ]
    document.getElementById("info-modal-title").textContent = ed.name
    document.getElementById("info-modal-body").innerHTML = html
    document.getElementById("info-modal-overlay").classList.add("open")
]

fun close_edition_info() [
    cl_rm(document.getElementById("info-modal-overlay"), "open")
]

fun dl_close_menu(m: Any) [
    cl_rm(m, "open")
]

fun dl_close_all_menus() [
    document.querySelectorAll(".dl-menu.open").forEach(dl_close_menu)
    document.querySelectorAll(".dl-trigger.open").forEach(dl_close_menu)
]

!! Jedna karta edycji (domkniecia przechwytuja ed / t / menu / trigger)
fun render_edition(grid: Any, ed: Any, t: Any) [
    let card = document.createElement("div")
    card.className = "edition-card"

    fun open_info(e: Any) [
        open_edition_info(ed)
    ]

    if ed.img [
        let img = document.createElement("img")
        img.className = "edition-thumb"
        img.src = ed.img
        img.alt = ed.name
        img.loading = "lazy"
        img.addEventListener("click", open_info)
        card.appendChild(img)
    ] else [
        let fb = document.createElement("div")
        fb.className = "edition-thumb-fallback"
        let initials = ed.name.replace("HackerOS", "").trim().slice(0, 2).toUpperCase()
        if not initials [
            initials = "OS"
        ]
        fb.textContent = initials
        fb.addEventListener("click", open_info)
        card.appendChild(fb)
    ]

    let body = document.createElement("div")
    body.className = "edition-body"

    let h2 = document.createElement("h2")
    h2.textContent = ed.name
    h2.addEventListener("click", open_info)
    body.appendChild(h2)

    let actions = document.createElement("div")
    actions.className = "edition-actions"

    let trigger = document.createElement("button")
    trigger.setAttribute("type", "button")
    trigger.className = "dl-trigger"
    trigger.innerHTML = "<span class=\"label\">" + (t.downloadBtn or "Pobierz") + "</span><span class=\"caret\">▾</span>"

    let menu = document.createElement("div")
    menu.className = "dl-menu"

    let title = document.createElement("div")
    title.className = "dl-menu-title"
    title.textContent = t.chooseSource or "Wybierz źródło"
    menu.appendChild(title)

    let i = 0
    while i < SOURCE_KEYS.len() [
        let key = SOURCE_KEYS[i]
        let label = jget(t, SOURCE_LABELS[i]) or key
        let skip = false
        if ed.excluded and ed.excluded.indexOf(key) != -1 [
            skip = true
        ]
        if not skip [
            let url = null
            if ed.links [
                url = jget(ed.links, key)
            ]
            if url [
                let a = document.createElement("a")
                a.href = url
                a.target = "_blank"
                a.rel = "noopener noreferrer"
                a.innerHTML = "<span>" + label + "</span>"
                menu.appendChild(a)
            ] else [
                let span = document.createElement("span")
                span.className = "dl-disabled"
                span.innerHTML = "<span>" + label + "</span><span class=\"soon-tag\">" + (t.comingSoon or "Soon") + "</span>"
                menu.appendChild(span)
            ]
        ]
        i = i + 1
    ]

    fun toggle_menu(e: Any) [
        e.stopPropagation()
        let is_open = menu.classList.contains("open")
        dl_close_all_menus()
        if not is_open [
            menu.classList.add("open")
            trigger.classList.add("open")
        ]
    ]
    trigger.addEventListener("click", toggle_menu)

    actions.appendChild(trigger)
    actions.appendChild(menu)
    body.appendChild(actions)
    card.appendChild(body)
    grid.appendChild(card)
]

fun render_editions(t: Any) [
    let grid = document.getElementById("edition-grid")
    grid.innerHTML = ""
    for ed in dl_editions [
        render_edition(grid, ed, t)
    ]
]

fun dl_on_doc_click(e: Any) [
    dl_close_all_menus()
]

fun dl_on_overlay_click(e: Any) [
    if e.target == e.currentTarget [
        close_edition_info()
    ]
]

fun dl_on_keydown(e: Any) [
    if e.key == "Escape" [
        close_edition_info()
    ]
]

fun dl_nav(k: Str, t: Any) [
    let a = document.getElementById("nav-" + k)
    if a != null [
        a.textContent = jget(t, "nav" + k.charAt(0).toUpperCase() + k.slice(1))
    ]
]

fun dl_apply_lang(lang: Str) [
    let t = jget(dl_trans, lang)
    if nil(t) [
        end
    ]
    document.documentElement.lang = lang
    document.title = t.pageTitle
    set_text("section-h1", t.sectionH1)
    set_text("quick-title", t.quickTitle)
    set_text("quick-desc", t.quickDesc)
    set_text("select-label", t.selectLabel)
    set_text("select-default", t.selectDefault)
    set_text("footer-copy", t.footerCopy)
    let heading = t.allEditionsTitle
    if not heading [
        heading = "All editions"
        if lang == "pl" [
            heading = "Wszystkie edycje"
        ]
    ]
    set_text("editions-heading", heading)
    set_text("editions-sub", t.allEditionsSub or t.chooseSource or "")
    for k in ["home", "download", "releases", "team", "docs"] [
        dl_nav(k, t)
    ]
    let dl_link = document.getElementById("download-link")
    if dl_link != null and dl_link.style.display != "none" [
        dl_link.textContent = t.downloadBtn
    ]
    render_editions(t)
]

fun dl_on_select_change(e: Any) [
    let sel = e.currentTarget
    let link = document.getElementById("download-link")
    let t = jget(dl_trans, get_lang())
    link.href = sel.value
    if not nil(t) [
        link.textContent = t.downloadBtn
    ] else [
        link.textContent = "Pobierz"
    ]
    if sel.value [
        link.style.display = "inline-block"
    ] else [
        link.style.display = "none"
    ]
]

fun download_init() [
    dl_trans = trans_download()
    dl_docs = trans_docs()
    dl_editions = download_editions()
    document.addEventListener("click", dl_on_doc_click)
    document.getElementById("info-modal-close").addEventListener("click", close_edition_info)
    document.getElementById("info-modal-overlay").addEventListener("click", dl_on_overlay_click)
    document.addEventListener("keydown", dl_on_keydown)
    window.__hackeros_applyLang = dl_apply_lang
    dl_apply_lang(get_lang())
    document.getElementById("edition-select").addEventListener("change", dl_on_select_change)
    lang_switcher_init()
]
