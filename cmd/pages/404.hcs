use <mode:website>

include <../logic/notfound>

style {
#app { display: none; }
*{margin:0;padding:0;box-sizing:border-box;font-family:'Arial',sans-serif;}
:root{--bg:#1C2526;--panel:#2F3A44;--dark:#121212;--grey:#B0B0B0;--cy:#00d4ff;--bl:#4a9eff;--red:#ff4d5e;--ok:#35e08a;--mono:'Courier New',Consolas,monospace;}
html,body{height:100%;}
body{background:var(--bg);color:#FFF;line-height:1.6;overflow-x:hidden;min-height:100vh;}
#rain{position:fixed;inset:0;width:100%;height:100%;z-index:0;opacity:.35;}
body::before{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;background:radial-gradient(circle at 50% 40%,rgba(47,58,68,.35) 0%,rgba(0,0,0,.75) 100%);}

.scan{position:fixed;inset:0;z-index:50;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.18) 0,rgba(0,0,0,.18) 1px,transparent 1px,transparent 3px);animation:flick 4s infinite steps(1);}
.scan::after{content:'';position:absolute;left:0;width:100%;height:120px;top:-120px;background:linear-gradient(180deg,transparent,rgba(0,212,255,.07),transparent);animation:sweep 6s linear infinite;}
@keyframes sweep{to{top:100%}}
@keyframes flick{0%,100%{opacity:1}92%{opacity:.85}93%{opacity:1}96%{opacity:.9}}
.tear{position:fixed;left:0;width:100%;height:0;z-index:49;pointer-events:none;background:rgba(0,212,255,.12);mix-blend-mode:screen;display:none;}
header{background:var(--dark);position:fixed;width:100%;top:0;z-index:60;box-shadow:0 4px 10px rgba(0,0,0,.7);}
nav{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:12px 20px;}
nav .logo img{height:40px;width:auto;display:block;}
.status{font-family:var(--mono);font-size:13px;letter-spacing:2px;padding:5px 12px;border-radius:3px;border:1px solid var(--red);color:var(--red);background:rgba(255,77,94,.1);}
.status i{display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor;margin-right:8px;animation:blink .9s infinite;}
.status.on{border-color:var(--ok);color:var(--ok);background:rgba(53,224,138,.1);}
.status.nf{border-color:var(--bl);color:var(--bl);background:rgba(74,158,255,.1);}
@keyframes blink{50%{opacity:.15}}
main{position:relative;z-index:10;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:100px 18px 50px;text-align:center;}
.wrap{width:100%;max-width:820px;transition:filter .1s;}
.wrap.burst{animation:burst .32s steps(2) 1;filter:hue-rotate(40deg) saturate(1.6);}
@keyframes burst{0%{transform:translate(0,0) skewX(0)}25%{transform:translate(-8px,2px) skewX(6deg)}50%{transform:translate(9px,-3px) skewX(-8deg)}75%{transform:translate(-4px,1px) skewX(3deg)}100%{transform:none}}
.eyebrow{font-family:var(--mono);color:var(--cy);font-size:12.5px;letter-spacing:3px;text-transform:uppercase;margin-bottom:6px;}

.glitch{position:relative;display:inline-block;font-family:var(--mono);font-weight:bold;font-size:clamp(54px,15vw,132px);line-height:1.05;letter-spacing:4px;color:#fff;text-shadow:0 0 18px rgba(0,212,255,.45);cursor:pointer;}
.glitch::before,.glitch::after{content:attr(data-text);position:absolute;left:0;top:0;width:100%;height:100%;overflow:hidden;}
.glitch::before{color:var(--cy);transform:translateX(-4px);text-shadow:none;animation:g1 2.6s infinite steps(1);}
.glitch::after{color:var(--red);transform:translateX(4px);text-shadow:none;animation:g2 3.1s infinite steps(1);}
@keyframes g1{0%{clip-path:inset(0 0 85% 0)}8%{clip-path:inset(30% 0 40% 0)}16%{clip-path:inset(70% 0 5% 0)}24%{clip-path:inset(10% 0 60% 0)}32%,100%{clip-path:inset(0 0 100% 0)}60%{clip-path:inset(45% 0 20% 0)}66%{clip-path:inset(0 0 100% 0)}}
@keyframes g2{0%{clip-path:inset(60% 0 10% 0)}10%{clip-path:inset(5% 0 80% 0)}20%{clip-path:inset(40% 0 35% 0)}28%,100%{clip-path:inset(0 0 100% 0)}70%{clip-path:inset(80% 0 2% 0)}76%{clip-path:inset(0 0 100% 0)}}
.sub{font-size:clamp(16px,3.4vw,22px);color:var(--grey);margin:6px 0 24px;min-height:1.6em;}
.sub b{color:#fff;}

.term{background:rgba(18,18,18,.88);border:1px solid #3A4A55;border-radius:10px;text-align:left;box-shadow:0 8px 30px rgba(0,0,0,.6),0 0 24px rgba(0,212,255,.08);overflow:hidden;}
.term-bar{display:flex;align-items:center;gap:7px;background:var(--panel);padding:8px 12px;font-family:var(--mono);font-size:12px;color:var(--grey);}
.term-bar span{width:11px;height:11px;border-radius:50%;background:#ff5f56;}
.term-bar span:nth-child(2){background:#ffbd2e;}.term-bar span:nth-child(3){background:#27c93f;}
.term-bar em{font-style:normal;margin-left:8px;}
#log{font-family:var(--mono);font-size:13.5px;line-height:1.55;padding:14px 16px;height:250px;overflow:hidden;color:#C6C6C6;white-space:pre-wrap;word-break:break-word;}
#log .p{color:var(--cy);}#log .e{color:var(--red);}#log .w{color:#ffbd2e;}#log .o{color:var(--ok);}#log .d{color:#6f7f8a;}
.caret{display:inline-block;width:8px;height:15px;background:var(--cy);vertical-align:-2px;animation:blink .7s infinite;}

.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0;}
.stat{background:rgba(47,58,68,.85);border-radius:8px;padding:12px 8px;box-shadow:0 4px 10px rgba(0,0,0,.3);}
.stat small{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:1.5px;color:var(--grey);text-transform:uppercase;}
.stat strong{font-family:var(--mono);font-size:18px;color:var(--cy);}
.stat strong.bad{color:var(--red);}
.bars{display:inline-flex;gap:3px;align-items:flex-end;height:20px;}
.bars i{width:5px;background:#3A4A55;display:block;}
.bars i:nth-child(1){height:5px}.bars i:nth-child(2){height:9px}.bars i:nth-child(3){height:14px}.bars i:nth-child(4){height:20px}
.bars i.on{background:var(--cy);}

.prog{height:6px;background:#2a343c;border-radius:4px;overflow:hidden;margin:4px 0 6px;}
.prog div{height:100%;width:0;background:linear-gradient(90deg,var(--bl),var(--cy));box-shadow:0 0 10px var(--cy);}
.prog-t{font-family:var(--mono);font-size:12px;color:var(--grey);margin-bottom:22px;min-height:1.2em;}

.hero-buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.btn{display:inline-block;padding:12px 24px;background-color:var(--grey);color:#121212;text-decoration:none;border-radius:5px;font-weight:bold;border:2px solid var(--grey);cursor:pointer;font-size:16px;transition:background-color .3s,transform .3s,box-shadow .3s;}
.btn:hover{background-color:#FFF;transform:scale(1.05);box-shadow:0 4px 14px rgba(0,212,255,.35);}
.btn.alt{background:transparent;color:#fff;border-color:#3A4A55;}
.btn.alt:hover{background:var(--panel);border-color:var(--cy);}
footer{position:relative;z-index:10;background:var(--dark);padding:16px;text-align:center;color:var(--grey);font-size:13px;box-shadow:0 -2px 5px rgba(0,0,0,.5);}
footer code{font-family:var(--mono);color:var(--cy);}
@media(max-width:560px){.stats{gap:8px}.stat strong{font-size:14px}#log{font-size:12px;height:230px}}
@media(prefers-reduced-motion:reduce){.glitch::before,.glitch::after,.scan,.scan::after,.wrap.burst{animation:none!important}#rain{display:none}}
}

let PAGE_BODY: Str = "<canvas id=\"rain\"></canvas>\n<div class=\"scan\"></div>\n<div class=\"tear\" id=\"tear\"></div>\n\n<header><nav>\n  <div class=\"logo\"><img id=\"logo\" src=\"HackerOS.png\" alt=\"HackerOS\" onerror=\"this.style.display='none'\"></div>\n  <div class=\"status\" id=\"status\"><i></i><span id=\"st-t\">OFFLINE</span></div>\n</nav></header>\n\n<main>\n  <div class=\"wrap\" id=\"wrap\">\n    <div class=\"eyebrow\" id=\"eyebrow\">// connection.lost</div>\n    <h1 class=\"glitch\" id=\"title\" data-text=\"OFFLINE\">OFFLINE</h1>\n    <p class=\"sub\" id=\"sub\"></p>\n\n    <div class=\"term\">\n      <div class=\"term-bar\"><span></span><span></span><span></span><em>root@hackeros:~# netcheck</em></div>\n      <div id=\"log\"></div>\n    </div>\n\n    <div class=\"stats\">\n      <div class=\"stat\"><small id=\"l-link\">Link</small><strong id=\"s-link\" class=\"bad\">DOWN</strong></div>\n      <div class=\"stat\"><small id=\"l-lat\">Ping</small><strong id=\"s-lat\" class=\"bad\">∞</strong></div>\n      <div class=\"stat\"><small id=\"l-sig\">Sygnał</small><strong><span class=\"bars\" id=\"bars\"><i></i><i></i><i></i><i></i></span></strong></div>\n    </div>\n\n    <div class=\"prog\"><div id=\"pbar\"></div></div>\n    <div class=\"prog-t\" id=\"ptxt\"></div>\n\n    <div class=\"hero-buttons\">\n      <button class=\"btn\" id=\"retry\">Spróbuj ponownie</button>\n      <a class=\"btn alt\" id=\"home\" href=\"Home-page.html\">Strona główna</a>\n    </div>\n  </div>\n</main>\n\n<footer>HackerOS &middot; <code id=\"code\">ERR_INTERNET_DISCONNECTED</code></footer>"

fun main() [
    boot_begin("pl", "HackerOS - Brak połączenia / 404")
    set_viewport("width=device-width,initial-scale=1.0")
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "HackerOS.png"])
    boot_body(PAGE_BODY)
    notfound_init()
]
