use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>

style {
#app { display: none; }
:root{--bg:#080a0d;--bg2:#0d1017;--bg3:#111520;--border:#1c2030;--border2:#252d42;--red:#ff2040;--red2:#ff4060;--red3:#ff6080;--cyan:#00d4ff;--yellow:#ffd000;--green:#00ff88;--dim:#3a4558;--text:#c5d3e8;--text2:#6b7f99;--mono:'JetBrains Mono',monospace;--head:'Bebas Neue',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:13.5px;line-height:1.75;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,32,64,0.015) 3px,rgba(255,32,64,0.015) 4px);pointer-events:none;z-index:9999}
.layout{display:flex;min-height:100vh}
nav{width:250px;min-width:250px;background:var(--bg2);border-right:1px solid var(--border);position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.nav-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,rgba(255,32,64,0.12) 0%,transparent 100%)}
.logo-big{font-family:var(--head);font-size:48px;line-height:1;color:var(--red);text-shadow:0 0 40px rgba(255,32,64,0.6),0 0 80px rgba(255,32,64,0.2);letter-spacing:2px}
.logo-sub{color:var(--text2);font-size:10px;letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.logo-ver{color:var(--red3);font-size:11px;margin-top:6px}
.nav-section{padding:14px 20px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
nav a{display:block;padding:5px 20px 5px 28px;color:var(--text2);text-decoration:none;font-size:12px;transition:all .15s;position:relative;border-left:2px solid transparent}
nav a::before{content:'›';position:absolute;left:14px;color:var(--dim)}
nav a:hover{color:var(--text);background:rgba(255,32,64,0.04)}
nav a.active{color:var(--red);border-left-color:var(--red);background:rgba(255,32,64,0.07)}
nav a.active::before{color:var(--red)}
main{flex:1;max-width:860px;padding:0 64px 80px}
.hero{padding:64px 0 56px;border-bottom:1px solid var(--border);margin-bottom:64px;position:relative;overflow:hidden}
.hero::before{content:'HAMMER';position:absolute;right:-20px;top:-20px;font-family:var(--head);font-size:200px;color:rgba(255,32,64,0.04);pointer-events:none;user-select:none}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.3);color:var(--red);font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:24px}
.hero-tag::before{content:'◆';font-size:8px}
.hero h1{font-family:var(--head);font-size:64px;line-height:1;letter-spacing:3px;color:#fff;margin-bottom:6px}
.hero h1 span{color:var(--red);text-shadow:0 0 30px rgba(255,32,64,0.5)}
.hero-desc{color:var(--text2);font-size:14px;margin-bottom:32px;max-width:560px}
.hero-cmd{background:var(--bg3);border:1px solid var(--border2);border-left:3px solid var(--red);padding:14px 20px;border-radius:3px;display:inline-block;font-size:14px}
.prompt{color:var(--dim)}.cmd-s{color:var(--red)}.arg-s{color:var(--text)}
section{margin-bottom:72px}
h2{font-family:var(--head);font-size:28px;color:#fff;letter-spacing:2px;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.h2-num{font-size:11px;color:var(--red);letter-spacing:2px;border:1px solid rgba(255,32,64,0.3);padding:2px 8px;border-radius:2px;font-family:var(--mono)}
h2 a{color:var(--dim);text-decoration:none;font-size:16px;margin-left:auto}
h2 a:hover{color:var(--red)}
h3{font-size:13px;color:var(--red2);letter-spacing:1px;margin:28px 0 10px;text-transform:uppercase}
p{color:var(--text);margin-bottom:14px;max-width:680px}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;overflow-x:auto;margin:14px 0 24px;position:relative}
pre::before{content:attr(data-lang);position:absolute;top:8px;right:12px;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim)}
code{font-family:var(--mono);font-size:12.5px;color:var(--text)}
.hl-r{color:var(--red)}.hl-c{color:var(--cyan)}.hl-y{color:var(--yellow)}.hl-g{color:var(--green)}.hl-d{color:var(--dim)}.hl-w{color:#fff;font-weight:600}
ci{display:inline;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.2);padding:1px 6px;border-radius:2px;font-size:12px;color:var(--red2);font-family:var(--mono)}
.tbl{width:100%;border-collapse:collapse;margin:16px 0 24px}
.tbl th{text-align:left;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);padding:8px 14px;border-bottom:1px solid var(--border2)}
.tbl td{padding:9px 14px;border-bottom:1px solid var(--border);vertical-align:top}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(255,32,64,0.03)}
.tbl .tc{color:var(--red2);font-weight:500;white-space:nowrap}.tbl .ta{color:var(--yellow)}.tbl .td{color:var(--text2);font-size:12.5px}
.yes{color:var(--green)}.no{color:var(--red)}.par{color:var(--yellow)}
.box{border-radius:3px;padding:14px 18px;margin:14px 0 20px;border-left:3px solid;font-size:13px;max-width:680px}
.box-n{background:rgba(0,212,255,0.06);border-color:var(--cyan)}.box-w{background:rgba(255,208,0,0.06);border-color:var(--yellow)}.box-t{background:rgba(255,32,64,0.06);border-color:var(--red)}
.box strong{display:block;margin-bottom:4px;font-size:9px;letter-spacing:2px;text-transform:uppercase}
.box-n strong{color:var(--cyan)}.box-w strong{color:var(--yellow)}.box-t strong{color:var(--red)}
.tree{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;margin:14px 0 24px;font-size:12.5px;line-height:2}
.td2{color:var(--red2)}.tf{color:var(--text)}.ta2{color:var(--dim);font-style:italic}.to{color:var(--dim)}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.badge{font-size:10px;padding:3px 10px;border-radius:2px;border:1px solid;letter-spacing:.5px}
.br{color:var(--red);border-color:rgba(255,32,64,0.3);background:rgba(255,32,64,0.08)}.bc{color:var(--cyan);border-color:rgba(0,212,255,0.3);background:rgba(0,212,255,0.08)}.by{color:var(--yellow);border-color:rgba(255,208,0,0.3);background:rgba(255,208,0,0.08)}.bg{color:var(--green);border-color:rgba(0,255,136,0.3);background:rgba(0,255,136,0.08)}
.ext{color:var(--red2);text-decoration:none;border-bottom:1px solid rgba(255,64,96,0.3)}
.ext:hover{color:var(--red);border-bottom-color:var(--red)}
ul.feat{color:var(--text2);margin:0 0 20px 20px;line-height:2}
footer{margin-top:80px;padding-top:24px;border-top:1px solid var(--border);color:var(--dim);font-size:11px}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--red)}
@media(max-width:860px){nav{display:none}main{padding:32px 20px}.hero h1{font-size:44px}}
}

let PAGE_BODY: Str = "<div class=\"layout\">\n<nav>\n  <div class=\"nav-logo\">\n    <div class=\"logo-big\">HAMMER</div>\n    <div class=\"logo-sub\">HackerOS Package Manager</div>\n    <div class=\"logo-ver\">v0.5.0 &middot; Atomic &middot; H#</div>\n  </div>\n  <span class=\"nav-section\">Getting Started</span>\n  <a href=\"#overview\">Overview</a>\n  <a href=\"#quickstart\">Quickstart</a>\n  <a href=\"#modes\">Build Modes</a>\n  <span class=\"nav-section\">Usage</span>\n  <a href=\"#commands\">Command Reference</a>\n  <a href=\"#flags\">Global Flags</a>\n  <a href=\"#generations\">Generations</a>\n  <a href=\"#immutable\">Immutable FS</a>\n  <a href=\"#solver\">Dependency Solver</a>\n  <span class=\"nav-section\">Sources</span>\n  <a href=\"#repos\">Repositories</a>\n  <a href=\"#tools\">HackerOS Tools</a>\n  <span class=\"nav-section\">System</span>\n  <a href=\"#security\">Security</a>\n  <a href=\"#daemon\">Daemon</a>\n  <a href=\"#user\">User Mode</a>\n  <a href=\"#oci\">OCI Mode</a>\n  <span class=\"nav-section\">Reference</span>\n  <a href=\"#libhammer\">libhammer</a>\n  <a href=\"#layout\">Source Layout</a>\n  <a href=\"#port\">Port Notes</a>\n</nav>\n<main>\n\n<div class=\"hero\">\n  <div class=\"hero-tag\">Atomic &middot; Generations &middot; SAT solver &middot; HackerOS</div>\n  <h1><span>HAMMER</span></h1>\n  <p class=\"hero-desc\">Menedżer pakietów HackerOS Atomic dla repozytoriów Debiana. Transakcyjne aktualizacje, generacje systemu z rollbackiem, niezmienny system plików i solver SAT &mdash; oraz tryb normal dla zwykłych systemów i kontenerów.</p>\n  <div class=\"hero-cmd\"><span class=\"prompt\">$ </span><span class=\"cmd-s\">hammer</span> <span class=\"arg-s\">install &lt;package&gt;</span></div>\n</div>\n\n<section id=\"overview\">\n  <h2><span class=\"h2-num\">01</span> OVERVIEW <a href=\"#overview\">#</a></h2>\n  <div class=\"badges\"><span class=\"badge br\">Atomic</span><span class=\"badge bc\">SAT solver</span><span class=\"badge by\">Generations</span><span class=\"badge bg\">H#</span><span class=\"badge br\">Apache-2.0</span></div><p><strong>hammer</strong> to menedżer pakietów HackerOS dla repozytoriów Debiana, zaprojektowany pod <strong>HackerOS Atomic</strong>: aktualizacje pakietów są transakcjami, każda zmiana tworzy nową <em>generację</em> systemu, a do poprzedniej można wrócić jedną komendą. Ten sam kod buduje się też w trybie <ci>normal</ci> &mdash; klasyczne instalacje w stylu apt bez wymagań wobec systemu plików (kontenery, chroot, zwykły Debian).</p><p>Wersja <ci>0.5.0</ci>, licencja Apache-2.0. Program jest portem wcześniejszej wersji w Rust na H#. Logika rdzenia (wersje, zależności, <ci>.deb</ci>, solver, baza) mieszka w bibliotece <ci>libhammer</ci>, a pakiet <ci>hammer</ci> dokłada CLI, demona <ci>hammerd</ci>, warstwę OCI/ostree i operacje systemowe.</p><ul class=\"feat\"><li>Zależności rozwiązuje solver SAT (CDCL), z wyjaśnieniami <ci>why</ci> / <ci>why-not</ci> przy konfliktach.</li><li>Weryfikacja sygnatur repozytoriów (<ci>InRelease</ci>, <ci>gpgv</ci>) i sum SHA-256, łańcuch audytu z podpisami Ed25519.</li><li>Generacje, <ci>rollback</ci>, <ci>undo</ci>, migawki, niezmienny system plików i automatyczny fallback bootu do ostatniej dobrej generacji.</li><li>Źródła pakietów w formacie <ci>.hk</ci> (<ci>/etc/hammer/sources-list.hk</ci>), wiele architektur, przypinanie wersji.</li><li>Tryb użytkownika <ci>--user</ci> bez roota, demon w tle, wyjście <ci>--json</ci> i opcjonalny tryb obrazowy <ci>hammer oci</ci>.</li></ul>\n</section>\n\n<section id=\"quickstart\">\n  <h2><span class=\"h2-num\">02</span> QUICKSTART <a href=\"#quickstart\">#</a></h2>\n  <pre data-lang=\"sh\"><code>sudo hammer init                 <span class=\"hl-d\"># tworzy /hammer/*, /etc/hammer, domyślny sources-list.hk</span>\nsudo hammer sync                 <span class=\"hl-d\"># pobierz indeksy pakietów</span>\nhammer search editor             <span class=\"hl-d\"># szukaj (działa bez roota)</span>\nsudo hammer install curl         <span class=\"hl-d\"># instalacja z zależnościami</span>\nsudo hammer upgrade              <span class=\"hl-d\"># aktualizacja zainstalowanych</span>\nhammer gen list                  <span class=\"hl-d\"># generacje systemu (tryb atomic)</span>\nsudo hammer rollback             <span class=\"hl-d\"># powrót do poprzedniej generacji</span>\nhammer doctor                    <span class=\"hl-d\"># diagnostyka</span></code></pre><div class=\"box box-n\"><strong>Root</strong>Komendy zmieniające system (<ci>init</ci>, <ci>sync</ci>, <ci>install</ci>, <ci>remove</ci>, <ci>upgrade</ci>, <ci>gen</ci>, <ci>immutable</ci> ...) wymagają uprawnień roota. Wyszukiwanie i zapytania działają jako zwykły użytkownik. <ci>hammer init --suite=&lt;wydanie&gt;</ci> wybiera wydanie Debiana dla domyślnego sources-list (domyślnie <ci>bookworm</ci>).</div><p><ci>hammer help</ci> wypisuje komendy pogrupowane tematycznie, a <ci>hammer &lt;komenda&gt; --help</ci> szczegóły danej komendy.</p>\n</section>\n\n<section id=\"modes\">\n  <h2><span class=\"h2-num\">03</span> BUILD MODES <a href=\"#modes\">#</a></h2>\n  <p>Ten sam kod działa w dwóch trybach. Pomoc i <ci>hammer version</ci> pokazują aktywny tryb (znacznik ATOMIC albo NORMAL).</p><table class=\"tbl\">\n    <tr><th></th><th>atomic (domyślny)</th><th>normal</th></tr>\n    <tr><td class=\"tc\">Cel</td><td>HackerOS zainstalowany na dysku</td><td>dowolny system, kontenery, chroot</td></tr>\n    <tr><td class=\"tc\">Generacje, rollback, undo, pending</td><td><span class=\"yes\">tak</span></td><td><span class=\"no\">nie</span> (komendy zwracają wyjaśnienie)</td></tr>\n    <tr><td class=\"tc\">Niezmienny system plików, migawki</td><td><span class=\"yes\">tak</span></td><td><span class=\"no\">nie</span></td></tr>\n    <tr><td class=\"tc\">Katalog bazowy</td><td><ci>/hammer/</ci></td><td><ci>/var/lib/hammer/</ci></td></tr>\n    <tr><td class=\"tc\">Baza zainstalowanych</td><td><ci>/hammer/db/packages.sqlite</ci></td><td><ci>/var/lib/hammer/db.sqlite</ci></td></tr>\n    <tr><td class=\"tc\">Katalog tymczasowy</td><td><ci>/hammer/tmp</ci></td><td><ci>/tmp/hammer</ci></td></tr>\n  </table><h3>Wybór trybu</h3><table class=\"tbl\">\n    <tr><th>Mechanizm</th><th>Działanie</th></tr>\n    <tr><td class=\"tc\"><ci>HAMMER_MODE=normal|atomic</ci></td><td class=\"td\">wybór w czasie działania, ma pierwszeństwo &mdash; wygodne w kontenerach i chroot bez przebudowy</td></tr>\n    <tr><td class=\"tc\"><ci>HAMMER_OCI=1|0</ci></td><td class=\"td\">włącza lub wyłącza <ci>hammer oci</ci> w czasie działania</td></tr>\n    <tr><td class=\"tc\"><ci>HAMMER_ROOT=&lt;katalog&gt;</ci></td><td class=\"td\">przesuwa katalog bazowy, np. <ci>HAMMER_ROOT=/mnt/target hammer install curl</ci></td></tr>\n    <tr><td class=\"tc\"><ci>bit build</ci></td><td class=\"td\">budowa domyślna (atomic)</td></tr>\n    <tr><td class=\"tc\"><ci>bit build-normal</ci></td><td class=\"td\">przepisuje wkompilowany domyślny tryb na <ci>normal</ci> w <ci>source-code/internal/build_mode.h#</ci> i buduje</td></tr>\n    <tr><td class=\"tc\"><ci>bit build-oci</ci></td><td class=\"td\">wkompilowuje obsługę <ci>hammer oci</ci></td></tr>\n  </table><p><ci>hammer features</ci> wypisuje tryb i flagi funkcji: atomowość i rollback generacji, niezmienny FS (btrfs/zfs/remount), magazyn tylko do odczytu, migawki, solver SAT, weryfikacja GPG/Ed25519, multi-arch, przypinanie, usługi systemd, sandbox przestrzeni nazw, doctor oraz <ci>hammer oci</ci>.</p>\n</section>\n\n<section id=\"commands\">\n  <h2><span class=\"h2-num\">04</span> COMMAND REFERENCE <a href=\"#commands\">#</a></h2>\n  <h3>Package management</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer install <span class=\"ta\">&amp;lt;pkg...&amp;gt; [--arch=ARCH] [--no-recommends]</span></td><td class=\"td\">instalacja z zależnościami (alias <ci>in</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer remove <span class=\"ta\">&amp;lt;pkg...&amp;gt;</span></td><td class=\"td\">usuwa pakiety (alias <ci>rm</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer reinstall <span class=\"ta\">&amp;lt;pkg...&amp;gt;</span></td><td class=\"td\">instaluje ponownie</td></tr>\n    <tr><td class=\"tc\">hammer upgrade <span class=\"ta\">[pkg...]</span></td><td class=\"td\">aktualizuje zainstalowane (alias <ci>up</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer dist-upgrade</td><td class=\"td\">aktualizacja z zamianą zależności (alias <ci>dup</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer autoremove</td><td class=\"td\">usuwa osierocone zależności (alias <ci>ar</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer fix-broken</td><td class=\"td\">naprawia niespójny stan zależności (alias <ci>fix</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer sync</td><td class=\"td\">odświeża indeksy pakietów (aliasy <ci>ref</ci>, <ci>update</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer mark <span class=\"ta\">[auto|manual] &amp;lt;pkg...&amp;gt;</span></td><td class=\"td\">oznacza pakiet jako instalowany automatycznie lub ręcznie</td></tr>\n    <tr><td class=\"tc\">hammer download <span class=\"ta\">&amp;lt;pkg&amp;gt; [--arch=ARCH] [--no-verify]</span></td><td class=\"td\">pobiera <ci>.deb</ci> bez instalacji</td></tr>\n    <tr><td class=\"tc\">hammer self-update</td><td class=\"td\">aktualizuje samego hammera</td></tr>\n  </table><h3>Query</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer search <span class=\"ta\">&amp;lt;fraza&amp;gt; [--installed] [--json]</span></td><td class=\"td\">szuka pakietów (alias <ci>se</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer info <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">szczegóły pakietu; <ci>show</ci> działa podobnie</td></tr>\n    <tr><td class=\"tc\">hammer list <span class=\"ta\">[--installed|--upgradable]</span></td><td class=\"td\">lista pakietów (alias <ci>ls</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer depends | rdepends | show-deps <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">zależności, zależności odwrotne i drzewo zależności</td></tr>\n    <tr><td class=\"tc\">hammer files | which | owns | what <span class=\"ta\">&amp;lt;pkg|ścieżka&amp;gt;</span></td><td class=\"td\">pliki pakietu oraz który pakiet dostarcza dany plik (przez indeks plików)</td></tr>\n    <tr><td class=\"tc\">hammer what-rebuild</td><td class=\"td\">co trzeba przebudować po zmianie</td></tr>\n    <tr><td class=\"tc\">hammer size <span class=\"ta\">&amp;lt;pkg...&amp;gt;</span></td><td class=\"td\">rozmiar na dysku</td></tr>\n    <tr><td class=\"tc\">hammer policy | changelog <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">polityka wersji (przypięcia, priorytety) i changelog</td></tr>\n    <tr><td class=\"tc\">hammer stats</td><td class=\"td\">statystyki bazy</td></tr>\n    <tr><td class=\"tc\">hammer why | why-not <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">dlaczego pakiet jest (lub nie może być) zainstalowany</td></tr>\n  </table><h3>Pinning &amp; architectures</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer hold | unhold <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">wstrzymuje lub zwalnia aktualizacje pakietu</td></tr>\n    <tr><td class=\"tc\">hammer pin add <span class=\"ta\">&amp;lt;pkg&amp;gt; &amp;lt;wersja&amp;gt; [priorytet] [notatka]</span></td><td class=\"td\">przypina wersję; <ci>pin remove</ci>, <ci>pin hold</ci>, <ci>pin unhold</ci></td></tr>\n    <tr><td class=\"tc\">hammer unpin <span class=\"ta\">&amp;lt;pkg...&amp;gt;</span></td><td class=\"td\">zdejmuje przypięcie</td></tr>\n    <tr><td class=\"tc\">hammer arch | dpkg-arch <span class=\"ta\">add|remove &amp;lt;arch&amp;gt; | print | foreign | assert</span></td><td class=\"td\">architektury obce (multi-arch); <ci>--arch=ARCH</ci> przy instalacji</td></tr>\n  </table><h3>Atomic only</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer gen <span class=\"ta\">list|switch N|delete N|gc</span></td><td class=\"td\">generacje systemu</td></tr>\n    <tr><td class=\"tc\">hammer rollback</td><td class=\"td\">powrót do poprzedniej generacji (alias <ci>rb</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer undo <span class=\"ta\">[--to N] [-y]</span></td><td class=\"td\">cofa ostatnią operację albo wraca do generacji N</td></tr>\n    <tr><td class=\"tc\">hammer diff <span class=\"ta\">[A [B]]</span></td><td class=\"td\">różnice między generacjami lub względem generacji oczekującej</td></tr>\n    <tr><td class=\"tc\">hammer pending <span class=\"ta\">status|show|apply-live|cancel</span></td><td class=\"td\">generacja oczekująca na aktywację</td></tr>\n    <tr><td class=\"tc\">hammer snapshot <span class=\"ta\">[etykieta]</span></td><td class=\"td\">tworzy migawkę (alias <ci>snap</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer immutable <span class=\"ta\">status|enable|disable|lock|unlock|verify|snapshot|snapshots|install-service</span></td><td class=\"td\">niezmienny system plików (alias <ci>imm</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer boot <span class=\"ta\">status|activate|fallback|update-grub</span></td><td class=\"td\">aktywacja generacji i fallback bootu</td></tr>\n  </table><h3>Diagnostics &amp; maintenance</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer doctor</td><td class=\"td\">diagnostyka systemu</td></tr>\n    <tr><td class=\"tc\">hammer check | verify | fsck <span class=\"ta\">[--deep] [--fix] [--json] [--full]</span></td><td class=\"td\">kontrola spójności pakietów i magazynu</td></tr>\n    <tr><td class=\"tc\">hammer audit <span class=\"ta\">list|verify|export|keygen</span></td><td class=\"td\">łańcuch audytu</td></tr>\n    <tr><td class=\"tc\">hammer history <span class=\"ta\">[-n N] [--diff A B] [--search pkg] [--json]</span></td><td class=\"td\">historia zmian (alias <ci>hi</ci>); <ci>-n</ci> przyjmuje liczbę jako osobny argument</td></tr>\n    <tr><td class=\"tc\">hammer status</td><td class=\"td\">stan systemu (alias <ci>st</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer log <span class=\"ta\">[-nN]</span></td><td class=\"td\">ostatnie linie logu hammera, np. <ci>-n100</ci> (alias <ci>logs</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer service <span class=\"ta\">list|start|stop|restart|reload|enable|disable|status|log [unit...]</span></td><td class=\"td\">usługi systemd (alias <ci>svc</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer gc <span class=\"ta\">[--keep=N] [-y]</span></td><td class=\"td\">sprząta stare generacje i nieużywane wpisy magazynu</td></tr>\n    <tr><td class=\"tc\">hammer clean</td><td class=\"td\">usuwa pobrane archiwa z cache</td></tr>\n    <tr><td class=\"tc\">hammer init | relink | store</td><td class=\"td\">inicjalizacja magazynu, odtworzenie dowiązań binarek, uruchomienie <ci>hammer-store</ci></td></tr>\n    <tr><td class=\"tc\">hammer export | import <span class=\"ta\">[plik.tar.gz]</span></td><td class=\"td\">eksport bieżącej generacji i import archiwum</td></tr>\n    <tr><td class=\"tc\">hammer key <span class=\"ta\">add|list|remove|import|check|doctor</span></td><td class=\"td\">zaufane klucze GPG</td></tr>\n    <tr><td class=\"tc\">hammer db <span class=\"ta\">export-json|import-json|validate-json|recover</span></td><td class=\"td\">baza zainstalowanych pakietów (SQLite + JSON)</td></tr>\n    <tr><td class=\"tc\">hammer daemon <span class=\"ta\">start|stop|status|reload|sync|check|verify|gc|security-upgrade|install-service</span></td><td class=\"td\">demon <ci>hammerd</ci></td></tr>\n    <tr><td class=\"tc\">hammer completion <span class=\"ta\">bash|zsh|fish|install</span></td><td class=\"td\">uzupełnianie poleceń</td></tr>\n    <tr><td class=\"tc\">hammer version | features</td><td class=\"td\">wersja, tryb i flagi funkcji</td></tr>\n  </table><h3>Sources &amp; tools</h3><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer repo <span class=\"ta\">list|add &amp;lt;uri&amp;gt; &amp;lt;suite&amp;gt; [komponenty]|remove|enable|disable|info|set-default</span></td><td class=\"td\">zarządzanie źródłami pakietów</td></tr>\n    <tr><td class=\"tc\">hammer source | build-dep <span class=\"ta\">&amp;lt;pkg&amp;gt;</span></td><td class=\"td\">źródła pakietu i zależności budowania</td></tr>\n    <tr><td class=\"tc\">hammer build</td><td class=\"td\">budowa pakietu ze źródeł</td></tr>\n    <tr><td class=\"tc\">hammer mirror <span class=\"ta\">&amp;lt;url&amp;gt; &amp;lt;ścieżka&amp;gt; [--arch=] [--suite=] [--limit=KBPS] [--insecure]</span></td><td class=\"td\">lustro repozytorium Debiana z weryfikacją GPG i SHA-256</td></tr>\n    <tr><td class=\"tc\">hammer hk validate <span class=\"ta\">&amp;lt;plik.hk&amp;gt;</span></td><td class=\"td\">walidacja pliku w formacie .hk</td></tr>\n  </table>\n</section>\n\n<section id=\"flags\">\n  <h2><span class=\"h2-num\">05</span> GLOBAL FLAGS <a href=\"#flags\">#</a></h2>\n  <table class=\"tbl\">\n    <tr><th>Flaga</th><th>Znaczenie</th></tr>\n    <tr><td class=\"tc\"><ci>-y</ci>, <ci>--yes</ci>, <ci>--assume-yes</ci></td><td class=\"td\">bez pytań</td></tr>\n    <tr><td class=\"tc\"><ci>-n</ci>, <ci>--dry-run</ci></td><td class=\"td\">tylko pokaż plan (baner DRY-RUN)</td></tr>\n    <tr><td class=\"tc\"><ci>--json</ci></td><td class=\"td\">wyjście maszynowe, kolory wyłączone</td></tr>\n    <tr><td class=\"tc\"><ci>--color=always|never|auto</ci></td><td class=\"td\">tryb kolorów (także <ci>NO_COLOR</ci>, <ci>FORCE_COLOR</ci>)</td></tr>\n    <tr><td class=\"tc\"><ci>-v</ci>, <ci>--verbose</ci>, <ci>-q</ci>, <ci>--quiet</ci>, <ci>--debug</ci></td><td class=\"td\">poziom komunikatów (też <ci>HAMMER_LOG_LEVEL=debug</ci>)</td></tr>\n    <tr><td class=\"tc\"><ci>--no-progress</ci>, <ci>--no-download</ci>, <ci>--force</ci></td><td class=\"td\">bez pasków postępu, bez pobierania, wymuszenie</td></tr>\n    <tr><td class=\"tc\"><ci>--arch=ARCH</ci>, <ci>--root=KATALOG</ci></td><td class=\"td\">architektura docelowa, katalog główny instalacji</td></tr>\n    <tr><td class=\"tc\"><ci>-U</ci>, <ci>--user</ci></td><td class=\"td\">tryb użytkownika (patrz User Mode)</td></tr>\n    <tr><td class=\"tc\"><ci>--allow-unauthenticated</ci></td><td class=\"td\">świadoma zgoda na pakiety z repozytoriów bez weryfikacji GPG</td></tr>\n  </table>\n</section>\n\n<section id=\"generations\">\n  <h2><span class=\"h2-num\">06</span> GENERATIONS &amp; ROLLBACK <a href=\"#generations\">#</a></h2>\n  <p>W trybie atomic każda transakcja (instalacja, usunięcie, aktualizacja) składa nowy profil z magazynu pakietów i zapisuje go jako <em>generację</em> (stany <ci>Active</ci>, <ci>Pending</ci>, <ci>Old</ci>, <ci>Failed</ci>; rejestr w <ci>generations.json</ci>). Profil to drzewo dowiązań do magazynu <ci>/hammer/store</ci>; aktywacja podmienia dowiązanie <ci>active</ci> atomowo.</p><pre data-lang=\"sh\"><code>hammer gen list                 <span class=\"hl-d\"># lista generacji</span>\nhammer diff 4 5                 <span class=\"hl-d\"># różnice między generacjami</span>\nsudo hammer gen switch 4        <span class=\"hl-d\"># przełącz na generację 4</span>\nsudo hammer rollback            <span class=\"hl-d\"># wróć do poprzedniej</span>\nsudo hammer undo --to 3         <span class=\"hl-d\"># cofnij do generacji 3</span>\nsudo hammer gen gc              <span class=\"hl-d\"># usuń stare generacje</span>\nhammer pending status           <span class=\"hl-d\"># co czeka na aktywację</span></code></pre><p>Generacja oczekująca (<ci>pending</ci>) aktywuje się przy następnym restarcie; <ci>hammer pending apply-live</ci> stosuje od razu zmiany, które da się wprowadzić bez restartu (klasyfikacja plików nowych wpisów magazynu), a <ci>pending cancel</ci> ją anuluje. Przy aktualizacji generacji <ci>undo</ci> pyta o potwierdzenie i zwraca uwagę na zmodyfikowane pliki konfiguracyjne (conffiles).</p><h3>Fallback bootu</h3><p>hammer prowadzi licznik prób startu każdej generacji (<ci>/hammer/db/boot-attempts.json</ci>) i zna generacje, które uruchomiły się poprawnie. Po nieudanych próbach potrafi automatycznie wrócić do ostatniej dobrej generacji. <ci>hammer boot status</ci> pokazuje stan, <ci>boot fallback</ci> wymusza powrót ręcznie, a <ci>boot update-grub</ci> odświeża konfigurację GRUB-a. Aktywację po starcie wykonuje usługa <ci>hammer-activate.service</ci> (komenda <ci>_activate</ci>).</p><div class=\"box box-n\"><strong>Limit generacji</strong>Demon przechowuje domyślnie do 20 generacji (<ci>max_generations</ci> w <ci>/etc/hammer/hammerd.toml</ci>).</div>\n</section>\n\n<section id=\"immutable\">\n  <h2><span class=\"h2-num\">07</span> IMMUTABLE FILESYSTEM <a href=\"#immutable\">#</a></h2>\n  <p>W trybie atomic hammer potrafi zablokować system plików przed zapisem (np. tylko do odczytu <ci>/usr</ci>) i odblokowywać go na czas transakcji. Obsługiwane backendy: ponowne montowanie (<ci>mount -o remount,ro</ci>), btrfs, ZFS oraz sysext; migawki tworzą btrfs/ZFS.</p><table class=\"tbl\">\n    <tr><th>Komenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hammer immutable status</td><td class=\"td\">stan blokady i wykryty backend</td></tr>\n    <tr><td class=\"tc\">hammer immutable enable | disable</td><td class=\"td\">włącza lub wyłącza tryb niezmienny</td></tr>\n    <tr><td class=\"tc\">hammer immutable lock | unlock</td><td class=\"td\"><ci>unlock</ci> tymczasowo odblokowuje zapis (przypomina o ponownym zablokowaniu), <ci>lock</ci> blokuje ponownie</td></tr>\n    <tr><td class=\"tc\">hammer immutable snapshot <span class=\"ta\">[etykieta]</span></td><td class=\"td\">migawka (alias: <ci>hammer snapshot</ci>)</td></tr>\n    <tr><td class=\"tc\">hammer immutable snapshots | list-snapshots</td><td class=\"td\">lista migawek</td></tr>\n    <tr><td class=\"tc\">hammer immutable verify</td><td class=\"td\">weryfikacja stanu</td></tr>\n    <tr><td class=\"tc\">hammer immutable install-service</td><td class=\"td\">instaluje usługę <ci>hammer-immutable.service</ci></td></tr>\n  </table><div class=\"box box-w\"><strong>Normal-mode</strong>W buildzie <ci>normal</ci> komenda <ci>hammer immutable</ci> wypisuje, że jest niedostępna; <ci>gen</ci>, <ci>rollback</ci>, <ci>pending</ci>, <ci>undo</ci> i <ci>snapshot</ci> zwracają wyjaśnienie i podpowiedź, by użyć <ci>hammer history</ci>.</div>\n</section>\n\n<section id=\"solver\">\n  <h2><span class=\"h2-num\">08</span> DEPENDENCY SOLVER <a href=\"#solver\">#</a></h2>\n  <p>Zależności rozwiązuje solver SAT z uczeniem klauzul (CDCL: VSIDS, dwa obserwowane literały, analiza 1UIP, restarty, preprocessing) z biblioteki <ci>libhammer</ci>, z warstwą wyjaśnień konfliktów po stronie CLI. Obsługuje zależności, konflikty (<ci>Conflicts</ci>), <ci>Provides</ci> i alternatywy <ci>a | b</ci>, a wersje porównuje po regułach Debiana (epoka, tylda, rewizja).</p><pre data-lang=\"sh\"><code>hammer why libssl3         <span class=\"hl-d\"># dlaczego pakiet jest w systemie</span>\nhammer why-not foo         <span class=\"hl-d\"># dlaczego foo nie może zostać zainstalowany</span>\nhammer show-deps curl      <span class=\"hl-d\"># drzewo zależności</span>\nhammer _selftest           <span class=\"hl-d\"># testy solvera (komenda ukryta)</span></code></pre><p>W buildzie hammera dostępny jest też moduł oparty o bibliotekę <ci>satsolv</ci> (zależność w <ci>Bit.hk</ci>).</p>\n</section>\n\n<section id=\"repos\">\n  <h2><span class=\"h2-num\">09</span> REPOSITORIES <a href=\"#repos\">#</a></h2>\n  <p>Źródła pakietów leżą w <ci>/etc/hammer/sources-list.hk</ci> w formacie <ci>.hk</ci> HackerOS: jedna sekcja to jedno repozytorium. Domyślny plik tworzy <ci>hammer init</ci>; po edycji uruchom <ci>hammer sync</ci>.</p><pre data-lang=\"hk\"><code><span class=\"hl-d\">! komentarze zaczynają się od !</span>\n[debian-trixie]\n-&gt; name       =&gt; debian-trixie\n-&gt; baseurl    =&gt; http://deb.debian.org/debian\n-&gt; suite      =&gt; trixie\n-&gt; components =&gt; [\"main\", \"contrib\", \"non-free\", \"non-free-firmware\"]\n-&gt; arch       =&gt; [\"amd64\"]\n-&gt; enabled    =&gt; true</code></pre><table class=\"tbl\">\n    <tr><th>Klucz</th><th>Wymagany</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>baseurl</ci></td><td>tak</td><td class=\"td\">bazowy URL repozytorium</td></tr>\n    <tr><td class=\"tc\"><ci>suite</ci></td><td>tak</td><td class=\"td\">wydanie, np. <ci>trixie</ci>, <ci>trixie-security</ci></td></tr>\n    <tr><td class=\"tc\"><ci>components</ci></td><td>tak</td><td class=\"td\">lista składowych, np. <ci>[\"main\", \"contrib\"]</ci></td></tr>\n    <tr><td class=\"tc\"><ci>name</ci></td><td>nie</td><td class=\"td\">nazwa wyświetlana</td></tr>\n    <tr><td class=\"tc\"><ci>arch</ci></td><td>nie</td><td class=\"td\">architektury (domyślnie architektura hosta)</td></tr>\n    <tr><td class=\"tc\"><ci>enabled</ci></td><td>nie</td><td class=\"td\"><ci>true</ci>/<ci>false</ci> (domyślnie <ci>true</ci>)</td></tr>\n    <tr><td class=\"tc\"><ci>gpgkey</ci></td><td>nie</td><td class=\"td\">URL lub ścieżka klucza GPG</td></tr>\n    <tr><td class=\"tc\"><ci>type</ci></td><td>nie</td><td class=\"td\"><ci>deb</ci> albo <ci>deb-src</ci></td></tr>\n  </table><p>Repozytorium zawiera gotowe listy: <ci>sources-lists/trixie</ci> i <ci>forky</ci>, warianty HackerOS (<ci>atomic.hk</ci>, <ci>cybersecurity-default.hk</ci>) oraz katalog <ci>examples/</ci> z szablonami (Debian trixie/forky, Kali, Linux Mint, Ubuntu PPA, Raspberry Pi, lokalne lustro, tylko arm64, repozytoria zewnętrzne). Schemat pliku opisuje <ci>sources-list.hk.schema</ci>; plik sprawdzisz przez <ci>hammer hk validate</ci>. Komenda <ci>hammer repo</ci> modyfikuje listę i zapisuje ją w tym samym formacie.</p><div class=\"box box-w\"><strong>Mieszanie dystrybucji</strong>Źródła Kali czy Ubuntu obok Debiana mogą powodować konflikty zależności. Szablony tego ostrzegają i zalecają izolowane środowisko (VM, chroot, kontener).</div>\n</section>\n\n<section id=\"tools\">\n  <h2><span class=\"h2-num\">10</span> HACKEROS TOOLS <a href=\"#tools\">#</a></h2>\n  <p>Katalog <ci>repo-HackerOS/</ci> zawiera definicje narzędzi HackerOS dystrybuowanych przez GitHub Releases (np. <ci>hedit</ci>, <ci>hsh</ci>, <ci>ngt</ci>, <ci>getit</ci>, <ci>Hacker-Term</ci>, <ci>H-Sharp</ci>, <ci>HackerOS-Package-Manager</ci>). Plik <ci>.hk</ci> opisuje, skąd pobrać binarkę; hammer pobiera ją, aktualizuje i tworzy wrapper.</p><pre data-lang=\"hk\"><code>[hedit]\n-&gt; releases    =&gt; https://github.com/HackerOS-Linux-System/hedit/releases\n-&gt; binary      =&gt; hedit\n-&gt; description =&gt; The hedit tool is inspired by nano.\n-&gt; hidden      =&gt; false</code></pre><table class=\"tbl\">\n    <tr><th>Klucz</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>releases</ci></td><td class=\"td\">URL strony releases na GitHubie (wymagany)</td></tr>\n    <tr><td class=\"tc\"><ci>binary</ci> / <ci>binaries</ci></td><td class=\"td\">nazwa pliku w assetach; lista <ci>[\"tool\", \"tool-helper\"]</ci>; alias w postaci <ci>\"asset:wrapper\"</ci> (wymagany)</td></tr>\n    <tr><td class=\"tc\"><ci>description</ci></td><td class=\"td\">krótki opis</td></tr>\n    <tr><td class=\"tc\"><ci>hidden</ci></td><td class=\"td\"><ci>true</ci> &mdash; wrapper w <ci>/usr/lib/hammer/</ci> zamiast <ci>/usr/local/bin</ci></td></tr>\n  </table>\n</section>\n\n<section id=\"security\">\n  <h2><span class=\"h2-num\">11</span> SECURITY <a href=\"#security\">#</a></h2>\n  <ul class=\"feat\"><li><strong>Sygnatury repozytoriów</strong> &mdash; parser <ci>InRelease</ci>, weryfikacja podpisu przez <ci>gpgv</ci> i plików po SHA-256. <ci>hammer key</ci> zarządza zaufanymi kluczami (<ci>add</ci>, <ci>list</ci>, <ci>remove</ci>, <ci>import</ci>, <ci>check</ci>, <ci>doctor</ci>). Brak weryfikacji trzeba zaakceptować jawnie przez <ci>--allow-unauthenticated</ci>.</li><li><strong>Łańcuch audytu</strong> &mdash; <ci>/hammer/db/audit.jsonl</ci> z haszowaniem i podpisami Ed25519; <ci>hammer audit list|verify|export|keygen</ci>.</li><li><strong>Integralność magazynu</strong> &mdash; <ci>hammer verify [pkg] [--deep] [--fix]</ci>, <ci>hammer fsck [--full]</ci>, w tle także demon.</li><li><strong>Skrypty opiekunów</strong> &mdash; <ci>postinst</ci>/<ci>preinst</ci>/<ci>postrm</ci> są tłumaczone na listę bezpiecznych akcji (tworzenie użytkowników i grup, włączanie jednostek systemd itp.), a skrypty i aplikacje mogą działać w izolacji (bwrap, systemd-nspawn, limity cgroup v2, lista dozwolonych wywołań systemowych).</li><li><strong>Blokady</strong> &mdash; operacje na systemie biorą blokadę transakcji, żeby dwie instancje nie modyfikowały magazynu naraz.</li></ul>\n</section>\n\n<section id=\"daemon\">\n  <h2><span class=\"h2-num\">12</span> DAEMON (hammerd) <a href=\"#daemon\">#</a></h2>\n  <p><ci>hammerd</ci> działa w tle: synchronizuje indeksy, sprawdza aktualizacje i wysyła powiadomienia, okresowo weryfikuje magazyn i może stosować aktualizacje bezpieczeństwa. Sterujesz nim przez <ci>hammer daemon</ci>, który wysyła polecenia do działającego demona.</p><table class=\"tbl\">\n    <tr><th>Podkomenda</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>start</ci>, <ci>stop</ci>, <ci>status</ci>, <ci>reload</ci></td><td class=\"td\">cykl życia demona i przeładowanie konfiguracji</td></tr>\n    <tr><td class=\"tc\"><ci>sync</ci>, <ci>check</ci>, <ci>verify</ci></td><td class=\"td\">zlecają działającemu demonowi odświeżenie indeksów, sprawdzenie aktualizacji i skan integralności</td></tr>\n    <tr><td class=\"tc\"><ci>gc</ci> <span class=\"ta\">[--keep=N]</span></td><td class=\"td\">sprzątanie generacji</td></tr>\n    <tr><td class=\"tc\"><ci>security-upgrade</ci></td><td class=\"td\">stosuje aktualizacje bezpieczeństwa</td></tr>\n    <tr><td class=\"tc\"><ci>install-service</ci></td><td class=\"td\">instaluje i włącza <ci>hammerd.service</ci></td></tr>\n  </table><p>Konfiguracja w <ci>/etc/hammer/hammerd.toml</ci> (proste linie <ci>klucz = wartość</ci>, komentarze <ci>#</ci>; plik, którego nie da się odczytać w całości, zostaje zastąpiony wartościami domyślnymi):</p><table class=\"tbl\">\n    <tr><th>Klucz</th><th>Domyślnie</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>sync_interval_hours</ci></td><td>6</td><td class=\"td\">godziny między auto-sync (0 = wyłączone)</td></tr>\n    <tr><td class=\"tc\"><ci>check_interval_hours</ci></td><td>6</td><td class=\"td\">godziny między sprawdzeniem aktualizacji i powiadomieniem</td></tr>\n    <tr><td class=\"tc\"><ci>verify_interval_hours</ci></td><td>24</td><td class=\"td\">godziny między skanem integralności magazynu</td></tr>\n    <tr><td class=\"tc\"><ci>notify</ci></td><td>true</td><td class=\"td\">powiadomienia</td></tr>\n    <tr><td class=\"tc\"><ci>log_level</ci></td><td>\"info\"</td><td class=\"td\"><ci>trace</ci>, <ci>debug</ci>, <ci>info</ci>, <ci>warn</ci>, <ci>error</ci></td></tr>\n    <tr><td class=\"tc\"><ci>auto_security_upgrade</ci></td><td>false</td><td class=\"td\">automatyczne aktualizacje bezpieczeństwa</td></tr>\n    <tr><td class=\"tc\"><ci>max_generations</ci></td><td>20</td><td class=\"td\">limit przechowywanych generacji</td></tr>\n  </table>\n</section>\n\n<section id=\"user\">\n  <h2><span class=\"h2-num\">13</span> USER MODE <a href=\"#user\">#</a></h2>\n  <p>Flaga <ci>--user</ci> (<ci>-U</ci>) przełącza hammera na instalacje bez roota w <ci>~/.hammer</ci>, z własnym profilem i integracją z powłoką:</p><pre data-lang=\"sh\"><code>hammer --user init                <span class=\"hl-d\"># tworzy ~/.hammer i integrację z powłoką</span>\nhammer --user install ripgrep\nhammer --user list\nhammer --user status\nhammer --user remove ripgrep</code></pre><div class=\"box box-w\"><strong>Znane ograniczenia portu</strong>W obecnym porcie <ci>--user install</ci> zapisuje generacje, ale nie wpisuje pakietów do bazy użytkownika, a <ci>--user remove</ci> szuka wpisów w katalogu systemowego magazynu, nie w <ci>~/.hammer/store</ci>. Traktuj tryb użytkownika jako wczesny.</div>\n</section>\n\n<section id=\"oci\">\n  <h2><span class=\"h2-num\">14</span> OCI MODE <a href=\"#oci\">#</a></h2>\n  <p><ci>hammer oci</ci> to tryb obrazowy (OSTree + obrazy OCI + pakiety deb), natywny zamiennik samodzielnego narzędzia <em>deb-ostree</em>. Jest dostępny tylko w buildach z włączonym oci-mode (<ci>bit build-oci</ci>) albo przy <ci>HAMMER_OCI=1</ci>; <ci>hammer features</ci> pokazuje, czy bieżąca binarka go ma.</p><table class=\"tbl\">\n    <tr><th>Grupa</th><th>Podkomendy</th></tr>\n    <tr><td class=\"tc\">Bootstrap</td><td><ci>deploy &lt;image-ref&gt;</ci> &mdash; początkowe wdrożenie z obrazu bazowego; <ci>rebase &lt;image-ref&gt;</ci> &mdash; zmiana obrazu bazowego</td></tr>\n    <tr><td class=\"tc\">Warstwy pakietów</td><td><ci>install</ci>, <ci>uninstall</ci>, <ci>upgrade</ci> (obraz bazowy + ponowne nałożenie warstw), <ci>update</ci> (tylko indeksy), <ci>autoremove</ci></td></tr>\n    <tr><td class=\"tc\">Wdrożenia</td><td><ci>status [--verbose]</ci>, <ci>rollback</ci>, <ci>pin</ci> / <ci>unpin &lt;id&gt;</ci>, <ci>cleanup [--keep N]</ci> (domyślnie zostają 2), <ci>fsck</ci>, <ci>diff</ci></td></tr>\n    <tr><td class=\"tc\">Zapytania</td><td><ci>search &lt;fraza&gt;</ci>, <ci>list</ci></td></tr>\n    <tr><td class=\"tc\">System</td><td><ci>initramfs</ci> &mdash; regeneracja initramfs w nowym wdrożeniu</td></tr>\n  </table><pre data-lang=\"sh\"><code>hammer oci deploy ghcr.io/example/hackeros-base:trixie\nhammer oci install htop\nhammer oci status --verbose</code></pre>\n</section>\n\n<section id=\"libhammer\">\n  <h2><span class=\"h2-num\">15</span> LIBHAMMER <a href=\"#libhammer\">#</a></h2>\n  <p><ci>libhammer</ci> to biblioteka z rdzeniem hammera, wydawana jako <ci>hlib</ci> (<ci>[lib] output =&gt; hlib</ci> w <ci>Bit.hk</ci>, wersja 0.5.0). Nie zależy od CLI, demona ani magazynu, więc można z niej budować własne frontendy i narzędzia migracyjne. Zależności: <ci>satsolv</ci> i <ci>progress-bar</ci>.</p><table class=\"tbl\">\n    <tr><th>Moduł</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>lhpackage</ci></td><td class=\"td\">struktura pakietu i parser indeksu <ci>Packages</ci></td></tr>\n    <tr><td class=\"tc\"><ci>lhversion</ci></td><td class=\"td\">porównywanie wersji Debiana (epoka, tylda, rewizja)</td></tr>\n    <tr><td class=\"tc\"><ci>dep</ci></td><td class=\"td\">parser pól <ci>Depends</ci>, <ci>Conflicts</ci> itd.</td></tr>\n    <tr><td class=\"tc\"><ci>solver</ci>, <ci>solver_error</ci></td><td class=\"td\">solver SAT i opisy błędów rozwiązywania</td></tr>\n    <tr><td class=\"tc\"><ci>lhdeb</ci></td><td class=\"td\">parser archiwum <ci>.deb</ci></td></tr>\n    <tr><td class=\"tc\"><ci>digest</ci></td><td class=\"td\">sumy SHA-256</td></tr>\n    <tr><td class=\"tc\"><ci>control</ci></td><td class=\"td\">czytnik i zapis plików kontrolnych w stylu RFC822</td></tr>\n    <tr><td class=\"tc\"><ci>release</ci></td><td class=\"td\">parser <ci>Release</ci>/<ci>InRelease</ci> (suite, komponenty, sumy indeksów)</td></tr>\n    <tr><td class=\"tc\"><ci>lhdb</ci></td><td class=\"td\">baza zainstalowanych pakietów</td></tr>\n    <tr><td class=\"tc\"><ci>fetch</ci>, <ci>lhsys</ci></td><td class=\"td\">pobieranie indeksów oraz zamienniki HTTP, skrótów i czasu oparte na plikach i narzędziach systemowych (<ci>curl</ci>, <ci>sha256sum</ci>)</td></tr>\n  </table><div class=\"box box-n\"><strong>README biblioteki</strong>Plik <ci>libhammer/README.md</ci> nadal opisuje wersję w Rust (crate, flagi cech, <ci>cargo</ci>); aktualny kod w <ci>libhammer/src/*.h#</ci> to port na H#.</div>\n</section>\n\n<section id=\"layout\">\n  <h2><span class=\"h2-num\">16</span> SOURCE LAYOUT <a href=\"#layout\">#</a></h2>\n  <div class=\"tree\">\n    <span class=\"td2\">hammer/</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/cli/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; dyspozytor komend, flagi globalne, tryb --user</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/pkg/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; baza, cache, magazyn, transakcje, solver, przypięcia, multi-arch</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/system/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; immutable, profile/generacje, GPG, audyt, sandbox, usługi, boot</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/hammerd/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; demon i jego konfiguracja</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/oci/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; warstwa OCI + OSTree i komendy hammer oci</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/tools/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; mirror, build-dep, completion, self-update, narzędzia .hk</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/ui/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; wyjście terminalowe, postęp pobierania, JSON</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">libhammer/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; biblioteka rdzenia (hlib)</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">sources-lists/, repo-HackerOS/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; listy źródeł i definicje narzędzi HackerOS</span><br>\n    &nbsp;&nbsp;<span class=\"to\">Bit.hk, build.hl</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; manifest bit (komendy check, build-normal, build-oci)</span>\n  </div><p>Zależności pakietu: <ci>libhammer</ci>, <ci>satsolv</ci>, <ci>hk-parser</ci>, <ci>progress-bar</ci>, <ci>colors</ci>. Biblioteka <ci>hk-parser</ci> ładuje natywny <ci>libhk_parser</ci> dynamicznie, więc binarka nie jest w pełni statyczna. <ci>bit check</ci> sprawdza składnię i typy wszystkich modułów.</p>\n</section>\n\n<section id=\"port\">\n  <h2><span class=\"h2-num\">17</span> PORT NOTES <a href=\"#port\">#</a></h2>\n  <p>hammer jest przepisywany z Rust na H#. Znane, świadomie utrzymane różnice względem wersji w Rust:</p><ul class=\"feat\"><li><ci>hammer help</ci> wspomina <ci>list --available</ci>, ale <ci>list</ci> obsługuje tylko <ci>--installed</ci> oraz <ci>--upgradable</ci> / <ci>--upgrades</ci>.</li><li><ci>hammer history -n N</ci> wymaga osobnego argumentu (<ci>-n 20</ci>); forma <ci>-n20</ci> jest w tej komendzie ignorowana.</li><li>Sekcja „HackerOS tools” w <ci>hammer status</ci> i <ci>hammer doctor</ci> jest pominięta.</li><li><ci>hammer changelog</ci> działa bez klienta HTTP z wersji w Rust.</li><li>W <ci>hammer undo</ci> lista zmian oznacza literą <ci>M</ci> każdy istniejący plik konfiguracyjny; faktyczne wykrycie modyfikacji następuje przy czyszczeniu.</li><li>Ręczny <ci>hammer boot fallback</ci> cofa do przedostatniej znanej dobrej generacji (albo kończy się błędem, gdy jest tylko jedna).</li><li>Moduły portu w trakcie przepisywania są opisane w pliku <ci>PORT_STATUS.md</ci> w repozytorium źródłowym.</li></ul>\n</section>\n\n<footer>hammer v0.5.0 &middot; HackerOS Package Manager &middot; HackerOS Ecosystem &middot; <a href=\"https://github.com/HackerOS-Linux-System/hammer\" style=\"color:var(--dim)\">GitHub &#8599;</a> &middot; Apache-2.0</footer>\n</main>\n</div>"

fun main() [
    boot_begin("pl", "hammer — HackerOS Package Manager")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["href", "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Bebas+Neue&display=swap", "rel", "stylesheet"])
    boot_body(PAGE_BODY)
    offline_init("../")
    scrollspy("section[id]", "nav a", "-15% 0px -75% 0px", 0.0)
]
