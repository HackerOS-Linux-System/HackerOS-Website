use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>

style {
#app { display: none; }
:root{--bg:#080a0d;--bg2:#0d1017;--bg3:#111520;--border:#1c2030;--border2:#252d42;--red:#ff2040;--red2:#ff4060;--red3:#ff6080;--cyan:#00d4ff;--yellow:#ffd000;--green:#00ff88;--dim:#3a4558;--text:#c5d3e8;--text2:#6b7f99;--mono:'JetBrains Mono',monospace;--head:'Bebas Neue',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:13.5px;line-height:1.75;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,32,64,0.015) 3px,rgba(255,32,64,0.015) 4px);pointer-events:none;z-index:9999}
.layout{display:flex;min-height:100vh}
nav{width:250px;min-width:250px;background:var(--bg2);border-right:1px solid var(--border);position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.nav-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,rgba(255,32,64,0.12) 0%,transparent 100%)}
.logo-big{font-family:var(--head);font-size:48px;line-height:1;color:var(--red);text-shadow:0 0 40px rgba(255,32,64,0.6),0 0 80px rgba(255,32,64,0.2);letter-spacing:2px}
.logo-sub{color:var(--text2);font-size:10px;letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.logo-ver{color:var(--red3);font-size:11px;margin-top:6px}
.nav-section{padding:14px 20px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
nav a{display:block;padding:5px 20px 5px 28px;color:var(--text2);text-decoration:none;font-size:12px;transition:all .15s;position:relative;border-left:2px solid transparent}
nav a::before{content:'›';position:absolute;left:14px;color:var(--dim)}
nav a:hover{color:var(--text);background:rgba(255,32,64,0.04)}
nav a.active{color:var(--red);border-left-color:var(--red);background:rgba(255,32,64,0.07)}
nav a.active::before{color:var(--red)}
main{flex:1;max-width:860px;padding:0 64px 80px}
.hero{padding:64px 0 56px;border-bottom:1px solid var(--border);margin-bottom:64px;position:relative;overflow:hidden}
.hero::before{content:'GAME';position:absolute;right:-20px;top:-20px;font-family:var(--head);font-size:200px;color:rgba(255,32,64,0.04);pointer-events:none;user-select:none}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.3);color:var(--red);font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:24px}
.hero-tag::before{content:'◆';font-size:8px}
.hero h1{font-family:var(--head);font-size:64px;line-height:1;letter-spacing:3px;color:#fff;margin-bottom:6px}
.hero h1 span{color:var(--red);text-shadow:0 0 30px rgba(255,32,64,0.5)}
.hero-desc{color:var(--text2);font-size:14px;margin-bottom:32px;max-width:560px}
.hero-cmd{background:var(--bg3);border:1px solid var(--border2);border-left:3px solid var(--red);padding:14px 20px;border-radius:3px;display:inline-block;font-size:14px}
.prompt{color:var(--dim)}.cmd-s{color:var(--red)}.arg-s{color:var(--text)}
section{margin-bottom:72px}
h2{font-family:var(--head);font-size:28px;color:#fff;letter-spacing:2px;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.h2-num{font-size:11px;color:var(--red);letter-spacing:2px;border:1px solid rgba(255,32,64,0.3);padding:2px 8px;border-radius:2px;font-family:var(--mono)}
h2 a{color:var(--dim);text-decoration:none;font-size:16px;margin-left:auto}
h2 a:hover{color:var(--red)}
h3{font-size:13px;color:var(--red2);letter-spacing:1px;margin:28px 0 10px;text-transform:uppercase}
p{color:var(--text);margin-bottom:14px;max-width:680px}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;overflow-x:auto;margin:14px 0 24px;position:relative}
pre::before{content:attr(data-lang);position:absolute;top:8px;right:12px;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim)}
code{font-family:var(--mono);font-size:12.5px;color:var(--text)}
.hl-r{color:var(--red)}.hl-c{color:var(--cyan)}.hl-y{color:var(--yellow)}.hl-g{color:var(--green)}.hl-d{color:var(--dim)}.hl-w{color:#fff;font-weight:600}
ci{display:inline;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.2);padding:1px 6px;border-radius:2px;font-size:12px;color:var(--red2);font-family:var(--mono)}
.tbl{width:100%;border-collapse:collapse;margin:16px 0 24px}
.tbl th{text-align:left;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);padding:8px 14px;border-bottom:1px solid var(--border2)}
.tbl td{padding:9px 14px;border-bottom:1px solid var(--border);vertical-align:top}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(255,32,64,0.03)}
.tbl .tc{color:var(--red2);font-weight:500;white-space:nowrap}.tbl .ta{color:var(--yellow)}.tbl .td{color:var(--text2);font-size:12.5px}
.yes{color:var(--green)}.no{color:var(--red)}.par{color:var(--yellow)}
.box{border-radius:3px;padding:14px 18px;margin:14px 0 20px;border-left:3px solid;font-size:13px;max-width:680px}
.box-n{background:rgba(0,212,255,0.06);border-color:var(--cyan)}.box-w{background:rgba(255,208,0,0.06);border-color:var(--yellow)}.box-t{background:rgba(255,32,64,0.06);border-color:var(--red)}
.box strong{display:block;margin-bottom:4px;font-size:9px;letter-spacing:2px;text-transform:uppercase}
.box-n strong{color:var(--cyan)}.box-w strong{color:var(--yellow)}.box-t strong{color:var(--red)}
.tree{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;margin:14px 0 24px;font-size:12.5px;line-height:2}
.td2{color:var(--red2)}.tf{color:var(--text)}.ta2{color:var(--dim);font-style:italic}.to{color:var(--dim)}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.badge{font-size:10px;padding:3px 10px;border-radius:2px;border:1px solid;letter-spacing:.5px}
.br{color:var(--red);border-color:rgba(255,32,64,0.3);background:rgba(255,32,64,0.08)}.bc{color:var(--cyan);border-color:rgba(0,212,255,0.3);background:rgba(0,212,255,0.08)}.by{color:var(--yellow);border-color:rgba(255,208,0,0.3);background:rgba(255,208,0,0.08)}.bg{color:var(--green);border-color:rgba(0,255,136,0.3);background:rgba(0,255,136,0.08)}
.ext{color:var(--red2);text-decoration:none;border-bottom:1px solid rgba(255,64,96,0.3)}
.ext:hover{color:var(--red);border-bottom-color:var(--red)}
ul.feat{color:var(--text2);margin:0 0 20px 20px;line-height:2}
footer{margin-top:80px;padding-top:24px;border-top:1px solid var(--border);color:var(--dim);font-size:11px}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--red)}
@media(max-width:860px){nav{display:none}main{padding:32px 20px}.hero h1{font-size:44px}}
}

let PAGE_BODY: Str = "<div class=\"layout\">\n<nav>\n  <div class=\"nav-logo\">\n    <div class=\"logo-big\">HACKER MODE</div>\n    <div class=\"logo-sub\">Gaming Session</div>\n    <div class=\"logo-ver\">H# &middot; gui + webview &middot; HackerOS</div>\n  </div>\n  <span class=\"nav-section\">Start</span>\n  <a href=\"#overview\">Overview</a>\n  <a href=\"#quickstart\">Quickstart</a>\n  <a href=\"#commands\">Command Reference</a>\n  <span class=\"nav-section\">Features</span>\n  <a href=\"#platforms\">Platforms</a>\n  <a href=\"#ui\">Interface</a>\n  <a href=\"#launch\">Launching Games</a>\n  <a href=\"#saves\">Save Backups</a>\n  <span class=\"nav-section\">System</span>\n  <a href=\"#session\">Session &amp; Compositor</a>\n  <a href=\"#config\">Configuration</a>\n  <a href=\"#doctor\">Doctor</a>\n  <span class=\"nav-section\">Reference</span>\n  <a href=\"#layout\">Repository Layout</a>\n  <a href=\"#limits\">Limits</a>\n</nav>\n<main>\n\n<div class=\"hero\">\n  <div class=\"hero-tag\">Gaming shell &middot; Wayland session &middot; HackerOS</div>\n  <h1><span>HACKER MODE</span></h1>\n  <p class=\"hero-desc\">Sesja do gier dla HackerOS &mdash; jedna binarka zbierająca Steam, Epic, GOG, Amazon Games, Lutris, EA app, Battle.net i Roblox w jednej powłoce sterowanej myszą, klawiaturą i padem.</p>\n  <div class=\"hero-cmd\"><span class=\"prompt\">$ </span><span class=\"cmd-s\">hacker-mode</span> <span class=\"arg-s\">[--dev | doctor | list | login &lt;sklep&gt;]</span></div>\n</div>\n\n<section id=\"overview\">\n  <h2><span class=\"h2-num\">01</span> OVERVIEW <a href=\"#overview\">#</a></h2>\n  <div class=\"badges\"><span class=\"badge br\">H#</span><span class=\"badge bc\">gui + webview</span><span class=\"badge by\">Wayland session</span><span class=\"badge bg\">HackerOS</span><span class=\"badge br\">GPL-3.0</span></div><p><strong>Hacker Mode</strong> to sesja konsolowa do gier dla HackerOS &mdash; odpowiednik Steam Big Picture / Gamescope Session, ale jako <strong>jedna binarka</strong>, która zbiera biblioteki Steam, Epic Games, GOG, Amazon Games, Lutris, EA app, Battle.net i Roblox w jednej siatce okładek. Z poziomu powłoki można grę uruchomić, zainstalować (z paskiem postępu, gdy narzędzie podaje procenty) i odinstalować.</p><p>Powłoka jest napisana w H# na bibliotekach <ci>gui</ci> (interfejs) i <ci>webview</ci> (okna logowania do sklepów), a pakiet <ci>hacker-mode</ci> w <ci>Bit.hk</ci> ma język <ci>h#</ci> i linkowanie statyczne. Sesję uruchamia menedżer logowania (SDDM/GDM/LightDM) albo TTY przez skrypt <ci>hacker-mode-session</ci>, który startuje kompozytor <ci>labwc</ci> (domyślnie) lub <ci>comphwde</ci>.</p><div class=\"box box-n\"><strong>Stos technologiczny</strong>Aktualne źródła to <ci>src/*.h#</ci> (H#). Poprzednia wersja (TypeScript + Solid.js + Rust/Tauri) jest przechowywana w katalogu <ci>archived/</ci>. Część plików pomocniczych w repozytorium (<ci>README.md</ci>, <ci>build.hl</ci>, workflow CI) nadal opisuje starą wersję, więc na tej stronie za źródło prawdy uznano kod w <ci>src/</ci>.</div>\n</section>\n\n<section id=\"quickstart\">\n  <h2><span class=\"h2-num\">02</span> QUICKSTART <a href=\"#quickstart\">#</a></h2>\n  <pre data-lang=\"sh\"><code>hacker-mode               <span class=\"hl-d\"># uruchom powłokę (pełny ekran w sesji)</span>\nhacker-mode --dev         <span class=\"hl-d\"># tryb deweloperski: zwykłe okno, akcje zasilania tylko symulowane</span>\nhacker-mode doctor        <span class=\"hl-d\"># diagnostyka zależności i Robloxa</span>\nhacker-mode list          <span class=\"hl-d\"># biblioteka gier w terminalu</span>\nhacker-mode login epic    <span class=\"hl-d\"># logowanie do sklepu w oknie webview  (epic | gog | amazon)</span></code></pre><p>Sesja jest dostępna z menedżera logowania jako „Hacker Mode” (plik <ci>hacker-mode.desktop</ci> z <ci>Exec=hacker-mode-session</ci> w <ci>/usr/share/wayland-sessions/</ci>) albo ręcznie z TTY: <ci>hacker-mode-session</ci>.</p>\n</section>\n\n<section id=\"commands\">\n  <h2><span class=\"h2-num\">03</span> COMMAND REFERENCE <a href=\"#commands\">#</a></h2>\n  <table class=\"tbl\">\n    <tr><th>Polecenie</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">hacker-mode</td><td class=\"td\">Uruchamia powłokę w oknie 1280&times;800 (w sesji kompozytor maksymalizuje okno)</td></tr>\n    <tr><td class=\"tc\">hacker-mode --dev | dev</td><td class=\"td\">Tryb deweloperski (też zmienna <ci>HACKER_MODE_DEV</ci>): bez trybu wrapper, zasilanie symulowane</td></tr>\n    <tr><td class=\"tc\">hacker-mode login <span class=\"ta\">&amp;lt;sklep&amp;gt;</span></td><td class=\"td\">Okno logowania: <ci>epic</ci>, <ci>gog</ci> lub <ci>amazon</ci>; przy sukcesie drukuje <ci>ok</ci></td></tr>\n    <tr><td class=\"tc\">hacker-mode doctor</td><td class=\"td\">Raport zależności pogrupowany na Sklepy / System / Narzędzia / Roblox</td></tr>\n    <tr><td class=\"tc\">hacker-mode list</td><td class=\"td\">Lista wszystkich gier: platforma, znacznik &#9679; (zainstalowana) lub &#9675;, tytuł i <ci>[id]</ci>; na końcu liczba gier</td></tr>\n    <tr><td class=\"tc\">hacker-mode roblox search <span class=\"ta\">&amp;lt;fraza&amp;gt;</span></td><td class=\"td\">Szuka doświadczeń Roblox (do 10 wyników, z liczbą graczy online)</td></tr>\n    <tr><td class=\"tc\">hacker-mode roblox add <span class=\"ta\">&amp;lt;link|id&amp;gt;</span></td><td class=\"td\">Przypina doświadczenie do biblioteki po linku lub numerze miejsca</td></tr>\n    <tr><td class=\"tc\">hacker-mode roblox launch <span class=\"ta\">&amp;lt;id&amp;gt;</span></td><td class=\"td\">Wypisuje i wykonuje polecenie startu doświadczenia</td></tr>\n    <tr><td class=\"tc\">hacker-mode roblox import <span class=\"ta\">&amp;lt;użytkownik&amp;gt;</span></td><td class=\"td\">Przypina publiczne ulubione użytkownika Roblox</td></tr>\n    <tr><td class=\"tc\">hacker-mode roblox doctor</td><td class=\"td\">Sprawdza Sober, Flatpak, architekturę, Vulkan i obsługę schematu <ci>roblox://</ci></td></tr>\n    <tr><td class=\"tc\">hacker-mode bnet versions <span class=\"ta\">&amp;lt;kod produktu&amp;gt;</span></td><td class=\"td\">Wersje produktu Blizzard przez protokół Ribbit (TCP 1119, <ci>nc</ci>)</td></tr>\n    <tr><td class=\"tc\">hacker-mode ipc <span class=\"ta\">ping | shutdown | launch &amp;lt;polecenie&amp;gt; [args]</span></td><td class=\"td\">Zamiennik <ci>hacker-mode-ipcctl</ci> dla comphwde; drukuje <ci>ok</ci> albo <ci>error: ...</ci></td></tr>\n    <tr><td class=\"tc\">hacker-mode help | version</td><td class=\"td\">Pomoc i wersja</td></tr>\n  </table>\n</section>\n\n<section id=\"platforms\">\n  <h2><span class=\"h2-num\">04</span> PLATFORMS <a href=\"#platforms\">#</a></h2>\n  <p>Platformy włączasz i wyłączasz w Ustawieniach; niedostępne (brak narzędzia lub prefiksu Wine) są oznaczone i ukryte w filtrach biblioteki.</p><table class=\"tbl\">\n    <tr><th>Platforma</th><th>Wymaga</th><th>Uruchomienie</th><th>Instalacja / odinstalowanie</th></tr>\n    <tr><td class=\"tc\">Steam</td><td>katalog Steama (pliki lokalne)</td><td><ci>steam -applaunch &lt;id&gt;</ci></td><td class=\"td\"><ci>steam://install/&lt;id&gt;</ci> i <ci>steam://uninstall/&lt;id&gt;</ci></td></tr>\n    <tr><td class=\"tc\">Epic Games</td><td><ci>legendary</ci></td><td><ci>legendary launch</ci></td><td class=\"td\"><ci>legendary install -y</ci> / <ci>uninstall -y</ci></td></tr>\n    <tr><td class=\"tc\">GOG</td><td><ci>gogdl</ci></td><td><ci>gogdl launch</ci> (Linux)</td><td class=\"td\"><ci>gogdl download</ci> do katalogu gier GOG; odinstalowanie usuwa katalog gry</td></tr>\n    <tr><td class=\"tc\">Amazon Games</td><td><ci>nile</ci></td><td><ci>nile launch</ci></td><td class=\"td\"><ci>nile install</ci> / <ci>uninstall</ci></td></tr>\n    <tr><td class=\"tc\">Lutris</td><td><ci>lutris</ci></td><td><ci>lutris lutris:rungame/&lt;slug&gt;</ci></td><td class=\"td\">instalacja przez <ci>lutris:</ci>; odinstalowanie w aplikacji Lutris</td></tr>\n    <tr><td class=\"tc\">EA app</td><td><ci>wine</ci> + prefiks Wine</td><td>EALauncher / EADesktop w prefiksie</td><td class=\"td\">instalacja otwiera klienta; odinstalowanie usuwa katalog gry w prefiksie</td></tr>\n    <tr><td class=\"tc\">Battle.net</td><td><ci>wine</ci> + prefiks Wine</td><td>Battle.net Launcher w prefiksie</td><td class=\"td\">instalacja otwiera klienta; odinstalowanie usuwa katalog gry w prefiksie</td></tr>\n    <tr><td class=\"tc\">Roblox</td><td>Sober (Flatpak) lub dowolny handler <ci>roblox://</ci></td><td><ci>roblox://experiences/start?placeId=...</ci></td><td class=\"td\">instalacja klienta: Sober z Flathuba; „odinstaluj” usuwa wpis z biblioteki</td></tr>\n  </table><h3>Skąd biblioteka</h3><ul class=\"feat\"><li><strong>Steam</strong> &mdash; zainstalowane gry z lokalnych bibliotek Steama (<ci>libraryfolders</ci>), okładki z lokalnego cache; posiadane-niezainstalowane przez Steam Web API (klucz i SteamID64 w ustawieniach); aktualnie uruchomioną grę wykrywa po <ci>RunningAppID</ci>.</li><li><strong>Epic</strong> &mdash; <ci>legendary</ci> (zainstalowane i posiadane).</li><li><strong>GOG</strong> &mdash; <ci>gogdl</ci>, okładki z publicznego API GOG; rejestr instalacji prowadzony przez Hacker Mode.</li><li><strong>Amazon</strong> &mdash; <ci>nile</ci> (zainstalowane i biblioteka).</li><li><strong>Lutris</strong> &mdash; baza <ci>pga.db</ci> (przez <ci>sqlite3</ci>), w tym czas gry.</li><li><strong>EA app / Battle.net</strong> &mdash; skanowanie katalogów gier w prefiksie Wine (domyślne lokalizacje <ci>~/Games/ea-app</ci>, <ci>~/Games/battlenet</ci> i warianty nazw; własny prefiks: <ci>ea_wine_prefix</ci>, <ci>battlenet_wine_prefix</ci>). Brak publicznego API biblioteki, więc widać tylko zainstalowane.</li><li><strong>Roblox</strong> &mdash; własna lista przypiętych doświadczeń (wyszukiwanie, link, import ulubionych), ikony i oceny z publicznych API Roblox.</li></ul><div class=\"box box-n\"><strong>Czas gry</strong>Dla gier bez czasu z API sklepu Hacker Mode dopisuje <strong>lokalny licznik</strong> &mdash; mierzy wyłącznie sesje uruchomione przez samą powłokę. Ostatnie sesje gry widać w panelu szczegółów.</div>\n</section>\n\n<section id=\"ui\">\n  <h2><span class=\"h2-num\">05</span> INTERFACE <a href=\"#ui\">#</a></h2>\n  <p>Powłoka ma cztery zakładki, przełączane z górnego paska (na pasku także głośność, bateria, odświeżenie i wyjście):</p><table class=\"tbl\">\n    <tr><th>Zakładka</th><th>Zawartość</th></tr>\n    <tr><td class=\"tc\">Biblioteka</td><td class=\"td\">Siatka okładek z filtrami platform, wyszukiwarką i panelem szczegółów: Graj / Zainstaluj / Odinstaluj, pasek postępu zadania i „Zatrzymaj”, tagi, czas gry, ostatnie sesje, kopia i przywracanie zapisów</td></tr>\n    <tr><td class=\"tc\">Roblox</td><td class=\"td\">Karta klienta (Sober), dodawanie po linku, wyszukiwarka, import ulubionych, szczegóły doświadczenia</td></tr>\n    <tr><td class=\"tc\">Ustawienia</td><td class=\"td\">Język (polski / angielski), motyw, narzędzia gamingowe, platformy i logowanie, klucze Steam i SteamGridDB, dźwięk i jasność, zasilanie</td></tr>\n    <tr><td class=\"tc\">Diagnostyka</td><td class=\"td\">Ten sam raport co <ci>hacker-mode doctor</ci>, z ponownym uruchomieniem testów</td></tr>\n  </table><p>Dostępne motywy: <ci>dark</ci>, <ci>light</ci>, <ci>nord</ci>, <ci>dracula</ci>, <ci>tokyo</ci>, <ci>glass</ci>. Kafelki gier są przyciskami, więc nawigacja działa z klawiaturą i urządzeniami wskazującymi obsługiwanymi przez bibliotekę <ci>gui</ci>. Destrukcyjne czynności (odinstalowanie, zasilanie) wymagają potwierdzenia.</p>\n</section>\n\n<section id=\"launch\">\n  <h2><span class=\"h2-num\">06</span> LAUNCHING GAMES <a href=\"#launch\">#</a></h2>\n  <p>Uruchomienie gry owija polecenie platformy w kolejne warstwy zależnie od ustawień (Roblox jest uruchamiany bez owijania):</p><pre data-lang=\"flow\"><code>env XDG_SESSION_TYPE=wayland [MANGOHUD=1] [ENABLE_VKBASALT=1] [SDL_GAMECONTROLLERCONFIG=...]  \\\n    &lt;custom_launch_prefix&gt;  [gamescope --]  &lt;polecenie platformy&gt;</code></pre><table class=\"tbl\">\n    <tr><th>Ustawienie</th><th>Efekt</th><th>Domyślnie</th></tr>\n    <tr><td class=\"tc\"><ci>gaming_tools.mangohud</ci></td><td>ustawia <ci>MANGOHUD=1</ci></td><td class=\"td\">włączone</td></tr>\n    <tr><td class=\"tc\"><ci>gaming_tools.vkbasalt</ci></td><td>ustawia <ci>ENABLE_VKBASALT=1</ci></td><td class=\"td\">wyłączone</td></tr>\n    <tr><td class=\"tc\"><ci>gaming_tools.gamescope</ci></td><td>uruchamia grę przez <ci>gamescope --</ci></td><td class=\"td\">wyłączone</td></tr>\n    <tr><td class=\"tc\"><ci>custom_launch_prefix</ci></td><td>dowolny prefiks przed poleceniem gry</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>game_controller_configs</ci></td><td>mapowanie pada SDL dla konkretnej gry (<ci>platforma:id</ci>)</td><td class=\"td\">brak</td></tr>\n  </table><h3>Tryb wrapper</h3><p>Gdy <ci>wrapper_mode_enabled</ci> jest włączone (domyślnie) i nie jesteś w trybie <ci>--dev</ci>, powłoka na czas gry chowa swoje okno, a po zakończeniu gry przywraca je, dopisuje czas gry i pokazuje komunikat (z ostrzeżeniem, gdy gra zakończyła się natychmiast). W <strong>labwc</strong> pełny ekran gry zapewniają statyczne reguły okien w <ci>rc.xml</ci>; w <strong>comphwde</strong> powłoka minimalizuje się i przywraca przez IPC. Zadania w tle (start, instalacja, odinstalowanie) są odpytywane co ok. 700 ms, a postęp w procentach jest czytany z ostatniej linii logu.</p>\n</section>\n\n<section id=\"session\">\n  <h2><span class=\"h2-num\">07</span> SESSION & COMPOSITOR <a href=\"#session\">#</a></h2>\n  <p><ci>hacker-mode-session</ci> ustawia środowisko Wayland (<ci>XDG_SESSION_TYPE=wayland</ci>, <ci>XDG_CURRENT_DESKTOP=HackerMode</ci>), w razie potrzeby uruchamia się ponownie pod <ci>dbus-run-session</ci>, a potem startuje wybrany kompozytor. Logi lądują w <ci>~/.local/state/hacker-mode/</ci> (m.in. <ci>compositor.log</ci>).</p><table class=\"tbl\">\n    <tr><th>Wartość</th><th>Opis</th></tr>\n    <tr><td class=\"tc\"><ci>labwc</ci> (domyślna)</td><td class=\"td\"><ci>labwc -C ~/.config/Hacker-Mode/labwc -s &lt;klient&gt;</ci>; klient uruchamia <ci>hacker-mode</ci> i po jego wyjściu woła <ci>labwc --exit</ci>. Okna bez ramek i zmaksymalizowane regułą z <ci>rc.xml</ci>. Działa także z gołego TTY (DRM/KMS + libseat). Wymaga pakietu <ci>labwc</ci>.</td></tr>\n    <tr><td class=\"tc\"><ci>comphwde</ci></td><td class=\"td\"><ci>comphwde --extern-hacker-mode</ci>; skrypt czeka do 10 s na gniazdo IPC, po czym prosi kompozytor o uruchomienie powłoki (<ci>hacker-mode-ipcctl launch</ci>). Wymaga osobnej instalacji comphwde z projektu HWDE.</td></tr>\n  </table><p>Kompozytor wybiera się w <ci>~/.config/Hacker-Mode/config.json</ci> (<ci>{ \"compositor\": \"labwc\" }</ci>). Kolejność rozstrzygania: zmienna <ci>HACKER_MODE_COMPOSITOR</ci>, potem <ci>config.json</ci>, potem stary <ci>~/.config/hacker-mode/config.json</ci>, na końcu <ci>labwc</ci>. Nieznana wartość daje <ci>labwc</ci> z ostrzeżeniem. Zmiana działa po ponownym zalogowaniu. <ci>hacker-mode-session --print-compositor</ci> wypisuje wynik wyboru.</p><p>Szablon <ci>labwc/rc.xml</ci> (bez domyślnych skrótów; tylko <ci>Alt+Tab</ci>, <ci>Win+Tab</ci> i <ci>Alt+F4</ci>) jest kopiowany do <ci>~/.config/Hacker-Mode/labwc/rc.xml</ci> przy każdym starcie sesji, <strong>dopóki zawiera znacznik</strong> <ci>hacker-mode:generated</ci>. Usuń znacznik, żeby zachować własne zmiany.</p><div class=\"tree\">\n    <span class=\"td2\">/usr/share/wayland-sessions/</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">hacker-mode.desktop</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; Exec=hacker-mode-session</span><br>\n    <span class=\"td2\">/usr/share/hacker-mode/labwc/</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">rc.xml</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; szablon reguł okien labwc</span><br>\n    <span class=\"td2\">PATH</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">hacker-mode, hacker-mode-session</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; powłoka i skrypt sesji</span><br>\n    &nbsp;&nbsp;<span class=\"to\">hacker-mode-ipcctl</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; tylko dla comphwde</span>\n  </div>\n</section>\n\n<section id=\"config\">\n  <h2><span class=\"h2-num\">08</span> CONFIGURATION <a href=\"#config\">#</a></h2>\n  <p>Ustawienia leżą w <ci>~/.config/Hacker-Mode/config.json</ci>. Plik jest zapisywany atomowo z uprawnieniami <ci>0600</ci> w katalogu <ci>0700</ci>; uszkodzony plik jest przenoszony do <ci>config.json.corrupt-&lt;czas&gt;</ci> zamiast po cichu nadpisany, a stary <ci>~/.config/hacker-mode/config.json</ci> jest migrowany automatycznie.</p><table class=\"tbl\">\n    <tr><th>Klucz</th><th>Znaczenie</th><th>Domyślnie</th></tr>\n    <tr><td class=\"tc\"><ci>language</ci></td><td><ci>pl</ci> lub <ci>en</ci></td><td class=\"td\">z <ci>LANG</ci> (<ci>pl*</ci> &rarr; pl, inaczej en)</td></tr>\n    <tr><td class=\"tc\"><ci>theme</ci></td><td>motyw interfejsu</td><td class=\"td\"><ci>dark</ci></td></tr>\n    <tr><td class=\"tc\"><ci>compositor</ci></td><td><ci>labwc</ci> albo <ci>comphwde</ci></td><td class=\"td\"><ci>labwc</ci></td></tr>\n    <tr><td class=\"tc\"><ci>wrapper_mode_enabled</ci></td><td>chowanie powłoki podczas gry</td><td class=\"td\"><ci>true</ci></td></tr>\n    <tr><td class=\"tc\"><ci>enabled_platforms</ci></td><td>lista włączonych platform</td><td class=\"td\">wszystkie osiem</td></tr>\n    <tr><td class=\"tc\"><ci>roblox_opt_out</ci></td><td>wyłącza Roblox, gdy lista platform nie zawiera go jawnie</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>steam_api_key</ci>, <ci>steam_id64</ci></td><td>biblioteka posiadanych gier Steam przez Web API</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>steamgriddb_api_key</ci></td><td>okładki 600&times;900 z SteamGridDB po tytule</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>ea_wine_prefix</ci>, <ci>battlenet_wine_prefix</ci></td><td>jawny prefiks Wine dla EA app / Battle.net</td><td class=\"td\">wykrywanie w <ci>~/Games</ci></td></tr>\n    <tr><td class=\"tc\"><ci>roblox_command</ci></td><td>własne polecenie startu Robloxa (<ci>{uri}</ci>, <ci>{place}</ci>)</td><td class=\"td\">Sober, w razie braku <ci>xdg-open</ci></td></tr>\n    <tr><td class=\"tc\"><ci>custom_launch_prefix</ci></td><td>prefiks poleceń startu gier</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>gaming_tools.*</ci></td><td><ci>mangohud</ci>, <ci>gamescope</ci>, <ci>vkbasalt</ci></td><td class=\"td\">patrz Launching Games</td></tr>\n    <tr><td class=\"tc\"><ci>game_tags</ci>, <ci>cover_overrides</ci></td><td>tagi i własne okładki na grę (klucz <ci>platforma:id</ci>)</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>game_controller_configs</ci></td><td>mapowanie pada SDL na grę</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>game_save_paths</ci>, <ci>cloud_saves_backup_dir</ci></td><td>ścieżka zapisów gry i katalog kopii zapasowych</td><td class=\"td\">brak</td></tr>\n    <tr><td class=\"tc\"><ci>crash_detection_threshold_seconds</ci></td><td>jeśli nieudana gra kończy się szybciej niż tyle sekund, powłoka ostrzega o możliwym błędzie uruchomienia</td><td class=\"td\">8</td></tr>\n  </table><div class=\"box box-w\"><strong>Klucze API w pliku</strong>Klucze Steam i SteamGridDB są zapisane w <ci>config.json</ci> (plik prywatny dla użytkownika, <ci>0600</ci>), a nie w systemowym keyringu.</div>\n</section>\n\n<section id=\"saves\">\n  <h2><span class=\"h2-num\">09</span> SAVE BACKUPS <a href=\"#saves\">#</a></h2>\n  <p>Dla gry z ustawioną ścieżką zapisów (<ci>game_save_paths</ci>) panel szczegółów pokazuje <em>Kopia zapisów</em> i <em>Przywróć zapisy</em>. Kopia to archiwum <ci>&lt;katalog&gt;/&lt;platforma-id&gt;-&lt;unix&gt;.tar.gz</ci> w katalogu z <ci>cloud_saves_backup_dir</ci>; przywracanie bierze najnowszą kopię. Bez ustawionego katalogu lub istniejącej ścieżki zapisów powłoka pokazuje komunikat z prośbą o konfigurację.</p>\n</section>\n\n<section id=\"doctor\">\n  <h2><span class=\"h2-num\">10</span> DOCTOR <a href=\"#doctor\">#</a></h2>\n  <p><ci>hacker-mode doctor</ci> (tylko odczyt) sprawdza obecność narzędzi i podpowiada, jak je doinstalować:</p><table class=\"tbl\">\n    <tr><th>Grupa</th><th>Sprawdzane</th></tr>\n    <tr><td class=\"tc\">Sklepy</td><td class=\"td\"><ci>steam</ci>, <ci>legendary</ci>, <ci>gogdl</ci>, <ci>nile</ci>, <ci>lutris</ci>, <ci>wine</ci>, <ci>sqlite3</ci> (czas gry z Lutris)</td></tr>\n    <tr><td class=\"tc\">System</td><td class=\"td\"><ci>curl</ci> (wymagane), <ci>nmcli</ci>, <ci>bluetoothctl</ci>, <ci>wpctl</ci> / <ci>pactl</ci>, <ci>brightnessctl</ci>, <ci>powerprofilesctl</ci>, <ci>labwc</ci> / <ci>comphwde</ci></td></tr>\n    <tr><td class=\"tc\">Narzędzia</td><td class=\"td\"><ci>gamescope</ci>, <ci>mangohud</ci> (opcjonalne)</td></tr>\n    <tr><td class=\"tc\">Roblox</td><td class=\"td\">Flatpak, Sober, architektura, Vulkan, handler <ci>roblox://</ci></td></tr>\n  </table><p>Brak opcjonalnego narzędzia wyłącza tylko daną funkcję. Pozostałe zależności do sterowania systemem (Wi-Fi, Bluetooth, dźwięk, jasność, profile zasilania) są wywoływane przez te same polecenia i walidują dane wejściowe (SSID, hasło WPA, adres MAC); hasło Wi-Fi jest przekazywane przez plik tymczasowy <ci>600</ci>, a nie w argumentach procesu.</p>\n</section>\n\n<section id=\"layout\">\n  <h2><span class=\"h2-num\">11</span> REPOSITORY LAYOUT <a href=\"#layout\">#</a></h2>\n  <div class=\"tree\">\n    <span class=\"td2\">Hacker-Mode/</span><br>\n    &nbsp;&nbsp;<span class=\"td2\">src/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; źródła H# (powłoka)</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">main.h#, app.h#, screens.h#, ui.h#, gfx.h#, state.h#</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; punkt wejścia, pętla zdarzeń, widoki, warstwa gui</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">stores.h#, roblox.h#, launcher.h#, jobs.h#, login.h#</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; platformy, uruchamianie, zadania w tle, logowanie</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">settings.h#, compositor.h#, doctor.h#, sysctl.h#</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; konfiguracja, IPC kompozytora, diagnostyka, system</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">playtime.h#, covers.h#, cloud_saves.h#, vdf.h#, jsonlite.h#</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; czas gry, okładki, kopie zapisów, parsery</span><br>\n    &nbsp;&nbsp;<span class=\"td2\">scripts/</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">hacker-mode-session</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; skrypt sesji (labwc / comphwde)</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">hacker-mode.desktop, labwc/rc.xml</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; wpis sesji i szablon reguł okien</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"tf\">test-session-headless.sh</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; test cyklu życia sesji</span><br>\n    &nbsp;&nbsp;<span class=\"to\">archived/</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; poprzednie wersje (Tauri)</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">Bit.hk</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; hacker-mode 1.0.0, zależności: gui, webview</span>\n  </div><p>Zależności pakietu w <ci>Bit.hk</ci>: <ci>gui</ci> i <ci>webview</ci> (oba <ci>newest</ci>). Budowanie wykonuje <ci>bit</ci>; do działania okien logowania potrzebne są systemowe biblioteki WebKitGTK (<ci>libwebkit2gtk-4.1</ci>, <ci>libsoup-3.0</ci>).</p>\n</section>\n\n<section id=\"limits\">\n  <h2><span class=\"h2-num\">12</span> LIMITS <a href=\"#limits\">#</a></h2>\n  <ul class=\"feat\"><li>EA app i Battle.net: instalacja tylko otwiera klienta (brak prywatnego API), a lista posiadanych-niezainstalowanych nie istnieje &mdash; widać tylko gry już zainstalowane w prefiksie Wine.</li><li>Lutris: odinstalowanie gry odbywa się w samej aplikacji Lutris; powłoka nie usuwa jej plików.</li><li>Czas gry poza Steamem i Lutrisem to lokalny licznik sesji uruchomionych z Hacker Mode.</li><li>Sesja comphwde zależy od osobnego projektu HWDE; Hacker Mode komunikuje się z nim przez gniazdo IPC w <ci>$XDG_RUNTIME_DIR/sde/</ci>.</li><li>Menedżery logowania (SDDM/GDM/LightDM) i goły TTY na fizycznym GPU wymagają własnej weryfikacji na docelowym sprzęcie.</li></ul>\n</section>\n\n<footer>Hacker Mode &middot; HackerOS Ecosystem &middot; <a href=\"https://github.com/HackerOS-Linux-System/Hacker-Mode\" style=\"color:var(--dim)\">GitHub &#8599;</a> &middot; GPL-3.0</footer>\n</main>\n</div>"

fun main() [
    boot_begin("pl", "Hacker Mode — dokumentacja")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["href", "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Bebas+Neue&display=swap", "rel", "stylesheet"])
    boot_body(PAGE_BODY)
    offline_init("../")
    scrollspy("section[id]", "nav a", "-15% 0px -75% 0px", 0.0)
]
