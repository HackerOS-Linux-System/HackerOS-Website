use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>

style {
#app { display: none; }
:root{
  --bg:#12131a; --panel:#1a1c26; --panel2:#222534; --line:#2d3044; --fg:#dfe3f1; --dim:#9097b3;
  --acc:#8aa4ff; --acc2:#c39bff; --ok:#6fd49a; --warn:#ffcf70; --bad:#ff8a8a; --code:#0d0e14;
}
@media (prefers-color-scheme:light){
  :root{--bg:#f4f5fa;--panel:#fff;--panel2:#eceef6;--line:#d7dbea;--fg:#1d2033;--dim:#5b6180;--acc:#3b5bdb;--acc2:#7a3fd1;--ok:#1d8a52;--warn:#9a6a00;--bad:#c23b3b;--code:#f0f1f8}
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.65 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:100vh}
nav{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;background:var(--panel);border-right:1px solid var(--line);padding:22px 18px}
nav h2{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:20px 0 8px}
nav a{display:block;color:var(--fg);text-decoration:none;padding:5px 10px;border-radius:8px;font-size:14.5px}
nav a:hover{background:var(--panel2);color:var(--acc)}
.brand{font-weight:800;letter-spacing:.08em;font-size:15px}
.brand span{background:linear-gradient(90deg,var(--acc),var(--acc2));-webkit-background-clip:text;background-clip:text;color:transparent}
main{padding:44px clamp(20px,5vw,64px) 90px;max-width:980px}
h1{font-size:clamp(28px,4vw,40px);line-height:1.15;margin:0 0 8px}
h2{font-size:26px;margin:56px 0 12px;padding-top:12px;border-top:1px solid var(--line)}
h3{font-size:19px;margin:30px 0 8px}
p{margin:10px 0}
.lead{font-size:18px;color:var(--dim)}
.badge{display:inline-block;font-size:12px;font-weight:700;padding:2px 10px;border-radius:99px;background:linear-gradient(90deg,var(--acc),var(--acc2));color:#fff;margin-right:6px}
a{color:var(--acc)}
code{font:13.5px/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--panel2);padding:1px 6px;border-radius:6px}
pre{background:var(--code);border:1px solid var(--line);border-radius:12px;padding:14px 16px;overflow:auto;margin:14px 0}
pre code{background:none;padding:0;font-size:13px;display:block}
pre[data-l]::before{content:attr(data-l);display:block;font:700 11px/1 system-ui;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
table{border-collapse:collapse;width:100%;margin:14px 0;font-size:14.5px;display:block;overflow:auto}
th,td{border:1px solid var(--line);padding:8px 12px;text-align:left;vertical-align:top}
th{background:var(--panel2)}
.box{border-left:4px solid var(--acc);background:var(--panel);padding:12px 16px;border-radius:0 12px 12px 0;margin:16px 0}
.box.warn{border-color:var(--warn)} .box.ok{border-color:var(--ok)} .box.bad{border-color:var(--bad)}
.box b:first-child{display:block;margin-bottom:2px}
.k{color:var(--acc2)} .c{color:var(--dim)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:18px 0}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.card h4{margin:0 0 4px;font-size:16px}
.card p{margin:0;color:var(--dim);font-size:14.5px}
ul,ol{padding-left:22px} li{margin:4px 0}
footer{margin-top:60px;color:var(--dim);font-size:13.5px;border-top:1px solid var(--line);padding-top:16px}
@media(max-width:820px){.wrap{grid-template-columns:1fr}nav{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line)}}
nav a.active{background:var(--panel2);color:var(--acc);font-weight:600}
h2{scroll-margin-top:16px}
}

let PAGE_BODY: Str = "<div class=\"wrap\">\n<nav>\n  <div class=\"brand\">HACKER<span>OS</span> · HLIB API</div>\n  <h2>Wstęp</h2>\n  <a href=\"#czym\">Czym jest HLIB API</a>\n  <a href=\"#jezyki\">Obsługiwane języki</a>\n  <a href=\"#szybki\">Szybki start</a>\n  <h2>Format</h2>\n  <a href=\"#archiwum\">Archiwum .hlib</a>\n  <a href=\"#manifest\">manifest.json</a>\n  <a href=\"#abitypes\">Typy ABI</a>\n  <a href=\"#podpis\">Sumy i podpis</a>\n  <h2>Używanie</h2>\n  <a href=\"#import\">Import w języku</a>\n  <a href=\"#rozwiazywanie\">Jak kompilator wiąże</a>\n  <a href=\"#szukanie\">Ścieżki wyszukiwania</a>\n  <h2>Fasada C-ABI</h2>\n  <a href=\"#fasada\">Czym jest fasada</a>\n  <a href=\"#eksport\">Co jest eksportowane</a>\n  <a href=\"#nazwy\">Konwencja nazw</a>\n  <a href=\"#typy\">Mapowanie typów</a>\n  <a href=\"#wlasnosc\">Własność i pamięć</a>\n  <a href=\"#watki\">Wątki</a>\n  <h2>Praktyka</h2>\n  <a href=\"#przyklad\">Przykład H# → gui</a>\n  <a href=\"#bit\">Narzędzie bit</a>\n  <a href=\"#hackerc\">Narzędzie hackerc</a>\n  <a href=\"#hl\">Hacker Lang</a>\n  <a href=\"#bledy\">Błędy i rozwiązania</a>\n  <a href=\"#zasady\">Dobre praktyki</a>\n</nav>\n<main>\n\n<p><span class=\"badge\">HackerOS</span><span class=\"badge\">v1</span></p>\n<h1>HLIB API</h1>\n<p class=\"lead\">Natywne API bibliotek dla języków programowania HackerOS. Jedna biblioteka, napisana w jednym języku HackerOS, wołana z drugiego — bez ręcznie pisanych deklaracji <code>extern</code>.</p>\n\n<div class=\"box\">\n<b>Zasięg</b>\nHLIB API jest wewnętrznym mechanizmem HackerOS i działa wyłącznie między trzema językami systemu: <b>H#</b>, <b>HackerScript</b> i <b>Hacker Lang</b>. To nie jest ogólny standard FFI dla dowolnych języków; format i fasada są częścią toolchainów HackerOS i nie są publikowane poza nim.\n</div>\n\n<h2 id=\"czym\">1. Czym jest HLIB API</h2>\n<p>HLIB API składa się z trzech warstw, które razem sprawiają, że biblioteka napisana w jednym języku działa w programie napisanym w innym:</p>\n<div class=\"grid\">\n  <div class=\"card\"><h4>1. Archiwum <code>.hlib</code></h4><p>Jeden format pliku wspólny dla wszystkich trzech języków: tar + zstd, z manifestem, sumami kontrolnymi i opcjonalnym podpisem.</p></div>\n  <div class=\"card\"><h4>2. Manifest eksportów</h4><p><code>manifest.exports</code> opisuje każdą funkcję biblioteki typami ABI, tak by konsument mógł ją wywołać bez źródeł.</p></div>\n  <div class=\"card\"><h4>3. Fasada C-ABI</h4><p>Dla bibliotek HackerScript: generowana warstwa <code>extern \"C\"</code>, która udostępnia także struktury, listy i metody przez uchwyty.</p></div>\n</div>\n<p>Programista biblioteki nie pisze żadnego kodu „pod FFI\". Programista konsumujący dopisuje jedną linię importu, a kompilator sam wiąże funkcje.</p>\n\n<h2 id=\"jezyki\">2. Obsługiwane języki</h2>\n<table>\n<tr><th>Język</th><th>Import</th><th>Rola</th><th>Ścieżka „ta sama rodzina\"</th></tr>\n<tr><td><b>H#</b></td><td><code>use \"hlib -> nazwa\"</code><br><code>use \"bit -> nazwa\"</code></td><td>producent i konsument</td><td><code>ast/*.ast.json</code> — AST kompilatora H#, wklejane do programu</td></tr>\n<tr><td><b>HackerScript</b></td><td><code>get &lt;hlib:nazwa&gt;</code><br><code>get &lt;nazwa&gt;</code> (bez prefiksu)</td><td>producent i konsument</td><td><code>ast/*.hcs</code> — oryginalny tekst źródłowy</td></tr>\n<tr><td><b>Hacker Lang</b></td><td><code># &lt;hlib/nazwa&gt;</code></td><td>producent i konsument</td><td><code>ast/*.ast.json</code> + <code>bytecode/*.hlbc</code></td></tr>\n</table>\n<div class=\"box warn\">\n<b>Bez innych języków</b>\nHLIB nie ma na celu współpracy z C, Rustem czy innymi językami spoza HackerOS. Plik <code>.so</code> w archiwum ma co prawda zwykłe symbole C, ale gwarancje (manifest, fasada, bind w kompilatorze) dotyczą wyłącznie trzech języków wyżej.\n</div>\n\n<h2 id=\"szybki\">3. Szybki start</h2>\n<p>Biblioteka napisana w HackerScript, używana w programie H#. W <code>Bit.hk</code> programu:</p>\n<pre data-l=\"Bit.hk\"><code>[package]\n-> name    => moj-program\n-> version => 0.1.0\n-> lang    => h#\n\n[dependencies]\n-> gui => newest</code></pre>\n<p>W kodzie H#:</p>\n<pre data-l=\"src/main.h#\"><code>use \"hlib -> gui\"\n\nfn main() is\n    let app = app_new(\"Okno\", 400, 300)\n    let kids = List_Element_new()\n    List_Element_push(kids, text(\"Cześć\"))\n    let ms = App_frame1(app, column(kids))\n    println(to_string(List_Message_len(ms)))\nend</code></pre>\n<p>Budowanie i uruchomienie:</p>\n<pre data-l=\"shell\"><code>bit              <span class=\"c\"># buduje zależność gui (HackerScript → gui.hlib + fasada C-ABI), potem program</span></code></pre>\n<p>To wszystko. Żadnego <code>extern</code>, żadnego pliku adaptera po stronie biblioteki.</p>\n\n<h2 id=\"archiwum\">4. Archiwum <code>.hlib</code></h2>\n<p>Plik <code>.hlib</code> to archiwum <b>tar</b> skompresowane w całości przez <b>zstd</b> (domyślnie poziom 19). Brak własnych bajtów magicznych — <code>file x.hlib</code> pokaże „Zstandard compressed data\".</p>\n<pre data-l=\"shell — ręczna inspekcja\"><code>zstd -d moja.hlib -o moja.tar &amp;&amp; tar tf moja.tar</code></pre>\n<table>\n<tr><th>Ścieżka w archiwum</th><th>Wymagane</th><th>Zawartość</th></tr>\n<tr><td><code>manifest.json</code></td><td>tak</td><td>metadane, lista artefaktów, eksporty, podpis</td></tr>\n<tr><td><code>CHECKSUMS.sha256</code></td><td>tak</td><td>linie <code>&lt;sha256&gt;  &lt;ścieżka&gt;</code>, posortowane po ścieżce</td></tr>\n<tr><td><code>SIGNATURE.ed25519</code></td><td>nie</td><td>surowy 64-bajtowy podpis Ed25519 po bajtach <code>CHECKSUMS.sha256</code></td></tr>\n<tr><td><code>native/&lt;triple&gt;/&lt;nazwa&gt;.so</code></td><td>nie</td><td>skompilowana biblioteka współdzielona, osobna dla każdego celu</td></tr>\n<tr><td><code>bytecode/&lt;nazwa&gt;.hlbc</code></td><td>nie</td><td>bytecode Hacker Lang</td></tr>\n<tr><td><code>ast/…</code></td><td>nie</td><td>reprezentacja źródłowa w języku producenta (patrz niżej)</td></tr>\n<tr><td><code>headers/&lt;nazwa&gt;.iface.json</code></td><td>nie</td><td>kopia <code>manifest.exports</code> dla narzędzi</td></tr>\n<tr><td><code>extra/…</code></td><td>nie</td><td>dokumentacja, licencja itp. — przekazywane bez zmian</td></tr>\n</table>\n\n<h3>Artefakt <code>ast</code> — jedna specyfikacja, trzy kodowania</h3>\n<ul>\n<li><b>H#</b>: <code>ast/&lt;nazwa&gt;.ast.json</code> — tablica JSON prawdziwych węzłów AST kompilatora H#.</li>\n<li><b>Hacker Lang</b>: <code>ast/&lt;nazwa&gt;.ast.json</code> — tablica węzłów parsera Hacker Lang; często to główny artefakt, bo język nie ma statycznych typów.</li>\n<li><b>HackerScript</b>: <code>ast/&lt;nazwa&gt;.hcs</code> — oryginalny tekst <code>.hcs</code>, UTF-8, bez zmian.</li>\n</ul>\n<p>Artefakt <code>ast</code> jest czytany wyłącznie przez <b>ten sam język</b>, który go wyprodukował. Inne języki używają ścieżki <code>.so</code> + <code>headers</code>.</p>\n\n<h2 id=\"manifest\">5. <code>manifest.json</code></h2>\n<pre data-l=\"manifest.json\"><code>{\n  \"hlib_spec_version\": 1,\n  \"name\": \"mylib\",\n  \"version\": \"1.2.0\",\n  \"language\": \"hsharp\",            <span class=\"c\">// \"hsharp\" | \"hackerlang\" | \"hackerscript\"</span>\n  \"language_version\": \"0.9.0\",     <span class=\"c\">// wersja toolchaina producenta (informacyjnie)</span>\n  \"abi_version\": 1,                <span class=\"c\">// generacja ABI artefaktów .so</span>\n  \"description\": \"...\",\n  \"authors\": [\"...\"],\n  \"created_at\": \"2026-09-16T12:00:00Z\",\n  \"dependencies\": [ { \"name\": \"otherlib\", \"version_req\": \"^1.0\" } ],\n  \"artifacts\": [\n    { \"path\": \"native/x86_64-unknown-linux-gnu/mylib.so\",\n      \"kind\": \"shared_object\", \"target\": \"x86_64-unknown-linux-gnu\",\n      \"sha256\": \"…\", \"size\": 48213 }\n  ],\n  \"exports\": [\n    { \"name\": \"add\", \"kind\": \"function\",\n      \"signature\": \"fn add(a: i64, b: i64) -> i64\",\n      \"params\": [ { \"type\": \"i64\" }, { \"type\": \"i64\" } ],\n      \"returns\": { \"type\": \"i64\" },\n      \"generic\": false, \"is_macro\": false }\n  ],\n  \"signature\": { \"algorithm\": \"ed25519\", \"public_key\": \"…\", \"signed_entry\": \"CHECKSUMS.sha256\" }\n}</code></pre>\n<p><code>kind</code> artefaktu: <code>shared_object</code> · <code>bytecode</code> · <code>ast</code> · <code>header</code> · <code>extra</code>.<br>\n<code>kind</code> eksportu: <code>function</code> · <code>struct</code> · <code>enum</code> · <code>trait</code> · <code>const</code> · <code>type_alias</code>.</p>\n<p>Biblioteki z fasadą C-ABI mają w każdym eksporcie dodatkowe pole <code>\"api\"</code> z nazwą symbolu, np. <code>\"hksffi_gui_app_new\"</code>.</p>\n\n<h2 id=\"abitypes\">6. Stabilny zestaw typów ABI</h2>\n<p>Parametry i wyniki w <code>exports</code> są sprowadzone do małego, nudnego zestawu, który każdy język HackerOS mapuje na ten sam układ bitów:</p>\n<table>\n<tr><th>Typ ABI</th><th>Znaczenie</th></tr>\n<tr><td><code>i8 i16 i32 i64 u8 u16 u32 u64</code></td><td>liczby całkowite</td></tr>\n<tr><td><code>f32 f64</code></td><td>liczby zmiennoprzecinkowe</td></tr>\n<tr><td><code>bool</code>, <code>void</code></td><td>logiczny, brak wartości</td></tr>\n<tr><td><code>ptr</code></td><td>surowy wskaźnik bajtów (bufory), z długością wg konwencji producenta</td></tr>\n<tr><td><code>cstr</code></td><td>napis zakończony zerem (używany przez fasadę C-ABI do <code>Str</code>)</td></tr>\n<tr><td><code>opaque { struct_name }</code></td><td>uchwyt do obiektu o nieznanym układzie; zawsze przekazywany jako wskaźnik</td></tr>\n</table>\n<p>Wszystko bogatsze (generyki, domknięcia, układy struktur) istnieje wyłącznie w artefakcie <code>ast</code> i jest ponownie specjalizowane przez kompilator konsumenta.</p>\n\n<h2 id=\"podpis\">7. Sumy kontrolne i podpis</h2>\n<ul>\n<li><code>CHECKSUMS.sha256</code> obejmuje każdy artefakt (<code>native/</code>, <code>ast/</code>, <code>bytecode/</code>, <code>headers/</code>, <code>extra/</code>), ale <b>nie</b> sam <code>manifest.json</code> — manifest zawiera <code>sha256</code> każdego artefaktu, a jego bajty zależą od obecności podpisu, który liczy się z <code>CHECKSUMS.sha256</code>.</li>\n<li>Podpis jest opcjonalny. Weryfikacja dowodzi tylko, że plik sum podpisał posiadacz danego klucza — zaufanie do klucza zostaje po stronie wołającego (pin w lockfile, klucz wydawcy).</li>\n</ul>\n<pre data-l=\"shell\"><code>bit hlib verify gui          <span class=\"c\"># sprawdza sumy i podpis zainstalowanej biblioteki</span>\nbit hlib inspect gui.hlib    <span class=\"c\"># drukuje manifest i listę eksportów</span></code></pre>\n\n<h2 id=\"import\">8. Import w każdym języku</h2>\n<table>\n<tr><th>Język</th><th>Składnia</th></tr>\n<tr><td>H#</td><td><code>use \"hlib -> nazwa\"</code> lub <code>use \"bit -> nazwa\"</code> (równoważne dla biblioteki bit w innym języku); opcjonalnie <code>use \"hlib -> nazwa\" from \"plik\"</code></td></tr>\n<tr><td>HackerScript</td><td><code>get &lt;hlib:nazwa&gt;</code>, <code>get &lt;nazwa&gt;</code>, <code>get &lt;nazwa::1.2.0&gt;</code></td></tr>\n<tr><td>Hacker Lang</td><td><code># &lt;hlib/nazwa&gt;</code></td></tr>\n</table>\n<p>W HackerScript forma bez prefiksu <code>source:</code> jest przepisywana przez resolver projektu: na <code>hlib</code>, gdy istnieje <code>.hlib</code>, w przeciwnym razie na <code>bit</code>; gdy nie ma żadnego — jedno ostrzeżenie wymieniające oba źródła.</p>\n\n<h2 id=\"rozwiazywanie\">9. Jak kompilator wiąże bibliotekę</h2>\n<p>Rozwiązywanie zawsze próbuje dwóch ścieżek, w tej kolejności:</p>\n<ol>\n<li><b>Splice w tym samym języku.</b> Jeśli archiwum ma artefakt <code>ast</code> w kodowaniu <i>tego</i> języka, kompilator wkleja go do programu jak zwykły <code>mod</code>/<code>include</code>. Działają generyki i makra.</li>\n<li><b>Syntetyzowany <code>extern</code>.</b> Jeśli nie ma <code>ast</code> tego języka, ale jest <code>.so</code> dla hosta, kompilator sam tworzy deklaracje z <code>manifest.exports</code> i linkuje wyodrębniony <code>.so</code>.</li>\n</ol>\n<div class=\"box\">\n<b>H# + biblioteka HackerScript</b>\nArchiwum HackerScript niesie <code>ast</code> w formie <code>.hcs</code>, której H# nie umie wkleić. Dlatego <code>bit</code> buduje bibliotekę z fasadą C-ABI (<code>.so</code> + manifest eksportów) i H# wiąże się po ścieżce 2. Komunikat „H# can only splice an .hlib whose <code>ast</code> is H# (or that carries a native .so)\" oznacza, że archiwum nie miało fasady.\n</div>\n<ul>\n<li>Funkcje są wiązane po <b>nazwie z manifestu, bez prefiksu modułu</b> (<code>app_new</code>, nie <code>gui::app_new</code>).</li>\n<li>Wiązane są tylko funkcje, które program faktycznie wywołuje; reszta jest pomijana.</li>\n<li>Eksporty <code>generic: true</code> nie mają stałej sygnatury wywołania — wymagają ścieżki <code>ast</code> lub jawnej instancjacji (<code>--ffi-inst</code>).</li>\n<li>Gdy żadna ścieżka nie pasuje, import kończy się czytelnym błędem.</li>\n</ul>\n\n<h2 id=\"szukanie\">10. Ścieżki wyszukiwania</h2>\n<ol>\n<li>lokalny katalog projektu <code>hlibs/</code> (w górę od pliku importującego),</li>\n<li>miejsce zarządzane przez menedżer pakietów (np. <code>~/.hackeros/libs/&lt;nazwa&gt;/&lt;hash&gt;/.bit/build/release</code>, <code>.bit/out/</code>),</li>\n<li>katalog użytkownika <code>~/.hackeros/&lt;Język&gt;/hlibs/</code>,</li>\n<li>katalog systemowy <code>/usr/lib/HackerOS/&lt;Język&gt;/hlibs/</code>.</li>\n</ol>\n<p>Zmienna <code>HLIB_PATH=dir1:dir2</code> dodaje własne katalogi, a <code>BIT_HOME</code> zmienia katalog bibliotek bit. <code>.hlib</code> w katalogu pakietu zainstalowanego przez <code>bit</code>/<code>vira</code> jest wykrywany automatycznie.</p>\n\n<h2 id=\"fasada\">11. Fasada C-ABI</h2>\n<p>Biblioteka HackerScript nie ma typowanego ABI „z pudełka\". Fasada to kod generowany przez <code>hackerc</code> na podstawie IR biblioteki: dla każdej funkcji powstaje symbol <code>extern \"C\"</code> o nazwie <code>hksffi_&lt;biblioteka&gt;_&lt;nazwa&gt;</code>, a do manifestu trafia <code>exports</code>. Dzięki temu H# może używać <b>całego publicznego API biblioteki</b> — funkcji, metod, struktur, enumów, list, słowników i opcji — jakby było napisane natywnie.</p>\n<pre data-l=\"shell\"><code>hackerc hlib build lib/mod.hcs --ffi -o gui.hlib --name gui\n<span class=\"c\"># opcje: --ffi-target &lt;triple&gt;  --ffi-keep  --ffi-inst \"ident&lt;Int&gt;,Pair&lt;Int,Str&gt;\"  --ffi-api a,b,c</span></code></pre>\n<p>Na co dzień nie wołasz tego ręcznie — robi to <code>bit</code>.</p>\n\n<h2 id=\"eksport\">12. Co jest eksportowane</h2>\n<ul>\n<li>Domyślnie: wszystkie funkcje wolne oznaczone <code>pub fun</code>.</li>\n<li>Biblioteka bez ani jednego <code>pub fun</code> eksportuje <b>wszystko</b> (zgodność wsteczna) — tak jest w bibliotece <code>gui</code> (ok. 1000 eksportów).</li>\n<li><code>--ffi-api a,b,c</code> podaje listę jawnie i ma pierwszeństwo przed <code>pub</code>.</li>\n<li>Przy jawnej liście struktury i enumy dostają akcesory tylko wtedy, gdy występują w podpisie wyeksportowanej funkcji.</li>\n<li>Metody i typy generyczne wymagają instancjacji przez <code>--ffi-inst</code>.</li>\n</ul>\n<div class=\"box ok\">\n<b>Wskazówka dla autora biblioteki</b>\nJeśli chcesz wąskiego, stabilnego API dla H#, oznacz je <code>pub fun</code>. Wtedy wewnętrzne funkcje i typy nie zostaną wystawione.\n</div>\n\n<h2 id=\"nazwy\">13. Konwencja nazw eksportów</h2>\n<table>\n<tr><th>Element biblioteki</th><th>Eksport w H#</th><th>Przykład</th></tr>\n<tr><td>funkcja wolna</td><td><code>nazwa</code></td><td><code>app_new(Str, Int, Int) -&gt; App</code></td></tr>\n<tr><td>metoda typu</td><td><code>Typ_metoda</code> (pierwszy argument = obiekt)</td><td><code>App_frame1(App, Element) -&gt; List_Message</code></td></tr>\n<tr><td>pole struktury</td><td><code>Typ_get_pole</code>, <code>Typ_set_pole</code></td><td><code>Message_get_id(m)</code></td></tr>\n<tr><td>konstruktor struktury</td><td><code>Typ_new</code></td><td><code>Message_new(...)</code></td></tr>\n<tr><td>lista</td><td><code>List_T_new/len/get/set/push/insert/pop/remove/clear</code></td><td><code>List_Element_push(l, e)</code></td></tr>\n<tr><td>słownik</td><td><code>Dict_K_V_new/len/get/insert/contains/remove/keys/values/clear</code></td><td><code>Dict_Str_Float_get(d, \"k\")</code></td></tr>\n<tr><td>opcja</td><td><code>Option_T_some/none/is_some/get</code></td><td><code>Option_Box_is_some(o)</code></td></tr>\n<tr><td>każdy typ uchwytu</td><td><code>Typ_free</code>, <code>Typ_clone</code></td><td><code>Element_free(e)</code></td></tr>\n</table>\n<p>Nazwa symbolu C w manifeście: <code>hksffi_&lt;biblioteka&gt;_&lt;eksport&gt;</code> (pole <code>api</code>).</p>\n\n<h2 id=\"typy\">14. Mapowanie typów HackerScript → H#</h2>\n<table>\n<tr><th>HackerScript</th><th>ABI</th><th>H#</th></tr>\n<tr><td><code>Int</code></td><td><code>i64</code></td><td><code>int</code></td></tr>\n<tr><td><code>Float</code></td><td><code>f64</code></td><td>liczba zmiennoprzecinkowa</td></tr>\n<tr><td><code>Bool</code></td><td><code>bool</code></td><td><code>bool</code></td></tr>\n<tr><td><code>Str</code></td><td><code>cstr</code></td><td><code>string</code></td></tr>\n<tr><td>brak wartości</td><td><code>void</code></td><td>—</td></tr>\n<tr><td>struktura, enum, <code>List&lt;T&gt;</code>, <code>Dict&lt;K,V&gt;</code>, <code>Option&lt;T&gt;</code></td><td><code>opaque</code></td><td>uchwyt o nazwie typu (<code>App</code>, <code>Element</code>, <code>List_Message</code>…) — można go trzymać w polach struktur H# i przekazywać do funkcji</td></tr>\n</table>\n<p>Typy uchwytów są dostępne w H# pod ich nazwą, np. <code>fn f(a: App, e: Element) -&gt; bool</code>.</p>\n<div class=\"box warn\">\n<b>Floaty</b>\nAby uniknąć niejednoznaczności literałów, liczby z tekstu najwygodniej zamieniać funkcją biblioteki (<code>parse_f(Str) -&gt; Float</code> w <code>gui</code>) — tak robi Hacker-Mode.\n</div>\n\n<h2 id=\"wlasnosc\">15. Własność i pamięć</h2>\n<ul>\n<li><b>Argument-uchwyt</b> jest przekazywany jako wskaźnik <i>pożyczony</i>. Funkcje biorące wartość (np. <code>column(kids)</code>) klonują ją wewnątrz — twój uchwyt <code>kids</code> nadal jest ważny i nadal do ciebie należy.</li>\n<li><b>Wynik-uchwyt</b> to nowy obiekt na stercie, którego właścicielem jest wołający. Zwalniasz go przez <code>Typ_free</code>.</li>\n<li><b>Napisy zwracane</b> (<code>Str</code>) mieszkają w buforze wątku i są ważne do <i>następnego</i> wywołania zwracającego napis w tym samym wątku. Skopiuj je od razu, jeśli ich potrzebujesz dłużej.</li>\n<li><b>Argument-<code>Str</code></b> jest kopiowany z C-stringa; <code>\\0</code> w napisach zwracanych jest usuwane.</li>\n<li><b>Dostęp do pól</b> przez <code>Typ_get_pole</code> zwraca kopię (skalar, napis) lub pożyczony wskaźnik (uchwyt zagnieżdżony).</li>\n</ul>\n<div class=\"box\">\n<b>Wycieki</b>\nProgram krótkotrwały może pominąć <code>_free</code>. Pętla, która co klatkę buduje widok, powinna zwalniać uchwyty, które już nie są potrzebne.\n</div>\n\n<h2 id=\"watki\">16. Wątki</h2>\n<p>Fasada nie dodaje żadnej synchronizacji. Obiekty biblioteki pozostają związane z wątkiem, w którym zostały utworzone, jeśli biblioteka tak działa (np. okno biblioteki <code>gui</code> jest używane z jednego wątku). Jeśli potrzebujesz komunikacji między wątkami, biblioteka musi sama udostępniać bezpieczną strukturę (np. kolejkę za <code>Mutex</code>). Bufor napisów zwracanych jest osobny dla każdego wątku.</p>\n\n<h2 id=\"przyklad\">17. Przykład: H# używa <code>gui</code> (HackerScript)</h2>\n<p>Przetestowany, minimalny program. Okno z przyciskiem i napisem; pętla przetwarza klatki i drukuje identyfikatory zdarzeń:</p>\n<pre data-l=\"src/main.h#\"><code>use \"hlib -> gui\"\n\nfn main() is\n    let app = app_new(\"T\", 400, 300)\n    App_set_tick(app, 100)\n    let n = 0\n    while App_running(app) &amp;&amp; n &lt; 5 is\n        let kids = List_Element_new()\n        List_Element_push(kids, Element_on_press(button(\"Klik\"), \"btn\"))\n        List_Element_push(kids, text(\"hello\"))\n        let ms = App_frame1(app, column(kids))\n        let i = 0\n        while i &lt; List_Message_len(ms) is\n            let m = List_Message_get(ms, i)\n            println(Message_get_id(m))\n            i = i + 1\n        end\n        n = n + 1\n    end\n    println(\"done\")\nend</code></pre>\n<h3>Uchwyty w strukturach H#</h3>\n<pre data-l=\"H#\"><code>use \"hlib -> gui\"\n\npub struct Win is\n    pub app: App\n    pub pending: [string]\nend\n\npub fn open(title: string) -> Win is\n    let app = app_new(title, 1280, 800)\n    App_set_key_nav(app, true)\n    return Win { app: app, pending: [] }\nend</code></pre>\n<div class=\"box ok\">\n<b>Hacker-Mode</b>\nPrawdziwy przykład użycia: <code>src/gfx.h#</code> zamienia tekstowy opis widoku na drzewo <code>Element</code> i obsługuje pętlę okna, wołając wyłącznie zwykłe API <code>gui</code>.\n</div>\n\n<h2 id=\"bit\">18. Narzędzie <code>bit</code></h2>\n<p><code>bit</code> buduje zależność jej własnym kompilatorem (HackerScript, Hacker Lang albo H#), niezależnie od języka projektu. Biblioteka HackerScript używana z H# jest budowana z fasadą C-ABI.</p>\n<pre data-l=\"shell\"><code>bit                              <span class=\"c\"># zbuduj projekt wraz z zależnościami</span>\nbit hlib list                    <span class=\"c\"># które .hlib istnieją</span>\nbit hlib inspect &lt;nazwa|plik&gt;    <span class=\"c\"># manifest i eksporty</span>\nbit hlib verify  &lt;nazwa|plik&gt;    <span class=\"c\"># sumy kontrolne i podpis</span>\nbit hlib build   &lt;nazwa&gt;         <span class=\"c\"># zbuduj .hlib wskazanej zależności</span>\nbit hlib path    &lt;nazwa&gt;         <span class=\"c\"># gdzie leży</span>\nbit upgrade &lt;nazwa&gt;              <span class=\"c\"># odśwież zainstalowaną bibliotekę</span></code></pre>\n<p>Biblioteka zainstalowana bez kompilatora jest dobudowywana przy następnym <code>bit</code>. Biblioteki HackerScript są przed spakowaniem spłaszczane (<code>include &lt;x&gt;</code> wklejane w miejscu) i budowane z <code>--name</code>.</p>\n<p>Pierwsze zbudowanie dużej biblioteki z fasadą (np. <code>gui</code>) trwa kilka minut.</p>\n\n<h2 id=\"hackerc\">19. Narzędzie <code>hackerc</code></h2>\n<table>\n<tr><th>Polecenie</th><th>Działanie</th></tr>\n<tr><td><code>hackerc hlib build &lt;plik.hcs&gt; -o x.hlib --name x</code></td><td>archiwum ze źródłami (<code>ast/*.hcs</code>)</td></tr>\n<tr><td>… <code>--ffi</code></td><td>dodatkowo fasada C-ABI jako <code>.so</code> i <code>manifest.exports</code></td></tr>\n<tr><td>… <code>--ffi-target &lt;triple&gt;</code></td><td>cel kompilacji fasady (np. <code>x86_64-unknown-linux-gnu</code>)</td></tr>\n<tr><td>… <code>--ffi-keep</code></td><td>zachowuje wygenerowany kod Rust fasady</td></tr>\n<tr><td>… <code>--ffi-inst \"…\"</code></td><td>instancje generyków, np. <code>ident&lt;Int&gt;,Pair&lt;Int,Str&gt;</code></td></tr>\n<tr><td>… <code>--ffi-api a,b,c</code></td><td>jawna lista eksportowanych funkcji wolnych</td></tr>\n<tr><td>… <code>--sign &lt;klucz&gt;</code></td><td>podpis Ed25519</td></tr>\n<tr><td><code>hackerc hlib inspect x.hlib</code></td><td>wypisuje manifest (JSON)</td></tr>\n</table>\n<div class=\"box warn\">\n<b>Cel kompilacji</b>\nFasada to biblioteka współdzielona dla konkretnego celu. H# kompilowany na hoście musl nie wczyta <code>.so</code> zbudowanego dla glibc. <code>bit</code> wybiera zgodny cel automatycznie; przy ręcznej kompilacji podaj go jawnie (np. <code>--target linux-x86_64-gnu</code>).\n</div>\n\n<h2 id=\"hl\">20. Hacker Lang</h2>\n<p>Hacker Lang to trzeci język HackerOS obsługiwany przez HLIB. Importuje bibliotekę przez <code># &lt;hlib/nazwa&gt;</code>.</p>\n<ul>\n<li>Nie ma statycznych typów, więc jego główny artefakt to <code>ast/*.ast.json</code> + <code>bytecode/*.hlbc</code> (węzły <code>FuncDef</code>/<code>ArenaFuncDef</code> są jednocześnie interfejsem i kodem, który runtime wykonuje wprost).</li>\n<li>Jego FFI to <b>jeden stały punkt wejścia</b>: <code>hl_extern_call(argc: i32, argv: *const *const i8) -&gt; i32</code> — z napisami zamiast typowanego ABI per funkcja.</li>\n</ul>\n<div class=\"box warn\">\n<b>Różnica konwencji wywołań</b>\nBiblioteki zbudowane w H# i HackerScript mają typowane symbole C, a Hacker Lang woła przez <code>hl_extern_call</code>. Dlatego łączenie Hacker Lang z <code>.so</code> H#/HackerScript (i odwrotnie) wymaga cienkiego shimu dopasowanego do konwencji Hacker Lang; format tej różnicy jeszcze nie ukrywa. <code>exports[].signature</code> zawsze mówi, z czym naprawdę się łączysz.\n</div>\n<p>W tej dokumentacji przetestowano ścieżkę H# ↔ HackerScript. Ścieżka Hacker Lang jest opisana według specyfikacji formatu i nie była tu uruchamiana.</p>\n\n<h2 id=\"bledy\">21. Błędy i rozwiązania</h2>\n<table>\n<tr><th>Komunikat</th><th>Przyczyna</th><th>Rozwiązanie</th></tr>\n<tr><td><code>undefined fn: nazwa</code></td><td>funkcji nie ma w manifeście eksportów biblioteki (literówka albo biblioteka jej nie ma / nie jest <code>pub</code>)</td><td><code>bit hlib inspect &lt;lib&gt;</code> i sprawdź nazwę; używaj prawdziwego API biblioteki, nie nazw „wymyślonych\"</td></tr>\n<tr><td><code>H# can only splice an .hlib whose ast is H#…</code></td><td>archiwum HackerScript bez fasady C-ABI</td><td>zbuduj z <code>--ffi</code> (robi to <code>bit</code>); <code>bit hlib build &lt;nazwa&gt;</code></td></tr>\n<tr><td>błąd o celu hosta (musl) przy linkowaniu <code>.so</code></td><td>niezgodny cel fasady i H#</td><td>skompiluj H# dla <code>linux-x86_64-gnu</code> albo zbuduj fasadę dla tego samego celu</td></tr>\n<tr><td><code>bit library 'x' not found</code></td><td>brak biblioteki w ścieżkach wyszukiwania</td><td><code>bit install x</code> albo dodaj do <code>[dependencies]</code>; <code>HLIB_PATH</code></td></tr>\n<tr><td><code>undefined variable `x`</code> w napisie z <code>{x}</code></td><td>w H# <code>{nazwa}</code> w literale napisu jest interpolacją</td><td>rozbij napis: <code>\"{\" + \"x}\"</code></td></tr>\n<tr><td>weryfikacja sum nie przechodzi</td><td>archiwum zmodyfikowane po zbudowaniu</td><td>przebuduj: <code>bit hlib build</code> / <code>bit upgrade</code></td></tr>\n</table>\n\n<h2 id=\"zasady\">22. Dobre praktyki</h2>\n<ul>\n<li>Pisz bibliotekę normalnie w jej języku; wąskie API oznacz <code>pub fun</code>.</li>\n<li>Nie twórz adapterów „pod H#\" w bibliotece — fasada udostępnia już całe API.</li>\n<li>W programie H# opakuj uchwyty w własne struktury (<code>pub struct Win is pub app: App end</code>) zamiast rozrzucać je po kodzie.</li>\n<li>Kopiuj napisy zwracane z biblioteki od razu — bufor jest nadpisywany przy następnym wywołaniu.</li>\n<li>Zwalniaj uchwyty w pętlach długo działających programów.</li>\n<li>Trzymaj obiekty związane z wątkiem (okno, kontekst GUI) w jednym wątku.</li>\n<li>Podpisuj biblioteki wydawane innym i przypinaj klucz publiczny w lockfile.</li>\n<li>Jeśli poprawiasz błąd w implementacji formatu w jednym języku, sprawdź pozostałe dwa — nie są synchronizowane automatycznie.</li>\n</ul>\n\n<footer>\nHLIB API · specyfikacja formatu: <code>hlib_spec_version: 1</code> · dokument opisuje stan na dzień 2026-11-13. Format <code>.hlib</code> i fasada C-ABI są wewnętrzne dla HackerOS (H#, HackerScript, Hacker Lang).\n</footer>\n</main>\n</div>"

fun main() [
    boot_begin("pl", "HLIB API — natywne API bibliotek HackerOS")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    boot_body(PAGE_BODY)
    offline_init("../")
    scrollspy("h2[id]", "nav a", "-15% 0px -75% 0px", 0.0)
]
