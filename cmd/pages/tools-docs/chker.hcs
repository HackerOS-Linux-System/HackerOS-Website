use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>

style {
#app { display: none; }
:root{--bg:#080a0d;--bg2:#0d1017;--bg3:#111520;--border:#1c2030;--border2:#252d42;--red:#ff2040;--red2:#ff4060;--red3:#ff6080;--cyan:#00d4ff;--yellow:#ffd000;--green:#00ff88;--dim:#3a4558;--text:#c5d3e8;--text2:#6b7f99;--mono:'JetBrains Mono',monospace;--head:'Bebas Neue',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:13.5px;line-height:1.75;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,32,64,0.015) 3px,rgba(255,32,64,0.015) 4px);pointer-events:none;z-index:9999}
.layout{display:flex;min-height:100vh}
nav{width:250px;min-width:250px;background:var(--bg2);border-right:1px solid var(--border);position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.nav-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,rgba(255,32,64,0.12) 0%,transparent 100%)}
.logo-big{font-family:var(--head);font-size:48px;line-height:1;color:var(--red);text-shadow:0 0 40px rgba(255,32,64,0.6),0 0 80px rgba(255,32,64,0.2);letter-spacing:2px}
.logo-sub{color:var(--text2);font-size:10px;letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.logo-ver{color:var(--red3);font-size:11px;margin-top:6px}
.nav-section{padding:14px 20px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
nav a{display:block;padding:5px 20px 5px 28px;color:var(--text2);text-decoration:none;font-size:12px;transition:all .15s;position:relative;border-left:2px solid transparent}
nav a::before{content:'›';position:absolute;left:14px;color:var(--dim)}
nav a:hover{color:var(--text);background:rgba(255,32,64,0.04)}
nav a.active{color:var(--red);border-left-color:var(--red);background:rgba(255,32,64,0.07)}
nav a.active::before{color:var(--red)}
main{flex:1;max-width:860px;padding:0 64px 80px}
.hero{padding:64px 0 56px;border-bottom:1px solid var(--border);margin-bottom:64px;position:relative;overflow:hidden}
.hero::before{content:'CHKER';position:absolute;right:-20px;top:-20px;font-family:var(--head);font-size:200px;color:rgba(255,32,64,0.04);pointer-events:none;user-select:none}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.3);color:var(--red);font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:24px}
.hero-tag::before{content:'◆';font-size:8px}
.hero h1{font-family:var(--head);font-size:64px;line-height:1;letter-spacing:3px;color:#fff;margin-bottom:6px}
.hero h1 span{color:var(--red);text-shadow:0 0 30px rgba(255,32,64,0.5)}
.hero-desc{color:var(--text2);font-size:14px;margin-bottom:32px;max-width:560px}
.hero-cmd{background:var(--bg3);border:1px solid var(--border2);border-left:3px solid var(--red);padding:14px 20px;border-radius:3px;display:inline-block;font-size:14px}
.prompt{color:var(--dim)}.cmd-s{color:var(--red)}.arg-s{color:var(--text)}
section{margin-bottom:72px}
h2{font-family:var(--head);font-size:28px;color:#fff;letter-spacing:2px;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.h2-num{font-size:11px;color:var(--red);letter-spacing:2px;border:1px solid rgba(255,32,64,0.3);padding:2px 8px;border-radius:2px;font-family:var(--mono)}
h2 a{color:var(--dim);text-decoration:none;font-size:16px;margin-left:auto}
h2 a:hover{color:var(--red)}
h3{font-size:13px;color:var(--red2);letter-spacing:1px;margin:28px 0 10px;text-transform:uppercase}
p{color:var(--text);margin-bottom:14px;max-width:680px}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;overflow-x:auto;margin:14px 0 24px;position:relative}
pre::before{content:attr(data-lang);position:absolute;top:8px;right:12px;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim)}
code{font-family:var(--mono);font-size:12.5px;color:var(--text)}
.hl-r{color:var(--red)}.hl-c{color:var(--cyan)}.hl-y{color:var(--yellow)}.hl-g{color:var(--green)}.hl-d{color:var(--dim)}.hl-w{color:#fff;font-weight:600}
ci{display:inline;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.2);padding:1px 6px;border-radius:2px;font-size:12px;color:var(--red2);font-family:var(--mono)}
.tbl{width:100%;border-collapse:collapse;margin:16px 0 24px}
.tbl th{text-align:left;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);padding:8px 14px;border-bottom:1px solid var(--border2)}
.tbl td{padding:9px 14px;border-bottom:1px solid var(--border);vertical-align:top}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(255,32,64,0.03)}
.tbl .tc{color:var(--red2);font-weight:500;white-space:nowrap}.tbl .ta{color:var(--yellow)}.tbl .td{color:var(--text2);font-size:12.5px}
.yes{color:var(--green)}.no{color:var(--red)}.par{color:var(--yellow)}
.box{border-radius:3px;padding:14px 18px;margin:14px 0 20px;border-left:3px solid;font-size:13px;max-width:680px}
.box-n{background:rgba(0,212,255,0.06);border-color:var(--cyan)}.box-w{background:rgba(255,208,0,0.06);border-color:var(--yellow)}.box-t{background:rgba(255,32,64,0.06);border-color:var(--red)}
.box strong{display:block;margin-bottom:4px;font-size:9px;letter-spacing:2px;text-transform:uppercase}
.box-n strong{color:var(--cyan)}.box-w strong{color:var(--yellow)}.box-t strong{color:var(--red)}
.tree{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;margin:14px 0 24px;font-size:12.5px;line-height:2}
.td2{color:var(--red2)}.tf{color:var(--text)}.ta2{color:var(--dim);font-style:italic}.to{color:var(--dim)}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.badge{font-size:10px;padding:3px 10px;border-radius:2px;border:1px solid;letter-spacing:.5px}
.br{color:var(--red);border-color:rgba(255,32,64,0.3);background:rgba(255,32,64,0.08)}.bc{color:var(--cyan);border-color:rgba(0,212,255,0.3);background:rgba(0,212,255,0.08)}.by{color:var(--yellow);border-color:rgba(255,208,0,0.3);background:rgba(255,208,0,0.08)}.bg{color:var(--green);border-color:rgba(0,255,136,0.3);background:rgba(0,255,136,0.08)}
.ext{color:var(--red2);text-decoration:none;border-bottom:1px solid rgba(255,64,96,0.3)}
.ext:hover{color:var(--red);border-bottom-color:var(--red)}
ul.feat{color:var(--text2);margin:0 0 20px 20px;line-height:2}
footer{margin-top:80px;padding-top:24px;border-top:1px solid var(--border);color:var(--dim);font-size:11px}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--red)}
@media(max-width:860px){nav{display:none}main{padding:32px 20px}.hero h1{font-size:44px}}
}

let PAGE_BODY: Str = "<div class=\"layout\">\n<nav>\n  <div class=\"nav-logo\">\n    <div class=\"logo-big\">CHKER</div>\n    <div class=\"logo-sub\">Change Kernel</div>\n    <div class=\"logo-ver\">XanMod &middot; Liquorix &middot; Debian</div>\n  </div>\n  <span class=\"nav-section\">Start</span>\n  <a href=\"#overview\">Overview</a>\n  <a href=\"#quickstart\">Quickstart</a>\n  <span class=\"nav-section\">Usage</span>\n  <a href=\"#commands\">Command Reference</a>\n  <a href=\"#xanmod\">XanMod</a>\n  <a href=\"#liquorix\">Liquorix</a>\n  <a href=\"#deb-kernel\">deb-kernel</a>\n  <span class=\"nav-section\">Internals</span>\n  <a href=\"#cpu\">CPU Detection</a>\n  <a href=\"#nvidia\">NVIDIA</a>\n  <a href=\"#cleanup\">Removing Debian kernel</a>\n  <a href=\"#files\">Files</a>\n  <a href=\"#build\">Build</a>\n</nav>\n<main>\n\n<div class=\"hero\">\n  <div class=\"hero-tag\">Kernel switcher &middot; H# &middot; HackerOS</div>\n  <h1><span>CHKER</span></h1>\n  <p class=\"hero-desc\">Change Kernel &mdash; jedna komenda zmienia jądro HackerOS na XanMod albo Liquorix (dobrane do procesora), doinstalowuje sterowniki NVIDIA i potrafi wrócić do jądra Debiana.</p>\n  <div class=\"hero-cmd\"><span class=\"prompt\">$ </span><span class=\"cmd-s\">chker</span> <span class=\"arg-s\">xanmod | liquorix | deb-kernel</span></div>\n</div>\n\n<section id=\"overview\">\n  <h2><span class=\"h2-num\">01</span> OVERVIEW <a href=\"#overview\">#</a></h2>\n  <div class=\"badges\"><span class=\"badge br\">H#</span><span class=\"badge bc\">Debian / apt</span><span class=\"badge by\">Liquorix</span><span class=\"badge bg\">XanMod</span><span class=\"badge br\">HackerOS</span></div><p><strong>chker</strong> (<em>Change Kernel</em>) to narzędzie HackerOS do przełączania jądra systemu. Jedna komenda instaluje jądro <ci>XanMod</ci> albo <ci>Liquorix</ci> (dobrane do procesora), doinstalowuje sterowniki NVIDIA, jeśli wykryje kartę, i usuwa jądro Debiana. Trzecia komenda robi odwrotnie &mdash; wraca do jądra z repozytorium Debiana.</p><p>Program jest napisany w H# (przepisany z wcześniejszej wersji w Odin) i mieści się w jednym pliku <ci>source-code/main.h#</ci>. Wszystkie operacje na pakietach wykonuje przez <ci>apt</ci> z <ci>sudo</ci>, więc działa na systemach opartych o Debiana.</p><div class=\"box box-w\"><strong>Zmienia jądro i usuwa poprzednie</strong>chker ignoruje kody wyjścia poleceń <ci>apt</ci>: jeśli instalacja nowego jądra się nie powiedzie, krok usuwania jądra Debiana i tak zostanie wykonany. Przed restartem sprawdź w wyjściu programu, że instalacja zakończyła się bez błędów, i miej pod ręką nośnik awaryjny.</div>\n</section>\n\n<section id=\"quickstart\">\n  <h2><span class=\"h2-num\">02</span> QUICKSTART <a href=\"#quickstart\">#</a></h2>\n  <pre data-lang=\"sh\"><code>chker                    <span class=\"hl-d\"># bez argumentów: wypisuje pomoc</span>\nchker xanmod             <span class=\"hl-d\"># jądro XanMod dopasowane do CPU</span>\nchker liquorix           <span class=\"hl-d\"># jądro Liquorix</span>\nchker deb-kernel         <span class=\"hl-d\"># powrót do jądra Debiana</span>\nsudo reboot              <span class=\"hl-d\"># po każdej zmianie jądra potrzebny restart</span></code></pre><div class=\"box box-n\"><strong>sudo</strong>Polecenia pakietowe chker uruchamia sam przez <ci>sudo</ci> (<ci>sudo apt install ...</ci>), więc program startuje jako zwykły użytkownik i poprosi o hasło przy pierwszym wywołaniu. Plik konfiguracyjny jest zapisywany w katalogu domowym uruchamiającego go użytkownika.</div>\n</section>\n\n<section id=\"commands\">\n  <h2><span class=\"h2-num\">03</span> COMMAND REFERENCE <a href=\"#commands\">#</a></h2>\n  <table class=\"tbl\">\n    <tr><th>Polecenie</th><th>Opis</th></tr>\n    <tr><td class=\"tc\">chker liquorix</td><td class=\"td\">Instaluje jądro Liquorix, instaluje sterowniki NVIDIA (jeśli jest karta), usuwa jądro Debiana i zapisuje wybór w <ci>~/.config/hackeros/kernel.hacker</ci></td></tr>\n    <tr><td class=\"tc\">chker xanmod</td><td class=\"td\">Dobiera wariant XanMod do CPU, dodaje repozytorium XanMod, instaluje <ci>linux-xanmod-lts-&lt;wariant&gt;</ci>, sterowniki NVIDIA, usuwa jądro Debiana, zapisuje wybór i uruchamia <ci>update-grub</ci></td></tr>\n    <tr><td class=\"tc\">chker deb-kernel</td><td class=\"td\">Usuwa aktualne jądro Liquorix/XanMod, instaluje <ci>linux-image-amd64</ci>, uruchamia <ci>update-grub</ci> i kasuje plik <ci>kernel.hacker</ci></td></tr>\n    <tr><td class=\"tc\">chker</td><td class=\"td\">Bez argumentów wypisuje listę poleceń</td></tr>\n    <tr><td class=\"tc\">chker &amp;lt;inne&amp;gt;</td><td class=\"td\">Nieznane polecenie: komunikat <ci>Nieznane polecenie</ci> i pomoc</td></tr>\n  </table><p>Komunikaty narzędzia (z wyjątkiem pomocy) są po polsku. Każdy instalator drukuje prefiks z nazwą etapu: <ci>[xanmod-installer]</ci>, <ci>[liquorix-installer]</ci>, <ci>[deb-kernel-installer]</ci>.</p>\n</section>\n\n<section id=\"xanmod\">\n  <h2><span class=\"h2-num\">04</span> XANMOD <a href=\"#xanmod\">#</a></h2>\n  <p>Ścieżka <ci>chker xanmod</ci> krok po kroku:</p><pre data-lang=\"flow\"><code><span class=\"hl-d\"># 1. dopasowanie do procesora</span>\n  -&gt; pobierz xanmod-cpu.hacker z repozytorium Hacker-Lang   (curl, instaluje curl jeśli brak)\n  -&gt; odczytaj model i producenta CPU, dopasuj wpis z pliku\n  -&gt; z nazwy celu wybierz wariant: x64v1 | x64v2 | x64v3\n\n<span class=\"hl-d\"># 2. repozytorium XanMod</span>\n  -&gt; pobierz klucz https://dl.xanmod.org/archive.key (wget, instaluje wget jeśli brak)\n  -&gt; gpg --dearmor  -&gt;  /etc/apt/keyrings/xanmod-archive-keyring.gpg\n  -&gt; zapisz /etc/apt/sources.list.d/xanmod-release.list\n  -&gt; apt update\n\n<span class=\"hl-d\"># 3. instalacja i sprzątanie</span>\n  -&gt; apt install -y linux-xanmod-lts-&lt;wariant&gt;\n  -&gt; sterowniki NVIDIA (jeśli wykryto kartę)\n  -&gt; usunięcie jądra Debiana\n  -&gt; zapis ~/.config/hackeros/kernel.hacker  ([xanmod])\n  -&gt; update-grub</code></pre><h3>Wariant pakietu</h3><table class=\"tbl\">\n    <tr><th>Cel z dopasowania zawiera</th><th>Wariant</th><th>Pakiet</th></tr>\n    <tr><td class=\"tc\"><ci>v3</ci></td><td>x64v3</td><td class=\"td\"><ci>linux-xanmod-lts-x64v3</ci></td></tr>\n    <tr><td class=\"tc\"><ci>v2</ci> (i nie zawiera <ci>v3</ci>)</td><td>x64v2</td><td class=\"td\"><ci>linux-xanmod-lts-x64v2</ci></td></tr>\n    <tr><td class=\"tc\">nic z powyższych (w tym domyślne <ci>x86-64</ci>)</td><td>x64v1</td><td class=\"td\"><ci>linux-xanmod-lts-x64v1</ci></td></tr>\n  </table><p>Wpis repozytorium ma postać <ci>deb [signed-by=/etc/apt/keyrings/xanmod-archive-keyring.gpg] http://deb.xanmod.org &lt;wydanie&gt; main</ci>, gdzie wydanie pochodzi z <ci>lsb_release -sc</ci> (przy braku polecenia: <ci>bookworm</ci>).</p>\n</section>\n\n<section id=\"liquorix\">\n  <h2><span class=\"h2-num\">05</span> LIQUORIX <a href=\"#liquorix\">#</a></h2>\n  <pre data-lang=\"flow\"><code><span class=\"hl-d\"># 1. CPU</span>\n  -&gt; pobierz xanmod-cpu.hacker, wypisz wykryty CPU i dopasowany cel   (tylko informacyjnie)\n\n<span class=\"hl-d\"># 2. instalacja</span>\n  -&gt; curl -s https://liquorix.net/install-liquorix.sh -o /tmp/install-liquorix.sh\n  -&gt; sudo bash /tmp/install-liquorix.sh\n  -&gt; sterowniki NVIDIA (jeśli wykryto kartę)\n  -&gt; usunięcie jądra Debiana\n  -&gt; zapis ~/.config/hackeros/kernel.hacker  ([liquorix])</code></pre><p>Dobór pakietu i konfigurację repozytorium Liquorix wykonuje oficjalny skrypt instalacyjny; chker nie wybiera wariantu na podstawie CPU, a dopasowany cel tylko wypisuje.</p><div class=\"box box-n\"><strong>GRUB</strong>W ścieżce Liquorix chker sam nie wywołuje <ci>update-grub</ci> (robi to dla XanMod i deb-kernel). Jeśli po restarcie nowe jądro nie jest na liście, uruchom <ci>sudo update-grub</ci> ręcznie.</div>\n</section>\n\n<section id=\"deb-kernel\">\n  <h2><span class=\"h2-num\">06</span> DEB-KERNEL <a href=\"#deb-kernel\">#</a></h2>\n  <p><ci>chker deb-kernel</ci> działa tylko wtedy, gdy aktualnie uruchomione jądro (<ci>uname -r</ci>) zawiera w nazwie <ci>liquorix</ci> albo <ci>xanmod</ci>. W przeciwnym razie wypisuje, że jądro Debiana jest już aktywne, i nic nie robi.</p><pre data-lang=\"flow\"><code>sudo apt remove --purge -y linux-image-$(uname -r)\nsudo apt update\nsudo apt install -y linux-image-amd64\nsudo update-grub\nrm -f ~/.config/hackeros/kernel.hacker</code></pre><p>Obraz <ci>linux-image-amd64</ci> jest zakodowany na stałe &mdash; polecenie jest przeznaczone dla architektury amd64.</p>\n</section>\n\n<section id=\"cpu\">\n  <h2><span class=\"h2-num\">07</span> CPU DETECTION <a href=\"#cpu\">#</a></h2>\n  <p>Dopasowanie do procesora opiera się na pliku mapowania <ci>xanmod-cpu.hacker</ci> pobieranym z repozytorium Hacker-Lang (<ci>hacker-packages/xanmod-cpu.hacker</ci> na gałęzi <ci>main</ci>, przez <ci>raw.githubusercontent.com</ci>) do <ci>/tmp/xanmod-cpu.hacker</ci>.</p><ul class=\"feat\"><li>Tekst do dopasowania: model CPU (<ci>/proc/cpuinfo</ci>, <em>Model name</em>), producent (<em>vendor_id</em>) i pełne wyjście <ci>lscpu</ci> &mdash; wszystko małymi literami.</li><li>Wpisy mapowania mają postać <ci>[wzorzec&gt;cel]</ci> i są wyciągane przez <ci>grep -oP</ci>.</li><li>Wzorce są sprawdzane od najdłuższego do najkrótszego; pierwszy, który występuje w tekście CPU (bez rozróżniania wielkości liter), wygrywa.</li><li>Brak dopasowania daje cel <ci>x86-64</ci>.</li></ul><pre data-lang=\"hacker\"><code>[ryzen 9&gt;x86-64-v3]\n[celeron&gt;x86-64]</code></pre><p>Powyższe dwa wpisy to przykład samego formatu; aktualna zawartość mapowania żyje w repozytorium Hacker-Lang. Błąd pobierania pliku przerywa instalację z komunikatem <ci>Blad pobierania pliku z GitHub</ci>.</p>\n</section>\n\n<section id=\"nvidia\">\n  <h2><span class=\"h2-num\">08</span> NVIDIA <a href=\"#nvidia\">#</a></h2>\n  <p>Po instalacji jądra (XanMod i Liquorix) chker sprawdza obecność karty NVIDIA poleceniem <ci>lspci -nnk</ci> (doinstalowuje <ci>pciutils</ci>, jeśli brakuje <ci>lspci</ci>). Gdy w wyjściu występuje <ci>nvidia</ci>:</p><pre data-lang=\"sh\"><code>sudo apt update\nsudo apt install -y nvidia-driver nvidia-kernel-dkms nvidia-smi libnvidia-ml1 nvidia-settings</code></pre><p>Bez karty NVIDIA wypisywany jest komunikat <ci>Nie wykryto NVIDIA</ci> i krok jest pomijany.</p>\n</section>\n\n<section id=\"cleanup\">\n  <h2><span class=\"h2-num\">09</span> REMOVING THE DEBIAN KERNEL <a href=\"#cleanup\">#</a></h2>\n  <p>Po instalacji nowego jądra chker usuwa stare jądro Debiana w jeden z dwóch sposobów:</p><table class=\"tbl\">\n    <tr><th>Warunek</th><th>Działanie</th></tr>\n    <tr><td class=\"tc\">istnieje <ci>/usr/share/HackerOS/Scripts/Bin/remove-debian-kernel.sh</ci></td><td class=\"td\">uruchamia ten skrypt przez <ci>sudo</ci></td></tr>\n    <tr><td class=\"tc\">skryptu nie ma</td><td class=\"td\">usuwa bieżące jądro: <ci>sudo apt remove --purge -y linux-image-$(uname -r)</ci></td></tr>\n  </table>\n</section>\n\n<section id=\"files\">\n  <h2><span class=\"h2-num\">10</span> FILES <a href=\"#files\">#</a></h2>\n  <table class=\"tbl\">\n    <tr><th>Ścieżka</th><th>Rola</th></tr>\n    <tr><td class=\"tc\"><ci>~/.config/hackeros/kernel.hacker</ci></td><td class=\"td\">wybrane jądro: <ci>[xanmod]</ci> albo <ci>[liquorix]</ci>; kasowany przez <ci>deb-kernel</ci></td></tr>\n    <tr><td class=\"tc\"><ci>/etc/apt/keyrings/xanmod-archive-keyring.gpg</ci></td><td class=\"td\">klucz repozytorium XanMod (po <ci>gpg --dearmor</ci>)</td></tr>\n    <tr><td class=\"tc\"><ci>/etc/apt/sources.list.d/xanmod-release.list</ci></td><td class=\"td\">wpis repozytorium XanMod</td></tr>\n    <tr><td class=\"tc\"><ci>/usr/share/HackerOS/Scripts/Bin/remove-debian-kernel.sh</ci></td><td class=\"td\">opcjonalny skrypt usuwający stare jądra</td></tr>\n    <tr><td class=\"tc\"><ci>/tmp/xanmod-cpu.hacker</ci>, <ci>/tmp/xanmod.key</ci>, <ci>/tmp/install-liquorix.sh</ci></td><td class=\"td\">pliki tymczasowe pobierane w trakcie instalacji</td></tr>\n  </table>\n</section>\n\n<section id=\"build\">\n  <h2><span class=\"h2-num\">11</span> BUILD <a href=\"#build\">#</a></h2>\n  <div class=\"tree\">\n    <span class=\"td2\">chker/</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">source-code/main.h#</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; cały program (komendy, wykrywanie CPU, instalatory)</span><br>\n    &nbsp;&nbsp;<span class=\"tf\">build.hl</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; bit build --release</span><br>\n    &nbsp;&nbsp;<span class=\"to\">Bit.hk</span>&nbsp;&nbsp;<span class=\"ta2\">&#8592; manifest pakietu bit</span><br>\n    &nbsp;&nbsp;<span class=\"to\">README.md</span><br>\n    &nbsp;&nbsp;<span class=\"to\">LICENSE</span>\n  </div><pre data-lang=\"sh\"><code>bit build --release       <span class=\"hl-d\"># tak jak w build.hl (język: H#)</span></code></pre><p>Program korzysta tylko z biblioteki standardowej H# (<ci>shell</ci>, <ci>fs_write</ci>, <ci>to_lower</ci>, <ci>contains</ci>); żadnych zewnętrznych zależności bit.</p>\n</section>\n\n<footer>chker &middot; Change Kernel &middot; HackerOS Ecosystem &middot; <a href=\"https://github.com/HackerOS-Linux-System/chker\" style=\"color:var(--dim)\">GitHub &#8599;</a></footer>\n</main>\n</div>"

fun main() [
    boot_begin("pl", "chker — Change Kernel")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["href", "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Bebas+Neue&display=swap", "rel", "stylesheet"])
    boot_body(PAGE_BODY)
    offline_init("../")
    scrollspy("section[id]", "nav a", "-15% 0px -75% 0px", 0.0)
]
