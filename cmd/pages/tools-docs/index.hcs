use <mode:website>

include <../../shared/offline>
include <../../logic/tools_index>

style {
#app { display: none; }
*{margin:0;padding:0;box-sizing:border-box;}
body{background-color:#0c0f14;font-family:'Inter','Segoe UI',system-ui,-apple-system,'Roboto',sans-serif;line-height:1.55;min-height:100vh;display:flex;flex-direction:column;color:#eef2f8;}


.search-top{background-color:#05070a;border-bottom:1px solid #1e262f;padding:14px 0;}
.search-top-inner{max-width:600px;margin:0 auto;padding:0 20px;}
.search-wrapper{position:relative;}
.search-icon{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:#7a8a9e;font-size:1rem;transition:color .2s;}
.search-top-inner input{width:100%;background:#141b24;border:2px solid #2f3845;border-radius:60px;padding:12px 24px 12px 50px;color:#eef2f8;font-size:1.05rem;outline:none;transition:all .25s;box-shadow:0 0 0 transparent;}
.search-top-inner input::placeholder{color:#7a8a9e;font-weight:300;}
.search-top-inner input:focus{border-color:#5f7f9e;background:#1e2834;box-shadow:0 0 0 4px rgba(95,127,158,0.2);}
.search-top-inner input:focus + .search-icon,
.search-top-inner input:focus ~ .search-icon{color:#8ab0d6;}

.top-bar{background-color:#05070a;width:100%;box-shadow:0 4px 16px rgba(0,0,0,.5);position:relative;z-index:100;border-bottom:1px solid #20262e;}
.navbar-container{display:flex;align-items:center;justify-content:flex-start;max-width:1600px;margin:0 auto;padding:0 28px;min-height:74px;gap:2rem;flex-wrap:wrap;}
.logo-area{flex-shrink:0;line-height:0;transition:filter .2s;}.logo-area:hover{filter:brightness(.92);}
.logo-area a{display:inline-block;text-decoration:none;}
.logo-area img{display:block;max-height:54px;width:auto;height:auto;filter:drop-shadow(0 2px 5px rgba(0,0,0,.5));border-radius:8px;cursor:pointer;}
.nav-menu{flex:1;display:flex;justify-content:center;}
.nav-list{display:flex;flex-wrap:wrap;justify-content:center;gap:.3rem;list-style:none;align-items:center;}
.nav-list li{margin:0;position:relative;}
.nav-list a{display:inline-block;padding:8px 18px;font-weight:550;font-size:.95rem;letter-spacing:.2px;text-decoration:none;color:#e3e9f2;background-color:transparent;border-radius:60px;transition:all .22s;font-family:inherit;white-space:nowrap;}
.nav-list a:hover{background-color:#2a313c;color:white;transform:translateY(-1px);box-shadow:0 2px 8px rgba(0,0,0,.4);}
.nav-list li.hidden-tool{display:none;}


#hl-settings-li{display:flex!important;align-items:center;margin-left:8px;}
.hl-settings-btn{background:none;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:6px;border-radius:8px;transition:opacity .2s,transform .3s;opacity:.85;}
.hl-settings-btn:hover{opacity:1;transform:rotate(30deg);}
.hl-settings-btn img{width:30px;height:30px;display:block;object-fit:contain;}


.dropdown{position:relative;}
.dropdown-btn{background:transparent;border:none;font-family:inherit;font-weight:550;font-size:.95rem;letter-spacing:.2px;color:#e3e9f2;padding:8px 18px;border-radius:60px;cursor:pointer;transition:all .22s;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
.dropdown-btn i{font-size:.75rem;transition:transform .2s;}
.dropdown-btn:hover{background-color:#2a313c;color:white;transform:translateY(-1px);box-shadow:0 2px 8px rgba(0,0,0,.4);}
.dropdown-content{position:absolute;top:calc(100% + 6px);left:0;background-color:#0f151e;backdrop-filter:blur(12px);border-radius:20px;min-width:210px;padding:.5rem 0;box-shadow:0 20px 30px -12px rgba(0,0,0,.6);border:1px solid #2c3540;opacity:0;visibility:hidden;transform:translateY(-8px);transition:all .2s;z-index:200;}
.dropdown.open .dropdown-content{opacity:1;visibility:visible;transform:translateY(0);}
.dropdown-content a{display:block;padding:10px 20px;color:#e0e8f2;text-decoration:none;font-size:.85rem;font-weight:500;transition:background .15s;white-space:nowrap;}
.dropdown-content a:hover{background-color:#1f2a36;color:white;}


.main-content{flex:1;max-width:1300px;margin:2rem auto;padding:2rem 2rem 2.5rem;background-color:#13181f;border-radius:44px;box-shadow:0 25px 40px -12px rgba(0,0,0,.5);border:1px solid #242c34;}
.section-header{text-align:center;margin-bottom:2rem;}
.section-header h2{font-size:2.3rem;font-weight:650;background:linear-gradient(125deg,#eef2fc,#b9c4d1);background-clip:text;-webkit-background-clip:text;color:transparent;letter-spacing:-.4px;}


.slider-shell{position:relative;margin:1rem 0 .8rem;border-radius:2rem;}
.slider-container{position:relative;overflow:hidden;border-radius:2rem;background:#0e131a;box-shadow:0 18px 30px -12px rgba(0,0,0,.5);border:1px solid #2c3540;margin:0 4px;}
.slides-wrapper{overflow:hidden;width:100%;}
.slides-track{display:flex;transition:transform .4s cubic-bezier(.2,.85,.4,1);will-change:transform;}
.slide{flex:0 0 100%;padding:2.2rem 3rem;background:#10161e;min-height:280px;display:flex;flex-direction:column;justify-content:center;border-radius:1.5rem;}
.slide h3{font-size:2rem;font-weight:700;letter-spacing:-.3px;background:linear-gradient(130deg,#fff,#cbdae6);background-clip:text;-webkit-background-clip:text;color:transparent;margin-bottom:1rem;border-left:4px solid #5f7f9e;padding-left:1.2rem;}
.slide p{font-size:1.05rem;line-height:1.55;color:#cfdeed;max-width:92%;margin-bottom:.2rem;}
.slider-btn{position:absolute;top:50%;transform:translateY(-50%);background:#1f2a33dd;backdrop-filter:blur(8px);border:1px solid #3a4451;width:44px;height:44px;border-radius:60px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;z-index:12;color:#f0f4fa;font-size:2rem;font-weight:400;box-shadow:0 4px 12px rgba(0,0,0,.3);left:12px;right:auto;}
.slider-btn.btn-next{left:auto;right:12px;}
.slider-btn:hover{background:#2c3846;transform:translateY(-50%) scale(1.02);border-color:#6f8aac;}
@media(max-width:700px){.slider-btn{width:38px;height:38px;font-size:1.7rem;left:6px;}.slider-btn.btn-next{right:6px;}.slide{padding:1.5rem 2rem;}.slide h3{font-size:1.6rem;}}
@media(max-width:550px){.slide{padding:1.2rem 1.5rem;}.slider-btn{width:34px;height:34px;font-size:1.5rem;}}
.dots-container{display:flex;justify-content:center;gap:12px;margin-top:1.6rem;flex-wrap:wrap;}
.dot{width:10px;height:10px;background-color:#3f4a57;border-radius:50%;cursor:pointer;transition:all .2s;}
.dot.active{background-color:#cbdae9;width:28px;border-radius:20px;}
.dot:hover{background-color:#8fa0b5;}


footer{background:transparent;border-top:1px solid #20262e;margin-top:.5rem;padding:1.2rem 2rem 1.8rem;}
.footer-copyright{text-align:center;font-size:.75rem;color:#8c9aaa;margin-bottom:1.2rem;}
.footer-social-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1.5rem;max-width:1300px;margin:0 auto;}
.footer-left,.footer-right{display:flex;flex-wrap:wrap;gap:1.8rem;align-items:center;}
.social-link{display:inline-flex;align-items:center;gap:8px;color:#b4c4da;text-decoration:none;font-size:.85rem;font-weight:500;transition:.2s;background:#0f141c60;padding:5px 12px;border-radius:40px;backdrop-filter:blur(2px);}
.social-link i{font-size:1.2rem;width:1.3rem;text-align:center;}
.social-link:hover{color:white;background:#1f2a36;transform:translateY(-1px);}
@media(max-width:800px){.footer-social-row{flex-direction:column;align-items:center;gap:1rem;}.footer-left,.footer-right{justify-content:center;gap:1rem;}}
@media(max-width:880px){.navbar-container{flex-wrap:wrap;padding:10px 20px;gap:.8rem;}.logo-area{margin-right:auto;}.nav-menu{flex:1 1 100%;justify-content:center;}.nav-list a,.dropdown-btn{padding:6px 13px;font-size:.85rem;}.dropdown-content{left:0;right:auto;min-width:180px;}.main-content{margin:1rem;padding:1.5rem;}.section-header h2{font-size:1.9rem;}}


:root{--accent:#4a9eff;--accent2:#00d4ff;--panel:#10161e;}
body{background:radial-gradient(1100px 500px at 15% -5%,rgba(74,158,255,.13),transparent 60%),radial-gradient(900px 480px at 100% 10%,rgba(0,212,255,.08),transparent 60%),#0c0f14;background-attachment:fixed;}
.top-bar{background:rgba(5,7,10,.88);backdrop-filter:blur(14px);position:sticky;top:0;}
.nav-list a{border:1px solid transparent;}
.nav-list a:hover{border-color:#3b4a5c;background:#1b2531;}
.nav-list li:nth-child(-n+4) a{background:linear-gradient(135deg,rgba(74,158,255,.18),rgba(0,212,255,.10));border-color:rgba(74,158,255,.4);color:#fff;}
.nav-list li:nth-child(-n+4) a:hover{border-color:var(--accent2);box-shadow:0 0 14px rgba(0,212,255,.25);}
.main-content{background:linear-gradient(180deg,#151c25,#11161d);border-radius:32px;position:relative;overflow:hidden;}
.main-content::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:linear-gradient(90deg,transparent,var(--accent),var(--accent2),transparent);}
.section-header h2{font-size:2.5rem;background:linear-gradient(120deg,#fff 20%,var(--accent2));-webkit-background-clip:text;background-clip:text;}
.section-header h2::after{content:'';display:block;width:70px;height:3px;margin:.7rem auto 0;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));}
.slider-container{border-radius:24px;border:1px solid #2f3b49;background:var(--panel);box-shadow:0 22px 40px -16px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.04);}
.slide{position:relative;min-height:320px;padding:2.4rem 4rem;background:radial-gradient(600px 260px at 90% 0%,rgba(74,158,255,.12),transparent 70%),var(--panel);}
.slide-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.3rem;}
.slide-mono{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;font-weight:800;font-size:1.1rem;letter-spacing:.5px;color:#fff;background:linear-gradient(135deg,var(--accent),#2a5fd0);box-shadow:0 8px 18px -6px rgba(74,158,255,.6);}
.slide-count{font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:.85rem;color:#7f93aa;background:#0b1017;border:1px solid #27323f;padding:4px 12px;border-radius:40px;}
.slide h3{border-left:0;padding-left:0;font-size:2.2rem;margin-bottom:.9rem;}
.slide p{font-size:1.1rem;line-height:1.7;color:#d3e0ee;max-width:100%;}
.slider-btn{background:rgba(20,28,38,.85);}
.slider-btn:hover{background:var(--accent);border-color:var(--accent2);color:#fff;}
.dots-container{gap:8px;}
.dot{height:8px;width:8px;}
.dot.active{background:linear-gradient(90deg,var(--accent),var(--accent2));width:30px;}
.dot:hover{background:var(--accent);}
footer{background:rgba(5,7,10,.5);}
@media(max-width:700px){.slide{padding:1.6rem 3rem;min-height:300px}.slide h3{font-size:1.7rem}.slide-mono{width:44px;height:44px}.section-header h2{font-size:1.9rem}}
@media(max-width:550px){.slide{padding:1.3rem 2.6rem}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
}

let PAGE_BODY: Str = "<header class=\"top-bar\">\n  \n  <div class=\"search-top\">\n    <div class=\"search-top-inner\">\n      <div class=\"search-wrapper\">\n        <i class=\"fas fa-search search-icon\"></i>\n        <input type=\"text\" id=\"toolsSearch\" placeholder=\"Szukaj narzędzia...\" aria-label=\"Wyszukaj narzędzie\">\n      </div>\n    </div>\n  </div>\n\n  <div class=\"navbar-container\">\n    <div class=\"logo-area\">\n      <a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/Home-page.html\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <img src=\"../HackerOS.png\" alt=\"HackerOS\"\n             onerror=\"this.onerror=null;this.src='data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20120%2040%22%3E%3Crect%20width%3D%22120%22%20height%3D%2240%22%20fill%3D%22%230d1117%22%20rx%3D%228%22%2F%3E%3Ctext%20x%3D%2210%22%20y%3D%2225%22%20fill%3D%22%23f0f3fa%22%20font-size%3D%2214%22%20font-family%3D%27monospace%27%3EHackerOS%3C%2Ftext%3E%3C%2Fsvg%3E';\">\n      </a>\n    </div>\n    <nav class=\"nav-menu\" aria-label=\"HackerOS ecosystem menu\">\n      <ul class=\"nav-list\" id=\"nav-list\">\n        <li><a href=\"https://hackeros-linux-system.github.io/bit/about.html\" target=\"_blank\" rel=\"noopener noreferrer\" data-key=\"bit\">bit</a></li>\n        <li><a href=\"#getit\" data-slide=\"getit\" data-key=\"getit\">getit</a></li>\n        <li><a href=\"#chker\" data-slide=\"chker\" data-key=\"chker\">chker</a></li>\n        <li><a href=\"#hdm\" data-slide=\"hdm\" data-key=\"hdm\">HDM</a></li>\n        <li><a href=\"gaming-cli.html\" data-key=\"gaming-cli\">gaming-cli</a></li>\n        <li><a href=\"hpm.html\" data-key=\"hpm\">HPM</a></li>\n        <li><a href=\"hackeros-containers.html\" data-key=\"hackeros-containers\">HackerOS Containers</a></li>\n        <li><a href=\"hackeros-builder.html\" data-key=\"hackeros-builder\">HackerOS Builder</a></li>\n        <li><a href=\"hammer.html\" data-key=\"hammer\">hammer</a></li>\n        <li><a href=\"hacker.html\" data-key=\"hacker\">hacker</a></li>\n        \n        <li><a href=\"hk.html\" data-key=\"hk\">.hk</a></li>\n        <li><a href=\"hsh.html\" data-key=\"hsh\">hsh</a></li>\n        <li><a href=\"hedit.html\" data-key=\"hedit\">hedit</a></li>\n        <li><a href=\"hdev.html\" data-key=\"hdev\">hdev</a></li>\n        <li><a href=\"ngt.html\" data-key=\"ngt\">ngt</a></li>\n        <li><a href=\"penetration-mode.html\" data-key=\"penetration-mode\">Penetration Mode</a></li>\n        <li><a href=\"cybersecurity-mode.html\" data-key=\"cybersecurity-mode\">Cybersecurity Mode</a></li>\n        <li><a href=\"hacker-term.html\" data-key=\"hacker-term\">Hacker Term</a></li>\n        <li><a href=\"hackerdeck.html\" data-key=\"hackerdeck\">HackerDeck</a></li>\n        <li><a href=\"ghostfs.html\" data-key=\"ghostfs\">GhostFS</a></li>\n        <li><a href=\"hexai.html\" data-key=\"hexai\">HexAI</a></li>\n        <li><a href=\"hnm.html\" data-key=\"hnm\">HNM</a></li>\n        <li><a href=\"hacker-mode.html\" data-key=\"hacker-mode\">Hacker Mode</a></li>\n        <li><a href=\"isolator.html\" data-key=\"isolator\">Isolator</a></li>\n        <li><a href=\"hackeros-steam.html\" data-key=\"hackeros-steam\">HackerOS Steam</a></li>\n        \n        <li><a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/hackeros-games/docs.html\" target=\"_blank\" rel=\"noopener noreferrer\">HackerOS Games</a></li>\n        <li><a href=\"hackeros-kernel.html\">HackerOS Kernel</a></li>\n        <li><a href=\"Hacker-Launcher.html\">Hacker Launcher</a></li>\n        <li><a href=\"hackeros-store.html\">HackerOS Store</a></li>\n        <li><a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/Blue-Environment/docs.html\" target=\"_blank\" rel=\"noopener noreferrer\">Blue Environment</a></li>\n        <li class=\"dropdown\" id=\"langDropdown\">\n          <button class=\"dropdown-btn\" id=\"langDropdownBtn\">\n            <span id=\"lang-drop-label\">Języki programowania</span> <i class=\"fas fa-chevron-down\"></i>\n          </button>\n          <div class=\"dropdown-content\">\n            <a id=\"lang-drop-hsharp\" href=\"https://hackeros-linux-system.github.io/HackerOS-Website/h-sharp/docs.html\" target=\"_blank\" rel=\"noopener noreferrer\">H# – dokumentacja</a>\n            <a id=\"lang-drop-hackerlang\" href=\"https://hackeros-linux-system.github.io/HackerOS-Website/hacker-lang/docs.html\" target=\"_blank\" rel=\"noopener noreferrer\">Hacker Lang – dokumentacja</a>\n            <a id=\"lang-drop-hackerscript\" href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/HackerScript/docs.html\" target=\"_blank\" rel=\"noopener noreferrer\">HackerScript – dokumentacja</a>\n          </div>\n        </li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<main class=\"main-content\">\n  <div class=\"section-header\"><h2 id=\"section-h2\">Poznaj ekosystem HackerOS.</h2></div>\n  <div class=\"slider-shell\">\n    <div class=\"slider-container\" id=\"sliderContainer\">\n      <div class=\"slides-wrapper\"><div class=\"slides-track\" id=\"slidesTrack\"></div></div>\n      <button class=\"slider-btn btn-prev\" id=\"prevSlideBtn\" aria-label=\"poprzedni slajd\">‹</button>\n      <button class=\"slider-btn btn-next\" id=\"nextSlideBtn\" aria-label=\"następny slajd\">›</button>\n    </div>\n    <div class=\"dots-container\" id=\"dotsContainer\"></div>\n  </div>\n</main>\n\n<footer>\n  <div class=\"footer-copyright\" id=\"footer-copy\">HackerOS · © 2026 HackerOS. Wszelkie prawa zastrzeżone. | Dokumentacja ekosystemu HackerOS</div>\n  <div class=\"footer-social-row\">\n    <div class=\"footer-left\">\n      <a href=\"https://sourceforge.net/projects/hackeros/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-sourceforge\"></i> SourceForge</a>\n      <a href=\"https://discord.com/invite/8yHNcBaEKy\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-discord\"></i> Discord</a>\n      <a href=\"https://linuxiarze.pl/distro-hackeros/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fas fa-globe\"></i> Linuxiarze</a>\n    </div>\n    <div class=\"footer-right\">\n      <a href=\"https://github.com/HackerOS-Linux-System\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-github\"></i> GitHub</a>\n      <a href=\"https://x.com/hackeros_linux\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-x-twitter\"></i> X</a>\n      <a href=\"https://distrowatch.com/table.php?distribution=hackeros\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fas fa-chart-line\"></i> DistroWatch</a>\n      <a href=\"https://www.reddit.com/r/HackerOS_/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\"><i class=\"fab fa-reddit-alien\"></i> Reddit</a>\n    </div>\n  </div>\n</footer>"

fun main() [
    boot_begin("pl", "HackerOS · Ekosystem & narzędzia")
    set_viewport("width=device-width,initial-scale=1.0,viewport-fit=cover")
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["rel", "stylesheet", "href", "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"])
    boot_body(PAGE_BODY)
    offline_init("../")
    tools_index_init()
]
