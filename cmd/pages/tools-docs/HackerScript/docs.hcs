use <mode:website>

include <../../../logic/docsites>

style {
#app { display: none; }
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

:root{
  --ink-0:#0f1115;
  --ink-1:#161a20;
  --ink-2:#1e232b;
  --ink-3:#2a313c;
  --line:#333c48;
  --steel-0:#7c8695;
  --steel-1:#a9b1bd;
  --paper:#eef0f3;
  --copper:#c96a3f;
  --copper-dim:#8a4a2c;
  --slate-blue:#6f9bb0;
  --ok:#7fae7a;
  --warn:#d0a24c;
  --radius:3px;
  --mono:'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
  --sans:'Space Grotesk', system-ui, sans-serif;
}

*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }

body{
  margin:0;
  background:var(--ink-0);
  color:var(--steel-1);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

::selection{ background:var(--copper); color:var(--ink-0); }

a{ color:var(--slate-blue); text-decoration:none; }
a:hover{ text-decoration:underline; }

code, pre, .mono{ font-family:var(--mono); }


.skip-link{
  position:absolute; left:-999px; top:0;
  background:var(--copper); color:var(--ink-0);
  padding:.6rem 1rem; z-index:200; border-radius:var(--radius);
}
.skip-link:focus{ left:1rem; top:1rem; }
a:focus-visible, button:focus-visible, input:focus-visible{
  outline:2px solid var(--copper); outline-offset:2px;
}


.topbar{
  position:sticky; top:0; z-index:100;
  display:flex; align-items:center; gap:1rem;
  padding:0 1.25rem; height:56px;
  background:rgba(15,17,21,.92);
  backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);
}
.topbar .brand{
  display:flex; align-items:center; gap:.55rem;
  font-family:var(--mono); font-weight:600; color:var(--paper);
  font-size:.95rem; letter-spacing:.01em;
}
.brand .mark{
  width:20px; height:20px; flex:none;
  background:linear-gradient(135deg,var(--steel-1),var(--steel-0));
  clip-path:polygon(0 0,45% 0,45% 40%,100% 40%,100% 100%,55% 100%,55% 60%,0 60%);
}
.brand .ver{
  color:var(--copper); font-weight:500; font-size:.78rem;
  border:1px solid var(--copper-dim); padding:.1rem .4rem; border-radius:var(--radius);
}
.topbar .spacer{ flex:1; }
.nav-toggle{
  display:none; background:none; border:1px solid var(--line); color:var(--steel-1);
  width:38px; height:38px; border-radius:var(--radius); cursor:pointer;
}
.nav-toggle span{ display:block; width:16px; height:2px; background:var(--steel-1); margin:3px auto; }

.gh-link{
  font-size:.85rem; color:var(--steel-0); border:1px solid var(--line);
  padding:.4rem .75rem; border-radius:var(--radius);
}
.gh-link:hover{ color:var(--paper); border-color:var(--steel-0); text-decoration:none; }


.layout{
  display:grid;
  grid-template-columns:240px minmax(0,1fr);
  max-width:1180px; margin:0 auto;
}

.sidebar{
  position:sticky; top:56px;
  align-self:start;
  height:calc(100vh - 56px);
  overflow-y:auto;
  padding:1.75rem 1rem 2rem 1.25rem;
  border-right:1px solid var(--line);
}
.sidebar h3{
  font-size:.72rem; text-transform:uppercase; letter-spacing:.09em;
  color:var(--steel-0); margin:1.4rem 0 .5rem; font-weight:600;
}
.sidebar h3:first-child{ margin-top:0; }
.sidebar ul{ list-style:none; margin:0; padding:0; }
.sidebar li a{
  display:block; padding:.32rem .5rem; margin:.05rem 0;
  color:var(--steel-0); font-size:.88rem; border-left:2px solid transparent;
  border-radius:0 var(--radius) var(--radius) 0;
}
.sidebar li a:hover{ color:var(--paper); text-decoration:none; background:var(--ink-2); }
.sidebar li a.active{
  color:var(--copper); border-left-color:var(--copper); background:var(--ink-2);
  font-weight:500;
}

main{ min-width:0; padding:0 2.25rem 6rem; }


.hero{
  padding:4.5rem 0 3rem;
  border-bottom:1px solid var(--line);
  margin-bottom:3rem;
}
.hero .eyebrow-line{
  display:flex; align-items:center; gap:.6rem;
  color:var(--steel-0); font-family:var(--mono); font-size:.82rem; margin-bottom:1.1rem;
}
.hero .eyebrow-line .dot{ width:7px; height:7px; border-radius:50%; background:var(--ok); }
.hero h1{
  font-size:clamp(2.1rem,5vw,3.1rem); line-height:1.08; margin:0 0 1.1rem;
  color:var(--paper); font-weight:700; max-width:16ch;
}
.hero h1 .accent{ color:var(--copper); }
.hero p.lede{
  max-width:56ch; font-size:1.08rem; color:var(--steel-1); margin:0 0 2rem;
}
.hero-actions{ display:flex; gap:.85rem; flex-wrap:wrap; margin-bottom:2.5rem; }
.btn{
  font-family:var(--mono); font-size:.86rem; padding:.65rem 1.1rem;
  border-radius:var(--radius); border:1px solid var(--line); color:var(--paper);
  cursor:pointer; display:inline-flex; align-items:center; gap:.5rem;
}
.btn.primary{ background:var(--copper); border-color:var(--copper); color:#1a0e08; font-weight:600; }
.btn.primary:hover{ background:#d97a4c; text-decoration:none; }
.btn:hover{ border-color:var(--steel-0); text-decoration:none; }

.term{
  background:var(--ink-1); border:1px solid var(--line); border-radius:var(--radius);
  overflow:hidden; max-width:560px;
}
.term .term-head{
  display:flex; gap:.4rem; padding:.6rem .75rem; border-bottom:1px solid var(--line);
}
.term .term-head span{ width:9px; height:9px; border-radius:50%; background:var(--ink-3); }
.term pre{ margin:0; padding:1.1rem 1.25rem; font-size:.86rem; overflow-x:auto; }


section.doc-section{ padding-top:2.75rem; margin-top:-2.75rem; }
section.doc-section h2{
  font-size:1.5rem; color:var(--paper); margin:0 0 .35rem;
  padding-top:1.25rem; scroll-margin-top:70px;
}
section.doc-section > .kicker{
  font-family:var(--mono); font-size:.76rem; color:var(--copper);
  text-transform:none; margin-bottom:.15rem; display:block;
}
section.doc-section h3{
  font-size:1.08rem; color:var(--paper); margin:2rem 0 .6rem; scroll-margin-top:70px;
}
section.doc-section p{ max-width:68ch; color:var(--steel-1); }
section.doc-section > p:first-of-type{ margin-top:.25rem; }

.grid-cards{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:1rem; margin:1.5rem 0 2rem;
}
.card{
  border:1px solid var(--line); border-radius:var(--radius); padding:1rem 1.1rem;
  background:var(--ink-1);
}
.card h4{ margin:0 0 .4rem; font-size:.95rem; color:var(--paper); }
.card p{ margin:0; font-size:.87rem; color:var(--steel-0); }
.card code{ color:var(--slate-blue); font-size:.82rem; }


.code-block{
  position:relative; background:var(--ink-1); border:1px solid var(--line);
  border-radius:var(--radius); margin:1rem 0 1.75rem; overflow:hidden;
}
.code-block .code-label{
  display:flex; justify-content:space-between; align-items:center;
  padding:.45rem .85rem; border-bottom:1px solid var(--line);
  font-family:var(--mono); font-size:.74rem; color:var(--steel-0);
}
.copy-btn{
  background:none; border:1px solid var(--line); color:var(--steel-0);
  font-family:var(--mono); font-size:.72rem; padding:.25rem .55rem;
  border-radius:var(--radius); cursor:pointer;
}
.copy-btn:hover{ color:var(--paper); border-color:var(--steel-0); }
.copy-btn.copied{ color:var(--ok); border-color:var(--ok); }
.code-block pre{ margin:0; padding:1rem 1.15rem; overflow-x:auto; font-size:.85rem; line-height:1.65; }
.code-block code{ color:var(--steel-1); }

.tok-kw{ color:var(--copper); }
.tok-str{ color:var(--ok); }
.tok-com{ color:var(--steel-0); font-style:italic; }
.tok-type{ color:var(--slate-blue); }
.tok-fn{ color:#c9b45e; }

table.ref-table{ width:100%; border-collapse:collapse; margin:1.25rem 0 2rem; font-size:.88rem; }
.ref-table th{
  text-align:left; font-family:var(--mono); font-weight:500; color:var(--steel-0);
  font-size:.76rem; text-transform:none; padding:.5rem .7rem; border-bottom:1px solid var(--line);
}
.ref-table td{ padding:.55rem .7rem; border-bottom:1px solid var(--ink-2); vertical-align:top; }
.ref-table code{ color:var(--copper); font-size:.83rem; }
.ref-table tr:hover td{ background:var(--ink-1); }

.status-pill{
  display:inline-block; font-family:var(--mono); font-size:.72rem;
  padding:.15rem .5rem; border-radius:var(--radius); border:1px solid;
}
.status-pill.ok{ color:var(--ok); border-color:var(--ok); }
.status-pill.wip{ color:var(--warn); border-color:var(--warn); }
.status-pill.planned{ color:var(--steel-0); border-color:var(--steel-0); }

.note{
  border-left:3px solid var(--copper-dim); background:var(--ink-1);
  padding:.85rem 1.1rem; margin:1.25rem 0; border-radius:0 var(--radius) var(--radius) 0;
  font-size:.9rem; color:var(--steel-1); max-width:64ch;
}
.note strong{ color:var(--copper); }

.search-wrap{ position:relative; margin:0 0 1.25rem; }
.search-wrap input{
  width:100%; background:var(--ink-1); border:1px solid var(--line); color:var(--paper);
  font-family:var(--mono); font-size:.85rem; padding:.55rem .8rem .55rem 2.1rem;
  border-radius:var(--radius);
}
.search-wrap input:focus{ outline:none; border-color:var(--copper); }
.search-wrap::before{
  content:'/'; position:absolute; left:.8rem; top:50%; transform:translateY(-50%);
  color:var(--steel-0); font-family:var(--mono); font-size:.85rem; pointer-events:none;
}
.no-match{ display:none; }

footer.site-footer{
  border-top:1px solid var(--line); padding:2.5rem 2.25rem; margin-top:4rem;
  font-size:.85rem; color:var(--steel-0); max-width:1180px; margin-left:auto; margin-right:auto;
  display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem;
}

@media (max-width:860px){
  .layout{ grid-template-columns:1fr; }
  .sidebar{
    position:fixed; inset:56px 0 0 0; height:auto; bottom:0;
    background:var(--ink-0); z-index:90; transform:translateX(-100%);
    transition:transform .18s ease; width:100%; border-right:none;
  }
  .sidebar.open{ transform:translateX(0); }
  .nav-toggle{ display:block; }
  main{ padding:0 1.15rem 4rem; }
  .hero{ padding:2.5rem 0 2rem; }
}

@media (prefers-reduced-motion:reduce){
  html{ scroll-behavior:auto; }
  .sidebar{ transition:none; }
}
}

let PAGE_BODY: Str = "<a class=\"skip-link\" href=\"#content\">Przejdź do treści</a>\n\n<header class=\"topbar\">\n  <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Otwórz nawigację\" aria-expanded=\"false\">\n    <span></span><span></span><span></span>\n  </button>\n  <div class=\"brand\">\n    <span class=\"mark\" aria-hidden=\"true\"></span>\n    HackerScript <span class=\"ver\">v0.1</span>\n  </div>\n  <div class=\"spacer\"></div>\n  <a class=\"gh-link\" href=\"https://github.com/HackerOS-Linux-System/HackerScript\" target=\"_blank\" rel=\"noopener\">Repozytorium ↗</a>\n</header>\n\n<div class=\"layout\">\n  <nav class=\"sidebar\" id=\"sidebar\" aria-label=\"Nawigacja dokumentacji\">\n    <div class=\"search-wrap\">\n      <input type=\"text\" id=\"docSearch\" placeholder=\"Szukaj w dokumentacji…\" aria-label=\"Szukaj w dokumentacji\">\n    </div>\n\n    <h3>Start</h3>\n    <ul>\n      <li><a href=\"#wprowadzenie\">Wprowadzenie</a></li>\n      <li><a href=\"#instalacja\">Instalacja</a></li>\n      <li><a href=\"#pierwszy-projekt\">Pierwszy projekt</a></li>\n    </ul>\n\n    <h3>Składnia</h3>\n    <ul>\n      <li><a href=\"#zmienne-typy\">Zmienne i typy</a></li>\n      <li><a href=\"#funkcje\">Funkcje</a></li>\n      <li><a href=\"#struct-impl\">Struktury i impl</a></li>\n      <li><a href=\"#enum-match\">Enum i match</a></li>\n      <li><a href=\"#sterowanie\">Sterowanie przepływem</a></li>\n      <li><a href=\"#direct-manual\">direct i manual</a></li>\n      <li><a href=\"#native-js\">native" + " {JavaScript}</a></li>\n      <li><a href=\"#sandbox\">$ ... $ Sandbox</a></li>\n      <li><a href=\"#hot-reload\">@" + "hot_reload</a></li>\n    </ul>\n\n    <h3>Moduły i pakiety</h3>\n    <ul>\n      <li><a href=\"#moduly\">System modułów (get)</a></li>\n      <li><a href=\"#manifest\">Virus.hk</a></li>\n    </ul>\n\n    <h3>Narzędzia</h3>\n    <ul>\n      <li><a href=\"#cli\">CLI: hackerc i virus</a></li>\n      <li><a href=\"#biblioteka\">Biblioteka standardowa</a></li>\n    </ul>\n\n    <h3>Projekt</h3>\n    <ul>\n      <li><a href=\"#roadmap\">Roadmap</a></li>\n    </ul>\n  </nav>\n\n  <main id=\"content\">\n\n    <section class=\"hero\">\n      <div class=\"eyebrow-line\"><span class=\"dot\"></span> bootstrap self-hostujący się osiągnięty w 0.1</div>\n      <h1>Zwykła <span class=\"accent\">fun</span> kompiluje się<br>do prawdziwego Rusta.</h1>\n      <p class=\"lede\">HackerScript to język ogólnego przeznaczenia: statyczne typy i bezpieczeństwo pamięci Rusta na co dzień, z <code>direct" + " [ ... ]</code> jako ucieczką do czystego Pythona dla małych fragmentów, które nigdy nie będą wymagały wydajności.</p>\n      <div class=\"hero-actions\">\n        <a class=\"btn primary\" href=\"#instalacja\">Zacznij →</a>\n        <a class=\"btn\" href=\"#pierwszy-projekt\">Pierwszy projekt</a>\n      </div>\n      <div class=\"term\">\n        <div class=\"term-head\"><span></span><span></span><span></span></div>\n        <pre><code><span class=\"tok-kw\">struct</span> Point [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">distance_squared</span>(p: Point) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">end</span> (p.x * p.x) + (p.y * p.y)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> p = Point(3, 4)\n    log(<span class=\"tok-str\">\"dist^2 =\"</span>, distance_squared(p))\n\n    <span class=\"tok-kw\">direct</span> [\n        print(<span class=\"tok-str\">\"To jest czysty Python wewnątrz binarki Rust.\"</span>)\n    ]\n    <span class=\"tok-kw\">end</span>\n]</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"wprowadzenie\">\n      <span class=\"kicker\">Start</span>\n      <h2>Wprowadzenie</h2>\n      <p><code>fun</code> → <code>hackerc</code> generuje prawdziwy Rust: <code>struct</code> staje się <code>struct</code> + <code>impl new()</code>, <code>manual [...]</code> staje się <code>unsafe { ... }</code>, <code>List&lt;T&gt;</code> staje się <code>Vec&lt;T&gt;</code>. Parametry typu <code>struct</code>/<code>List</code>/<code>Str</code> automatycznie dostają <code>&amp;</code>/<code>&amp;mut</code> zamiast przenoszenia własności.</p>\n      <p><code>direct" + " [ ... ]</code> → surowy Python wykonywany w trakcie działania programu przez <code>Python::with_gil</code> (PyO3, tryb <code>auto-initialize</code>) — Rust jest hostem.</p>\n      <div class=\"grid-cards\">\n        <div class=\"card\"><h4>Statyczne typy</h4><p>Cały front — <code>lexer</code>/<code>parser</code>/<code>typecheck</code>/<code>typeinfer</code> — jest sam napisany w HackerScript.</p></div>\n        <div class=\"card\"><h4>Zero-cost</h4><p>Kompilacja do Rusta oznacza brak własnego runtime'u ponad to, co daje <code>rustc</code>.</p></div>\n        <div class=\"card\"><h4>Self-hosted</h4><p><code>hackerc</code> i <code>virus</code> są dziś w całości napisane w samym HackerScript (<code>.hcs</code>).</p></div>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"instalacja\">\n      <span class=\"kicker\">Start</span>\n      <h2>Instalacja</h2>\n      <p><code>hackerc</code> i <code>virus</code> to binarki natywne (self-hosted) — najprościej pobrać gotowe wydanie.</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"install-code\">Kopiuj</button></div>\n        <pre id=\"install-code\"><code>curl -L --fail -o hackerc \\\n  https://github.com/HackerOS-Linux-System/HackerScript/releases/download/v0.1/hackerc\nchmod +x hackerc\n\n./hackerc check docs/hello-world/Virus.hk\n./hackerc build docs/hello-world/cmd/main.hcs -o /tmp/out\ncd /tmp/out &amp;&amp; cargo run   # wymaga zainstalowanego Rusta</code></pre>\n      </div>\n      <div class=\"note\"><strong>Uwaga:</strong> <code>using &lt;wersja&gt;</code> na początku pliku (lub <code>[package] using</code> w <code>Virus.hk</code>) deklaruje wymaganą wersję <code>hackerc</code> — jeśli nie jest zainstalowana, <code>virus</code> pobiera ją automatycznie z GitHub Releases.</div>\n    </section>\n\n    <section class=\"doc-section\" id=\"pierwszy-projekt\">\n      <span class=\"kicker\">Start</span>\n      <h2>Pierwszy projekt</h2>\n      <p>W projekcie zarządzanym przez <code>virus</code> (patrz <code>Virus.hk</code>):</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"init-code\">Kopiuj</button></div>\n        <pre id=\"init-code\"><code>virus init --name moj-projekt\ncd moj-projekt\nvirus build --release   # pobierze właściwy hackerc automatycznie</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"zmienne-typy\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>Zmienne i typy</h2>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"vars-code\">Kopiuj</button></div>\n        <pre id=\"vars-code\"><code><span class=\"tok-kw\">let</span> x = 5\n<span class=\"tok-kw\">const</span> PI = 3.14159\n\n<span class=\"tok-kw\">let</span> lista: List&lt;Int&gt; = [1, 2, 3]\n<span class=\"tok-kw\">let</span> wynik: Result&lt;Int, Str&gt; = ok(42)\n<span class=\"tok-kw\">let</span> moze: Option&lt;Int&gt; = some(7)</code></pre>\n      </div>\n      <table class=\"ref-table\">\n        <thead><tr><th>Typ</th><th>Znaczenie</th></tr></thead>\n        <tbody>\n          <tr><td><code>Int / Float / Str / Bool / Void</code></td><td>typy podstawowe</td></tr>\n          <tr><td><code>List&lt;T&gt;</code></td><td>lista, transpilowana do <code>Vec&lt;T&gt;</code></td></tr>\n          <tr><td><code>Dict&lt;K, V&gt;</code></td><td>mapa (dziś: bez iteracji <code>for k, v in ...</code> — patrz Roadmap)</td></tr>\n          <tr><td><code>Option&lt;T&gt;</code></td><td><code>some(x)</code> / <code>none()</code></td></tr>\n          <tr><td><code>Result&lt;T, E&gt;</code></td><td><code>ok(x)</code> / <code>err(e)</code></td></tr>\n        </tbody>\n      </table>\n    </section>\n\n    <section class=\"doc-section\" id=\"funkcje\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>Funkcje</h2>\n      <p><code>end &lt;wyrażenie&gt;</code> zwraca wartość i kończy funkcję. Ostatnie wyrażenie w bloku nie jest niejawnie zwracane — <code>end</code> jest zawsze wymagane, żeby coś zwrócić.</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"fun-code\">Kopiuj</button></div>\n        <pre id=\"fun-code\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">fib</span>(n: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">if</span> n &lt;= 1 [\n        <span class=\"tok-kw\">end</span> n\n    ]\n    <span class=\"tok-kw\">end</span> fib(n - 1) + fib(n - 2)\n]</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"struct-impl\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>Struktury i impl</h2>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"struct-code\">Kopiuj</button></div>\n        <pre id=\"struct-code\"><code><span class=\"tok-kw\">struct</span> Point [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">impl</span> Point [\n    <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">sum</span>(<span class=\"tok-kw\">self</span>) -&gt; <span class=\"tok-type\">Int</span> [\n        <span class=\"tok-kw\">end self</span>.x + <span class=\"tok-kw\">self</span>.y\n    ]\n]\n\n<span class=\"tok-kw\">let</span> p = Point(1, 2)\nlog(p.sum())</code></pre>\n      </div>\n      <p class=\"mono\" style=\"font-size:.85rem\">Generyczne deklaracje <code>struct Box&lt;T&gt;</code> / <code>fun map&lt;T,U&gt;</code> jeszcze nie istnieją <span class=\"status-pill planned\">planowane</span> — <code>List&lt;T&gt;</code>/<code>Dict&lt;K,V&gt;</code> działają jako <em>użycie</em> generyków, nie deklaracja własnych.</p>\n    </section>\n\n    <section class=\"doc-section\" id=\"enum-match\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>Enum i match</h2>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"enum-code\">Kopiuj</button></div>\n        <pre id=\"enum-code\"><code><span class=\"tok-kw\">enum</span> Shape [\n    Circle(<span class=\"tok-type\">Float</span>),\n    Rectangle(<span class=\"tok-type\">Float</span>, <span class=\"tok-type\">Float</span>),\n    Empty\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">area</span>(s: Shape) -&gt; <span class=\"tok-type\">Float</span> [\n    <span class=\"tok-kw\">match</span> s [\n        Circle(r) -&gt; [ <span class=\"tok-kw\">end</span> 3.14159 * r * r ]\n        Rectangle(w, h) -&gt; [ <span class=\"tok-kw\">end</span> w * h ]\n        _ -&gt; [ <span class=\"tok-kw\">end</span> 0.0 ]\n    ]\n]</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"sterowanie\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>Sterowanie przepływem</h2>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"flow-code\">Kopiuj</button></div>\n        <pre id=\"flow-code\"><code><span class=\"tok-kw\">if</span> n &gt; 0 [\n    log(<span class=\"tok-str\">\"dodatnie\"</span>)\n] <span class=\"tok-kw\">elif</span> n &lt; 0 [\n    log(<span class=\"tok-str\">\"ujemne\"</span>)\n] <span class=\"tok-kw\">else</span> [\n    log(<span class=\"tok-str\">\"zero\"</span>)\n]\n\n<span class=\"tok-kw\">let</span> i = 0\n<span class=\"tok-kw\">while</span> i &lt; 5 [\n    log(i)\n    i = i + 1\n]\n\n<span class=\"tok-kw\">for</span> jezyk <span class=\"tok-kw\">in</span> [<span class=\"tok-str\">\"Python\"</span>, <span class=\"tok-str\">\"Rust\"</span>, <span class=\"tok-str\">\"HackerScript\"</span>] [\n    log(jezyk)\n]</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"direct-manual\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>direct i manual</h2>\n      <p><code>direct" + " [ ... ]</code> uruchamia surowy Python w trakcie działania programu (PyO3). <code>manual [ ... ]</code> transpiluje się do <code>unsafe { ... }</code> w wygenerowanym Ruście — do użycia świadomie.</p>\n    </section>\n\n    <section class=\"doc-section\" id=\"native-js\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>native" + " {JavaScript}</h2>\n      <p>Statycznie linkowany silnik JS — <strong>QuickJS przez <code>rquickjs</code></strong> (kompilowany przez <code>cc</code>, nie zewnętrzny interpreter). <code>console.log(...)</code> jest polyfillem dopisywanym przez kompilator.</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"native-code\">Kopiuj</button></div>\n        <pre id=\"native-code\"><code><span class=\"tok-kw\">native</span> {JavaScript} [\n    <span class=\"tok-kw\">const</span> dane = { jezyk: <span class=\"tok-str\">\"JavaScript\"</span>, dziala: <span class=\"tok-kw\">true</span> };\n    console.log(JSON.stringify(dane));\n]\n\n<span class=\"tok-com\">// import zewnetrznego pliku (sciezka wzgledna do .hcs)</span>\n<span class=\"tok-kw\">native</span> {JavaScript} &lt;lib/utils.js&gt; [\n    console.log(funkcjaZUtilsJs());\n]</code></pre>\n      </div>\n      <p class=\"mono\" style=\"font-size:.85rem\">Dziś tylko silnik <code>\"JavaScript\"</code> — inna nazwa daje komentarz, bez błędu kompilacji.</p>\n    </section>\n\n    <section class=\"doc-section\" id=\"sandbox\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>$ polecenie $ — Zero-Cost Sandbox</h2>\n      <p>Uruchamia polecenie powłoki w izolacji <strong>sieci i systemu plików</strong> przez <code>libc::unshare(CLONE_NEWNET|CLONE_NEWNS)</code> + bind-remount <code>/</code> na read-only — zero zewnętrznych narzędzi (firejail/bwrap). Brak uprawnień → ostrzeżenie na stderr, polecenie i tak działa, ale bez izolacji (nigdy cichy fejl).</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"sandbox-code\">Kopiuj</button></div>\n        <pre id=\"sandbox-code\"><code>$\nwhoami\necho \"brak dostepu do sieci hosta i zapisu do /\"\n$</code></pre>\n      </div>\n      <div class=\"note\"><strong>Ograniczenia:</strong> izoluje tylko ten podproces (nie resztę programu); polecenie nie może zawierać dosłownego <code>$</code> (np. <code>$HOME</code>) — zamyka blok na pierwszym napotkanym.</div>\n    </section>\n\n    <section class=\"doc-section\" id=\"hot-reload\">\n      <span class=\"kicker\">Składnia</span>\n      <h2>@" + "hot_reload — podmiana kodu żywego procesu</h2>\n      <p>Funkcja oznaczona <code>@" + "hot_reload</code> trafia do osobnego, dynamicznie ładowanego <code>cdylib</code>. Wątek-obserwator śledzi plik <code>.hcs</code> i przy zmianie sam woła <code>hackerc build</code> + <code>cargo build --release</code>, po czym atomowo podmienia wskaźnik funkcji w <strong>działającym procesie</strong> — bez restartu.</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"hot-code\">Kopiuj</button></div>\n        <pre id=\"hot-code\"><code><span class=\"tok-kw\">@" + "hot_reload</span>\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">greet</span>() [\n    log(<span class=\"tok-str\">\"wersja 1\"</span>)\n    <span class=\"tok-kw\">end</span>\n]</code></pre>\n      </div>\n      <div class=\"note\"><strong>v1:</strong> tylko funkcje bez parametrów i bez wartości zwracanej, na najwyższym poziomie. Wymaga zmiennej środowiskowej <code>HKS_HOT_OUT_DIR</code> przy uruchomieniu (jawny błąd, jeśli brak) i ręcznego pierwszego builda <code>hotlib/</code>.</div>\n    </section>\n\n    <section class=\"doc-section\" id=\"moduly\">\n      <span class=\"kicker\">Moduły i pakiety</span>\n      <h2>System modułów (get)</h2>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>hcs</span><button class=\"copy-btn\" data-copy-target=\"mod-code\">Kopiuj</button></div>\n        <pre id=\"mod-code\"><code><span class=\"tok-kw\">get</span> &lt;core:memory::arena&gt; <span class=\"tok-kw\">import</span> &lt;arena_new::arena_alloc::arena_get&gt;\n<span class=\"tok-kw\">get</span> &lt;std:path&gt; <span class=\"tok-kw\">import</span> &lt;path_join&gt;\n<span class=\"tok-kw\">get</span> &lt;crates:serde&gt;   <span class=\"tok-com\">! prawdziwa zależność Cargo</span>\n<span class=\"tok-kw\">get</span> &lt;pypi:nazwa&gt;     <span class=\"tok-com\">! pobierane przez virus install</span></code></pre>\n      </div>\n      <table class=\"ref-table\">\n        <thead><tr><th>Prefiks</th><th>Źródło</th></tr></thead>\n        <tbody>\n          <tr><td><code>std:</code> / <code>core:</code></td><td><code>libs/std/lib/</code> / <code>libs/core/lib/</code> w tym repozytorium</td></tr>\n          <tr><td><code>crates:</code></td><td>prawdziwa zależność Cargo</td></tr>\n          <tr><td><code>pypi: / npm: / jsr:</code></td><td>pobierane bezpośrednio przez <code>virus install</code>, bez <code>pip</code>/<code>npm install</code></td></tr>\n          <tr><td><code>vira:</code></td><td>oficjalny rejestr <a href=\"https://vira.io\" target=\"_blank\" rel=\"noopener\">vira.io</a></td></tr>\n        </tbody>\n      </table>\n    </section>\n\n    <section class=\"doc-section\" id=\"manifest\">\n      <span class=\"kicker\">Moduły i pakiety</span>\n      <h2>Virus.hk</h2>\n      <p>Format <code>.hk</code> manifestu projektu — nie TOML, mimo podobnego wyglądu.</p>\n      <div class=\"code-block\">\n        <div class=\"code-label\"><span>Virus.hk</span><button class=\"copy-btn\" data-copy-target=\"manifest-code\">Kopiuj</button></div>\n        <pre id=\"manifest-code\"><code>[package]\nname = \"hello-world\"\nversion = \"0.0.1\"\nusing = \"0.1\"\nedition = \"2026\"\nauthors = [\"Twoje Imię\"]\n\n[dependencies]\n# \"pypi:rich\" = \"*\"\n\n[build]\nentry = \"cmd/main.hcs\"</code></pre>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"cli\">\n      <span class=\"kicker\">Narzędzia</span>\n      <h2>CLI: hackerc i virus</h2>\n      <table class=\"ref-table\">\n        <thead><tr><th>Komenda</th><th>Co robi</th></tr></thead>\n        <tbody>\n          <tr><td><code>hackerc check plik.hcs</code></td><td>parsuje + typechecking, bez generowania Rusta</td></tr>\n          <tr><td><code>hackerc build plik.hcs -o dir</code></td><td>generuje crate Cargo w <code>dir</code></td></tr>\n          <tr><td><code>virus init --name x</code></td><td>tworzy nowy projekt z <code>Virus.hk</code></td></tr>\n          <tr><td><code>virus build --release</code></td><td>pobiera właściwy <code>hackerc</code> wg <code>using</code>, buduje</td></tr>\n          <tr><td><code>virus install &lt;pakiet&gt;</code></td><td>pobiera zależność z PyPI/crates.io/npm/JSR/Vira</td></tr>\n          <tr><td><code>virus fmt [--check]</code></td><td>formatuje (lub sprawdza formatowanie) plików <code>.hcs</code></td></tr>\n          <tr><td><code>virus lint</code></td><td>uruchamia diagnostyki <code>hackerc</code> na projekcie</td></tr>\n        </tbody>\n      </table>\n      <p>Kolorowe wyjście (zielony = sukces, czerwony = błąd, cyan = nazwy) wyłącza się automatycznie, gdy ustawiona jest zmienna środowiskowa <code>NO_COLOR</code>.</p>\n    </section>\n\n    <section class=\"doc-section\" id=\"biblioteka\">\n      <span class=\"kicker\">Narzędzia</span>\n      <h2>Biblioteka standardowa</h2>\n      <div class=\"grid-cards\">\n        <div class=\"card\"><h4>fs / io / path</h4><p>System plików, wejście-wyjście, operacje na ścieżkach.</p></div>\n        <div class=\"card\"><h4>string / math</h4><p>Operacje tekstowe i matematyczne.</p></div>\n        <div class=\"card\"><h4>json / toml / hk</h4><p>Parsery formatów danych, w tym własnego formatu manifestu.</p></div>\n        <div class=\"card\"><h4>http / process / env</h4><p>Zapytania HTTP, uruchamianie poleceń, zmienne środowiskowe.</p></div>\n        <div class=\"card\"><h4>term</h4><p>Kolorowe CLI i pasek postępu renderowany w miejscu.</p></div>\n        <div class=\"card\"><h4>result</h4><p>Pomocnicze funkcje dla <code>Result&lt;T,E&gt;</code>.</p></div>\n        <div class=\"card\"><h4>cybersecurity</h4><p><code>constant_time_eq</code>, <code>shannon_entropy</code>.</p></div>\n        <div class=\"card\"><h4>core/memory</h4><p>Cztery alokatory: arena, chained_arena, stack_allocator, pool_allocator.</p></div>\n      </div>\n    </section>\n\n    <section class=\"doc-section\" id=\"roadmap\">\n      <span class=\"kicker\">Projekt</span>\n      <h2>Roadmap</h2>\n      <p>Pełna, szczegółowa wersja: <code>docs/ROADMAP.md</code> w repozytorium. Skrót stanu:</p>\n      <table class=\"ref-table\">\n        <thead><tr><th>Funkcja</th><th>Status</th></tr></thead>\n        <tbody>\n          <tr><td><code>direct" + " [ ... ]</code> (Python przez PyO3)</td><td><span class=\"status-pill ok\">naprawione i zweryfikowane</span></td></tr>\n          <tr><td><code>native" + " {JavaScript} [ ... ]</code> (QuickJS, statyczne linkowanie)</td><td><span class=\"status-pill ok\">nowe, zweryfikowane</span></td></tr>\n          <tr><td><code>native" + " {JavaScript} &lt;plik.js&gt;</code> (import)</td><td><span class=\"status-pill ok\">nowe, zweryfikowane</span></td></tr>\n          <tr><td><code>$ polecenie $</code> (Zero-Cost Sandbox)</td><td><span class=\"status-pill ok\">nowe, zweryfikowane</span></td></tr>\n          <tr><td><code>@" + "hot_reload</code> (podmiana kodu żywego procesu)</td><td><span class=\"status-pill ok\">nowe, zweryfikowane</span></td></tr>\n          <tr><td><code>get &lt;crates:nazwa::wersja&gt;</code></td><td><span class=\"status-pill ok\">działa, zweryfikowane</span></td></tr>\n          <tr><td><code>get &lt;pypi:nazwa&gt;</code> (tylko wewnątrz <code>direct</code>)</td><td><span class=\"status-pill ok\">działa, zweryfikowane</span></td></tr>\n          <tr><td><code>get &lt;npm:...&gt;</code> / <code>get &lt;jsr:...&gt;</code></td><td><span class=\"status-pill wip\">tylko komentarz, bez importu</span></td></tr>\n          <tr><td><code>virus install</code> (realne pobieranie)</td><td><span class=\"status-pill wip\">niezweryfikowane w tym środowisku</span></td></tr>\n          <tr><td>Linia/kolumna w błędach parsera</td><td><span class=\"status-pill ok\">naprawione i zweryfikowane</span></td></tr>\n          <tr><td>Numery linii w węzłach AST (dla <code>typecheck.hcs</code>)</td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>Iteracja po <code>Dict</code></td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>Typ <code>Set&lt;T&gt;</code></td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td><code>log()</code> dla struct/enum</td><td><span class=\"status-pill wip\">częściowe</span></td></tr>\n          <tr><td>Generyczne <code>fun&lt;T&gt;</code> / <code>struct&lt;T&gt;</code></td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>Trait / interface</td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td><code>virus test</code> + <code>#[test]</code></td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>REPL</td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>LSP</td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>Checksumy/lockfile w <code>virus install</code></td><td><span class=\"status-pill planned\">planowane</span></td></tr>\n          <tr><td>Backend Cranelift</td><td><span class=\"status-pill planned\" style=\"text-decoration:line-through;opacity:.6\">zdjęte z planów</span></td></tr>\n        </tbody>\n      </table>\n    </section>\n\n  </main>\n</div>\n\n<footer class=\"site-footer\">\n  <span>HackerScript © 2026 HackerOS Team — MIT</span>\n  <span>Wygenerowano z <code>hackerc/</code>, <code>virus/</code>, <code>docs/</code> tego repozytorium.</span>\n</footer>"

fun main() [
    boot_begin("pl", "HackerScript — dokumentacja")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("meta", ["name", "description", "content", "Dokumentacja języka HackerScript: fun kompiluje się do prawdziwego Rusta, direct" + "[...] wykonuje czysty Python w locie."])
    boot_body(PAGE_BODY)
    hackerscript_docs_init()
]
