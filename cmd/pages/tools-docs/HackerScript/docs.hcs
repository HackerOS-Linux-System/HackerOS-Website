use <mode:website>

include <../../../logic/docsites>

!! Strona dokumentacji HackerScript. Wygląd dopasowany do logo (grafit + srebro).
!! Treść jest generowana ze wspólnego źródła razem z docs/*.md w repozytorium HackerScript.

style {
#app { display: none; }
@import url('https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,400;0,600;1,700;1,800&family=JetBrains+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap');

/* ── Paleta z logo: grafit (litera H) + srebro (litera S) na bieli ───────── */
:root{
  --bg:#f6f6f7;
  --surface:#ffffff;
  --surface-2:#efeff1;
  --line:#d9d9dc;
  --line-strong:#b9b9be;
  --ink:#232325;
  --graphite:#3b3b3e;
  --graphite-2:#5a5a5e;
  --silver:#a9a9ae;
  --silver-2:#cfcfd3;
  --muted:#6d6d72;
  --code-bg:#1d1d20;
  --code-bar:#2a2a2e;
  --code-ink:#e4e4e7;
  --code-dim:#8c8c93;
  --metal:linear-gradient(135deg,#6b6b6f 0%,#3b3b3e 55%,#2a2a2d 100%);
  --metal-light:linear-gradient(135deg,#ffffff 0%,#e3e3e6 50%,#bdbdc2 100%);
  --shadow:0 1px 2px rgba(0,0,0,.06),0 6px 18px rgba(0,0,0,.05);
  --radius:4px;
  --skew:-9deg;
  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
  --sans:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  --display:'Exo 2','Segoe UI',system-ui,sans-serif;
  --logo-filter:none;
  --logo-blend:multiply;
}
:root[data-theme="dark"]{
  --bg:#141416; --surface:#1b1b1e; --surface-2:#242427; --line:#323236; --line-strong:#4a4a50;
  --ink:#f1f1f3; --graphite:#e4e4e7; --graphite-2:#c3c3c8; --silver:#8e8e95; --silver-2:#56565c;
  --muted:#a0a0a7; --code-bg:#0f0f11; --code-bar:#19191c;
  --metal:linear-gradient(135deg,#f4f4f6 0%,#cfcfd3 55%,#a9a9ae 100%);
  --metal-light:linear-gradient(135deg,#34343a 0%,#26262a 50%,#1b1b1e 100%);
  --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px rgba(0,0,0,.35);
  --logo-filter:invert(1);
  --logo-blend:screen;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#141416; --surface:#1b1b1e; --surface-2:#242427; --line:#323236; --line-strong:#4a4a50;
    --ink:#f1f1f3; --graphite:#e4e4e7; --graphite-2:#c3c3c8; --silver:#8e8e95; --silver-2:#56565c;
    --muted:#a0a0a7; --code-bg:#0f0f11; --code-bar:#19191c;
    --metal:linear-gradient(135deg,#f4f4f6 0%,#cfcfd3 55%,#a9a9ae 100%);
    --metal-light:linear-gradient(135deg,#34343a 0%,#26262a 50%,#1b1b1e 100%);
    --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px rgba(0,0,0,.35);
    --logo-filter:invert(1);
    --logo-blend:screen;
  }
}

*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
body{
  margin:0; background:var(--bg); color:var(--graphite);
  font-family:var(--sans); font-size:16px; line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
::selection{ background:var(--graphite); color:var(--bg); }
a{ color:var(--ink); text-decoration:underline; text-decoration-color:var(--silver); text-underline-offset:3px; }
a:hover{ text-decoration-color:var(--ink); }
code,pre,.mono{ font-family:var(--mono); }
:not(pre) > code{
  background:var(--surface-2); border:1px solid var(--line); color:var(--ink);
  padding:.08em .38em; border-radius:3px; font-size:.86em; word-break:break-word;
}

.skip-link{ position:absolute; left:-999px; top:0; background:var(--ink); color:var(--bg); padding:.6rem 1rem; z-index:200; }
.skip-link:focus{ left:1rem; top:1rem; }
a:focus-visible,button:focus-visible,input:focus-visible{ outline:2px solid var(--ink); outline-offset:2px; }

/* ── Pasek górny ─────────────────────────────────────────────────────────── */
.topbar{
  position:sticky; top:0; z-index:100; height:62px;
  display:flex; align-items:center; gap:1rem; padding:0 1.25rem;
  background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(8px); border-bottom:1px solid var(--line);
}
.topbar::after{            /* cienka metaliczna krawędź */
  content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px;
  background:linear-gradient(90deg,transparent 0%,var(--silver) 20%,var(--graphite-2) 55%,transparent 100%);
  opacity:.7;
}
.brand{ display:flex; align-items:center; gap:.7rem; color:var(--ink); text-decoration:none; }
.brand:hover{ text-decoration:none; }
.brand img{ height:50px; width:96px; object-fit:cover; object-position:50% 52%; display:block; mix-blend-mode:var(--logo-blend); filter:var(--logo-filter); }
.ver{
  font-family:var(--display); font-style:italic; font-weight:700; font-size:.78rem;
  color:var(--bg); background:var(--metal); padding:.12rem .6rem; transform:skewX(var(--skew));
  display:inline-block;
}
.ver > span{ display:inline-block; transform:skewX(calc(-1 * var(--skew))); }
.spacer{ flex:1; }
.nav-toggle{
  display:none; background:none; border:1px solid var(--line); width:40px; height:40px;
  border-radius:var(--radius); cursor:pointer;
}
.nav-toggle span{ display:block; width:16px; height:2px; background:var(--graphite); margin:3px auto; }
.icon-btn,.gh-link{
  font-family:var(--mono); font-size:.8rem; color:var(--graphite-2); background:var(--surface);
  border:1px solid var(--line); padding:.4rem .75rem; border-radius:var(--radius); cursor:pointer; text-decoration:none;
}
.icon-btn:hover,.gh-link:hover{ color:var(--ink); border-color:var(--graphite-2); text-decoration:none; }

/* ── Układ ───────────────────────────────────────────────────────────────── */
.layout{ display:grid; grid-template-columns:272px minmax(0,1fr); max-width:1320px; margin:0 auto; }
.sidebar{
  position:sticky; top:62px; align-self:start; height:calc(100vh - 62px); overflow-y:auto;
  padding:1.5rem 1rem 2.5rem 1.25rem; border-right:1px solid var(--line);
}
.sidebar h3{
  font-family:var(--display); font-style:italic; font-weight:800; font-size:.8rem;
  letter-spacing:.06em; text-transform:uppercase; color:var(--ink);
  margin:1.6rem 0 .5rem; display:flex; align-items:center; gap:.5rem;
}
.sidebar h3::before{        /* trzy „linie prędkości” z logo */
  content:""; width:18px; height:10px; flex:none;
  background:
    linear-gradient(90deg,var(--silver),transparent) 0 0/100% 2px no-repeat,
    linear-gradient(90deg,var(--graphite-2),transparent) 4px 4px/100% 2px no-repeat,
    linear-gradient(90deg,var(--silver),transparent) 1px 8px/100% 2px no-repeat;
}
.sidebar h3:first-of-type{ margin-top:1rem; }
.sidebar ul{ list-style:none; margin:0; padding:0; }
.sidebar li a{
  display:block; padding:.3rem .65rem; margin:.04rem 0; color:var(--muted); font-size:.88rem;
  text-decoration:none; border-left:2px solid transparent;
}
.sidebar li a:hover{ color:var(--ink); background:var(--surface-2); }
.sidebar li a.active{ color:var(--ink); font-weight:600; border-left-color:var(--ink); background:var(--surface-2); }
.sidebar li.no-match{ display:none; }
.search-wrap{ position:relative; }
.search-wrap input{
  width:100%; background:var(--surface); border:1px solid var(--line); color:var(--ink);
  font-family:var(--mono); font-size:.85rem; padding:.55rem .8rem .55rem 2rem; border-radius:var(--radius);
}
.search-wrap input:focus{ outline:none; border-color:var(--graphite-2); }
.search-wrap::before{
  content:'/'; position:absolute; left:.8rem; top:50%; transform:translateY(-50%);
  color:var(--silver); font-family:var(--mono); font-size:.85rem; pointer-events:none;
}
main{ min-width:0; padding:0 2.5rem 6rem; }

/* ── Hero ────────────────────────────────────────────────────────────────── */
.hero{
  position:relative; padding:3.5rem 0 3rem; margin-bottom:2.5rem; border-bottom:1px solid var(--line); overflow:hidden;
}
.hero .speed{                /* dekoracja: linie prędkości jak w logo */
  position:absolute; right:-40px; top:2.2rem; width:min(46%,420px); height:130px; pointer-events:none; opacity:.9;
}
.hero .speed i{
  position:absolute; right:0; height:13px; transform:skewX(-35deg);
  background:linear-gradient(90deg,transparent,var(--silver-2) 40%,var(--silver));
  border-radius:2px;
}
.hero .speed i:nth-child(1){ top:0; width:78%; }
.hero .speed i:nth-child(2){ top:34px; width:100%; background:linear-gradient(90deg,transparent,var(--silver) 40%,var(--graphite-2)); }
.hero .speed i:nth-child(3){ top:68px; width:62%; }
.eyebrow-line{ display:flex; align-items:center; gap:.6rem; font-family:var(--mono); font-size:.8rem; color:var(--muted); margin-bottom:1rem; position:relative; }
.eyebrow-line .dot{ width:8px; height:8px; background:var(--graphite); transform:skewX(-20deg); }
.hero h1{
  position:relative; font-family:var(--display); font-style:italic; font-weight:800;
  font-size:clamp(2.2rem,5.4vw,3.7rem); line-height:1.04; margin:0 0 1.1rem; color:var(--ink); max-width:17ch; letter-spacing:-.01em;
}
.hero h1 .accent{
  background:var(--metal); -webkit-background-clip:text; background-clip:text; color:transparent;
  -webkit-text-fill-color:transparent;
}
.hero p.lede{ position:relative; max-width:60ch; font-size:1.08rem; color:var(--graphite-2); margin:0 0 1.8rem; }
.hero-actions{ display:flex; gap:.8rem; flex-wrap:wrap; margin-bottom:2.2rem; position:relative; }
.btn{
  font-family:var(--display); font-style:italic; font-weight:700; font-size:.95rem; letter-spacing:.02em;
  display:inline-block; padding:.65rem 1.5rem; color:var(--ink); background:var(--surface);
  border:1px solid var(--line-strong); text-decoration:none; transform:skewX(var(--skew)); cursor:pointer;
}
.btn > span{ display:inline-block; transform:skewX(calc(-1 * var(--skew))); }
.btn:hover{ border-color:var(--ink); text-decoration:none; }
.btn.primary{ background:var(--metal); color:var(--bg); border-color:transparent; box-shadow:var(--shadow); }
.btn.primary:hover{ filter:brightness(1.12); }

/* ── Sekcje ──────────────────────────────────────────────────────────────── */
section.doc-section{ padding-top:2.5rem; margin-top:-2rem; scroll-margin-top:40px; }
section.doc-section > .kicker{
  font-family:var(--mono); font-size:.74rem; color:var(--muted); text-transform:uppercase; letter-spacing:.1em; display:block;
}
section.doc-section h2{
  font-family:var(--display); font-style:italic; font-weight:800; font-size:1.9rem; line-height:1.15;
  color:var(--ink); margin:.15rem 0 .9rem; scroll-margin-top:76px; padding-bottom:.55rem; position:relative;
}
section.doc-section h2::after{
  content:""; position:absolute; left:0; bottom:0; width:120px; height:4px; transform:skewX(-35deg);
  background:linear-gradient(90deg,var(--graphite),var(--silver) 70%,transparent);
}
section.doc-section h3{
  font-family:var(--display); font-style:italic; font-weight:700; font-size:1.15rem; color:var(--ink);
  margin:2.1rem 0 .55rem; scroll-margin-top:76px;
}
section.doc-section p{ max-width:72ch; margin:.6rem 0; }
section.doc-section ul,section.doc-section ol{ max-width:72ch; padding-left:1.3rem; }
section.doc-section li{ margin:.35rem 0; }
section.doc-section li::marker{ color:var(--silver); }

.grid-cards{ display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:1rem; margin:1.5rem 0 2rem; }
.card{
  position:relative; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
  padding:1.05rem 1.15rem 1.05rem 1.3rem; box-shadow:var(--shadow);
}
.card::before{ content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--metal); }
.card h4{ margin:0 0 .35rem; font-family:var(--display); font-style:italic; font-weight:700; font-size:1rem; color:var(--ink); }
.card p{ margin:0; font-size:.87rem; color:var(--muted); }

/* ── Kod (zawsze grafitowy, jak litera H) ────────────────────────────────── */
.code-block{
  background:var(--code-bg); border:1px solid #000; border-radius:var(--radius);
  margin:1.1rem 0 1.7rem; overflow:hidden; box-shadow:var(--shadow);
}
:root[data-theme="dark"] .code-block{ border-color:var(--line); }
.code-label{
  display:flex; justify-content:space-between; align-items:center; padding:.45rem .85rem;
  background:var(--code-bar); border-bottom:1px solid #000; font-family:var(--mono); font-size:.74rem; color:var(--code-dim);
}
.copy-btn{
  background:none; border:1px solid #4a4a50; color:#b5b5bb; font-family:var(--mono); font-size:.72rem;
  padding:.22rem .6rem; border-radius:3px; cursor:pointer;
}
.copy-btn:hover{ color:#fff; border-color:#9a9aa0; }
.copy-btn.copied{ color:#fff; border-color:#fff; }
.code-block pre{ margin:0; padding:1rem 1.15rem; overflow-x:auto; font-size:.84rem; line-height:1.65; }
.code-block code{ color:var(--code-ink); background:none; border:0; padding:0; font-size:inherit; }
.tok-kw{ color:#ffffff; font-weight:600; }
.tok-str{ color:#c6c6cc; }
.tok-com{ color:#7c7c84; font-style:italic; }
.tok-type{ color:#a9a9b0; text-decoration:underline; text-decoration-color:#55555b; text-underline-offset:3px; }
.tok-fn{ color:#ececef; font-style:italic; }
.tok-num{ color:#d4d4d8; }

/* ── Tabele ──────────────────────────────────────────────────────────────── */
.table-wrap{ overflow-x:auto; margin:1.2rem 0 2rem; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); box-shadow:var(--shadow); }
table.ref-table{ width:100%; border-collapse:collapse; font-size:.88rem; }
.ref-table th{
  text-align:left; font-family:var(--display); font-style:italic; font-weight:700; font-size:.82rem; letter-spacing:.04em;
  color:var(--bg); background:var(--metal); padding:.6rem .8rem; white-space:nowrap;
}
.ref-table td{ padding:.55rem .8rem; border-top:1px solid var(--line); vertical-align:top; }
.ref-table tbody tr:nth-child(even) td{ background:var(--surface-2); }
.ref-table tbody tr:hover td{ background:color-mix(in srgb,var(--silver-2) 35%,transparent); }
.ref-table td:first-child{ white-space:normal; }

.status-pill{
  display:inline-block; font-family:var(--mono); font-size:.72rem; padding:.12rem .55rem; border:1px solid; border-radius:2px;
  transform:skewX(var(--skew));
}
.status-pill.ok{ background:var(--graphite); color:var(--bg); border-color:var(--graphite); }
.status-pill.wip{ color:var(--graphite); border-color:var(--graphite-2); background:repeating-linear-gradient(135deg,transparent 0 5px,var(--silver-2) 5px 6px); }
.status-pill.planned{ color:var(--muted); border-color:var(--silver); border-style:dashed; }
.status-pill.gone{ color:var(--silver); border-color:var(--silver-2); text-decoration:line-through; }
:root[data-theme="dark"] .status-pill.ok{ background:var(--graphite); color:#141416; }

.note{
  position:relative; background:var(--surface); border:1px solid var(--line); border-left:4px solid var(--graphite-2);
  padding:.85rem 1.1rem; margin:1.3rem 0; border-radius:0 var(--radius) var(--radius) 0; font-size:.92rem; max-width:76ch;
}
.note .note-title{ font-family:var(--display); font-style:italic; font-weight:800; color:var(--ink); margin-right:.4rem; }
.note.warn{ border-left-color:var(--ink); background:repeating-linear-gradient(135deg,var(--surface) 0 14px,var(--surface-2) 14px 15px); }
.note.tip{ border-left-color:var(--silver); }

/* ── Stopka ──────────────────────────────────────────────────────────────── */
footer.site-footer{
  border-top:1px solid var(--line); margin-top:3rem; padding:2.2rem 2.5rem; font-size:.85rem; color:var(--muted);
  max-width:1320px; margin-left:auto; margin-right:auto; display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem; align-items:center;
}
footer.site-footer img{ height:50px; width:96px; object-fit:cover; object-position:50% 52%; mix-blend-mode:var(--logo-blend); filter:var(--logo-filter); }

/* ── Responsywność ───────────────────────────────────────────────────────── */
@media (max-width:980px){ .hero .speed{ display:none; } }
@media (max-width:860px){
  .layout{ grid-template-columns:1fr; }
  .sidebar{
    position:fixed; inset:62px 0 0 0; height:auto; background:var(--bg); z-index:90;
    transform:translateX(-100%); transition:transform .18s ease; width:100%; border-right:none;
  }
  .sidebar.open{ transform:translateX(0); }
  .nav-toggle{ display:block; }
  main{ padding:0 1.1rem 4rem; }
  .hero{ padding:2.2rem 0 2rem; }
  .gh-link{ display:none; }
}
@media (prefers-reduced-motion:reduce){ html{ scroll-behavior:auto; } .sidebar{ transition:none; } }
@media print{
  .topbar,.sidebar,.hero .speed,.copy-btn{ display:none !important; }
  .layout{ display:block; } main{ padding:0; } body{ background:#fff; color:#000; }
  .code-block{ box-shadow:none; }
}
}

let PAGE_BODY: Str = "<a class=\"skip-link\" href=\"#content\">Przejdź do treści</a>\n\n<header class=\"topbar\">\n  <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Otwórz nawigację\" aria-expanded=\"false\"><span></span><span></span><span></span></button>\n  <a class=\"brand\" href=\"#top\" aria-label=\"HackerScript\"><img src=\"https://raw.githubusercontent.com/HackerOS-Linux-System/HackerScript/main/images/icon.png\" alt=\"HackerScript\" width=\"96\" height=\"50\" class=\"logo-img\"><span class=\"ver\"><span>v0.6</span></span></a>\n  <div class=\"spacer\"></div>\n  <button class=\"icon-btn\" id=\"themeToggle\" type=\"button\" aria-label=\"Przełącz motyw jasny/ciemny\">◐ motyw</button>\n  <a class=\"gh-link\" href=\"https://github.com/HackerOS-Linux-System/HackerScript\" target=\"_blank\" rel=\"noopener\">Repozytorium ↗</a>\n</header>\n\n<div class=\"layout\" id=\"top\">\n  <nav class=\"sidebar\" id=\"sidebar\" aria-label=\"Nawigacja dokumentacji\">\n<div class=\"search-wrap\"><input type=\"text\" id=\"docSearch\" placeholder=\"Szukaj w dokumentacji…\" aria-label=\"Szukaj w dokumentacji\"></div>\n<h3>Start</h3>\n<ul><li><a href=\"#wprowadzenie\">Wprowadzenie</a></li><li><a href=\"#instalacja\">Instalacja</a></li><li><a href=\"#pierwszy-projekt\">Pierwszy projekt</a></li><li><a href=\"#tour\">Szybki przegląd języka</a></li></ul>\n<h3>Język</h3>\n<ul><li><a href=\"#komentarze-literaly\">Komentarze i literały</a></li><li><a href=\"#zmienne-typy\">Zmienne i typy</a></li><li><a href=\"#operatory\">Operatory i wyrażenia</a></li><li><a href=\"#funkcje\">Funkcje</a></li><li><a href=\"#struct-impl\">Struktury i impl</a></li><li><a href=\"#enum-match\">Enum i match</a></li><li><a href=\"#sterowanie\">Sterowanie przepływem</a></li><li><a href=\"#kolekcje\">Kolekcje i napisy</a></li><li><a href=\"#option-result\">Option, Result i operator ?</a></li><li><a href=\"#async\">Współbieżność: async, await, spawn, chan</a></li><li><a href=\"#wbudowane\">Funkcje wbudowane</a></li><li><a href=\"#direct-manual\">direct, f" + "ast direct i manual</a></li><li><a href=\"#native-js\">n" + "ative { ... } — kod w innym języku</a></li><li><a href=\"#sandbox\">$ polecenie $ — Zero-Cost Sandbox</a></li><li><a href=\"#hot-reload\">Atrybuty: @" + "hot_reload i @" + "wasm_export</a></li></ul>\n<h3>Moduły i pakiety</h3>\n<ul><li><a href=\"#moduly\">System modułów: get i include</a></li><li><a href=\"#manifest\">Bit.hk — manifest i workspace</a></li><li><a href=\"#wersje-using\">using — wersja języka per plik</a></li><li><a href=\"#hlib\">Archiwa .hlib</a></li></ul>\n<h3>Cele kompilacji</h3>\n<ul><li><a href=\"#cele\">Dyrektywy use: lang, mode, os</a></li><li><a href=\"#backend-js\">Backend JavaScript</a></li><li><a href=\"#tryb-strony\">Tryb strony: u" + "se &lt;mode:website&gt;</a></li><li><a href=\"#ffi\">FFI: extern, region, C i C++</a></li><li><a href=\"#wasm\">Playground i WASM</a></li></ul>\n<h3>Narzędzia</h3>\n<ul><li><a href=\"#cli\">CLI: hackerc</a></li><li><a href=\"#hack3rc\">Kompilator AOT: hack3rc</a></li><li><a href=\"#lsp\">Language Server (LSP)</a></li><li><a href=\"#wydajnosc\">Wydajność i cache budowania</a></li><li><a href=\"#diagnostyki\">Diagnostyki i kody błędów</a></li></ul>\n<h3>Biblioteka</h3>\n<ul><li><a href=\"#biblioteka\">Biblioteka standardowa — przegląd</a></li><li><a href=\"#std-tekst\">std: string, math, path, result</a></li><li><a href=\"#std-system\">std: fs, io, env, process, http, os</a></li><li><a href=\"#std-dane\">std: json, toml, hk, term</a></li><li><a href=\"#std-security\">std: cybersecurity</a></li><li><a href=\"#core-memory\">core: alokatory pamięci</a></li></ul>\n<h3>Projekt</h3>\n<ul><li><a href=\"#historia\">Historia wersji</a></li><li><a href=\"#roadmap\">Roadmap i status</a></li><li><a href=\"#faq\">Najczęstsze pytania</a></li></ul>\n  </nav>\n\n  <main id=\"content\">\n    <section class=\"hero\">\n      <div class=\"speed\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n      <div class=\"eyebrow-line\"><span class=\"dot\"></span> wersja 0.6 · self-hosting · licencja MIT</div>\n      <h1>Zwykła <span class=\"accent\">fun</span> kompiluje się do prawdziwego Rusta.</h1>\n      <p class=\"lede\">HackerScript to język ogólnego przeznaczenia o prostej, nawiasowej składni: statyczne typy i bezpieczeństwo pamięci Rusta na co dzień, a ten sam kod możesz skierować na JavaScript, statyczną stronę WWW albo natywny plik przez kompilator AOT.</p>\n      <div class=\"hero-actions\">\n        <a class=\"btn primary\" href=\"#instalacja\"><span>Zacznij →</span></a>\n        <a class=\"btn\" href=\"#tour\"><span>Szybki przegląd</span></a>\n        <a class=\"btn\" href=\"#biblioteka\"><span>Biblioteka</span></a>\n      </div>\n      <div class=\"code-block\" style=\"max-width:560px\">\n        <div class=\"code-label\"><span>cmd/main.hcs</span></div>\n        <pre><code><span class=\"tok-kw\">struct</span> <span class=\"tok-type\">Point</span> [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">distance_squared</span>(p: Point) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">end</span> (p.x * p.x) + (p.y * p.y)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> p = Point(<span class=\"tok-num\">3</span>, <span class=\"tok-num\">4</span>)\n    log(<span class=\"tok-str\">\"dist^2 =\"</span>, distance_squared(p))\n]</code></pre>\n      </div>\n    </section>\n\n<section class=\"doc-section\" id=\"wprowadzenie\">\n  <span class=\"kicker\">Start</span>\n  <h2>Wprowadzenie</h2>\n  <p><strong>HackerScript</strong> to język programowania ogólnego przeznaczenia o prostej, nawiasowej składni: bloki ujmujesz w <code>[ ... ]</code>, wartość z funkcji zwracasz słowem <code>end</code>, a komentarze zaczynasz od <code>!!</code>. Zwykła <code>fun</code> kompiluje się do <strong>prawdziwego Rusta</strong> (statyczne typy, bezpieczeństwo pamięci, abstrakcje bez narzutu), ale ten sam kod można też skierować na inne cele: JavaScript, statyczną stronę WWW albo natywny plik wykonywalny przez kompilator AOT.</p><div class=\"code-block\"><div class=\"code-label\"><span>cmd/main.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-1\">Kopiuj</button></div><pre id=\"code-1\"><code><span class=\"tok-kw\">struct</span> <span class=\"tok-type\">Point</span> [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">distance_squared</span>(p: Point) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">end</span> (p.x * p.x) + (p.y * p.y)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> p = Point(<span class=\"tok-num\">3</span>, <span class=\"tok-num\">4</span>)\n    log(<span class=\"tok-str\">\"dist^2 =\"</span>, distance_squared(p))\n]</code></pre></div><p><code>hackerc</code> zamienia <code>struct</code> na <code>struct</code> + <code>impl new()</code>, <code>manual [ ... ]</code> na <code>unsafe { ... }</code>, a <code>List&lt;T&gt;</code> na <code>Vec&lt;T&gt;</code>. Parametry typu <code>struct</code>, <code>List</code> i <code>Str</code> automatycznie dostają <code>&amp;</code> / <code>&amp;mut</code> zamiast przenoszenia własności, więc nie musisz sam myśleć o pożyczaniu.</p><h3>Cele kompilacji</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Cel</th><th>Jak go wybrać</th><th>Wynik</th></tr></thead><tbody><tr><td>Rust (domyślnie)</td><td><code>hackerc build plik.hcs -o katalog</code></td><td>crate Cargo (<code>Cargo.toml</code> + <code>src/</code>), potem <code>cargo build</code></td></tr><tr><td>JavaScript</td><td><code>u" + "se &lt;lang:javascript&gt;</code> albo <code>hackerc js</code></td><td>pojedynczy plik <code>.js</code> (Node.js lub przeglądarka)</td></tr><tr><td>Strona WWW</td><td><code>u" + "se &lt;mode:website&gt;</code> albo <code>hackerc website</code></td><td><code>index.html</code> + <code>app.js</code>, bez serwera i bundlera</td></tr><tr><td>Natywny plik (AOT)</td><td><code>hack3rc plik.hcs</code></td><td>plik wykonywalny przez Cranelift, bez <code>cargo</code></td></tr><tr><td>Kotlin (eksperymentalny)</td><td><code>u" + "se &lt;lang:kotlin&gt;</code> albo <code>hackerc kotlin</code></td><td>plik <code>.kt</code></td></tr></tbody></table></div><div class=\"grid-cards\"><div class=\"card\"><h4>Samo-hostujący się</h4><p><code>hackerc</code> (transpilator) i <code>hack3rc</code> (kompilator AOT) są w całości napisane w HackerScript (<code>.hcs</code>).</p></div><div class=\"card\"><h4>Statyczne typy</h4><p>Lekser, parser, <code>typecheck</code> i <code>typeinfer</code> wyłapują błędy przed <code>rustc</code>; diagnostyki są w stylu rustc.</p></div><div class=\"card\"><h4>Kilka backendów</h4><p>Rust, JavaScript, strona WWW, Kotlin oraz natywny kod z <code>hack3rc</code>.</p></div><div class=\"card\"><h4>FFI bez bólu</h4><p>C, C++, Go, Java, Kotlin i JavaScript przez <code>get &lt;...&gt;</code> oraz <code>n" + "ative { ... }</code>.</p></div><div class=\"card\"><h4>Moduły i workspace</h4><p><code>get &lt;std:...&gt;</code>, <code>get &lt;work:...&gt;</code>, <code>include</code>, manifest <code>Bit.hk</code> i menedżer <code>bit</code>.</p></div><div class=\"card\"><h4>Narzędzia</h4><p>Formater, linter, Language Server (<code>hackerc lsp</code>), archiwa <code>.hlib</code>, playground WASM.</p></div></div>\n</section>\n\n<section class=\"doc-section\" id=\"instalacja\">\n  <span class=\"kicker\">Start</span>\n  <h2>Instalacja</h2>\n  <p><code>hackerc</code> i <code>hack3rc</code> to binarki natywne (self-hosted), więc najprościej pobrać gotowe wydanie z GitHub Releases. Do uruchomienia wygenerowanego programu Rust potrzebujesz zainstalowanego Rusta (<code>cargo</code>).</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-2\">Kopiuj</button></div><pre id=\"code-2\"><code>VERSION=0.6\ncurl -L --fail -o hackerc \\\n  https://github.com/HackerOS-Linux-System/HackerScript/releases/download/v$VERSION/hackerc\nchmod +x hackerc\n\n./hackerc --version\n./hackerc check docs/hello-world/cmd/main.hcs\n./hackerc build docs/hello-world/cmd/main.hcs -o /tmp/out\ncd /tmp/out &amp;&amp; cargo run          <span class=\"tok-com\"># wymaga Rusta</span></code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Jeśli wydanie o danym numerze nie jest jeszcze opublikowane w Releases (adres zwraca 404), użyj najnowszego dostępnego albo zbuduj <code>hackerc</code> ze źródeł (patrz niżej). Workflow strony HackerOS pobiera dziś <code>hackerc</code> w wersji <code>v0.5</code>.</div><h3>Budowanie ze źródeł</h3><p>Kompilator jest napisany w HackerScript, więc do zbudowania nowego <code>hackerc</code> potrzebny jest starszy <code>hackerc</code> (co najmniej 0.4; dla <code>hack3rc</code> — wersja z obsługą *features* w <code>get &lt;crates:...&gt;</code>).</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-3\">Kopiuj</button></div><pre id=\"code-3\"><code><span class=\"tok-com\"># 1. zbuduj hackerc z tego repozytorium dowolnym hackerc &gt;= 0.4</span>\nhackerc build hackerc/cmd/main.hcs -o /tmp/hackerc-crate --crate-name hackerc\n(cd /tmp/hackerc-crate &amp;&amp; cargo build --release)\n\n<span class=\"tok-com\"># 2. (opcjonalnie) zbuduj kompilator AOT nowym hackerc</span>\n/tmp/hackerc-crate/target/release/hackerc build hack3rc/cmd/main.hcs \\\n    -o /tmp/hack3rc-crate --crate-name hack3rc\n(cd /tmp/hack3rc-crate &amp;&amp; cargo build --release)</code></pre></div><div class=\"note tip\"><span class=\"note-title\">Wskazówka:</span><code>using &lt;wersja&gt;</code> na początku pliku (albo <code>[package] -&gt; using</code> w <code>Bit.hk</code>) deklaruje wymaganą wersję <code>hackerc</code>. Jeśli nie jest zainstalowana, menedżer <code>bit</code> pobiera ją automatycznie z GitHub Releases i buforuje w <code>cache/env/</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"pierwszy-projekt\">\n  <span class=\"kicker\">Start</span>\n  <h2>Pierwszy projekt</h2>\n  <p>Projekty zakłada i buduje menedżer pakietów <code>bit</code> (osobny projekt, który czyta <code>Bit.hk</code>, instaluje zależności i woła <code>hackerc</code>).</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-4\">Kopiuj</button></div><pre id=\"code-4\"><code>bit init --name moj-projekt\ncd moj-projekt\nbit build --release     <span class=\"tok-com\"># pobierze właściwy hackerc (using &lt;wersja&gt;) i zbuduje binarkę</span></code></pre></div><p>Plik wejściowy budowalnego projektu to <strong>zawsze</strong> <code>cmd/main.hcs</code> — bez żadnej konfiguracji, tak jak Cargo samo znajduje <code>src/main.rs</code>. Kod biblioteczny trafia do <code>lib/</code> (punkt wejścia <code>lib/mod.hcs</code>).</p><div class=\"code-block\"><div class=\"code-label\"><span>układ katalogów</span><button class=\"copy-btn\" data-copy-target=\"code-5\">Kopiuj</button></div><pre id=\"code-5\"><code>moj-projekt/\n  Bit.hk            manifest projektu\n  cmd/\n    main.hcs        punkt wejścia (fun main)\n  lib/              (opcjonalnie) kod biblioteczny\n    mod.hcs\n  cache/            tworzony przez bit (zależności, pobrane kompilatory)</code></pre></div><p>Bez <code>bit</code> możesz używać samego kompilatora na pojedynczym pliku:</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-6\">Kopiuj</button></div><pre id=\"code-6\"><code>hackerc check plik.hcs                   <span class=\"tok-com\"># parsowanie + typecheck, bez generowania kodu</span>\nhackerc build plik.hcs -o /tmp/out       <span class=\"tok-com\"># crate Cargo w /tmp/out</span>\nhackerc js plik.hcs -o plik.js           <span class=\"tok-com\"># backend JavaScript</span>\nnode plik.js</code></pre></div>\n</section>\n\n<section class=\"doc-section\" id=\"tour\">\n  <span class=\"kicker\">Start</span>\n  <h2>Szybki przegląd języka</h2>\n  <p>Jeden plik pokazujący najważniejsze elementy: <code>struct</code> + <code>impl</code>, <code>enum</code> + <code>match</code>, <code>Result</code> z operatorem <code>?</code>, listy i pętle.</p><div class=\"code-block\"><div class=\"code-label\"><span>cmd/main.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-7\">Kopiuj</button></div><pre id=\"code-7\"><code><span class=\"tok-kw\">struct</span> <span class=\"tok-type\">Point</span> [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">impl</span> <span class=\"tok-type\">Point</span> [\n    <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">dist2</span>(<span class=\"tok-kw\">self</span>) -&gt; <span class=\"tok-type\">Int</span> [\n        <span class=\"tok-kw\">end</span> <span class=\"tok-kw\">self</span>.x * <span class=\"tok-kw\">self</span>.x + <span class=\"tok-kw\">self</span>.y * <span class=\"tok-kw\">self</span>.y\n    ]\n]\n\n<span class=\"tok-kw\">enum</span> <span class=\"tok-type\">Shape</span> [\n    Circle(<span class=\"tok-type\">Float</span>),\n    Rect(<span class=\"tok-type\">Float</span>, <span class=\"tok-type\">Float</span>),\n    Empty\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">area</span>(s: Shape) -&gt; <span class=\"tok-type\">Float</span> [\n    <span class=\"tok-kw\">match</span> s [\n        Circle(r) -&gt; [ <span class=\"tok-kw\">end</span> <span class=\"tok-num\">3.14159</span> * r * r ]\n        Rect(w, h) -&gt; [ <span class=\"tok-kw\">end</span> w * h ]\n        _ -&gt; [ <span class=\"tok-kw\">end</span> <span class=\"tok-num\">0.0</span> ]\n    ]\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">safe_div</span>(a: <span class=\"tok-type\">Int</span>, b: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Result</span>&lt;<span class=\"tok-type\">Int</span>, <span class=\"tok-type\">Str</span>&gt; [\n    <span class=\"tok-kw\">if</span> b == <span class=\"tok-num\">0</span> [\n        <span class=\"tok-kw\">end</span> err(<span class=\"tok-str\">\"dzielenie przez zero\"</span>)\n    ]\n    <span class=\"tok-kw\">end</span> ok(a / b)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">half_of_div</span>(a: <span class=\"tok-type\">Int</span>, b: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Result</span>&lt;<span class=\"tok-type\">Int</span>, <span class=\"tok-type\">Str</span>&gt; [\n    <span class=\"tok-kw\">let</span> q = safe_div(a, b)?\n    <span class=\"tok-kw\">end</span> ok(q / <span class=\"tok-num\">2</span>)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> p = Point(<span class=\"tok-num\">3</span>, <span class=\"tok-num\">4</span>)\n    log(<span class=\"tok-str\">\"dist^2 =\"</span>, p.dist2())\n    log(<span class=\"tok-str\">\"pole kola:\"</span>, area(Circle(<span class=\"tok-num\">2.0</span>)))\n\n    <span class=\"tok-kw\">let</span> nums = [<span class=\"tok-num\">5</span>, <span class=\"tok-num\">3</span>, <span class=\"tok-num\">8</span>, <span class=\"tok-num\">1</span>]\n    nums.sort()\n    <span class=\"tok-kw\">for</span> n <span class=\"tok-kw\">in</span> nums [\n        log(n)\n    ]\n\n    <span class=\"tok-kw\">match</span> half_of_div(<span class=\"tok-num\">20</span>, <span class=\"tok-num\">0</span>) [\n        <span class=\"tok-type\">Ok</span>(v) -&gt; [ log(<span class=\"tok-str\">\"wynik\"</span>, v) ]\n        <span class=\"tok-type\">Err</span>(e) -&gt; [ log(<span class=\"tok-str\">\"blad:\"</span>, e) ]\n    ]\n    <span class=\"tok-kw\">match</span> half_of_div(<span class=\"tok-num\">20</span>, <span class=\"tok-num\">4</span>) [\n        <span class=\"tok-type\">Ok</span>(v) -&gt; [ log(<span class=\"tok-str\">\"wynik\"</span>, v) ]\n        <span class=\"tok-type\">Err</span>(e) -&gt; [ log(<span class=\"tok-str\">\"blad:\"</span>, e) ]\n    ]\n]</code></pre></div><div class=\"note tip\"><span class=\"note-title\">Wskazówka:</span>Przykłady w tej dokumentacji, oznaczone jako kompletne programy, są sprawdzane przez <code>hackerc check</code> (a gdzie to możliwe — uruchamiane przez backend JavaScript), więc kopiowanie ich do własnego projektu jest bezpieczne.</div>\n</section>\n\n<section class=\"doc-section\" id=\"komentarze-literaly\">\n  <span class=\"kicker\">Język</span>\n  <h2>Komentarze i literały</h2>\n  <div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Składnia</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>!! tekst</code></td><td>zwykły komentarz liniowy</td></tr><tr><td><code>!!! tekst</code></td><td>komentarz dokumentacyjny — jako samodzielna instrukcja staje się <code>ExprStmt(StringLit(..., true))</code> (parytet z docstringiem)</td></tr><tr><td><code>!" + "&gt; ... &" + "lt;!</code></td><td>komentarz blokowy (wieloliniowy), usuwany przed tokenizacją; nowe linie są zachowywane, żeby numery linii się nie przesuwały</td></tr></tbody></table></div><div class=\"code-block\"><div class=\"code-label\"><span>komentarze.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-8\">Kopiuj</button></div><pre id=\"code-8\"><code><span class=\"tok-com\">!! komentarz liniowy</span>\n<span class=\"tok-com\">!!! komentarz dokumentacyjny</span>\n<span class=\"tok-com\">!" + "&gt; komentarz\n   blokowy &" + "lt;!</span>\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(<span class=\"tok-num\">123</span>, <span class=\"tok-num\">4.5</span>, <span class=\"tok-str\">\"tekst\"</span>, <span class=\"tok-kw\">true</span>, <span class=\"tok-kw\">false</span>)\n]</code></pre></div><h3>Literały</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Literał</th><th>Typ</th><th>Uwagi</th></tr></thead><tbody><tr><td><code>123</code>, <code>4.5</code></td><td><code>Int</code> / <code>Float</code></td><td>lekser nie rozróżnia liczb całkowitych i zmiennoprzecinkowych — robi to dopiero typecheck</td></tr><tr><td><code>\"tekst\"</code></td><td><code>Str</code></td><td>escape'y: <code>\\n \\t \\r \\\\ \\\" \\' \\0 \\e</code> (ESC, 0x1B), a od 0.5 także <code>\\xHH</code> i <code>\\u{...}</code></td></tr><tr><td><code>true</code> / <code>false</code></td><td><code>Bool</code></td><td></td></tr><tr><td><code>null</code></td><td>—</td><td>literał pusty (<code>NullLit</code>)</td></tr><tr><td><code>[1, 2, 3]</code></td><td><code>List&lt;T&gt;</code></td><td>literał listy</td></tr></tbody></table></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>Słowa zarezerwowane przez Rusta, które nie są słowami HackerScript (np. <code>type</code>, <code>loop</code>, <code>ref</code>, <code>mut</code>, <code>trait</code>, <code>crate</code>), lekser automatycznie przepisuje na identyfikatory z dopisanym <code>_</code> — możesz ich używać jako nazw. Słowa kluczowe HackerScript to: <code>fun let const if else elif while for in return end get import using direct manual true false null struct enum match break continue gc pub self and or not as impl include native region use async await spawn</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"zmienne-typy\">\n  <span class=\"kicker\">Język</span>\n  <h2>Zmienne i typy</h2>\n  <p><code>let</code> tworzy zmienną (zawsze modyfikowalną przez przypisanie), <code>const</code> na najwyższym poziomie pliku — stałą. Wartość <code>const</code> musi być literałem. Typ można podać po dwukropku albo pozwolić wywnioskować.</p><div class=\"code-block\"><div class=\"code-label\"><span>zmienne.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-9\">Kopiuj</button></div><pre id=\"code-9\"><code><span class=\"tok-kw\">const</span> MAX: <span class=\"tok-type\">Int</span> = <span class=\"tok-num\">100</span>\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> x = <span class=\"tok-num\">5</span>\n    <span class=\"tok-kw\">let</span> nazwa: <span class=\"tok-type\">Str</span> = <span class=\"tok-str\">\"Hacker\"</span>\n    <span class=\"tok-kw\">let</span> lista: <span class=\"tok-type\">List</span>&lt;<span class=\"tok-type\">Int</span>&gt; = [<span class=\"tok-num\">1</span>, <span class=\"tok-num\">2</span>, <span class=\"tok-num\">3</span>]\n    <span class=\"tok-kw\">let</span> slownik: <span class=\"tok-type\">Dict</span>&lt;<span class=\"tok-type\">Str</span>, <span class=\"tok-type\">Int</span>&gt; = dict()\n    <span class=\"tok-kw\">let</span> zbior: <span class=\"tok-type\">Set</span>&lt;<span class=\"tok-type\">Int</span>&gt; = set()\n    <span class=\"tok-kw\">let</span> wynik: <span class=\"tok-type\">Result</span>&lt;<span class=\"tok-type\">Int</span>, <span class=\"tok-type\">Str</span>&gt; = ok(<span class=\"tok-num\">42</span>)\n    <span class=\"tok-kw\">let</span> moze: <span class=\"tok-type\">Option</span>&lt;<span class=\"tok-type\">Int</span>&gt; = some(<span class=\"tok-num\">7</span>)\n\n    x = x + <span class=\"tok-num\">1</span>\n    x += <span class=\"tok-num\">2</span>\n    log(x, nazwa, lista.len(), slownik.len(), zbior.len(), MAX)\n]</code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Typ</th><th>Znaczenie</th><th>W Rust</th></tr></thead><tbody><tr><td><code>Int</code></td><td>liczba całkowita</td><td><code>i64</code></td></tr><tr><td><code>Float</code></td><td>liczba zmiennoprzecinkowa</td><td><code>f64</code></td></tr><tr><td><code>Str</code></td><td>napis</td><td><code>String</code> / <code>&amp;str</code></td></tr><tr><td><code>Bool</code></td><td>wartość logiczna</td><td><code>bool</code></td></tr><tr><td><code>Void</code></td><td>brak wartości (np. <code>Result&lt;Void, Str&gt;</code>)</td><td><code>()</code></td></tr><tr><td><code>List&lt;T&gt;</code></td><td>lista</td><td><code>Vec&lt;T&gt;</code></td></tr><tr><td><code>Dict&lt;K, V&gt;</code></td><td>mapa (kolejność jak w <code>HashMap</code> — nieokreślona)</td><td><code>HashMap&lt;K, V&gt;</code></td></tr><tr><td><code>Set&lt;T&gt;</code></td><td>zbiór</td><td><code>HashSet&lt;T&gt;</code></td></tr><tr><td><code>Option&lt;T&gt;</code></td><td><code>some(x)</code> / <code>none()</code></td><td><code>Option&lt;T&gt;</code></td></tr><tr><td><code>Result&lt;T, E&gt;</code></td><td><code>ok(x)</code> / <code>err(e)</code></td><td><code>Result&lt;T, E&gt;</code></td></tr><tr><td><code>Chan&lt;T&gt;</code></td><td>kanał (async, patrz „Współbieżność”)</td><td><code>HksChan&lt;T&gt;</code></td></tr><tr><td>własne <code>struct</code> / <code>enum</code></td><td>typy użytkownika</td><td><code>struct</code> / <code>enum</code></td></tr></tbody></table></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>W backendzie JavaScript <code>Int</code> jest liczbą IEEE-754 (dokładną do 2^53), a nie <code>i64</code>. Szczegóły w sekcji „Backend JavaScript”.</div>\n</section>\n\n<section class=\"doc-section\" id=\"operatory\">\n  <span class=\"kicker\">Język</span>\n  <h2>Operatory i wyrażenia</h2>\n  <p>Priorytety od najniższego do najwyższego (operatory na tym samym poziomie łączą się lewostronnie):</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Poziom</th><th>Operatory</th><th>Przykład</th></tr></thead><tbody><tr><td>1</td><td><code>or</code></td><td><code>a or b</code></td></tr><tr><td>2</td><td><code>and</code></td><td><code>a and b</code></td></tr><tr><td>3</td><td><code>==  !=  &lt;  &lt;=  &gt;  &gt;=</code></td><td><code>x &gt;= 10</code></td></tr><tr><td>4</td><td><code>+  -</code></td><td><code>a + b - c</code></td></tr><tr><td>5</td><td><code>*  /  %</code></td><td><code>n % 2 == 0</code></td></tr><tr><td>6</td><td><code>not</code>, jednoargumentowe <code>-</code></td><td><code>not ok</code>, <code>-x</code></td></tr><tr><td>7 (przyrostkowe)</td><td>wywołanie <code>f(x)</code>, indeks <code>xs[i]</code>, pole <code>p.x</code>, metoda <code>xs.len()</code>, <code>?</code>, rzutowanie <code>as</code></td><td><code>xs[0].nazwa</code>, <code>f(x)?</code>, <code>n as Str</code></td></tr></tbody></table></div><p>Przypisania złożone <code>+=  -=  *=  /=</code> działają na zmiennych, polach (<code>p.x += 1</code>) i elementach list (<code>xs[i] += 1</code>, <code>g[i][j] += 1</code>) — modyfikują element w miejscu.</p><div class=\"code-block\"><div class=\"code-label\"><span>operatory.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-10\">Kopiuj</button></div><pre id=\"code-10\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> f = <span class=\"tok-num\">3.7</span>\n    <span class=\"tok-kw\">let</span> n = f <span class=\"tok-kw\">as</span> <span class=\"tok-type\">Int</span>          <span class=\"tok-com\">!! 3</span>\n    <span class=\"tok-kw\">let</span> s = n <span class=\"tok-kw\">as</span> <span class=\"tok-type\">Str</span>          <span class=\"tok-com\">!! \"3\"</span>\n    <span class=\"tok-kw\">let</span> liczby = [<span class=\"tok-num\">10</span>, <span class=\"tok-num\">20</span>, <span class=\"tok-num\">30</span>]\n    liczby[<span class=\"tok-num\">1</span>] += <span class=\"tok-num\">5</span>\n    <span class=\"tok-kw\">if</span> <span class=\"tok-kw\">not</span> (n &gt; <span class=\"tok-num\">5</span>) <span class=\"tok-kw\">and</span> s == <span class=\"tok-str\">\"3\"</span> [\n        log(<span class=\"tok-str\">\"ok\"</span>, liczby[<span class=\"tok-num\">1</span>])\n    ]\n]</code></pre></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>Dzielenie <code>/</code> na <code>Int</code> jest dzieleniem całkowitym (obcina). Dzielenie przez zero kończy się panic'iem — w Rust, JavaScript i <code>hack3rc</code> komunikat to <code>hks panic: ...</code>, a kod wyjścia to 101.</div>\n</section>\n\n<section class=\"doc-section\" id=\"funkcje\">\n  <span class=\"kicker\">Język</span>\n  <h2>Funkcje</h2>\n  <p><code>end wyrażenie</code> zwraca wartość i kończy funkcję (to samo robi <code>return</code> — w repozytorium preferowane jest <code>end</code>). Ostatnie wyrażenie w bloku <strong>nie</strong> jest niejawnie zwracane: <code>end</code> jest zawsze wymagane, żeby coś zwrócić. <code>pub</code> przed <code>fun</code> oznacza <code>pub fn</code> w wygenerowanym Ruście.</p><div class=\"code-block\"><div class=\"code-label\"><span>funkcje.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-11\">Kopiuj</button></div><pre id=\"code-11\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">fib</span>(n: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">if</span> n &lt;= <span class=\"tok-num\">1</span> [\n        <span class=\"tok-kw\">end</span> n\n    ]\n    <span class=\"tok-kw\">end</span> fib(n - <span class=\"tok-num\">1</span>) + fib(n - <span class=\"tok-num\">2</span>)\n]\n\n<span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">greet</span>(name: <span class=\"tok-type\">Str</span>) [\n    log(<span class=\"tok-str\">\"Hej,\"</span>, name)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    greet(<span class=\"tok-str\">\"swiecie\"</span>)\n    log(fib(<span class=\"tok-num\">10</span>))\n]</code></pre></div><h3>Generyki</h3><p>Funkcje, <code>struct</code> i <code>enum</code> mogą mieć parametry typu w nawiasach <code>&lt;...&gt;</code>. Tak napisane są m.in. funkcje z <code>std:result</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>generyki.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-12\">Kopiuj</button></div><pre id=\"code-12\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">unwrap_or</span>&lt;T, E&gt;(r: <span class=\"tok-type\">Result</span>&lt;T, E&gt;, domyslna: T) -&gt; T [\n    <span class=\"tok-kw\">match</span> r [\n        <span class=\"tok-type\">Ok</span>(v) -&gt; [ <span class=\"tok-kw\">end</span> v ]\n        <span class=\"tok-type\">Err</span>(_e) -&gt; [ <span class=\"tok-kw\">end</span> domyslna ]\n    ]\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">pierwszy</span>&lt;T&gt;(xs: <span class=\"tok-type\">List</span>&lt;T&gt;) -&gt; T [\n    <span class=\"tok-kw\">end</span> xs[<span class=\"tok-num\">0</span>]\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> a: <span class=\"tok-type\">Result</span>&lt;<span class=\"tok-type\">Int</span>, <span class=\"tok-type\">Str</span>&gt; = err(<span class=\"tok-str\">\"zle\"</span>)\n    log(unwrap_or(a, <span class=\"tok-num\">7</span>), pierwszy([<span class=\"tok-num\">4</span>, <span class=\"tok-num\">5</span>, <span class=\"tok-num\">6</span>]))\n]</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Jawna adnotacja typu generycznej struktury (np. <code>let w: Wrapper&lt;Int&gt;</code>) nadal jest na liście otwartych punktów — patrz „Roadmap”. <code>List&lt;T&gt;</code>, <code>Dict&lt;K,V&gt;</code>, <code>Set&lt;T&gt;</code>, <code>Option&lt;T&gt;</code> i <code>Result&lt;T,E&gt;</code> działają jako zwykłe użycie generyków.</div><h3>Funkcje asynchroniczne</h3><p><code>async fun</code>, <code>await</code> i <code>spawn</code> opisuje sekcja „Współbieżność”.</p>\n</section>\n\n<section class=\"doc-section\" id=\"struct-impl\">\n  <span class=\"kicker\">Język</span>\n  <h2>Struktury i impl</h2>\n  <p><code>struct</code> deklaruje pola (z typami, rozdzielone przecinkami), a konstruktor jest generowany automatycznie i wywoływany jak funkcja o nazwie struktury. Metody umieszczasz w bloku <code>impl</code>; pierwszym parametrem jest <code>self</code>. Pola odczytujesz i zapisujesz przez <code>.</code></p><div class=\"code-block\"><div class=\"code-label\"><span>struct.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-13\">Kopiuj</button></div><pre id=\"code-13\"><code><span class=\"tok-kw\">struct</span> <span class=\"tok-type\">Point</span> [\n    x: <span class=\"tok-type\">Int</span>,\n    y: <span class=\"tok-type\">Int</span>\n]\n\n<span class=\"tok-kw\">impl</span> <span class=\"tok-type\">Point</span> [\n    <span class=\"tok-kw\">pub</span> <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">sum</span>(<span class=\"tok-kw\">self</span>) -&gt; <span class=\"tok-type\">Int</span> [\n        <span class=\"tok-kw\">end</span> <span class=\"tok-kw\">self</span>.x + <span class=\"tok-kw\">self</span>.y\n    ]\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">origin</span>() -&gt; Point [\n    <span class=\"tok-kw\">end</span> Point(<span class=\"tok-num\">0</span>, <span class=\"tok-num\">0</span>)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> p = Point(<span class=\"tok-num\">1</span>, <span class=\"tok-num\">2</span>)\n    log(p.sum())\n    p.x = <span class=\"tok-num\">10</span>\n    log(p.x, origin().x)\n]</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Każda funkcja w <code>impl</code> jest dziś metodą (<code>&amp;self</code> w wygenerowanym Ruście). Funkcji skojarzonych bez <code>self</code> (jak <code>Point::new</code>) nie ma — zamiast nich używaj zwykłych funkcji na najwyższym poziomie, jak <code>origin()</code> powyżej. Generowany konstruktor <code>Point(a, b)</code> to jedyna „funkcja skojarzona”.</div><p><code>log(p)</code> potrafi wypisać <code>struct</code> i <code>enum</code> (od 0.6).</p>\n</section>\n\n<section class=\"doc-section\" id=\"enum-match\">\n  <span class=\"kicker\">Język</span>\n  <h2>Enum i match</h2>\n  <p>Warianty <code>enum</code> mogą nieść wartości. <code>match</code> dopasowuje wariant, wiąże jego pola do nazw i wykonuje blok po <code>-&gt;</code>. Wzorzec <code>_</code> pasuje do wszystkiego. <code>match</code> obsługuje też <code>Option</code> (<code>Some</code> / <code>None</code>) i <code>Result</code> (<code>Ok</code> / <code>Err</code>).</p><div class=\"code-block\"><div class=\"code-label\"><span>enum.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-14\">Kopiuj</button></div><pre id=\"code-14\"><code><span class=\"tok-kw\">enum</span> <span class=\"tok-type\">Shape</span> [\n    Circle(<span class=\"tok-type\">Float</span>),\n    Rectangle(<span class=\"tok-type\">Float</span>, <span class=\"tok-type\">Float</span>),\n    Empty\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">area</span>(s: Shape) -&gt; <span class=\"tok-type\">Float</span> [\n    <span class=\"tok-kw\">match</span> s [\n        Circle(r) -&gt; [\n            <span class=\"tok-kw\">end</span> <span class=\"tok-num\">3.14159</span> * r * r\n        ]\n        Rectangle(w, h) -&gt; [\n            <span class=\"tok-kw\">end</span> w * h\n        ]\n        _ -&gt; [\n            <span class=\"tok-kw\">end</span> <span class=\"tok-num\">0.0</span>\n        ]\n    ]\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(area(Rectangle(<span class=\"tok-num\">2.0</span>, <span class=\"tok-num\">3.0</span>)))\n    log(area(Empty))\n]</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Nazwy wariantów <code>enum</code> muszą być unikalne w całym programie (ograniczenie bootstrapu) — dlatego warianty w <code>std:json</code> mają prefiks <code>Json*</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"sterowanie\">\n  <span class=\"kicker\">Język</span>\n  <h2>Sterowanie przepływem</h2>\n  <div class=\"code-block\"><div class=\"code-label\"><span>sterowanie.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-15\">Kopiuj</button></div><pre id=\"code-15\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> n = <span class=\"tok-num\">3</span>\n    <span class=\"tok-kw\">if</span> n &gt; <span class=\"tok-num\">0</span> [\n        log(<span class=\"tok-str\">\"dodatnie\"</span>)\n    ] <span class=\"tok-kw\">elif</span> n &lt; <span class=\"tok-num\">0</span> [\n        log(<span class=\"tok-str\">\"ujemne\"</span>)\n    ] <span class=\"tok-kw\">else</span> [\n        log(<span class=\"tok-str\">\"zero\"</span>)\n    ]\n\n    <span class=\"tok-kw\">let</span> i = <span class=\"tok-num\">0</span>\n    <span class=\"tok-kw\">while</span> i &lt; <span class=\"tok-num\">5</span> [\n        <span class=\"tok-kw\">if</span> i == <span class=\"tok-num\">3</span> [\n            <span class=\"tok-kw\">break</span>\n        ]\n        i = i + <span class=\"tok-num\">1</span>\n    ]\n\n    <span class=\"tok-kw\">for</span> jezyk <span class=\"tok-kw\">in</span> [<span class=\"tok-str\">\"Python\"</span>, <span class=\"tok-str\">\"Rust\"</span>, <span class=\"tok-str\">\"HackerScript\"</span>] [\n        <span class=\"tok-kw\">if</span> jezyk == <span class=\"tok-str\">\"Python\"</span> [\n            <span class=\"tok-kw\">continue</span>\n        ]\n        log(jezyk)\n    ]\n]</code></pre></div><p><code>for x in lista</code> iteruje po elementach listy. Po słowniku iterujesz parami przez <code>.items()</code> (od 0.6), a po samych kluczach lub wartościach przez <code>.keys()</code> / <code>.values()</code>:</p><div class=\"code-block\"><div class=\"code-label\"><span>dict_items.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-16\">Kopiuj</button></div><pre id=\"code-16\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> d: <span class=\"tok-type\">Dict</span>&lt;<span class=\"tok-type\">Str</span>, <span class=\"tok-type\">Int</span>&gt; = dict()\n    d.insert(<span class=\"tok-str\">\"a\"</span>, <span class=\"tok-num\">1</span>)\n    d.insert(<span class=\"tok-str\">\"b\"</span>, <span class=\"tok-num\">2</span>)\n    <span class=\"tok-kw\">for</span> k, v <span class=\"tok-kw\">in</span> d.items() [\n        log(k, v)\n    ]\n]</code></pre></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>HackerScript nie ma typu krotki — <code>.items()</code> działa wyłącznie w nagłówku <code>for k, v in ...</code>. Kolejność par jest taka sama jak w <code>HashMap</code> (nieokreślona). W backendzie JavaScript dostępne jest dodatkowo <code>for x in range(a, b)</code>.</div><p><code>match</code> jako instrukcja opisuje sekcja „Enum i match”.</p>\n</section>\n\n<section class=\"doc-section\" id=\"kolekcje\">\n  <span class=\"kicker\">Język</span>\n  <h2>Kolekcje i napisy</h2>\n  <h3>List&lt;T&gt;</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Metoda</th><th>Działanie</th></tr></thead><tbody><tr><td><code>len()</code>, <code>is_empty()</code></td><td>długość / czy pusta</td></tr><tr><td><code>push(x)</code>, <code>pop()</code></td><td>dodaj na koniec / zdejmij ostatni</td></tr><tr><td><code>insert(i, x)</code>, <code>remove(i)</code></td><td>wstaw / usuń element o indeksie</td></tr><tr><td><code>extend(inna)</code>, <code>truncate(n)</code>, <code>clear()</code></td><td>dołącz listę / skróć do <code>n</code> / opróżnij</td></tr><tr><td><code>contains(x)</code>, <code>sort()</code></td><td>czy zawiera / sortuj w miejscu (<code>hack3rc</code> ma też <code>reverse()</code>)</td></tr><tr><td><code>clone()</code></td><td>kopia</td></tr><tr><td><code>xs[i]</code></td><td>indeks (poza zakresem = panic)</td></tr></tbody></table></div><h3>Dict&lt;K, V&gt;</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Metoda</th><th>Działanie</th></tr></thead><tbody><tr><td><code>dict()</code></td><td>tworzy pustą mapę (typ podajesz w adnotacji zmiennej)</td></tr><tr><td><code>insert(k, v)</code></td><td>wstaw / nadpisz</td></tr><tr><td><code>fetch(k)</code></td><td>zwraca <code>Option&lt;V&gt;</code> (<code>Some(v)</code> / <code>None</code>)</td></tr><tr><td><code>contains(k)</code>, <code>contains_key(k)</code></td><td>czy klucz istnieje</td></tr><tr><td><code>remove(k)</code>, <code>len()</code>, <code>clear()</code></td><td>usuń / liczba par / opróżnij</td></tr><tr><td><code>keys()</code>, <code>values()</code>, <code>items()</code></td><td>klucze / wartości / pary (<code>items()</code> tylko w <code>for k, v in</code>)</td></tr></tbody></table></div><h3>Set&lt;T&gt;</h3><p><code>set()</code> tworzy pusty zbiór; dostępne są <code>insert(x)</code>, <code>contains(x)</code>, <code>remove(x)</code>, <code>len()</code>.</p><h3>Str</h3><p>Metody: <code>len()</code> (bajty UTF-8), <code>char_at(i)</code>, <code>slice(od, do)</code>, <code>clone()</code>, <code>contains(...)</code>. Reszta operacji tekstowych to funkcje z <code>std:string</code> (patrz „Biblioteka standardowa”). Łączenie napisów: <code>+</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>napisy.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-17\">Kopiuj</button></div><pre id=\"code-17\"><code><span class=\"tok-kw\">get</span> &lt;std:string&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> s = <span class=\"tok-str\">\"  Hello, HackerScript!  \"</span>\n    <span class=\"tok-kw\">let</span> t = str_trim(s)\n    log(t, t.len())\n    log(str_contains(t, <span class=\"tok-str\">\"Hacker\"</span>), str_starts_with(t, <span class=\"tok-str\">\"Hello\"</span>))\n    log(str_replace(t, <span class=\"tok-str\">\"HackerScript\"</span>, <span class=\"tok-str\">\"swiat\"</span>))\n    log(str_join(str_split(t, <span class=\"tok-str\">\", \"</span>), <span class=\"tok-str\">\" | \"</span>))\n    log(t.slice(<span class=\"tok-num\">0</span>, <span class=\"tok-num\">5</span>), t.char_at(<span class=\"tok-num\">1</span>))\n]</code></pre></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>W backendzie JavaScript <code>Dict</code> to <code>Map</code>, a <code>char_at</code> / <code>slice</code> operują na jednostkach UTF-16 (różnica tylko dla znaków spoza BMP).</div>\n</section>\n\n<section class=\"doc-section\" id=\"option-result\">\n  <span class=\"kicker\">Język</span>\n  <h2>Option, Result i operator ?</h2>\n  <p>Brak wartości i błędy wyrażasz typami <code>Option&lt;T&gt;</code> i <code>Result&lt;T, E&gt;</code> — nie ma wyjątków. Konstruktory: <code>some(x)</code>, <code>none()</code>, <code>ok(x)</code>, <code>err(e)</code>; w <code>match</code> wzorce zapisujesz jako <code>Some(v)</code>, <code>None</code>, <code>Ok(v)</code>, <code>Err(e)</code>.</p><p>Operator <code>?</code> po wyrażeniu typu <code>Result</code> albo <code>Option</code> <strong>propaguje</strong> <code>Err</code> / <code>None</code> do otaczającej funkcji, więc jej typ zwracany musi być <code>Result&lt;_, _&gt;</code> albo <code>Option&lt;_&gt;</code> — w przeciwnym razie kompilator zgłosi <code>E0011</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>option.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-18\">Kopiuj</button></div><pre id=\"code-18\"><code><span class=\"tok-kw\">get</span> &lt;std:string&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">parse_dodaj</span>(a: <span class=\"tok-type\">Str</span>, b: <span class=\"tok-type\">Str</span>) -&gt; <span class=\"tok-type\">Option</span>&lt;<span class=\"tok-type\">Int</span>&gt; [\n    <span class=\"tok-kw\">let</span> x = str_to_int(a)?\n    <span class=\"tok-kw\">let</span> y = str_to_int(b)?\n    <span class=\"tok-kw\">end</span> some(x + y)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">match</span> parse_dodaj(<span class=\"tok-str\">\"20\"</span>, <span class=\"tok-str\">\"22\"</span>) [\n        <span class=\"tok-type\">Some</span>(v) -&gt; [ log(<span class=\"tok-str\">\"suma\"</span>, v) ]\n        <span class=\"tok-type\">None</span> -&gt; [ log(<span class=\"tok-str\">\"niepoprawne dane\"</span>) ]\n    ]\n    <span class=\"tok-kw\">match</span> parse_dodaj(<span class=\"tok-str\">\"20\"</span>, <span class=\"tok-str\">\"x\"</span>) [\n        <span class=\"tok-type\">Some</span>(v) -&gt; [ log(<span class=\"tok-str\">\"suma\"</span>, v) ]\n        <span class=\"tok-type\">None</span> -&gt; [ log(<span class=\"tok-str\">\"niepoprawne dane\"</span>) ]\n    ]\n]</code></pre></div><p>Funkcje pomocnicze (<code>unwrap_or</code>, <code>unwrap_or_default</code>, <code>is_ok</code>, <code>is_err</code>, <code>is_some</code>) są w <code>std:result</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"async\">\n  <span class=\"kicker\">Język</span>\n  <h2>Współbieżność: async, await, spawn, chan</h2>\n  <p><code>async fun</code> deklaruje funkcję asynchroniczną, <code>await</code> czeka na jej wynik, a <code>spawn wywołanie</code> uruchamia koroutynę i zwraca uchwyt, na który też można zrobić <code>await</code>. Kanały tworzy <code>chan(n)</code>; mają metody <code>send</code>, <code>recv</code> i <code>close</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>async.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-19\">Kopiuj</button></div><pre id=\"code-19\"><code><span class=\"tok-kw\">async</span> <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">podwoj</span>(n: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Int</span> [\n    <span class=\"tok-kw\">end</span> n * <span class=\"tok-num\">2</span>\n]\n\n<span class=\"tok-kw\">async</span> <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> zadanie = <span class=\"tok-kw\">spawn</span> podwoj(<span class=\"tok-num\">21</span>)\n    <span class=\"tok-kw\">let</span> wynik = <span class=\"tok-kw\">await</span> zadanie\n    log(<span class=\"tok-str\">\"wynik:\"</span>, wynik)\n]</code></pre></div><ul><li><strong>Rust:</strong> <code>hackerc</code> dopisuje runtime oparty na <code>tokio</code> (features <code>rt-multi-thread</code>, <code>sync</code>, <code>time</code>) do <code>Cargo.toml</code> <strong>automatycznie</strong> i tylko wtedy, gdy program używa <code>async</code> / <code>spawn</code> / <code>chan</code>. Koroutyny to zadania <code>tokio</code>; <code>await</code> poza funkcją <code>async</code> blokuje bieżący wątek.</li><li><strong>JavaScript:</strong> <code>async fun</code> → <code>async function</code>, <code>spawn</code> → <code>Promise</code>, kanały to <code>HksChan</code>; <code>send</code> i <code>recv</code> trzeba poprzedzić <code>await</code>.</li><li><strong>Strona WWW:</strong> <code>async fun main()</code> też działa; funkcje obsługi zdarzeń mogą być <code>async</code>.</li><li>**<code>hack3rc</code>:** nie obsługuje dziś <code>async</code> (patrz „Kompilator AOT hack3rc”).</li></ul>\n</section>\n\n<section class=\"doc-section\" id=\"wbudowane\">\n  <span class=\"kicker\">Język</span>\n  <h2>Funkcje wbudowane</h2>\n  <p>Poniższe nazwy kompilator zna bez żadnego <code>get</code> — działają w każdym pliku.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Działanie</th></tr></thead><tbody><tr><td><code>log(a, b, ...)</code>, <code>elog(...)</code></td><td>wypisz na stdout / stderr (argumenty rozdzielane spacją; wypisuje też <code>struct</code> i <code>enum</code>)</td></tr><tr><td><code>some(x)</code>, <code>none()</code>, <code>ok(x)</code>, <code>err(e)</code></td><td>konstruktory <code>Option</code> i <code>Result</code></td></tr><tr><td><code>dict()</code>, <code>set()</code>, <code>chan(n)</code></td><td>puste kolekcje i kanał</td></tr><tr><td><code>read_file(p)</code>, <code>write_file(p, tresc)</code></td><td>odczyt / zapis pliku tekstowego</td></tr><tr><td><code>copy_file</code>, <code>remove_file</code>, <code>create_dir</code>, <code>dir_exists</code>, <code>list_dir</code>, <code>path_exists</code>, <code>remove_dir_all</code></td><td>operacje na systemie plików</td></tr><tr><td><code>current_dir()</code>, <code>env_var(nazwa)</code>, <code>args()</code>, <code>exit(kod)</code></td><td>środowisko i argumenty procesu</td></tr><tr><td><code>run_command</code>, <code>run_command_combined</code>, <code>run_command_inherit</code></td><td>uruchamianie programów (bez powłoki)</td></tr><tr><td><code>read_stdin_line()</code>, <code>read_stdin_exact(n)</code>, <code>write_stdout(s)</code></td><td>standardowe wejście / wyjście</td></tr><tr><td><code>http_get(url)</code></td><td>zapytanie HTTP GET (<code>Result&lt;Str, Str&gt;</code>)</td></tr><tr><td><code>sha256_hex(tekst)</code>, <code>now_ms()</code>, <code>target_os()</code></td><td>skrót SHA-256, czas w ms, system docelowy programu</td></tr></tbody></table></div><p>Nieznana funkcja daje ostrzeżenie <code>W0002</code> (np. gdy pochodzi z importu, którego bootstrap nie widzi). Wywołanie z błędną liczbą argumentów to błąd <code>E0001</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"direct-manual\">\n  <span class=\"kicker\">Język</span>\n  <h2>direct, f" + "ast direct i manual</h2>\n  <p><code>d" + "irect [ ... ]</code> uruchamia <strong>surowy Python</strong> w trakcie działania programu przez wbudowany interpreter (PyO3, <code>auto-initialize</code>) — Rust jest hostem. To ucieczka dla małych fragmentów, które nigdy nie będą wymagały wydajności. Tylko wewnątrz <code>direct</code> dostępne jest <code>get &lt;pypi:...&gt;</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>direct.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-20\">Kopiuj</button></div><pre id=\"code-20\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">direct</span> [\n        print(<span class=\"tok-str\">\"To jest czysty Python wewnątrz binarki Rust.\"</span>)\n    ]\n]</code></pre></div><p><code>manual [ ... ]</code> transpiluje się do <code>unsafe { ... }</code> w wygenerowanym Ruście — używaj świadomie.</p><h3>f" + "ast direct {backend}</h3><p><code>f" + "ast direct {backend} [ ... ]</code> pozwala wybrać <strong>backend wykonania Pythona</strong> zamiast domyślnego CPythona. Backend jest zawsze obowiązkowy (nie ma „gołego” <code>f" + "ast direct</code>). Dostępne identyfikatory: <code>pypy</code>, <code>numba</code>, <code>cython</code>, <code>numpy</code>, <code>polars</code>, <code>scipy</code>, <code>asyncio</code>, <code>uvloop</code>, <code>multiprocessing</code>, <code>jax</code>, <code>pythran</code>, <code>duckdb</code>, <code>cupy</code>, <code>vaex</code>, <code>numexpr</code>, <code>trio</code>, <code>aiohttp</code>, <code>granian</code>, <code>httpx</code>, <code>ray</code> (pełna tabela i semantyka: <code>docs/FAST_DIRECT.md</code>).</p><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Status: zaimplementowana jest wersja <strong>dynamiczna</strong>; statyczne linkowanie interpretera/bibliotek do binarki jest zaplanowane, ale jeszcze niezrobione.</div>\n</section>\n\n<section class=\"doc-section\" id=\"native-js\">\n  <span class=\"kicker\">Język</span>\n  <h2>n" + "ative { ... } — kod w innym języku</h2>\n  <p>Blok <code>n" + "ative {Silnik} [ ... ]</code> osadza kod w innym języku. Co dokładnie się dzieje, zależy od silnika:</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Silnik</th><th>Jak działa</th><th>Dokument</th></tr></thead><tbody><tr><td><code>{JavaScript}</code></td><td>statycznie linkowany <strong>QuickJS</strong> (przez <code>rquickjs</code>), wykonywany w runtime; <code>console.log</code> to polyfill dopisywany przez kompilator</td><td>SYNTAX.md</td></tr><tr><td><code>{C++}</code></td><td>kompilowany <strong>w czasie budowania</strong> (crate <code>cc</code>), linkowany statycznie; ciało trafia do <code>extern \"C\" void __hks_native_cpp_block_N()</code></td><td>SYNTAX.md</td></tr><tr><td><code>{go}</code></td><td>bloki zbierane do jednego <code>hks_go.go</code>, budowane <code>go build -buildmode=c-archive</code> i linkowane statycznie; Go potrzebny tylko przy budowaniu</td><td>GO.md</td></tr><tr><td><code>{java}</code></td><td>kompilowany <code>javac</code> do klasy <code>HksNativeJavaN</code>, uruchamiany w osadzonej JVM (crate <code>jni</code>)</td><td>JAVA.md</td></tr><tr><td><code>{kotlin}</code></td><td>jak Java, ale <code>kotlinc</code>; funkcja <code>run()</code> w pliku <code>.kt</code></td><td>KOTLIN.md</td></tr></tbody></table></div><div class=\"code-block\"><div class=\"code-label\"><span>native.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-21\">Kopiuj</button></div><pre id=\"code-21\"><code><span class=\"tok-kw\">native</span> {JavaScript} [\n    <span class=\"tok-kw\">const</span> dane = { jezyk: <span class=\"tok-str\">\"JavaScript\"</span>, dziala: <span class=\"tok-kw\">true</span> };\n    console.log(JSON.stringify(dane));\n]\n\n<span class=\"tok-com\">!! import zewnętrznego pliku (ścieżka względna do .hcs)</span>\n<span class=\"tok-kw\">native</span> {JavaScript} &lt;lib/utils.js&gt; [\n    console.log(funkcjaZUtilsJs());\n]</code></pre></div><ul><li>Dziś jedyny obsługiwany silnik JavaScript to <code>\"JavaScript\"</code> — inna nazwa daje komentarz w wyniku, bez błędu kompilacji.</li><li>Bloki <code>{C++}</code>, <code>{go}</code>, <code>{java}</code>, <code>{kotlin}</code> nie przyjmują i nie zwracają parametrów — komunikacja tylko przez efekty uboczne (stdout, pliki).</li><li><code>native</code> i <code>get &lt;npm:...&gt;</code> są niedostępne w trybie strony oraz w backendzie JavaScript.</li></ul>\n</section>\n\n<section class=\"doc-section\" id=\"sandbox\">\n  <span class=\"kicker\">Język</span>\n  <h2>$ polecenie $ — Zero-Cost Sandbox</h2>\n  <p>Uruchamia polecenie powłoki w izolacji <strong>sieci i systemu plików</strong> przez <code>libc::unshare(CLONE_NEWNET|CLONE_NEWNS)</code> + bind-remount <code>/</code> na read-only — bez zewnętrznych narzędzi (firejail, bwrap). Brak uprawnień kończy się ostrzeżeniem na stderr: polecenie i tak działa, ale bez izolacji (nigdy cichy fejl).</p><div class=\"code-block\"><div class=\"code-label\"><span>sandbox.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-22\">Kopiuj</button></div><pre id=\"code-22\"><code>$\nwhoami\necho \"brak dostepu do sieci hosta i zapisu do /\"\n$</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Izoluje tylko ten podproces (nie resztę programu). Polecenie nie może zawierać dosłownego <code>$</code> (np. <code>$HOME</code>) — blok zamyka się na pierwszym napotkanym.</div>\n</section>\n\n<section class=\"doc-section\" id=\"hot-reload\">\n  <span class=\"kicker\">Język</span>\n  <h2>Atrybuty: @" + "hot_reload i @" + "wasm_export</h2>\n  <p>Funkcja oznaczona <code>@" + "hot_reload</code> trafia do osobnego, dynamicznie ładowanego <code>cdylib</code>. Wątek-obserwator śledzi plik <code>.hcs</code> i przy zmianie sam woła <code>hackerc build</code> + <code>cargo build --release</code>, po czym atomowo podmienia wskaźnik funkcji w <strong>działającym procesie</strong> — bez restartu.</p><div class=\"code-block\"><div class=\"code-label\"><span>hot_reload.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-23\">Kopiuj</button></div><pre id=\"code-23\"><code><span class=\"tok-kw\">@" + "hot_reload</span>\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">greet</span>() [\n    log(<span class=\"tok-str\">\"wersja 1\"</span>)\n    <span class=\"tok-kw\">end</span>\n]</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Tylko funkcje bez parametrów i bez wartości zwracanej, na najwyższym poziomie. Wymaga zmiennej środowiskowej <code>HKS_HOT_OUT_DIR</code> przy uruchomieniu i ręcznego pierwszego builda <code>hotlib/</code>.</div><p><code>@" + "wasm_export</code> oznacza funkcję do wyeksportowania z crate'a do JavaScript przez <code>wasm-bindgen</code> (patrz „Playground i WASM”). Oba atrybuty to markery tekstowe wycinane przed tokenizacją — AST nic o nich nie wie.</p><div class=\"code-block\"><div class=\"code-label\"><span>wasm_export.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-24\">Kopiuj</button></div><pre id=\"code-24\"><code><span class=\"tok-kw\">@" + "wasm_export</span>\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">check_source</span>(source: <span class=\"tok-type\">Str</span>) -&gt; <span class=\"tok-type\">Str</span> [\n    <span class=\"tok-kw\">end</span> source\n]</code></pre></div><p><code>gc:use::tryb</code> to pragma wybierająca strategię alokacji dla bieżącego zakresu (patrz <code>libs/core/lib/memory/</code>), np. <code>gc:use::arena</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"moduly\">\n  <span class=\"kicker\">Moduły i pakiety</span>\n  <h2>System modułów: get i include</h2>\n  <p>Importy realizują dwa słowa. **<code>get &lt;źródło:nazwa[::podmoduł]&gt;</code>** tworzy nazwany, osobny moduł (opcjonalnie z <code>import &lt;a::b&gt;</code> — wybór nazw), a **<code>include &lt;ścieżka&gt;</code><strong> scala plik siostrzany </strong>bez prefiksu**, jak Rustowe <code>mod</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>importy.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-25\">Kopiuj</button></div><pre id=\"code-25\"><code><span class=\"tok-kw\">include</span> &lt;narzedzia&gt;                          <span class=\"tok-com\">!! plik narzedzia.hcs obok bieżącego</span>\n\n<span class=\"tok-kw\">get</span> &lt;std:io&gt;                                 <span class=\"tok-com\">!! biblioteka standardowa</span>\n<span class=\"tok-kw\">get</span> &lt;std:string&gt; <span class=\"tok-kw\">import</span> &lt;str_join::str_trim&gt; <span class=\"tok-com\">!! tylko wybrane nazwy</span>\n<span class=\"tok-kw\">get</span> &lt;std:cybersecurity::entropy&gt;             <span class=\"tok-com\">!! podmoduł po ::</span>\n<span class=\"tok-kw\">get</span> &lt;core:memory::arena&gt;                     <span class=\"tok-com\">!! biblioteka core</span>\n<span class=\"tok-kw\">get</span> &lt;work:parser::ast&gt;                       <span class=\"tok-com\">!! członek workspace (od 0.4)</span>\n<span class=\"tok-kw\">get</span> &lt;crates:serde::<span class=\"tok-num\">1.0</span>&gt;                      <span class=\"tok-com\">!! zależność Cargo</span>\n<span class=\"tok-kw\">get</span> &lt;bit:nazwa&gt;                              <span class=\"tok-com\">!! biblioteka zainstalowana przez bit</span></code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Źródło</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>std:</code> / <code>core:</code></td><td>biblioteki dołączone do języka (<code>libs/std/lib/</code>, <code>libs/core/lib/</code>)</td></tr><tr><td><code>work:</code></td><td>dowolny członek <code>[workspace] -&gt; members</code> (jego <code>lib/mod.hcs</code> albo <code>lib/&lt;plik&gt;.hcs</code>) — analog Rustowego <code>use czlonek::modul::*;</code></td></tr><tr><td><code>bit:</code></td><td>biblioteka zainstalowana przez <code>bit install</code> (<code>cache/libs/&lt;nazwa&gt;/</code> lub <code>~/.hackeros/libs/&lt;nazwa&gt;/current/</code>, źródła w <code>lib/</code>)</td></tr><tr><td><code>hlib:</code></td><td>archiwum <code>.hlib</code> (patrz „Archiwa .hlib”); <code>get &lt;nazwa&gt;</code> bez prefiksu wybiera <code>hlib</code> albo <code>bit</code> automatycznie</td></tr><tr><td><code>crates:</code></td><td>prawdziwa zależność Cargo (<code>get &lt;crates:nazwa::wersja+feature1+feature2&gt;</code>)</td></tr><tr><td><code>pypi:</code></td><td>pakiet Pythona, dostępny tylko wewnątrz <code>d" + "irect [ ... ]</code></td></tr><tr><td><code>npm:</code> / <code>jsr:</code></td><td>pakiety JS/TS; w backendzie JavaScript <code>get &lt;npm:x&gt;</code> → <code>require(\"x\")</code> (tylko Node)</td></tr><tr><td><code>extern:</code>, <code>c:</code>, <code>cpp:</code></td><td>FFI do bibliotek natywnych (sekcja „FFI”)</td></tr><tr><td><code>go:</code>, <code>java:</code>, <code>kotlin:</code></td><td>pakiety Go / archiwa <code>.jar</code> używane przez bloki <code>n" + "ative { ... }</code></td></tr><tr><td><code>selfhost:</code></td><td>tylko <code>include</code> (wewnętrzne, blokowane w <code>get</code>)</td></tr></tbody></table></div><p>Nieznane źródło daje błąd <code>E0003</code>.</p><h3>get &lt;work:...&gt; i include &lt;work:...&gt;</h3><p>Oba formy rozwiązują ścieżkę względem <strong>korzenia workspace</strong>, a nie bieżącego katalogu: kompilator idzie w górę drzewa od pliku, w którym napisano <code>get</code>, szukając najbliższego przodka mającego <code>&lt;członek&gt;/lib</code> jako katalog. Członek workspace jest „binarką” (ma <code>cmd/main.hcs</code>), „biblioteką” (ma <code>lib/mod.hcs</code>) albo obydwoma naraz.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Kształt członka</th><th>Wymagany plik</th><th>Budowany przez</th><th>Importowalny przez</th></tr></thead><tbody><tr><td>binarka</td><td><code>cmd/main.hcs</code> (<code>fun main()</code>)</td><td><code>bit build</code></td><td>nie</td></tr><tr><td>biblioteka</td><td><code>lib/mod.hcs</code></td><td>—</td><td><code>get &lt;work:nazwa[::plik]&gt;</code></td></tr></tbody></table></div><p><code>include &lt;work:hackerc::lexer&gt;</code> robi <strong>statyczne linkowanie bez kopiowania</strong>: kod leksera trafia wprost do crate'a konsumenta, bez duplikowania źródła — tak playground WASM używa checkera <code>hackerc</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"manifest\">\n  <span class=\"kicker\">Moduły i pakiety</span>\n  <h2>Bit.hk — manifest i workspace</h2>\n  <p><code>Bit.hk</code> to manifest projektu w formacie <code>.hk</code> (nie TOML, mimo podobnego wyglądu). Sekcje w <code>[nawiasach]</code>, klucze zaczynają się od <code>-&gt;</code>, wartości po <code>=&gt;</code>. Zagnieżdżenie zapisujesz kolejnymi strzałkami <code>--&gt;</code>, <code>---&gt;</code>. Obsługiwana jest interpolacja <code>${sekcja.klucz}</code> i <code>${env:ZMIENNA}</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>Bit.hk</span><button class=\"copy-btn\" data-copy-target=\"code-26\">Kopiuj</button></div><pre id=\"code-26\"><code><span class=\"tok-type\">[package]</span>\n<span class=\"tok-kw\">-&gt;</span> name        <span class=\"tok-kw\">=&gt;</span> moj-projekt\n<span class=\"tok-kw\">-&gt;</span> version     <span class=\"tok-kw\">=&gt;</span> 0.1.0\n<span class=\"tok-kw\">-&gt;</span> description <span class=\"tok-kw\">=&gt;</span> Opis projektu.\n<span class=\"tok-kw\">-&gt;</span> authors     <span class=\"tok-kw\">=&gt;</span> [\"Twoje Imię\"]\n<span class=\"tok-kw\">-&gt;</span> license     <span class=\"tok-kw\">=&gt;</span> MIT\n<span class=\"tok-kw\">-&gt;</span> lang        <span class=\"tok-kw\">=&gt;</span> HackerScript\n<span class=\"tok-kw\">-&gt;</span> using       <span class=\"tok-kw\">=&gt;</span> 0.6\n\n<span class=\"tok-type\">[layout]</span>\n<span class=\"tok-kw\">-&gt;</span> cmd <span class=\"tok-kw\">=&gt;</span> cmd\n\n<span class=\"tok-type\">[build]</span>\n<span class=\"tok-kw\">-&gt;</span> link <span class=\"tok-kw\">=&gt;</span> static\n\n<span class=\"tok-type\">[default-build]</span>\n<span class=\"tok-kw\">-&gt;</span> profile <span class=\"tok-kw\">=&gt;</span> release</code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Sekcja</th><th>Klucze</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>[package]</code></td><td><code>name</code>, <code>version</code>, <code>description</code>, <code>authors</code>, <code>license</code>, <code>lang</code>, <code>using</code>, <code>all-versions</code>, <code>edition</code></td><td>metadane i wymagana wersja <code>hackerc</code></td></tr><tr><td><code>[layout]</code></td><td><code>cmd</code>, <code>lib</code></td><td>katalog z <code>main.hcs</code> / katalog biblioteki</td></tr><tr><td><code>[workspace]</code></td><td><code>members</code></td><td>lista członków workspace</td></tr><tr><td><code>[lib]</code></td><td><code>output</code></td><td>format wyniku biblioteki (np. <code>hlib</code>)</td></tr><tr><td><code>[build]</code></td><td><code>link</code></td><td>tryb linkowania (np. <code>static</code>)</td></tr><tr><td><code>[default-build]</code></td><td><code>profile</code></td><td>domyślny profil (<code>release</code>)</td></tr><tr><td><code>[dependencies]</code></td><td>wpisy zależności</td><td>biblioteki z indeksu, repozytoria git (<code>-&gt; x =&gt; git &lt;url&gt; v1</code>), ścieżki lokalne, pakiety PyPI/crates.io/npm/JSR</td></tr><tr><td><code>[native_sources]</code></td><td>pliki <code>.c</code> / <code>.cpp</code></td><td>własne źródła natywne kompilowane przez <code>cc</code></td></tr><tr><td><code>[commands]</code>, <code>[hooks]</code></td><td><code>run</code>, <code>description</code>, <code>pre-build</code></td><td>własne komendy <code>bit &lt;nazwa&gt;</code> i haki budowania (używane m.in. przez stronę HackerOS)</td></tr></tbody></table></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>Sekcja <code>[build] -&gt; entry =&gt; ...</code> została <strong>usunięta w 0.4</strong> — plik wejściowy to zawsze <code>cmd/main.hcs</code>. W starym <code>Bit.hk</code> jest po prostu ignorowana (nieznane sekcje nie są błędem).</div><h3>Workspace</h3><p>Korzeń z sekcją <code>[workspace]</code> buduje <strong>każdego</strong> członka mającego własny, uruchamialny <code>cmd/main.hcs</code> — analogicznie do <code>cargo build</code> w workspace Cargo. <code>cache/</code> jest wspólny dla całego workspace, niezależnie z którego członka uruchomisz <code>bit</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>Bit.hk (korzeń workspace)</span><button class=\"copy-btn\" data-copy-target=\"code-27\">Kopiuj</button></div><pre id=\"code-27\"><code><span class=\"tok-type\">[package]</span>\n<span class=\"tok-kw\">-&gt;</span> name        <span class=\"tok-kw\">=&gt;</span> HackerScript\n<span class=\"tok-kw\">-&gt;</span> version     <span class=\"tok-kw\">=&gt;</span> 0.6\n<span class=\"tok-kw\">-&gt;</span> lang        <span class=\"tok-kw\">=&gt;</span> HackerScript\n<span class=\"tok-kw\">-&gt;</span> using       <span class=\"tok-kw\">=&gt;</span> 0.6\n\n<span class=\"tok-type\">[workspace]</span>\n<span class=\"tok-kw\">-&gt;</span> members <span class=\"tok-kw\">=&gt;</span> [hackerc, hack3rc, libs/core, libs/std]</code></pre></div><h3>Własne komendy</h3><div class=\"code-block\"><div class=\"code-label\"><span>Bit.hk — komendy</span><button class=\"copy-btn\" data-copy-target=\"code-28\">Kopiuj</button></div><pre id=\"code-28\"><code><span class=\"tok-type\">[commands]</span>\n<span class=\"tok-kw\">-&gt;</span> site\n<span class=\"tok-kw\">--&gt;</span> run <span class=\"tok-kw\">=&gt;</span> lua scripts/build-site.lua\n<span class=\"tok-kw\">--&gt;</span> description <span class=\"tok-kw\">=&gt;</span> Buduje całą stronę do katalogu _site\n<span class=\"tok-kw\">-&gt;</span> serve\n<span class=\"tok-kw\">--&gt;</span> run <span class=\"tok-kw\">=&gt;</span> python3 -m http.server 8000 --directory _site\n<span class=\"tok-kw\">--&gt;</span> description <span class=\"tok-kw\">=&gt;</span> Lokalny podgląd zbudowanej strony</code></pre></div>\n</section>\n\n<section class=\"doc-section\" id=\"wersje-using\">\n  <span class=\"kicker\">Moduły i pakiety</span>\n  <h2>using — wersja języka per plik</h2>\n  <p>Każdy plik <code>.hcs</code> może zaczynać się od <code>using &lt;wersja&gt;</code> (np. <code>using &lt;0.6&gt;</code>). Brak deklaracji = wersja domyślna projektu (<code>[package] -&gt; using</code>). To odpowiednik „edycji” z Rusta, ale <strong>per plik</strong>: różne pliki jednego projektu mogą być budowane <strong>różnymi binarkami</strong> kompilatora.</p><div class=\"code-block\"><div class=\"code-label\"><span>using.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-29\">Kopiuj</button></div><pre id=\"code-29\"><code><span class=\"tok-kw\">using</span> &lt;<span class=\"tok-num\">0.6</span>&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(<span class=\"tok-str\">\"ten plik wymaga hackerc 0.6\"</span>)\n]</code></pre></div><ol><li><code>bit build</code> skanuje cały projekt w poszukiwaniu zadeklarowanych wersji (plus opcjonalne <code>[package] -&gt; all-versions =&gt; [...]</code>).</li><li>Dla każdej wersji pobiera / buduje binarkę <code>hackerc</code> do <code>cache/env/hackerc-&lt;wersja&gt;/</code>.</li><li>Główne wywołanie <code>hackerc build --version-map w1=ścieżka1;w2=ścieżka2</code> <strong>deleguje</strong> plik zadeklarowany w innej wersji do tamtej binarki przez <code>hackerc emit-module</code>, a wynikowy moduł Rust wkleja do crate'a.</li></ol><p>Nagłówek <code>using &lt;...&gt;</code> jest czytany wyłącznie przez <code>tokenize()</code>, nigdy <code>parse()</code>, i jest <strong>zamrożony na zawsze</strong> — dzięki temu stary kompilator może odczytać wersję pliku napisanego w nowszej składni i go zdelegować.</p><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Ograniczenia: brak sprawdzania typów między plikami różnych wersji; budowanie bibliotek-członków workspace nie przekazuje jeszcze <code>--version-map</code>. Szczegóły: <code>docs/MULTI_VERSION.md</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"hlib\">\n  <span class=\"kicker\">Moduły i pakiety</span>\n  <h2>Archiwa .hlib</h2>\n  <p><code>.hlib</code> (HackerOS Lib) to wspólny dla H#, Hacker Lang i HackerScript format archiwum biblioteki: <code>tar</code> skompresowany całościowo <code>zstd</code>, z <code>manifest.json</code>, sumami <code>CHECKSUMS.sha256</code> i opcjonalnym podpisem Ed25519. Dla HackerScript artefakt <code>ast/&lt;nazwa&gt;.hcs</code> to dosłowny tekst źródłowy.</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-30\">Kopiuj</button></div><pre id=\"code-30\"><code>hackerc hlib build lib/mod.hcs -o mojalib.hlib --lib-version 1.0.0\nhackerc hlib inspect mojalib.hlib                <span class=\"tok-com\"># wypisuje manifest.json</span>\nhackerc hlib keygen -o hlib_signing.key          <span class=\"tok-com\"># klucz Ed25519 (publiczny wypisany na ekran)</span>\nhackerc hlib build lib/mod.hcs -o mojalib.hlib --sign hlib_signing.key\nhackerc hlib verify mojalib.hlib --pubkey &lt;HEX&gt;</code></pre></div><p>Import: <code>get &lt;hlib:nazwa&gt;</code> albo samo <code>get &lt;nazwa&gt;</code> (kompilator wybiera <code>hlib</code> lub <code>bit</code>). Najpierw próbuje wstawić źródło z artefaktu <code>ast</code> (jak <code>include</code>), a gdy go nie ma — syntezuje deklaracje <code>extern</code> z <code>.so</code> dla bieżącego celu (tylko funkcje niegeneryczne). Pełna specyfikacja: <code>docs/HLIB_FORMAT.md</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"cele\">\n  <span class=\"kicker\">Cele kompilacji</span>\n  <h2>Dyrektywy use: lang, mode, os</h2>\n  <p>Dyrektywy <code>u" + "se &lt;klucz:wartość&gt;</code> w pliku wejściowym wybierają cel kompilacji. Rozpoznawane klucze: <code>lang</code>, <code>mode</code>, <code>os</code>, <code>crosscompile</code>, <code>arc</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Dyrektywa</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>u" + "se &lt;lang:javascript&gt;</code> (alias <code>js</code>)</td><td><code>hackerc build</code> generuje JavaScript (Node.js / przeglądarka) zamiast crate'a Rust</td></tr><tr><td><code>u" + "se &lt;lang:kotlin&gt;</code></td><td>eksperymentalny backend Kotlina (<code>hackerc kotlin</code>)</td></tr><tr><td><code>u" + "se &lt;mode:website&gt;</code></td><td><code>hackerc build</code> generuje stronę: <code>index.html</code> + <code>app.js</code></td></tr><tr><td><code>u" + "se &lt;os:linux|windows|macos|ios|android&gt;</code></td><td>system docelowy (0.6)</td></tr><tr><td><code>u" + "se &lt;arc:architektura&gt;</code>, <code>u" + "se &lt;crosscompile&gt;</code></td><td>zapisywane w pliku pomocniczym <code>.hks-use.txt</code> dla <code>bit</code></td></tr></tbody></table></div><h3>u" + "se &lt;os:...&gt; (0.6)</h3><p>Można podać kilka — projekt deklaruje wtedy, że wspiera <strong>wszystkie</strong> wymienione systemy. <code>hackerc</code> waliduje wartość (znane: <code>linux</code>, <code>windows</code>, <code>macos</code>, <code>ios</code>, <code>android</code>), dopisuje do <code>main.rs</code> guard <code>#[cfg(not(any(target_os = ...)))] compile_error!(...)</code> i zapisuje wskazówkę <code>target</code> dla <code>bit</code> (gdy zadeklarowano dokładnie jeden system).</p><div class=\"code-block\"><div class=\"code-label\"><span>os.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-31\">Kopiuj</button></div><pre id=\"code-31\"><code><span class=\"tok-kw\">use</span> &lt;os:linux&gt;\n<span class=\"tok-kw\">use</span> &lt;os:windows&gt;\n\n<span class=\"tok-kw\">get</span> &lt;std:os&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(<span class=\"tok-str\">\"system:\"</span>, target_os())\n    <span class=\"tok-kw\">if</span> os_is_unix() [\n        log(<span class=\"tok-str\">\"separator ścieżek:\"</span>, os_path_separator())\n    ]\n]</code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>os</th><th>x86_64</th><th>aarch64</th></tr></thead><tbody><tr><td>linux</td><td><code>x86_64-unknown-linux-gnu</code></td><td><code>aarch64-unknown-linux-gnu</code></td></tr><tr><td>windows</td><td><code>x86_64-pc-windows-gnu</code></td><td><code>aarch64-pc-windows-msvc</code></td></tr><tr><td>macos</td><td><code>x86_64-apple-darwin</code></td><td><code>aarch64-apple-darwin</code></td></tr><tr><td>ios</td><td><code>x86_64-apple-ios</code></td><td><code>aarch64-apple-ios</code></td></tr><tr><td>android</td><td><code>x86_64-linux-android</code></td><td><code>aarch64-linux-android</code></td></tr></tbody></table></div><p><code>target_os()</code> zwraca system docelowy programu (<code>\"linux\" | \"windows\" | \"macos\" | \"ios\" | \"android\"</code>), także przy cross-kompilacji; <code>std:os</code> dodaje predykaty <code>os_is_*</code>, <code>os_is_unix</code>, <code>os_is_mobile</code>, <code>os_path_separator</code>, <code>os_exe_suffix</code>, <code>os_shared_lib_ext</code>.</p><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Deklaracja jest na poziomie <strong>projektu</strong> — nie ma warunkowej kompilacji pojedynczych plików. Wybór <code>--target</code> w <code>cargo</code> należy do <code>bit</code>; <code>hack3rc</code> kieruje się własnym <code>--target</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"backend-js\">\n  <span class=\"kicker\">Cele kompilacji</span>\n  <h2>Backend JavaScript</h2>\n  <p><code>u" + "se &lt;lang:javascript&gt;</code> (albo <code>hackerc js plik.hcs -o plik.js</code>) tłumaczy program na <strong>jeden plik JavaScript</strong> (ES2020, bez zależności), uruchamiany w Node.js albo przeglądarce. Runtime jest dołączany kawałkami — tylko te, których używa program — i opakowany w IIFE.</p><div class=\"code-block\"><div class=\"code-label\"><span>program.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-32\">Kopiuj</button></div><pre id=\"code-32\"><code><span class=\"tok-kw\">use</span> &lt;lang:javascript&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">for</span> i <span class=\"tok-kw\">in</span> range(<span class=\"tok-num\">0</span>, <span class=\"tok-num\">3</span>) [\n        log(<span class=\"tok-str\">\"i =\"</span>, i)\n    ]\n]</code></pre></div><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-33\">Kopiuj</button></div><pre id=\"code-33\"><code>hackerc build program.hcs -o program.js\nnode program.js</code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>HackerScript</th><th>JavaScript</th></tr></thead><tbody><tr><td><code>Int</code>, <code>Float</code></td><td><code>number</code></td></tr><tr><td><code>Str</code>, <code>Bool</code></td><td><code>string</code>, <code>boolean</code></td></tr><tr><td><code>List&lt;T&gt;</code></td><td><code>Array</code> (indeksowanie sprawdzane: panic poza zakresem)</td></tr><tr><td><code>Dict&lt;K,V&gt;</code></td><td><code>Map</code> (<code>insert</code>, <code>fetch</code>, <code>contains</code>, <code>remove</code>, <code>len</code>)</td></tr><tr><td><code>struct</code></td><td><code>class</code> (konstruktor pozycyjny)</td></tr><tr><td><code>enum</code></td><td>klasa z polami <code>$</code> (nazwa wariantu) i <code>v</code> (pola)</td></tr><tr><td><code>match</code></td><td>łańcuch <code>if</code> z wiązaniem pól; <code>_</code> = <code>else</code></td></tr><tr><td><code>Option</code> / <code>Result</code>, <code>?</code></td><td><code>some</code>/<code>none</code>/<code>ok</code>/<code>err</code>, <code>?</code> przez wyjątek wczesnego powrotu</td></tr><tr><td><code>async fun</code>, <code>await</code>, <code>spawn</code></td><td><code>async function</code>, <code>await</code>, <code>Promise</code></td></tr><tr><td><code>chan(n)</code></td><td><code>HksChan</code> (<code>send</code>/<code>recv</code> z <code>await</code>)</td></tr><tr><td><code>log</code>, <code>elog</code></td><td><code>console.log</code>, <code>console.error</code></td></tr><tr><td><code>expr as T</code></td><td><code>Number()</code>, <code>Math.trunc(Number())</code>, <code>String()</code></td></tr><tr><td><code>==</code> na listach/struct/enum</td><td>porównanie strukturalne</td></tr></tbody></table></div><p>Nieznane nazwy przechodzą przez <strong>bez zmian</strong>, więc całe Web API i Node API jest dostępne bez bloków <code>native</code> (<code>Math.floor(x)</code>, <code>document.title</code>, <code>JSON.stringify(x)</code>). W Node dostępne są też <code>args()</code>, <code>exit()</code>, <code>read_file</code>, <code>write_file</code>, <code>file_readable</code>, <code>now_ms</code>, <code>sleep</code>.</p><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>**<code>Int</code> to liczba IEEE-754** (dokładna do 2^53); Rust (<code>i64</code>) zawija się przy przepełnieniu, JavaScript traci precyzję — programy z haszowaniem na dużych liczbach dadzą inny wynik. Niewspierane (czytelny błąd, nie crash): <code>region [...]</code>, <code>direct</code>, <code>native</code>, <code>get &lt;...&gt;</code> poza <code>std</code> / <code>core</code> / <code>npm</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"tryb-strony\">\n  <span class=\"kicker\">Cele kompilacji</span>\n  <h2>Tryb strony: u" + "se &lt;mode:website&gt;</h2>\n  <p>Tryb <code>website</code> kompiluje program do <strong>statycznej strony</strong>: <code>index.html</code> + <code>app.js</code> (ten sam backend co <code>lang:javascript</code>, plus mostek DOM). Nie ma serwera ani bundlera — wynik otwiera się w przeglądarce, także z <code>file://</code>. <code>main()</code> uruchamia się po załadowaniu DOM; <code>async fun main()</code> też działa.</p><div class=\"code-block\"><div class=\"code-label\"><span>strona.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-34\">Kopiuj</button></div><pre id=\"code-34\"><code><span class=\"tok-kw\">use</span> &lt;mode:website&gt;\n\n<span class=\"tok-kw\">style</span> {\n    :root { --graphit: #3b3b3b; --srebro: #d9d9d9; }\n    body  { margin: <span class=\"tok-num\">0</span>; font-family: sans-serif; color: var(--graphit); }\n    .karta { padding: 24px; border: 1px solid var(--srebro); }\n    <span class=\"tok-kw\">@media</span> (max-width: 760px) { .karta { padding: 12px; } }\n}\n\n<span class=\"tok-kw\">let</span> licznik = <span class=\"tok-num\">0</span>\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">on_click</span>() [\n    licznik = licznik + <span class=\"tok-num\">1</span>\n    dom_text(dom_get(<span class=\"tok-str\">\"out\"</span>), <span class=\"tok-str\">\"kliknięto \"</span> + (licznik <span class=\"tok-kw\">as</span> <span class=\"tok-type\">Str</span>) + <span class=\"tok-str\">\" razy\"</span>)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    page_title(<span class=\"tok-str\">\"Licznik\"</span>)\n    <span class=\"tok-kw\">let</span> root = app_root()\n    child(root, <span class=\"tok-str\">\"h1\"</span>, <span class=\"tok-str\">\"Cześć!\"</span>)\n    <span class=\"tok-kw\">let</span> k = child(root, <span class=\"tok-str\">\"div\"</span>, <span class=\"tok-str\">\"\"</span>)\n    dom_attr(k, <span class=\"tok-str\">\"class\"</span>, <span class=\"tok-str\">\"karta\"</span>)\n    <span class=\"tok-kw\">let</span> btn = child(k, <span class=\"tok-str\">\"button\"</span>, <span class=\"tok-str\">\"Kliknij\"</span>)\n    <span class=\"tok-kw\">let</span> out = child(k, <span class=\"tok-str\">\"p\"</span>, <span class=\"tok-str\">\"\"</span>)\n    dom_attr(out, <span class=\"tok-str\">\"id\"</span>, <span class=\"tok-str\">\"out\"</span>)\n    dom_on(btn, <span class=\"tok-str\">\"click\"</span>, on_click)\n]</code></pre></div><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-35\">Kopiuj</button></div><pre id=\"code-35\"><code>hackerc build strona.hcs -o dist        <span class=\"tok-com\"># dist/index.html + dist/app.js</span>\nhackerc website strona.hcs -o dist      <span class=\"tok-com\"># to samo, jawna podkomenda</span></code></pre></div><h3>Mostek DOM</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Działanie</th></tr></thead><tbody><tr><td><code>app_root()</code></td><td>element <code>#app</code> (kontener strony)</td></tr><tr><td><code>el(tag, tekst)</code>, <code>child(rodzic, tag, tekst)</code></td><td>nowy element / element dołączony do rodzica (zwraca go)</td></tr><tr><td><code>dom_get(id)</code>, <code>dom_query(selektor)</code></td><td>wyszukiwanie</td></tr><tr><td><code>dom_create</code>, <code>dom_append</code>, <code>dom_clear</code></td><td>struktura drzewa</td></tr><tr><td><code>dom_text(el, t)</code>, <code>dom_html(el, html)</code></td><td>zawartość</td></tr><tr><td><code>dom_attr</code>, <code>dom_style</code>, <code>dom_class</code></td><td>atrybuty, style, klasy</td></tr><tr><td><code>dom_value(el)</code>, <code>dom_set_value(el, v)</code></td><td>pola formularzy</td></tr><tr><td><code>dom_on(el, zdarzenie, funkcja)</code></td><td>zdarzenia — funkcję podajesz <strong>po nazwie</strong> (może być <code>async</code>)</td></tr><tr><td><code>page_title(t)</code>, <code>page_css(css)</code></td><td>tytuł i dodatkowy CSS</td></tr><tr><td><code>http_get(url)</code>, <code>http_post(url, body)</code></td><td><code>async</code>, zwracają <code>Result&lt;Str, Str&gt;</code> (użyj <code>await</code>)</td></tr><tr><td><code>storage_get(k)</code>, <code>storage_set(k, v)</code></td><td><code>localStorage</code> (<code>Option&lt;Str&gt;</code>)</td></tr><tr><td><code>set_timeout</code>, <code>set_interval</code>, <code>alert</code>, <code>random</code>, <code>now_ms</code>, <code>sleep</code></td><td>pomocnicze</td></tr></tbody></table></div><p>Reszta Web API jest dostępna wprost (<code>document.title</code>, <code>window.location</code>, <code>console.log</code>…). Stan trzymaj w zmiennych na poziomie pliku.</p><h3>Blok style { ... }</h3><p>Stronę stylujesz **bez osobnego pliku <code>.css</code>**: blokiem <code>style { ... }</code> prosto w <code>.hcs</code>. W środku obowiązuje zwykły CSS (reguły, <code>@media</code>, <code>@keyframes</code>, <code>@import</code>, zmienne <code>--x</code>, komentarze <code>/* */</code>).</p><ul><li><code>style {</code> musi stać <strong>na początku linii</strong>; <code>style {</code> w stringu albo komentarzu nie otwiera bloku.</li><li>Blok kończy pasujące <code>}</code> — klamry w stringach CSS (<code>content: \"}\"</code>) i w komentarzach <code>/* } */</code> nie liczą się do zagnieżdżenia.</li><li>Bloków może być wiele, także w plikach wciągniętych przez <code>include</code>. Kolejność w kaskadzie: najpierw style plików z <code>include</code>, na końcu style pliku wejściowego.</li><li>CSS trafia do <strong>statycznego</strong> <code>&lt;style&gt;</code> w <code>index.html</code>, po domyślnym stylu szkieletu (<code>body</code>, <code>#app</code>), więc możesz go nadpisać (np. <code>#app { max-width: none; }</code>). Nic nie jest wstrzykiwane z JavaScriptu — nie ma błysku niestylowanej strony.</li><li>Poza <code>mode:website</code> bloki są ignorowane (<code>hackerc js</code> ostrzega). <code>hackerc fmt</code> zachowuje CSS bez zmian i przenosi bloki na koniec pliku.</li></ul><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Ograniczenia: tylko <code>index.html</code> + <code>app.js</code> (brak routingu i SSR), jedna strona na plik wejściowy — wiele podstron to wiele wejść <code>hackerc build</code>. <code>n" + "ative {...}</code> i <code>get &lt;npm:...&gt;</code> są niedostępne. Tryb nie był testowany na prawdziwych urządzeniach mobilnych. Pełny opis: <code>docs/WEBSITE.md</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"ffi\">\n  <span class=\"kicker\">Cele kompilacji</span>\n  <h2>FFI: extern, region, C i C++</h2>\n  <p>Od 0.3 FFI składa się z trzech elementów. **<code>get &lt;extern:ścieżka&gt; u" + "se &lt;static|dynamic&gt;</code><strong> wskazuje bibliotekę natywną i tryb linkowania, </strong><code>region [ ... ]</code>** zawiera dowolnie wiele samych sygnatur (bez ciała) funkcji z tej biblioteki, a funkcje woła się potem normalnie.</p><div class=\"code-block\"><div class=\"code-label\"><span>ffi.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-36\">Kopiuj</button></div><pre id=\"code-36\"><code><span class=\"tok-kw\">get</span> &lt;extern:libs/<span class=\"tok-kw\">native</span>/libmymath.a&gt; <span class=\"tok-kw\">use</span> &lt;static&gt;\n<span class=\"tok-kw\">region</span> [\n    <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">add</span>(a: <span class=\"tok-type\">Int</span>, b: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Int</span>\n    <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">mul</span>(a: <span class=\"tok-type\">Int</span>, b: <span class=\"tok-type\">Int</span>) -&gt; <span class=\"tok-type\">Int</span>\n    <span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">greet</span>(name: <span class=\"tok-type\">Str</span>)\n]\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(<span class=\"tok-str\">\"2 + 3 =\"</span>, add(<span class=\"tok-num\">2</span>, <span class=\"tok-num\">3</span>))\n]</code></pre></div><ul><li><code>u" + "se &lt;static&gt;</code> → <code>kind = \"static\"</code> w <code>#[link(...)]</code>; <code>u" + "se &lt;dynamic&gt;</code> (lub brak <code>use</code>) → linkowanie dynamiczne.</li><li>Samo <code>get &lt;extern:...&gt;</code> niczego nie linkuje — linkowanie (kopiowanie pliku, <code>cargo:rustc-link-*</code> w <code>build.rs</code>) robi <code>bit build</code>.</li><li><code>get &lt;c:nazwa&gt;</code> / <code>get &lt;cpp:nazwa&gt;</code> deklarują zależność od systemowej biblioteki C/C++; sygnatury nadal podajesz przez <code>get &lt;extern:...&gt;</code> + <code>region</code>.</li><li>Własne źródła <code>.c</code> / <code>.cpp</code> z projektu kompiluje sekcja <code>[native_sources]</code> w <code>Bit.hk</code>.</li><li>Sygnatury z <code>region</code> trafiają do tej samej tabeli co zwykłe <code>fun</code>, więc zła liczba argumentów daje błąd <code>hackerc</code> (<code>E0001</code>), a nie dopiero <code>rustc</code>.</li></ul><h3>n" + "ative {C++}</h3><div class=\"code-block\"><div class=\"code-label\"><span>native_cpp.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-37\">Kopiuj</button></div><pre id=\"code-37\"><code><span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">native</span> {C++} [\n        #<span class=\"tok-kw\">include</span> &lt;cstdio&gt;\n        std::printf(<span class=\"tok-str\">\"Cześć z C++, skompilowane build-time.\\n\"</span>);\n    ]\n]</code></pre></div><p>W odróżnieniu od <code>n" + "ative {JavaScript}</code> (interpretowanego w runtime) kod C++ jest <strong>kompilowany w czasie budowania</strong> i linkowany statycznie. Wymaga kompilatora C++ (g++/clang++) tam, gdzie uruchamiasz <code>bit build</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"wasm\">\n  <span class=\"kicker\">Cele kompilacji</span>\n  <h2>Playground i WASM</h2>\n  <p>Od 0.4 istnieje działający pipeline do WebAssembly. Funkcja oznaczona <code>@" + "wasm_export</code> jest eksportowana do JavaScript przez <code>wasm-bindgen</code>; gdy w projekcie jest choć jedna taka funkcja, <code>hackerc build</code> generuje <code>Cargo.toml</code> w kształcie <code>[lib]</code> (<code>crate-type = [\"cdylib\", \"rlib\"]</code>) zamiast <code>[[bin]]</code>.</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-38\">Kopiuj</button></div><pre id=\"code-38\"><code>cd playground\nbit build --wasm</code></pre></div><p><code>bit build --wasm</code> kompiluje crate na <code>wasm32-unknown-unknown</code>, a jeśli zainstalowano <code>wasm-bindgen-cli</code> (osobny program, wersja <strong>musi</strong> zgadzać się z crate'em <code>wasm-bindgen</code>), generuje glue <code>.js</code>/<code>.d.ts</code> i finalny <code>..._bg.wasm</code>. Brak CLI nie jest błędem krytycznym — surowy <code>.wasm</code> trafia do <code>cache/build/</code> z ostrzeżeniem.</p><p><code>playground/cmd/main.hcs</code> statycznie linkuje cały checker <code>hackerc</code> (lexer, parser, typecheck, diagnostyki) przez <code>include &lt;work:hackerc::...&gt;</code>, dzięki czemu sprawdzanie składni działa w przeglądarce w stylu Rust Playground. Funkcje generyczne nie są wspierane przez <code>@" + "wasm_export</code> (ograniczenie <code>wasm-bindgen</code>).</p>\n</section>\n\n<section class=\"doc-section\" id=\"cli\">\n  <span class=\"kicker\">Narzędzia</span>\n  <h2>CLI: hackerc</h2>\n  <p><code>hackerc</code> to transpilator HackerScript. Wyjście jest kolorowe (zielony — sukces, czerwony — błąd, cyjan — nazwy) z procentowym paskiem postępu; kolory wyłącza zmienna <code>NO_COLOR</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Komenda</th><th>Co robi</th></tr></thead><tbody><tr><td><code>hackerc check plik.hcs</code></td><td>parsowanie + typecheck, bez generowania kodu</td></tr><tr><td><code>hackerc lint plik.hcs</code></td><td>tylko ostrzeżenia (podzbiór <code>check</code>)</td></tr><tr><td><code>hackerc build plik.hcs -o katalog</code></td><td>pełny crate Rust (<code>Cargo.toml</code> + <code>src/</code>); przy <code>u" + "se &lt;lang:javascript&gt;</code> / <code>u" + "se &lt;mode:website&gt;</code> zmienia cel</td></tr><tr><td><code>hackerc fmt plik.hcs [-o wynik] [--check]</code></td><td>formatuje kod; <code>--check</code> zwraca kod 1, gdy plik nie jest sformatowany</td></tr><tr><td><code>hackerc js plik.hcs -o plik.js</code></td><td>backend JavaScript</td></tr><tr><td><code>hackerc website plik.hcs -o dist</code></td><td>strona: <code>index.html</code> + <code>app.js</code></td></tr><tr><td><code>hackerc kotlin plik.hcs -o plik.kt</code></td><td>eksperymentalny backend Kotlina</td></tr><tr><td><code>hackerc lsp</code></td><td>Language Server po stdio (patrz „Language Server”)</td></tr><tr><td><code>hackerc hlib build|inspect|verify|keygen</code></td><td>archiwa <code>.hlib</code></td></tr><tr><td><code>hackerc emit-module plik.hcs -o plik.rs --module-name n</code></td><td>jeden plik → jeden moduł <code>.rs</code> (używane wewnętrznie przez <code>bit</code> przy <code>using &lt;inna-wersja&gt;</code>)</td></tr><tr><td><code>hackerc --version</code>, <code>-h</code></td><td>wersja / pomoc</td></tr></tbody></table></div><h3>Opcje komendy build</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Opcja</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>-o</code>, <code>--output</code></td><td>katalog wyjściowy (domyślnie <code>target-hcs</code> obok pliku źródłowego)</td></tr><tr><td><code>--crate-name nazwa</code></td><td>nazwa generowanego crate'a</td></tr><tr><td><code>--bin-name nazwa</code></td><td>nazwa binarki</td></tr><tr><td><code>--library</code></td><td>buduj jako bibliotekę (<code>[lib]</code>)</td></tr><tr><td><code>--libs-root</code>, <code>--bootstrap-root</code>, <code>--bit-root</code></td><td>ścieżki do bibliotek i korzenia <code>bit</code> (ustawiane zwykle przez <code>bit</code>)</td></tr><tr><td><code>--version-map w1=p1;w2=p2</code></td><td>mapa wersja → binarka dla <code>using &lt;wersja&gt;</code> per plik</td></tr></tbody></table></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>Flagi przyjmują wartość po spacji (<code>-o katalog</code>); składnia <code>--long=wartość</code> nie jest obsługiwana.</div><h3>Zmienne środowiskowe</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Zmienna</th><th>Działanie</th></tr></thead><tbody><tr><td><code>NO_COLOR</code></td><td>wyłącza kolory w wyjściu CLI</td></tr><tr><td><code>HACKERC_NO_CACHE=1</code></td><td>wyłącza cache budowania</td></tr><tr><td><code>BIT_LIBS</code></td><td>ustawiana przez <code>bit</code> — katalog bibliotek dla <code>get &lt;bit:...&gt;</code></td></tr><tr><td><code>HKS_HOT_OUT_DIR</code></td><td>katalog wyjściowy dla <code>@" + "hot_reload</code></td></tr></tbody></table></div>\n</section>\n\n<section class=\"doc-section\" id=\"hack3rc\">\n  <span class=\"kicker\">Narzędzia</span>\n  <h2>Kompilator AOT: hack3rc</h2>\n  <p><code>hack3rc</code> kompiluje <strong>podzbiór HackerScript do natywnych plików wykonywalnych</strong> przez <a href=\"https://cranelift.dev\" target=\"_blank\" rel=\"noopener\">Cranelift</a>, dla x86_64, aarch64, riscv64 i s390x. Nie transpiluje do Rusta i nie woła <code>cargo</code> — kompilacja programu trwa dziesiątki milisekund. Frontend (lexer, parser, AST) jest współdzielony z <code>hackerc</code>, więc program przyjęty przez <code>hack3rc</code> jest też poprawnym programem HackerScript i daje to samo wyjście.</p><div class=\"code-block\"><div class=\"code-label\"><span>bash</span><button class=\"copy-btn\" data-copy-target=\"code-39\">Kopiuj</button></div><pre id=\"code-39\"><code>hack3rc program.hcs                    <span class=\"tok-com\"># -&gt; ./program (natywny plik wykonywalny)</span>\nhack3rc program.hcs -o out             <span class=\"tok-com\"># własna nazwa wyniku</span>\nhack3rc program.hcs --run              <span class=\"tok-com\"># zbuduj i uruchom (kod wyjścia = kod programu)</span>\nhack3rc program.hcs --check            <span class=\"tok-com\"># tylko analiza, bez generowania kodu</span>\nhack3rc program.hcs --emit obj|ir      <span class=\"tok-com\"># tylko obiekt / IR</span>\nhack3rc program.hcs -O0|-O1|-O2        <span class=\"tok-com\"># optymalizacja Cranelift (domyślnie -O1)</span>\nhack3rc program.hcs --dump-clif        <span class=\"tok-com\"># Cranelift IR na stderr</span>\n\n<span class=\"tok-com\"># cross-kompilacja</span>\nhack3rc program.hcs --target aarch64 -o prog-arm\nhack3rc program.hcs --target aarch64 --run                    <span class=\"tok-com\"># uruchom pod QEMU</span>\nhack3rc program.hcs --target aarch64 --cc \"zig cc -target aarch64-linux-gnu\"</code></pre></div><h3>Zakres języka</h3><ul><li><strong>Obsługiwane:</strong> <code>Int</code>, <code>Float</code>, <code>Bool</code>, <code>Str</code>, <code>List&lt;T&gt;</code>, <code>Option&lt;T&gt;</code>, własne <code>struct</code> i <code>enum</code> (także rekurencyjne), <code>impl</code> z metodami, <code>match</code> na <code>enum</code> i <code>Option</code>, pętle <code>while</code> / <code>for x in lista</code>, przypisania złożone, rzutowania <code>as</code>, metody <code>Str</code> i list, funkcje matematyczne (<code>sqrt sin cos tan exp ln floor ceil fabs pow abs</code>), <code>read_int()</code>, <code>exit(Int)</code>.</li><li><strong>Nieobsługiwane</strong> (czytelny błąd <code>H0xxx</code>, nie crash): <code>Dict</code>, <code>Result</code> i <code>?</code>, <code>for</code> po czymkolwiek poza listą, funkcje asocjacyjne, <code>get</code> / <code>include</code>, <code>native</code> / <code>direct</code>, async i kanały.</li><li><strong>Pamięć:</strong> obiekty trafiają na stertę zarządzaną przez konserwatywny odśmiecacz mark-sweep (start po 8 MB). <code>HKS_GC_STRESS=1</code> odśmieca przy każdej alokacji.</li><li><strong>Semantyka:</strong> arytmetyka <code>Int</code> zawija się; dzielenie przez zero i indeks poza zakresem kończą program kodem 101; <code>.clone()</code> kopiuje głęboko.</li></ul><p>Błędy mają kod, linię i kolumnę (np. <code>error[H0073]: argument 2 ...</code>); błędy składni pochodzą z parsera <code>hackerc</code> (<code>E0100</code>). Pełny opis, tabela kodów i architektura (IR, backend, runtime): <code>docs/HACK3RC.md</code>.</p>\n</section>\n\n<section class=\"doc-section\" id=\"lsp\">\n  <span class=\"kicker\">Narzędzia</span>\n  <h2>Language Server (LSP)</h2>\n  <p><code>hackerc lsp</code> uruchamia serwer <strong>Language Server Protocol</strong> (JSON-RPC 2.0 po stdio, LSP 3.17) dla pojedynczego pliku — działa nawet poza katalogiem z <code>Bit.hk</code>. <code>bit lsp</code> to cienka nakładka z pełnym kontekstem workspace; w edytorze (VS Code, Neovim, dowolny klient LSP) ustaw jako komendę serwera <code>bit lsp</code> w katalogu projektu albo <code>hackerc lsp</code> jako fallback.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja LSP</th><th>Stan</th><th>Jak działa</th></tr></thead><tbody><tr><td><code>publishDiagnostics</code></td><td>jest</td><td>ten sam pipeline co <code>hackerc check</code></td></tr><tr><td><code>hover</code></td><td>jest</td><td>sygnatura <code>fun</code>, ciało <code>struct</code> / <code>enum</code>, opis wbudowanych i słów kluczowych</td></tr><tr><td><code>definition</code></td><td>jest</td><td>pierwsza deklaracja o tej nazwie; od 0.6 także w plikach z <code>include &lt;nazwa&gt;</code></td></tr><tr><td><code>completion</code></td><td>jest</td><td>słowa kluczowe, wbudowane i deklaracje z dokumentu (filtruje klient)</td></tr><tr><td><code>formatting</code></td><td>jest</td><td>nakładka na <code>formatter.hcs</code> (dokumenty bez błędów składni)</td></tr><tr><td><code>rename</code>, <code>references</code>, <code>documentSymbol</code></td><td>jest (0.6)</td><td>skan tekstu: całe słowa, z pominięciem literałów i komentarzy</td></tr><tr><td><code>codeAction</code></td><td>planowane</td><td>szybkie poprawki na bazie diagnostyk <code>bit repair</code></td></tr></tbody></table></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span>Implementacja jest oparta na <strong>tekście</strong>, nie na AST z pozycjami: <code>rename</code> nie analizuje zasięgów (dwie zmienne o tej samej nazwie w różnych funkcjach zostaną zmienione razem), a <code>definition</code> nie rozróżnia metod o tej samej nazwie w różnych <code>impl</code>. Serwer sprawdzono surowym JSON-RPC (<code>tests/lsp/</code>), ale nie w prawdziwym edytorze.</div>\n</section>\n\n<section class=\"doc-section\" id=\"wydajnosc\">\n  <span class=\"kicker\">Narzędzia</span>\n  <h2>Wydajność i cache budowania</h2>\n  <p>Wersja 0.6 przyspieszyła transpilację około <strong>6×</strong>. Pomiar: <code>hackerc</code> transpilujący własne źródła na jednym rdzeniu.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Wersja</th><th>Czas</th></tr></thead><tbody><tr><td>0.5 (stage0 z Releases)</td><td>~2 min 51 s</td></tr><tr><td>0.5 (zbudowany ze źródeł)</td><td>~1 min 56 s</td></tr><tr><td><strong>0.6</strong></td><td><strong>~19–25 s</strong></td></tr><tr><td>0.6, ponowny build bez zmian (cache)</td><td>~3 s</td></tr><tr><td>mały projekt, trafienie w cache</td><td>kilka ms</td></tr></tbody></table></div><ul><li><strong>Mniej klonowania:</strong> <code>infer_type</code> nie buduje już <code>TypeEnv(sigs.clone(), vars.clone())</code> przy każdym wywołaniu (głęboki klon był ~50% czasu).</li><li>**<code>s = s + x</code> dla <code>Str</code>** generuje <code>s.push_str(..)</code> zamiast <code>format!(\"{}{}\", s, x)</code> (było O(n²)); wymaga znanego typu <code>Str</code> zmiennej.</li><li><strong>Cache:</strong> klucz = sól formatu + parametry + hash treści każdego odkrytego pliku (z <code>std</code> / <code>core</code>); zapis w <code>&lt;out&gt;/.hks-cache/build.txt</code>, tylko po buildzie bez ostrzeżeń.</li><li>Pliki wynikowe są zapisywane tylko przy zmianie treści, więc <code>cargo</code> nie przebudowuje niezmienionego.</li><li>Wyłączenie: <code>HACKERC_NO_CACHE=1</code>. Czyszczenie: <code>rm -rf &lt;out&gt;/.hks-cache</code>. Zmiana samego komentarza unieważnia cache (hashowana jest surowa treść).</li></ul>\n</section>\n\n<section class=\"doc-section\" id=\"diagnostyki\">\n  <span class=\"kicker\">Narzędzia</span>\n  <h2>Diagnostyki i kody błędów</h2>\n  <p>Błędy i ostrzeżenia są renderowane w stylu rustc: kod, komunikat, lokalizacja <code>plik:linia:kolumna</code> i podkreślona linia źródła.</p><div class=\"code-block\"><div class=\"code-label\"><span>hackerc check e1.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-40\">Kopiuj</button></div><pre id=\"code-40\"><code>error[E0001]: 'dodaj' oczekuje 2 argument(ow), otrzymano 1\n  --&gt; e1.hcs:7:1\n  |\n7 |     log(dodaj(1))\n  | ^^^^^\n\nwarning[W0001]: zmienna 'nieuzywana' jest zadeklarowana, ale nigdy nie uzyta\n  --&gt; e1.hcs:6:1\n  |\n6 |     let nieuzywana = 1\n  | ^^^^^^^^^^</code></pre></div><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Kod</th><th>Poziom</th><th>Znaczenie</th></tr></thead><tbody><tr><td><code>E0001</code></td><td>błąd</td><td>zła liczba argumentów wywołania funkcji (także funkcji z <code>region</code>)</td></tr><tr><td><code>E0002</code></td><td>błąd</td><td>funkcja deklaruje typ zwracany, ale nigdzie nie ma <code>end &lt;wartość&gt;</code></td></tr><tr><td><code>E0003</code></td><td>błąd</td><td>nieznane źródło w <code>get &lt;źródło:nazwa&gt;</code></td></tr><tr><td><code>E0005</code></td><td>błąd</td><td>zmienna zadeklarowana jako jeden typ, a przypisana wartość ma inny wywnioskowany typ</td></tr><tr><td><code>E0011</code></td><td>błąd</td><td><code>?</code> użyte w funkcji, która nie zwraca <code>Result&lt;T,E&gt;</code> ani <code>Option&lt;T&gt;</code></td></tr><tr><td><code>E0100</code></td><td>błąd</td><td>błąd składni (z parsera; widoczny też w <code>hack3rc</code>)</td></tr><tr><td><code>W0001</code></td><td>ostrzeżenie</td><td>zmienna zadeklarowana, ale nigdy nieużyta</td></tr><tr><td><code>W0002</code></td><td>ostrzeżenie</td><td>wywołanie nieznanej funkcji — często ograniczenie bootstrapu przy funkcjach pochodzących z <code>get &lt;...&gt;</code></td></tr><tr><td><code>H0xxx</code></td><td>błąd</td><td>diagnostyki kompilatora AOT <code>hack3rc</code> (typy, wywołania, <code>let</code>, <code>match</code>, listy…) — tabela w „Kompilator AOT hack3rc”</td></tr></tbody></table></div><div class=\"note note\"><span class=\"note-title\">Uwaga:</span>Węzły AST nie niosą jeszcze numerów linii i kolumn, więc część diagnostyk wskazuje linię przybliżoną (wyszukiwaną w tekście). To jeden z otwartych punktów — patrz „Roadmap”.</div>\n</section>\n\n<section class=\"doc-section\" id=\"biblioteka\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>Biblioteka standardowa — przegląd</h2>\n  <p>Biblioteka składa się z dwóch członków workspace, napisanych w 100% w HackerScript: **<code>std</code>** (<code>libs/std/lib/</code>) i **<code>core</code>** (<code>libs/core/lib/</code>). Importujesz je przez <code>get &lt;std:moduł&gt;</code> / <code>get &lt;core:moduł::podmoduł&gt;</code> — opcjonalnie z <code>import &lt;nazwa1::nazwa2&gt;</code>, żeby wciągnąć tylko wybrane nazwy.</p><div class=\"code-block\"><div class=\"code-label\"><span>import_std.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-41\">Kopiuj</button></div><pre id=\"code-41\"><code><span class=\"tok-kw\">get</span> &lt;std:string&gt;\n<span class=\"tok-kw\">get</span> &lt;std:path&gt; <span class=\"tok-kw\">import</span> &lt;path_join::path_basename&gt;\n<span class=\"tok-kw\">get</span> &lt;core:memory::arena&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    log(path_join(<span class=\"tok-str\">\"a\"</span>, <span class=\"tok-str\">\"b\"</span>), path_basename(<span class=\"tok-str\">\"/x/y/plik.txt\"</span>))\n    log(str_join([<span class=\"tok-str\">\"a\"</span>, <span class=\"tok-str\">\"b\"</span>, <span class=\"tok-str\">\"c\"</span>], <span class=\"tok-str\">\"-\"</span>))\n]</code></pre></div><div class=\"grid-cards\"><div class=\"card\"><h4>fs / io / path</h4><p>System plików, wejście-wyjście, operacje na ścieżkach.</p></div><div class=\"card\"><h4>string / math</h4><p>Operacje tekstowe i matematyczne (<code>PI</code>, <code>E</code>).</p></div><div class=\"card\"><h4>json / toml / hk</h4><p>Parsery i serializery formatów danych, w tym formatu manifestu <code>.hk</code>.</p></div><div class=\"card\"><h4>http / process / env</h4><p>Zapytania HTTP, uruchamianie poleceń, zmienne środowiskowe.</p></div><div class=\"card\"><h4>term</h4><p>Kolorowe CLI, pasek postępu renderowany w miejscu, rozmiar terminala.</p></div><div class=\"card\"><h4>result / os</h4><p>Pomocniki <code>Result</code> / <code>Option</code> oraz predykaty systemu docelowego.</p></div><div class=\"card\"><h4>cybersecurity</h4><p>Porównania w stałym czasie, entropia Shannona, SHA-256, HMAC, hex.</p></div><div class=\"card\"><h4>core / memory</h4><p>Cztery alokatory: arena, chained_arena, stack_allocator, pool_allocator.</p></div></div><div class=\"note tip\"><span class=\"note-title\">Wskazówka:</span><code>read_file()</code> / <code>write_file()</code> oraz <code>dir_exists()</code>, <code>create_dir()</code>, <code>remove_file()</code>, <code>list_dir()</code> są <strong>wbudowane w kompilator</strong> i działają wszędzie bez importu — <code>std:io</code> i <code>std:fs</code> dodają tylko wygodne warianty (<code>*_ok</code>, <code>*_or</code>).</div>\n</section>\n\n<section class=\"doc-section\" id=\"std-tekst\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>std: string, math, path, result</h2>\n  <h3>std:string</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>str_is_space(c)</code></td><td>czy znak jest białym znakiem</td></tr><tr><td><code>str_starts_with(s, prefix)</code>, <code>str_ends_with(s, suffix)</code></td><td>początek / koniec napisu</td></tr><tr><td><code>str_contains(s, needle)</code></td><td>czy zawiera podnapis</td></tr><tr><td><code>str_index_of(s, needle) -&gt; Option&lt;Int&gt;</code></td><td>indeks pierwszego wystąpienia</td></tr><tr><td><code>str_split(s, sep) -&gt; List&lt;Str&gt;</code>, <code>str_join(parts, sep)</code></td><td>dzielenie / łączenie</td></tr><tr><td><code>str_trim(s)</code>, <code>str_replace(s, from, to)</code>, <code>str_repeat(s, n)</code></td><td>przycinanie, zamiana, powtarzanie</td></tr><tr><td><code>str_to_int(s) -&gt; Option&lt;Int&gt;</code>, <code>str_to_float(s) -&gt; Option&lt;Float&gt;</code></td><td>parsowanie liczb</td></tr></tbody></table></div><h3>std:math</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja / stała</th><th>Opis</th></tr></thead><tbody><tr><td><code>PI</code>, <code>E</code></td><td>stałe <code>Float</code></td></tr><tr><td><code>math_abs_int</code>, <code>math_abs_float</code></td><td>wartość bezwzględna</td></tr><tr><td><code>math_min_int</code>, <code>math_max_int</code>, <code>math_min_float</code>, <code>math_max_float</code></td><td>minimum / maksimum</td></tr><tr><td><code>math_pow_int(base, exp)</code>, <code>math_pow_float(base, exp)</code></td><td>potęgowanie (wykładnik <code>Int</code>)</td></tr><tr><td><code>math_sqrt</code>, <code>math_floor</code>, <code>math_ceil</code>, <code>math_round</code></td><td>pierwiastek i zaokrąglenia na <code>Float</code></td></tr></tbody></table></div><h3>std:path</h3><p>Separator uniksowy <code>/</code>, zbudowane na <code>std:string</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>path_join(a, b)</code></td><td>łączy dwie części ścieżki</td></tr><tr><td><code>path_basename(p)</code>, <code>path_dirname(p)</code>, <code>path_extension(p)</code></td><td>nazwa pliku / katalog / rozszerzenie</td></tr><tr><td><code>path_is_absolute(p)</code>, <code>path_segments(p)</code></td><td>czy bezwzględna / lista segmentów</td></tr></tbody></table></div><h3>std:result</h3><p>Prawdziwe generyki dla <code>Result&lt;T,E&gt;</code> i <code>Option&lt;T&gt;</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>unwrap_or(r, domyslna)</code></td><td>wartość z <code>Ok</code> albo wartość domyślna</td></tr><tr><td><code>unwrap_or_default(o, domyslna)</code></td><td>to samo dla <code>Option&lt;T&gt;</code></td></tr><tr><td><code>is_ok(r)</code>, <code>is_err(r)</code>, <code>is_some(o)</code></td><td>predykaty bez <code>match</code></td></tr></tbody></table></div>\n</section>\n\n<section class=\"doc-section\" id=\"std-system\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>std: fs, io, env, process, http, os</h2>\n  <h3>std:fs i std:io</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>ensure_dir(path) -&gt; Result&lt;Void, Str&gt;</code></td><td>tworzy katalog (z rodzicami), jeśli go nie ma</td></tr><tr><td><code>create_dir_ok(path)</code>, <code>remove_dir_all_ok(path)</code>, <code>copy_file_ok(src, dest)</code></td><td>warianty zwracające <code>Bool</code> zamiast <code>Result</code></td></tr><tr><td><code>list_dir_or_empty(path) -&gt; List&lt;Str&gt;</code></td><td>lista nazw; brak katalogu = pusta lista</td></tr><tr><td><code>list_dir_full_paths(path) -&gt; Result&lt;List&lt;Str&gt;, Str&gt;</code></td><td>pełne ścieżki (<code>path/nazwa</code>) zamiast samych nazw</td></tr><tr><td><code>read_file_or(path, domyslna) -&gt; Str</code></td><td>treść pliku albo wartość domyślna</td></tr><tr><td><code>file_readable(path) -&gt; Bool</code></td><td>czy plik istnieje (działa też dla plików binarnych)</td></tr><tr><td><code>write_file_ok(path, tresc) -&gt; Bool</code></td><td>zapis zwracający <code>true</code> / <code>false</code></td></tr></tbody></table></div><h3>std:env</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>env_var_or(name, default)</code></td><td>zmienna środowiskowa albo wartość domyślna</td></tr><tr><td><code>env_var_present(name)</code></td><td>czy zmienna jest ustawiona (nawet pusta)</td></tr><tr><td><code>env_path_entries() -&gt; List&lt;Str&gt;</code></td><td><code>PATH</code> rozbite na wpisy</td></tr></tbody></table></div><h3>std:process</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>run_command_checked(program, args)</code></td><td><code>Result&lt;Str, Str&gt;</code>; błąd z informacją, który program zawiódł</td></tr><tr><td><code>command_succeeds(program, args) -&gt; Bool</code></td><td>czy polecenie zakończyło się sukcesem (np. sprawdzenie narzędzia)</td></tr><tr><td><code>run_command_simple(program)</code></td><td>polecenie bez argumentów</td></tr><tr><td><code>run_command_combined_labeled(program, args)</code></td><td>stdout + stderr z nagłówkiem <code>$ program args</code></td></tr><tr><td><code>run_command_inherit_ok(program, args) -&gt; Bool</code></td><td>dziedziczy stdio; <code>true</code> przy kodzie 0</td></tr><tr><td><code>run_capture(program, args) -&gt; Result&lt;CmdOutput, Str&gt;</code></td><td>kod wyjścia, stdout i stderr osobno (<code>CmdOutput { code, stdout, stderr }</code>)</td></tr><tr><td><code>run_capture_input(program, args, input)</code></td><td>jak <code>run_capture</code>, ale z tekstem na stdin</td></tr><tr><td><code>run_tee(program, args)</code></td><td>wyjście na żywo (jak <code>tee</code>) i pełny zapis w <code>CmdOutput</code></td></tr></tbody></table></div><h3>std:http</h3><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>http_get_checked(url)</code>, <code>http_get_ok(url)</code></td><td>GET z kontekstem błędu / sprawdzenie powodzenia</td></tr><tr><td><code>http_get_with_header(url, header, value)</code></td><td>GET z jednym nagłówkiem</td></tr><tr><td><code>http_post(url, body)</code>, <code>http_post_json(url, json)</code>, <code>http_post_typed(url, body, content_type)</code></td><td>POST tekstowy / JSON / z dowolnym <code>Content-Type</code></td></tr><tr><td><code>http_put(url, body)</code>, <code>http_delete(url)</code></td><td>PUT, DELETE</td></tr><tr><td><code>http_status(url) -&gt; Int</code></td><td>kod statusu GET (0 gdy brak połączenia)</td></tr><tr><td><code>http_download(url, path) -&gt; Result&lt;Int, Str&gt;</code></td><td>strumieniowo do pliku, także binarnego; zwraca liczbę bajtów</td></tr><tr><td><code>http_get_lines(url) -&gt; Result&lt;List&lt;Str&gt;, Str&gt;</code></td><td>ciało jako lista linii, czytane strumieniowo</td></tr></tbody></table></div><h3>std:os</h3><p><code>os_name</code>, <code>os_is_linux</code>, <code>os_is_windows</code>, <code>os_is_macos</code>, <code>os_is_ios</code>, <code>os_is_android</code>, <code>os_is_unix</code>, <code>os_is_mobile</code>, <code>os_path_separator</code>, <code>os_exe_suffix</code>, <code>os_shared_lib_ext</code> — patrz „Dyrektywy use”.</p>\n</section>\n\n<section class=\"doc-section\" id=\"std-dane\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>std: json, toml, hk, term</h2>\n  <h3>std:json</h3><p>Parser rekurencyjnie zstępujący. Drzewo wartości to <code>enum JsonValue</code> z wariantami <code>JsonNull</code>, <code>JsonBool(Bool)</code>, <code>JsonNumber(Float)</code>, <code>JsonString(Str)</code>, <code>JsonArray(List&lt;JsonValue&gt;)</code> i <code>JsonObject(List&lt;JsonEntry&gt;)</code>; <code>JsonEntry</code> ma pola <code>key</code> i <code>value</code>. Obiekt jest listą wpisów (nie <code>Dict</code>), więc zachowuje kolejność kluczy.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>json_parse(s) -&gt; Result&lt;JsonValue, Str&gt;</code></td><td>parsuje JSON; <code>Err(opis)</code> przy pierwszym błędzie składni (obsługuje <code>\\uXXXX</code>)</td></tr><tr><td><code>json_stringify(v) -&gt; Str</code></td><td>serializacja drzewa do JSON</td></tr><tr><td><code>json_escape_string(s)</code></td><td>escape'owanie napisu</td></tr></tbody></table></div><h3>std:toml</h3><p>Minimalny, praktyczny podzbiór TOML: <code>klucz = wartość</code>, <code>[sekcje]</code>, <code>[[tablice tabel]]</code>, tablice, napisy, liczby, wartości logiczne. Wynik to <code>JsonValue</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>toml_parse(s) -&gt; Result&lt;JsonValue, Str&gt;</code></td><td>parsowanie</td></tr><tr><td><code>toml_stringify(root) -&gt; Result&lt;Str, Str&gt;</code></td><td>serializacja (0.6)</td></tr></tbody></table></div><h3>std:hk</h3><p>Parser i serializer formatu <code>.hk</code> używanego przez <code>Bit.hk</code>: dowolne zagnieżdżenie <code>-&gt;</code> / <code>--&gt;</code> / <code>---&gt;</code>, klucze kropkowe, interpolacja <code>${sekcja.klucz}</code> i <code>${env:VAR}</code>. Wynik to <code>JsonValue</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>hk_parse(source) -&gt; Result&lt;JsonValue, Str&gt;</code></td><td>parsuje tekst <code>.hk</code></td></tr><tr><td><code>hk_resolve_interpolations(config)</code></td><td>rozwija <code>${...}</code></td></tr><tr><td><code>hk_serialize(config) -&gt; Str</code></td><td>zapis z powrotem do tekstu <code>.hk</code></td></tr><tr><td><code>hk_lookup_path(root, path)</code></td><td>wartość pod ścieżką (np. <code>package.name</code>)</td></tr></tbody></table></div><h3>std:term</h3><p>Kolory ANSI, pasek postępu i informacje o terminalu. Kolory wyłączają się automatycznie przy ustawionym <code>NO_COLOR</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>c_red</code>, <code>c_green</code>, <code>c_yellow</code>, <code>c_blue</code>, <code>c_magenta</code>, <code>c_cyan</code>, <code>c_gray</code>, <code>c_bold</code>, <code>c_dim</code>, <code>c_bold_green</code>, <code>c_bold_red</code>, <code>c_bold_yellow</code>, <code>c_bold_cyan</code></td><td>kolorują napis (no-op bez kolorów)</td></tr><tr><td><code>ansi_*</code>, <code>colorize(text, color)</code>, <code>term_color_enabled()</code>, <code>term_use_color()</code></td><td>surowe kody ANSI i sterowanie kolorami</td></tr><tr><td><code>render_bar(current, total, width)</code>, <code>render_progress_line(label, current, total, item)</code>, <code>print_progress_line(...)</code></td><td>pasek postępu renderowany w miejscu</td></tr><tr><td><code>term_size() -&gt; Option&lt;TermSize&gt;</code>, <code>term_width()</code>, <code>term_height()</code></td><td>rozmiar terminala (<code>TermSize { cols, rows }</code>)</td></tr><tr><td><code>term_stdout_is_tty()</code>, <code>term_stdin_is_tty()</code>, <code>term_set_raw(enable)</code></td><td>TTY i tryb surowy</td></tr></tbody></table></div>\n</section>\n\n<section class=\"doc-section\" id=\"std-security\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>std: cybersecurity</h2>\n  <p>Moduły: <code>std:cybersecurity::constant_time</code>, <code>::entropy</code>, <code>::encoding</code>.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Opis</th></tr></thead><tbody><tr><td><code>constant_time_eq(a: List&lt;Int&gt;, b: List&lt;Int&gt;) -&gt; Int</code></td><td>porównanie bajtów w stałym czasie; <code>1</code> = równe, <code>0</code> = różne</td></tr><tr><td><code>ct_eq(a, b) -&gt; Bool</code></td><td>stałoczasowe porównanie napisów (hashe, tokeny, podpisy); różne długości dają <code>false</code> od razu</td></tr><tr><td><code>sha256_matches(data, expected_hex) -&gt; Bool</code></td><td>czy SHA-256 tekstu zgadza się z oczekiwanym skrótem (porównanie stałoczasowe)</td></tr><tr><td><code>byte_histogram(data)</code>, <code>shannon_entropy(data) -&gt; Float</code></td><td>histogram bajtów / entropia w bitach na bajt (0.0–8.0)</td></tr><tr><td><code>looks_encrypted(data, threshold) -&gt; Bool</code></td><td>czy entropia przekracza próg (zwykle sugerowane 7.2) — detekcja packerów / szyfrowania</td></tr><tr><td><code>hex_encode(text)</code>, <code>hex_decode(hex) -&gt; Result&lt;Str, Str&gt;</code></td><td>bajty UTF-8 ↔ cyfry hex</td></tr><tr><td><code>sha256_text_hex(text)</code>, <code>hmac_sha256_hex(key, message)</code></td><td>SHA-256 (64 znaki hex) i HMAC-SHA256 (RFC 2104)</td></tr><tr><td><code>random_hex(n)</code></td><td><code>n</code> losowych bajtów z <code>/dev/urandom</code> jako hex (Unix)</td></tr></tbody></table></div><div class=\"code-block\"><div class=\"code-label\"><span>ct_eq.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-42\">Kopiuj</button></div><pre id=\"code-42\"><code><span class=\"tok-kw\">get</span> &lt;std:cybersecurity::entropy&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> a = <span class=\"tok-str\">\"token-abc\"</span>\n    <span class=\"tok-kw\">let</span> b = <span class=\"tok-str\">\"token-abd\"</span>\n    log(ct_eq(a, a), ct_eq(a, b))\n]</code></pre></div><div class=\"note warn\"><span class=\"note-title\">Ograniczenie:</span><code>a == b</code> na napisach może wyjść z porównania przy pierwszej niezgodności (atak czasowy) — do sekretów używaj <code>ct_eq</code>.</div>\n</section>\n\n<section class=\"doc-section\" id=\"core-memory\">\n  <span class=\"kicker\">Biblioteka</span>\n  <h2>core: alokatory pamięci</h2>\n  <p><code>core</code> zawiera cztery alokatory w <code>libs/core/lib/memory/</code>. Wartości są dziś <code>Int</code>, a „wskaźnik” to indeks zwracany przez alokator.</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Moduł</th><th>Typ</th><th>Funkcje</th></tr></thead><tbody><tr><td><code>memory::arena</code></td><td><code>Arena</code></td><td><code>arena_new(capacity)</code>, <code>arena_alloc(a, value) -&gt; Int</code>, <code>arena_get(a, idx) -&gt; Int</code>, <code>arena_reset(a)</code></td></tr><tr><td><code>memory::chained_arena</code></td><td><code>ChainedArena</code></td><td><code>chained_arena_new(block_size)</code>, <code>chained_arena_alloc(ca, value)</code>, <code>chained_arena_block_count(ca)</code></td></tr><tr><td><code>memory::stack_allocator</code></td><td><code>StackAllocator</code></td><td><code>stack_new()</code>, <code>stack_push(s, value)</code>, <code>stack_pop(s)</code>, <code>stack_peek(s)</code>, <code>stack_len(s)</code></td></tr><tr><td><code>memory::pool_allocator</code></td><td><code>Pool</code></td><td><code>pool_new()</code>, <code>pool_alloc(p, value)</code>, <code>pool_free(p, idx)</code>, <code>pool_get(p, idx)</code></td></tr></tbody></table></div><div class=\"code-block\"><div class=\"code-label\"><span>arena.hcs</span><button class=\"copy-btn\" data-copy-target=\"code-43\">Kopiuj</button></div><pre id=\"code-43\"><code><span class=\"tok-kw\">get</span> &lt;core:memory::arena&gt;\n\n<span class=\"tok-kw\">fun</span> <span class=\"tok-fn\">main</span>() [\n    <span class=\"tok-kw\">let</span> a = arena_new(<span class=\"tok-num\">16</span>)\n    <span class=\"tok-kw\">let</span> i = arena_alloc(a, <span class=\"tok-num\">42</span>)\n    log(arena_get(a, i))\n    arena_reset(a)\n]</code></pre></div><p>Pragma <code>gc:use::arena</code> wybiera strategię alokacji dla bieżącego zakresu.</p>\n</section>\n\n<section class=\"doc-section\" id=\"historia\">\n  <span class=\"kicker\">Projekt</span>\n  <h2>Historia wersji</h2>\n  <div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Wersja</th><th>Co przyniosła</th></tr></thead><tbody><tr><td><code>0.0.1</code></td><td><strong>zamrożona</strong> wersja startowa: <code>hackerc</code> w Pythonie, <code>bit</code> w Ruście — punkt odniesienia „skąd zaczęliśmy”</td></tr><tr><td><code>0.1</code></td><td><strong>bootstrap:</strong> <code>hackerc</code> i <code>bit</code> przepisane w całości na sam HackerScript, pierwsze wydanie binarne na GitHub Releases</td></tr><tr><td><code>0.2</code></td><td>kolorowe CLI i prawdziwy pasek postępu (<code>std:term</code>)</td></tr><tr><td><code>0.3</code></td><td>przeprojektowane FFI: <code>get &lt;extern:...&gt; u" + "se &lt;...&gt;</code> + <code>region</code>, <code>get &lt;c:...&gt;</code> / <code>get &lt;cpp:...&gt;</code>, <code>n" + "ative {C++}</code></td></tr><tr><td><code>0.4</code></td><td><code>get &lt;work:...&gt;</code> i <code>include &lt;work:...&gt;</code>, usunięta sekcja <code>[build]</code>, wspólny <code>cache/</code> workspace, <code>@" + "wasm_export</code> + <code>bit build --wasm</code>, playground</td></tr><tr><td><code>0.5</code></td><td>escape'y <code>\\xHH</code> / <code>\\u{...}</code>, JSON <code>\\uXXXX</code>, backend JavaScript, tryb strony, FFI Go / Java / Kotlin, <code>direct {backend}</code>, pierwszy LSP, kompilator AOT <code>hack3rc</code></td></tr><tr><td><code>0.6</code></td><td><strong>ta wersja:</strong> <code>u" + "se &lt;os:...&gt;</code>, <code>target_os()</code>, <code>std:os</code>; transpilacja ~6× szybsza + cache budowania; <code>Dict.items()</code>; <code>log()</code> dla struct / enum; LSP <code>rename</code> / <code>references</code> / <code>documentSymbol</code>; <code>toml_stringify</code>; <code>http_download</code>; <code>run_tee</code>; features w <code>get &lt;crates:...&gt;</code>; nowe CI i testy</td></tr></tbody></table></div>\n</section>\n\n<section class=\"doc-section\" id=\"roadmap\">\n  <span class=\"kicker\">Projekt</span>\n  <h2>Roadmap i status</h2>\n  <p>Skrót stanu na wersję 0.6. Pełna, chronologiczna wersja: <code>docs/ROADMAP.md</code>; autorytatywna lista otwartych punktów: <code>CHANGELOG.md</code> („Nadal otwarte”).</p><div class=\"table-wrap\"><table class=\"ref-table\"><thead><tr><th>Funkcja</th><th>Status</th></tr></thead><tbody><tr><td><code>fun</code> → Rust (<code>hackerc</code>), self-hosting</td><td><span class=\"status-pill ok\">działa, zweryfikowane CI</span></td></tr><tr><td>Backend JavaScript (<code>u" + "se &lt;lang:javascript&gt;</code>)</td><td><span class=\"status-pill ok\">działa, testy tests/js/</span></td></tr><tr><td>Tryb strony (<code>u" + "se &lt;mode:website&gt;</code>, <code>style { }</code>)</td><td><span class=\"status-pill ok\">zweryfikowane w jsdom</span></td></tr><tr><td>Kompilator AOT <code>hack3rc</code> (podzbiór języka)</td><td><span class=\"status-pill ok\">testy różnicowe z hackerc</span></td></tr><tr><td>Generyki <code>fun&lt;T&gt;</code>, <code>struct&lt;T&gt;</code>, <code>enum&lt;T&gt;</code></td><td><span class=\"status-pill ok\">deklaracje działają</span></td></tr><tr><td><code>async</code> / <code>await</code> / <code>spawn</code> / <code>chan</code></td><td><span class=\"status-pill ok\">Rust (tokio) i JavaScript</span></td></tr><tr><td><code>Set&lt;T&gt;</code>, <code>Dict.keys()/values()/items()</code></td><td><span class=\"status-pill ok\">działa</span></td></tr><tr><td><code>log()</code> dla struct / enum</td><td><span class=\"status-pill ok\">0.6</span></td></tr><tr><td><code>u" + "se &lt;os:...&gt;</code>, <code>target_os()</code></td><td><span class=\"status-pill ok\">0.6</span></td></tr><tr><td>LSP: hover, definition, completion, rename, references, symbole</td><td><span class=\"status-pill ok\">oparty na tekście</span></td></tr><tr><td>Archiwa <code>.hlib</code> (build / inspect / verify / keygen)</td><td><span class=\"status-pill ok\">działa</span></td></tr><tr><td><code>get &lt;npm:...&gt;</code> / <code>get &lt;jsr:...&gt;</code> w backendzie Rust</td><td><span class=\"status-pill wip\">tylko komentarz, bez importu</span></td></tr><tr><td><code>n" + "ative {JavaScript}</code> w backendzie JS</td><td><span class=\"status-pill wip\">niedostępne</span></td></tr><tr><td><code>f" + "ast direct</code> — statyczne linkowanie</td><td><span class=\"status-pill wip\">jest wersja dynamiczna</span></td></tr><tr><td><code>hack3rc</code>: <code>Dict</code>, <code>Result</code>, <code>?</code>, async, <code>native</code></td><td><span class=\"status-pill wip\">nieobsługiwane</span></td></tr><tr><td>Jawna adnotacja typu generycznej struktury (<code>Wrapper&lt;Int&gt;</code>)</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>Typ krotki</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>Pozycje linia/kolumna w AST</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>LSP oparty na AST (zasięgi, <code>codeAction</code>)</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>Trait / interface</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td><code>bit test</code> + <code>#[test]</code>, REPL</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>Podział <code>codegen.hcs</code> / <code>project.hcs</code> na mniejsze pliki</td><td><span class=\"status-pill planned\">planowane</span></td></tr><tr><td>Backend Cranelift w <code>hackerc</code></td><td><span class=\"status-pill gone\">zdjęte z planów (jest osobny hack3rc)</span></td></tr></tbody></table></div>\n</section>\n\n<section class=\"doc-section\" id=\"faq\">\n  <span class=\"kicker\">Projekt</span>\n  <h2>Najczęstsze pytania</h2>\n  <h3>Dlaczego <code>end</code> zamiast <code>return</code>?</h3><p><code>return</code> też działa i znaczy to samo, ale w całym repozytorium preferowane jest <code>end</code> — jest krótsze i pasuje do składni nawiasowej <code>[ ... ]</code>. Pamiętaj tylko, że ostatnie wyrażenie w bloku nie jest zwracane niejawnie.</p><h3>Czy mogę używać HackerScript bez Rusta?</h3><p>Tak, na trzy sposoby: backend JavaScript (<code>u" + "se &lt;lang:javascript&gt;</code>, potrzebny tylko Node.js), tryb strony (<code>u" + "se &lt;mode:website&gt;</code>, wystarczy przeglądarka) albo <code>hack3rc</code> (natywny plik wykonywalny bez <code>cargo</code>, wymaga tylko kompilatora C do linkowania).</p><h3>Skąd ostrzeżenie W0002 na funkcję z biblioteki standardowej?</h3><p><code>hackerc check</code> na pojedynczym pliku nie zawsze widzi funkcje z <code>get &lt;std:...&gt;</code> — to znane ograniczenie bootstrapu, nie błąd w programie. W projekcie budowanym przez <code>bit</code> sygnatury są zbierane z całego projektu.</p><h3>Jak zgłosić błąd?</h3><p>W repozytorium <a href=\"https://github.com/HackerOS-Linux-System/HackerScript\" target=\"_blank\" rel=\"noopener\">HackerOS-Linux-System/HackerScript</a>. Dołącz wersję (<code>hackerc --version</code>), minimalny plik <code>.hcs</code> i wynik <code>hackerc check</code>.</p><h3>Gdzie jest pełny opis składni?</h3><p>W <code>docs/SYNTAX.md</code> (mapa i samouczek) oraz <code>docs/GRAMMAR.md</code> (EBNF). W razie rozbieżności wygrywa kod <code>hackerc/cmd/lexer.hcs</code> i <code>hackerc/cmd/parser.hcs</code>.</p>\n</section>\n  </main>\n</div>\n\n<footer class=\"site-footer\">\n  <span><img src=\"https://raw.githubusercontent.com/HackerOS-Linux-System/HackerScript/main/images/icon.png\" alt=\"HackerScript\" width=\"96\" height=\"50\" class=\"logo-img\"></span>\n  <span>HackerScript © 2026 HackerOS Team — MIT</span>\n  <span>Dokumentacja generowana ze źródeł w <code>docs/</code>, <code>hackerc/</code> i <code>libs/</code>.</span>\n</footer>"

fun main() [
    boot_begin("pl", "HackerScript — dokumentacja")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("meta", ["name", "description", "content", "Dokumentacja języka HackerScript: składnia, typy, moduły, backendy (Rust, JavaScript, strona WWW, AOT), biblioteka standardowa i narzędzia."])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "https://raw.githubusercontent.com/HackerOS-Linux-System/HackerScript/main/images/icon.png"])
    boot_body(PAGE_BODY)
    hackerscript_docs_init()
    hackerscript_theme_init()
]
