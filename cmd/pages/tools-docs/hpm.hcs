use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>

style {
#app { display: none; }
:root{--bg:#080a0d;--bg2:#0d1017;--bg3:#111520;--border:#1c2030;--border2:#252d42;--red:#ff2040;--red2:#ff4060;--red3:#ff6080;--cyan:#00d4ff;--yellow:#ffd000;--green:#00ff88;--dim:#3a4558;--text:#c5d3e8;--text2:#6b7f99;--mono:'JetBrains Mono',monospace;--head:'Bebas Neue',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:13.5px;line-height:1.75;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,32,64,0.015) 3px,rgba(255,32,64,0.015) 4px);pointer-events:none;z-index:9999}
.layout{display:flex;min-height:100vh}
nav{width:250px;min-width:250px;background:var(--bg2);border-right:1px solid var(--border);position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.nav-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,rgba(255,32,64,0.12) 0%,transparent 100%)}
.logo-big{font-family:var(--head);font-size:48px;line-height:1;color:var(--red);text-shadow:0 0 40px rgba(255,32,64,0.6),0 0 80px rgba(255,32,64,0.2);letter-spacing:2px}
.logo-sub{color:var(--text2);font-size:10px;letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.logo-ver{color:var(--red3);font-size:11px;margin-top:6px}
.nav-section{padding:14px 20px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
nav a{display:block;padding:5px 20px 5px 28px;color:var(--text2);text-decoration:none;font-size:12px;transition:all .15s;position:relative;border-left:2px solid transparent}
nav a::before{content:'›';position:absolute;left:14px;color:var(--dim)}
nav a:hover{color:var(--text);background:rgba(255,32,64,0.04)}
nav a.active{color:var(--red);border-left-color:var(--red);background:rgba(255,32,64,0.07)}
nav a.active::before{color:var(--red)}
main{flex:1;max-width:860px;padding:0 64px 80px}
.hero{padding:64px 0 56px;border-bottom:1px solid var(--border);margin-bottom:64px;position:relative;overflow:hidden}
.hero::before{content:'HPM';position:absolute;right:-20px;top:-20px;font-family:var(--head);font-size:200px;color:rgba(255,32,64,0.04);pointer-events:none;user-select:none}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.3);color:var(--red);font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:24px}
.hero-tag::before{content:'◆';font-size:8px}
.hero h1{font-family:var(--head);font-size:64px;line-height:1;letter-spacing:3px;color:#fff;margin-bottom:6px}
.hero h1 span{color:var(--red);text-shadow:0 0 30px rgba(255,32,64,0.5)}
.hero-desc{color:var(--text2);font-size:14px;margin-bottom:32px;max-width:560px}
.hero-cmd{background:var(--bg3);border:1px solid var(--border2);border-left:3px solid var(--red);padding:14px 20px;border-radius:3px;display:inline-block;font-size:14px}
.prompt{color:var(--dim)}.cmd-s{color:var(--red)}.arg-s{color:var(--text)}
section{margin-bottom:72px}
h2{font-family:var(--head);font-size:28px;color:#fff;letter-spacing:2px;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.h2-num{font-size:11px;color:var(--red);letter-spacing:2px;border:1px solid rgba(255,32,64,0.3);padding:2px 8px;border-radius:2px;font-family:var(--mono)}
h2 a{color:var(--dim);text-decoration:none;font-size:16px;margin-left:auto}
h2 a:hover{color:var(--red)}
h3{font-size:13px;color:var(--red2);letter-spacing:1px;margin:28px 0 10px;text-transform:uppercase}
p{color:var(--text);margin-bottom:14px;max-width:680px}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;overflow-x:auto;margin:14px 0 24px;position:relative}
pre::before{content:attr(data-lang);position:absolute;top:8px;right:12px;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim)}
code{font-family:var(--mono);font-size:12.5px;color:var(--text)}
.hl-r{color:var(--red)}.hl-c{color:var(--cyan)}.hl-y{color:var(--yellow)}.hl-g{color:var(--green)}.hl-d{color:var(--dim)}.hl-w{color:#fff;font-weight:600}
ci{display:inline;background:rgba(255,32,64,0.1);border:1px solid rgba(255,32,64,0.2);padding:1px 6px;border-radius:2px;font-size:12px;color:var(--red2);font-family:var(--mono)}
.tbl{width:100%;border-collapse:collapse;margin:16px 0 24px}
.tbl th{text-align:left;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);padding:8px 14px;border-bottom:1px solid var(--border2)}
.tbl td{padding:9px 14px;border-bottom:1px solid var(--border);vertical-align:top}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(255,32,64,0.03)}
.tbl .tc{color:var(--red2);font-weight:500;white-space:nowrap}.tbl .ta{color:var(--yellow)}.tbl .td{color:var(--text2);font-size:12.5px}
.yes{color:var(--green)}.no{color:var(--red)}.par{color:var(--yellow)}
.box{border-radius:3px;padding:14px 18px;margin:14px 0 20px;border-left:3px solid;font-size:13px;max-width:680px}
.box-n{background:rgba(0,212,255,0.06);border-color:var(--cyan)}.box-w{background:rgba(255,208,0,0.06);border-color:var(--yellow)}.box-t{background:rgba(255,32,64,0.06);border-color:var(--red)}
.box strong{display:block;margin-bottom:4px;font-size:9px;letter-spacing:2px;text-transform:uppercase}
.box-n strong{color:var(--cyan)}.box-w strong{color:var(--yellow)}.box-t strong{color:var(--red)}
.tree{background:var(--bg3);border:1px solid var(--border);border-radius:3px;padding:20px 24px;margin:14px 0 24px;font-size:12.5px;line-height:2}
.td2{color:var(--red2)}.tf{color:var(--text)}.ta2{color:var(--dim);font-style:italic}.to{color:var(--dim)}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.badge{font-size:10px;padding:3px 10px;border-radius:2px;border:1px solid;letter-spacing:.5px}
.br{color:var(--red);border-color:rgba(255,32,64,0.3);background:rgba(255,32,64,0.08)}.bc{color:var(--cyan);border-color:rgba(0,212,255,0.3);background:rgba(0,212,255,0.08)}.by{color:var(--yellow);border-color:rgba(255,208,0,0.3);background:rgba(255,208,0,0.08)}.bg{color:var(--green);border-color:rgba(0,255,136,0.3);background:rgba(0,255,136,0.08)}
.ext{color:var(--red2);text-decoration:none;border-bottom:1px solid rgba(255,64,96,0.3)}
.ext:hover{color:var(--red);border-bottom-color:var(--red)}
ul.feat{color:var(--text2);margin:0 0 20px 20px;line-height:2}
footer{margin-top:80px;padding-top:24px;border-top:1px solid var(--border);color:var(--dim);font-size:11px}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--red)}
@media(max-width:860px){nav{display:none}main{padding:32px 20px}.hero h1{font-size:44px}}
}

let PAGE_BODY: Str = "<div class=\"layout\">\n<nav>\n  <div class=\"nav-logo\">\n    <div class=\"logo-big\">HPM</div>\n    <div class=\"logo-sub\">HackerOS Package Manager</div>\n    <div class=\"logo-ver\">v0.8.0 &middot; HackerOS Ecosystem</div>\n  </div>\n  <span class=\"nav-section\">Getting Started</span>\n  <a href=\"#overview\">Overview</a>\n  <a href=\"#quickstart\">Quickstart</a>\n  <span class=\"nav-section\">Usage</span>\n  <a href=\"#commands\">Command Reference</a>\n  <a href=\"#versions\">Version Management</a>\n  <a href=\"#sandbox\">Sandbox</a>\n  <span class=\"nav-section\">Packaging</span>\n  <a href=\"#repo-layout\">Repository Layout</a>\n  <a href=\"#manifest\">info.hk Manifest</a>\n  <a href=\"#build-toml\">build.toml</a>\n  <a href=\"#gui-apps\">GUI Applications</a>\n  <a href=\"#publish\">Publishing</a>\n  <span class=\"nav-section\">Reference</span>\n  <a href=\"#repo-json\">repo.json</a>\n  <a href=\"#store\">Store Layout</a>\n  <a href=\"#compare\">vs AUR / PPA</a>\n  <a href=\"#hk-format\">HK Format &#8599;</a>\n</nav>\n<main>\n\n<div class=\"hero\">\n  <div class=\"hero-tag\">Git-native &middot; Sandboxed &middot; HackerOS Ecosystem</div>\n  <h1><span>HPM</span></h1>\n  <p class=\"hero-desc\">HackerOS Package Manager &mdash; the native package manager of HackerOS. No binary archives. Packages are git repositories. Versions are git tags. Built exclusively for the HackerOS ecosystem.</p>\n  <div class=\"hero-cmd\"><span class=\"prompt\">$ </span><span class=\"cmd-s\">hpm</span> <span class=\"arg-s\">install &lt;package&gt;</span></div>\n</div>\n\n<section id=\"overview\">\n  <h2><span class=\"h2-num\">01</span> OVERVIEW <a href=\"#overview\">#</a></h2>\n  <div class=\"badges\">\n    <span class=\"badge br\">Git-native</span>\n    <span class=\"badge bc\">Linux namespaces</span>\n    <span class=\"badge by\">Landlock LSM</span>\n    <span class=\"badge bg\">HackerOS Ecosystem</span>\n    <span class=\"badge br\">Side-by-side versions</span>\n    <span class=\"badge bc\">GUI app support</span>\n  </div>\n  <p>Each package is a plain git repository with an <ci>info.hk</ci> manifest and a <ci>contents/</ci> directory, or a <ci>build.toml</ci> describing how to obtain the binary. No <ci>.deb</ci> archives &mdash; just git.</p>\n  <p>Every package runs in an isolated environment using Linux namespaces + Landlock. GUI apps get X11/Wayland/D-Bus access and are registered in the system app menu automatically.</p>\n  <h3>Install flow</h3>\n  <pre data-lang=\"flow\"><code><span class=\"hl-d\"># 1. Central index</span>\n{ \"mypkg\": { \"repo\": \"https://github.com/user/mypkg\" } }\n\n<span class=\"hl-d\"># 2. hpm install mypkg</span>\n  <span class=\"hl-r\">&#8594;</span> fetch repo.json              <span class=\"hl-d\">(HTTP, no clone)</span>\n  <span class=\"hl-r\">&#8594;</span> clone git repo\n  <span class=\"hl-r\">&#8594;</span> checkout latest semver tag\n  <span class=\"hl-r\">&#8594;</span> read info.hk\n  <span class=\"hl-r\">&#8594;</span> install apt deps\n  <span class=\"hl-r\">&#8594;</span> run build.toml / build.info\n  <span class=\"hl-r\">&#8594;</span> copy contents/ &#8594; store\n  <span class=\"hl-r\">&#8594;</span> install .desktop + icon      <span class=\"hl-d\">(GUI apps)</span>\n  <span class=\"hl-r\">&#8594;</span> create /usr/bin wrapper\n\n<span class=\"hl-d\"># 3. Running</span>\n$ mypkg &#8594; hpm run mypkg &#8594; sandbox &#8594; exec</code></pre>\n</section>\n\n<section id=\"quickstart\">\n  <h2><span class=\"h2-num\">02</span> QUICKSTART <a href=\"#quickstart\">#</a></h2>\n  <pre data-lang=\"sh\"><code>sudo hpm refresh          <span class=\"hl-d\"># update package index</span>\nhpm search editor         <span class=\"hl-d\"># find packages</span>\nhpm info hedit            <span class=\"hl-d\"># show package details</span>\nsudo hpm install hedit    <span class=\"hl-d\"># install</span>\nhedit myfile.txt          <span class=\"hl-d\"># use it</span>\nsudo hpm update           <span class=\"hl-d\"># update all packages</span>\nsudo hpm remove hedit     <span class=\"hl-d\"># remove</span></code></pre>\n  <div class=\"box box-n\"><strong>Root required</strong>Install, remove, update and upgrade commands require <ci>sudo</ci>. Search, info, list and query commands work as normal user.</div>\n</section>\n\n<section id=\"commands\">\n  <h2><span class=\"h2-num\">03</span> COMMAND REFERENCE <a href=\"#commands\">#</a></h2>\n  <h3>Package Commands</h3>\n  <table class=\"tbl\">\n    <tr><th>Command</th><th>Description</th></tr>\n    <tr><td class=\"tc\">hpm refresh</td><td class=\"td\">Download package index and pre-fetch metadata</td></tr>\n    <tr><td class=\"tc\">hpm install <span class=\"ta\">&lt;pkg&gt;[@&lt;ver&gt;]...</span></td><td class=\"td\">Install packages, resolve hpm and apt dependencies automatically</td></tr>\n    <tr><td class=\"tc\">hpm remove <span class=\"ta\">&lt;pkg&gt;[@&lt;ver&gt;]</span></td><td class=\"td\">Remove a package or a specific installed version</td></tr>\n    <tr><td class=\"tc\">hpm update</td><td class=\"td\">Update all non-pinned packages to latest version</td></tr>\n    <tr><td class=\"tc\">hpm upgrade</td><td class=\"td\">Upgrade hpm itself</td></tr>\n    <tr><td class=\"tc\">hpm switch <span class=\"ta\">&lt;pkg&gt; &lt;ver&gt;</span></td><td class=\"td\">Switch the active version of an installed package</td></tr>\n  </table>\n  <h3>Query Commands</h3>\n  <table class=\"tbl\">\n    <tr><th>Command</th><th>Description</th></tr>\n    <tr><td class=\"tc\">hpm search <span class=\"ta\">&lt;query&gt;</span></td><td class=\"td\">Search by name or description &mdash; HTTP only, never clones git</td></tr>\n    <tr><td class=\"tc\">hpm info <span class=\"ta\">&lt;package&gt;</span></td><td class=\"td\">Show full package details</td></tr>\n    <tr><td class=\"tc\">hpm list</td><td class=\"td\">List all installed packages with versions and pinned status</td></tr>\n    <tr><td class=\"tc\">hpm outdated</td><td class=\"td\">Show packages with newer versions available</td></tr>\n    <tr><td class=\"tc\">hpm deps <span class=\"ta\">&lt;pkg&gt;</span></td><td class=\"td\">Print the full dependency tree</td></tr>\n    <tr><td class=\"tc\">hpm verify <span class=\"ta\">&lt;package&gt;</span></td><td class=\"td\">Verify installed package integrity (SHA-256)</td></tr>\n  </table>\n  <h3>Maintenance Commands</h3>\n  <table class=\"tbl\">\n    <tr><th>Command</th><th>Description</th></tr>\n    <tr><td class=\"tc\">hpm run <span class=\"ta\">&lt;pkg&gt; &lt;bin&gt; [args]</span></td><td class=\"td\">Run a binary from an installed package inside its sandbox</td></tr>\n    <tr><td class=\"tc\">hpm build <span class=\"ta\">&lt;name&gt;</span></td><td class=\"td\">Package the current directory as an hpm package</td></tr>\n    <tr><td class=\"tc\">hpm clean</td><td class=\"td\">Remove cached git repos and temporary files</td></tr>\n    <tr><td class=\"tc\">hpm pin <span class=\"ta\">&lt;pkg&gt; &lt;ver&gt;</span></td><td class=\"td\">Pin a package to a specific version</td></tr>\n    <tr><td class=\"tc\">hpm unpin <span class=\"ta\">&lt;pkg&gt;</span></td><td class=\"td\">Unpin the current version</td></tr>\n  </table>\n</section>\n\n<section id=\"versions\">\n  <h2><span class=\"h2-num\">04</span> VERSION MANAGEMENT <a href=\"#versions\">#</a></h2>\n  <p>hpm reads versions from git tags in the format <ci>v1.2.3</ci> or <ci>1.2.3</ci>. Multiple versions can be installed side by side.</p>\n  <pre data-lang=\"sh\"><code>sudo hpm install hedit@1.9.0   <span class=\"hl-d\"># install specific version alongside current</span>\nsudo hpm switch hedit 1.9.0    <span class=\"hl-d\"># switch active version</span>\nsudo hpm pin hedit 1.9.0       <span class=\"hl-d\"># pin — prevents automatic updates</span>\nsudo hpm unpin hedit            <span class=\"hl-d\"># unpin when ready to update</span>\nsudo hpm remove hedit@1.9.0    <span class=\"hl-d\"># remove specific version only</span></code></pre>\n</section>\n\n<section id=\"sandbox\">\n  <h2><span class=\"h2-num\">05</span> SANDBOX <a href=\"#sandbox\">#</a></h2>\n  <p>hpm automatically selects the right isolation level. No manual configuration required &mdash; the sandbox is transparent to the user.</p>\n  <h3>Sandbox modes</h3>\n  <table class=\"tbl\">\n    <tr><th>Mode</th><th>When</th><th>Isolation</th></tr>\n    <tr><td class=\"tc\">Full</td><td class=\"td\">Pure CLI, no network/GUI/extra paths</td><td class=\"td\">New user+mount+UTS+PID+net+cgroup namespaces + pivot_root + Landlock</td></tr>\n    <tr><td class=\"tc\">Compat</td><td class=\"td\">GUI apps, network, home dir access</td><td class=\"td\">New mount namespace only &mdash; shares host user/network/IPC. Landlock active.</td></tr>\n    <tr><td class=\"tc\">None</td><td class=\"td\"><ci>sandbox.disabled = true</ci></td><td class=\"td\">Direct exec &mdash; no isolation. Only for trusted system tools.</td></tr>\n  </table>\n  <h3>Sandbox options in info.hk</h3>\n  <pre data-lang=\"hk\"><code>[sandbox]\n-> network   => false   <span class=\"hl-d\"># allow network access</span>\n-> gui       => true    <span class=\"hl-d\"># bind X11/Wayland/D-Bus/PulseAudio/PipeWire</span>\n-> full_gui  => false   <span class=\"hl-d\"># gui + /dev/shm (Electron/Chromium apps)</span>\n-> dev       => false   <span class=\"hl-d\"># expose /dev devices</span>\n-> disabled  => false   <span class=\"hl-d\"># disable sandbox entirely</span>\n-> filesystem => {}     <span class=\"hl-d\"># extra host paths to bind-mount</span></code></pre>\n  <div class=\"box box-w\"><strong>Warning</strong><ci>sandbox.disabled = true</ci> gives the binary full host access. Use only for packages you fully trust.</div>\n  <h3>What Landlock protects</h3>\n  <table class=\"tbl\">\n    <tr><th>Path</th><th>Access</th></tr>\n    <tr><td class=\"tc\">/usr, /lib, /bin, /etc</td><td class=\"td\">Read + execute only</td></tr>\n    <tr><td class=\"tc\">/proc, /sys</td><td class=\"td\">Read only</td></tr>\n    <tr><td class=\"tc\">/app (package dir)</td><td class=\"td\">Full read/write/execute</td></tr>\n    <tr><td class=\"tc\">/tmp</td><td class=\"td\">Full read/write</td></tr>\n    <tr><td class=\"tc\">$HOME</td><td class=\"td\">Full read/write (compat mode)</td></tr>\n    <tr><td class=\"tc\">Extra filesystem paths</td><td class=\"td\">Full read/write</td></tr>\n  </table>\n</section>\n\n<section id=\"repo-layout\">\n  <h2><span class=\"h2-num\">06</span> REPOSITORY LAYOUT <a href=\"#repo-layout\">#</a></h2>\n  <div class=\"tree\">\n    <span class=\"td2\">my-package/</span><br>\n    &nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"tf\">info.hk</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; required: manifest</span><br>\n    &nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"to\">build.toml</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; optional: build/download instructions</span><br>\n    &nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"to\">contents/</span><br>\n    &nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"td2\">bin/</span><br>\n    &nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9492;&#9472;&#9472; <span class=\"tf\">my-binary</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; chmod +x in git (0o100755)</span><br>\n    &nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"to\">icons/</span><br>\n    &nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9492;&#9472;&#9472; <span class=\"to\">my-package.png</span>&nbsp;<span class=\"ta2\">&#8592; app icon (GUI apps)</span><br>\n    &nbsp;&nbsp;&#9474;&nbsp;&nbsp;&nbsp;&#9492;&#9472;&#9472; <span class=\"to\">my-package.desktop</span>&nbsp;<span class=\"ta2\">&#8592; custom .desktop (optional)</span><br>\n    &nbsp;&nbsp;&#9492;&#9472;&#9472; <span class=\"tf\">README.md</span>\n  </div>\n  <div class=\"box box-t\"><strong>Key rule</strong>The binary name in <ci>bins.&lt;name&gt;</ci> must match the actual filename in <ci>contents/bin/&lt;name&gt;</ci>. hpm searches recursively and shows a list of all files found when it doesn't match.</div>\n</section>\n\n<section id=\"manifest\">\n  <h2><span class=\"h2-num\">07</span> INFO.HK MANIFEST <a href=\"#manifest\">#</a></h2>\n  <div class=\"box box-n\"><strong>HK Format documentation</strong>The <ci>info.hk</ci> manifest uses the <strong>HK format</strong> &mdash; HackerOS's native configuration language. Full syntax reference is documented separately:<br><br><a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html\" class=\"ext\" target=\"_blank\">hackeros-linux-system.github.io &#8594; HK Format Documentation &#8599;</a></div>\n  <h3>Complete manifest reference</h3>\n  <pre data-lang=\"info.hk\"><code>[metadata]\n-> name    => my-package\n-> version => 1.0.0\n-> authors => Your Name\n-> license => MIT\n-> gui     => false               <span class=\"hl-d\"># shorthand for sandbox.gui = true</span>\n-> bins.my-binary => \"\"           <span class=\"hl-d\"># each binary gets a /usr/bin wrapper</span>\n\n[description]\n-> summary => One-line shown in hpm search\n-> long    => Longer description shown in hpm info\n\n[sandbox]\n-> network   => false\n-> gui       => false\n-> full_gui  => false\n-> dev       => false\n-> disabled  => false\n-> filesystem => {}\n\n[build]\n-> commands => {}\n-> deb_deps => {}\n\n[runtime]\n-> deb_deps => {}\n\n[specs]\n-> dependencies.other-pkg => \">=1.0\"\n\n[desktop]\n-> display_name => My Application\n-> icon         => icons/my-package.png\n-> categories   => Utility;GTK;\n-> comment      => Short description for the app menu\n-> mime_types   => text/plain;\n-> keywords     => tool;utility;\n-> desktop_file => my-package.desktop</code></pre>\n</section>\n\n<section id=\"build-toml\">\n  <h2><span class=\"h2-num\">08</span> BUILD.TOML <a href=\"#build-toml\">#</a></h2>\n  <p>When absent, hpm copies <ci>contents/</ci> directly. Add <ci>build.toml</ci> when the binary needs downloading or compiling.</p>\n  <h3>type = \"download\"</h3>\n  <pre data-lang=\"toml\"><code>type         = \"download\"\nurl          = \"https://github.com/user/repo/releases/download/v{version}/bin-linux-x86_64\"\ninstall_path = \"bin/mybinary\"\nruntime_deps = [\"libssl3\"]\n\n<span class=\"hl-d\"># From a tar.gz archive:</span>\ntype             = \"download\"\nurl              = \"https://example.com/v{version}/tool.tar.gz\"\nbinary_path      = \"tool/bin/tool\"\nstrip_components = 0\ninstall_path     = \"bin/tool\"</code></pre>\n  <h3>type = \"build\"</h3>\n  <pre data-lang=\"toml\"><code>type         = \"build\"\ncommands     = [\"cargo build --release\"]\noutput       = \"target/release/mytool\"\ninstall_path = \"bin/mytool\"\nbuild_deps   = [\"build-essential\"]\nruntime_deps = [\"libssl3\"]\n\n[env]\nCARGO_PROFILE_RELEASE_LTO = \"true\"</code></pre>\n</section>\n\n<section id=\"gui-apps\">\n  <h2><span class=\"h2-num\">09</span> GUI APPLICATIONS <a href=\"#gui-apps\">#</a></h2>\n  <p>When <ci>gui = true</ci> or <ci>sandbox.gui = true</ci>, hpm automatically:</p>\n  <ul class=\"feat\">\n    <li>Runs in <strong>compat mode</strong> &mdash; shares X11/Wayland/D-Bus with the host</li>\n    <li>Installs a <strong>.desktop file</strong> to <ci>/usr/share/applications/</ci></li>\n    <li>Installs the <strong>icon</strong> to hicolor and pixmaps</li>\n    <li>Runs <ci>update-desktop-database</ci> and <ci>gtk-update-icon-cache</ci></li>\n  </ul>\n  <h3>GUI info.hk example</h3>\n  <pre data-lang=\"info.hk\"><code>[metadata]\n-> name    => myapp\n-> version => 1.0.0\n-> gui     => true\n-> bins.myapp => \"\"\n\n[sandbox]\n-> gui      => true\n-> network  => false\n\n[runtime]\n-> deb_deps => { libgtk-3-0 => \"\" }\n\n[desktop]\n-> display_name => My App\n-> icon         => icons/myapp.png\n-> categories   => Graphics;Viewer;</code></pre>\n  <div class=\"box box-t\"><strong>Custom .desktop file</strong>If you ship a <ci>.desktop</ci> file in <ci>contents/</ci>, hpm uses it automatically and patches only the <ci>Exec=</ci> line to route through <ci>hpm run</ci>.</div>\n  <h3>Electron / Chromium apps</h3>\n  <pre data-lang=\"info.hk\"><code>[sandbox]\n-> full_gui => true    <span class=\"hl-d\"># adds /dev/shm for shared memory</span>\n-> network  => true    <span class=\"hl-d\"># if the app needs internet access</span></code></pre>\n</section>\n\n<section id=\"publish\">\n  <h2><span class=\"h2-num\">10</span> PUBLISHING <a href=\"#publish\">#</a></h2>\n  <h3>1. Create the repository</h3>\n  <pre data-lang=\"sh\"><code>mkdir my-package &amp;&amp; cd my-package &amp;&amp; git init\nmkdir -p contents/bin\ncp /path/to/binary contents/bin/my-package\nchmod +x contents/bin/my-package\n<span class=\"hl-d\"># create info.hk (see section 07 for full reference)</span>\ngit add . &amp;&amp; git commit -m \"initial release\"\ngit tag v1.0.0 &amp;&amp; git push origin main --tags</code></pre>\n  <h3>2. Add to repo.json</h3>\n  <pre data-lang=\"json\"><code>{\n  \"packages\": {\n    \"my-package\": {\n      \"repo\": \"https://github.com/yourname/my-package\"\n    }\n  }\n}</code></pre>\n  <div class=\"box box-t\"><strong>Versions field is optional</strong>hpm discovers available versions automatically from git tags. The <ci>\"versions\"</ci> array is optional hint-only metadata.</div>\n  <h3>3. Submit a pull request</h3>\n  <p>Open a PR to <a href=\"https://github.com/HackerOS-Linux-System/HackerOS-Package-Manager\" class=\"ext\" target=\"_blank\">HackerOS-Package-Manager &#8599;</a> adding your entry to <ci>repo/repo.json</ci>.</p>\n</section>\n\n<section id=\"repo-json\">\n  <h2><span class=\"h2-num\">11</span> REPO.JSON <a href=\"#repo-json\">#</a></h2>\n  <pre data-lang=\"json\"><code>{\n  \"packages\": {\n    \"hello-hpm\": {\n      \"repo\": \"https://github.com/HackerOS-Linux-System/hpm-example-repo\"\n    },\n    \"hedit\": {\n      \"repo\": \"https://github.com/hackerOS/hedit\",\n      \"versions\": [\"1.0.0\", \"2.0.0\", \"2.1.0\"]\n    }\n  }\n}</code></pre>\n</section>\n\n<section id=\"store\">\n  <h2><span class=\"h2-num\">12</span> STORE LAYOUT <a href=\"#store\">#</a></h2>\n  <div class=\"tree\">\n    <span class=\"td2\">/usr/lib/HackerOS/hpm/store/my-package/</span><br>\n    &nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"td2\">1.0.0/</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; installed version</span><br>\n    &nbsp;&nbsp;&#9500;&#9472;&#9472; <span class=\"td2\">2.0.0/</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; side-by-side</span><br>\n    &nbsp;&nbsp;&#9492;&#9472;&#9472; <span class=\"tf\">current</span>&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; symlink &#8594; 2.0.0</span><br><br>\n    <span class=\"tf\">/usr/bin/my-package</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; wrapper script</span><br>\n    <span class=\"tf\">/usr/share/applications/my-package.desktop</span>&nbsp;<span class=\"ta2\">&#8592; GUI apps only</span><br>\n    <span class=\"tf\">/usr/share/icons/hicolor/256x256/apps/my-package.png</span><br>\n    <span class=\"tf\">/var/lib/hpm/state.json</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"ta2\">&#8592; state + checksums</span>\n  </div>\n</section>\n\n<section id=\"compare\">\n  <h2><span class=\"h2-num\">13</span> HPM VS AUR VS PPA <a href=\"#compare\">#</a></h2>\n  <table class=\"tbl\">\n    <tr><th>Feature</th><th style=\"color:var(--red)\">hpm</th><th>AUR (yay)</th><th>PPA (apt)</th></tr>\n    <tr><td>Package format</td><td class=\"yes\">Git repo + info.hk</td><td>PKGBUILD</td><td>.deb archive</td></tr>\n    <tr><td>Sandbox / isolation</td><td class=\"yes\">Built-in (namespaces+Landlock)</td><td class=\"no\">None</td><td class=\"no\">None</td></tr>\n    <tr><td>GUI app support</td><td class=\"yes\">Yes (.desktop + icons)</td><td class=\"yes\">Yes</td><td class=\"yes\">Yes</td></tr>\n    <tr><td>Side-by-side versions</td><td class=\"yes\">Yes</td><td class=\"no\">No</td><td class=\"no\">No</td></tr>\n    <tr><td>Version pinning</td><td class=\"yes\">Yes</td><td class=\"par\">Partial</td><td class=\"par\">hold</td></tr>\n    <tr><td>Search speed</td><td class=\"yes\">Fast (raw HTTP)</td><td class=\"par\">Medium</td><td class=\"yes\">Fast</td></tr>\n    <tr><td>Binary integrity</td><td class=\"yes\">SHA-256</td><td class=\"par\">Optional</td><td class=\"yes\">GPG</td></tr>\n    <tr><td>Build from source</td><td class=\"yes\">Yes (build.toml)</td><td class=\"yes\">Yes</td><td class=\"no\">No</td></tr>\n    <tr><td>Pre-built download</td><td class=\"yes\">Yes (build.toml)</td><td class=\"par\">Partial</td><td class=\"yes\">Yes</td></tr>\n    <tr><td>Auto dep resolution</td><td class=\"par\">hpm + apt deps</td><td class=\"yes\">Full</td><td class=\"yes\">Full</td></tr>\n  </table>\n</section>\n\n<section id=\"hk-format\">\n  <h2><span class=\"h2-num\">14</span> HK FORMAT <a href=\"#hk-format\">#</a></h2>\n  <p>The <ci>info.hk</ci> manifest uses the <strong>HK format</strong> &mdash; HackerOS's native configuration language. Readable, hierarchical, with built-in interpolation, strong typing and precise error messages.</p>\n  <div style=\"margin:20px 0\">\n    <a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html\" class=\"ext\" target=\"_blank\" style=\"font-size:15px;font-weight:600\">hackeros-linux-system.github.io/tools-docs/hk.html &#8599;</a>\n  </div>\n</section>\n\n<footer>hpm v0.8.0 &middot; HackerOS Package Manager &middot; HackerOS Ecosystem &middot; <a href=\"https://github.com/HackerOS-Linux-System/HackerOS-Package-Manager\" style=\"color:var(--dim)\">GitHub &#8599;</a> &middot; MIT License</footer>\n</main>\n</div>"

fun main() [
    boot_begin("en", "hpm — HackerOS Package Manager")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["href", "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Bebas+Neue&display=swap", "rel", "stylesheet"])
    boot_body(PAGE_BODY)
    offline_init("../")
    scrollspy("section[id]", "nav a", "-15% 0px -75% 0px", 0.0)
]
