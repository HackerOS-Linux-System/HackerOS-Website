use <mode:website>

include <../../shared/offline>
include <../../logic/scrollspy>
include <../../logic/hk>

style {
#app { display: none; }
  :root {
    --bg: #000000;
    --bg2: #070707;
    --bg3: #0d0d0d;
    --panel: #101010;
    --panel2: #181818;
    --border: #2b2b2b;
    --border2: #4a4a4a;
    --text: #f5f5f5;
    --text2: #b8b8b8;
    --text3: #7d7d7d;
    --fg: #ffffff;
    --fg-dim: rgba(255, 255, 255, 0.06);
    --fg-glow: rgba(255, 255, 255, 0.14);
    --g1: #e4e4e4;
    --g1-dim: rgba(255, 255, 255, 0.05);
    --g2: #cfcfcf;
    --g2-dim: rgba(255, 255, 255, 0.05);
    --g3: #ffffff;
    --g4: #bdbdbd;
    --g5: #ededed;
    --font-mono: 'JetBrains Mono', monospace;
    --font-sans: 'Syne', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    min-height: 100vh;
    overflow-x: hidden;
  }

  
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.08) 2px,
      rgba(0,0,0,0.08) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  .wrapper {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
  }

  
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 0;
    height: 56px;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.05em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-logo::before {
    content: '>';
    color: var(--text3);
  }

  .nav-links {
    display: flex;
    gap: 0;
    list-style: none;
  }

  .nav-links a {
    display: block;
    padding: 0 18px;
    height: 56px;
    line-height: 56px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text2);
    border-left: 1px solid var(--border);
    transition: color 0.2s, background 0.2s;
  }

  .nav-links a:hover { color: var(--fg); background: var(--fg-dim); }
  .nav-links a.active { color: var(--fg); }

  
  .hero {
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--fg-dim);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 2px;
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 28px;
    animation: fadeUp 0.6s ease both;
  }

  .hero-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--fg);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--fg);
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.8); }
  }

  .hero h1 {
    font-size: clamp(42px, 7vw, 80px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    animation: fadeUp 0.6s 0.1s ease both;
  }

  .hero h1 .accent { color: var(--fg); }
  .hero h1 .dim { color: var(--text3); }

  .hero-sub {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text2);
    max-width: 520px;
    line-height: 1.8;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .hero-sub strong { color: var(--text); font-weight: 600; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-glow {
    position: absolute;
    top: -60px; right: -100px;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  
  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .section-label .tag {
    color: var(--fg);
  }

  h2.section-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    line-height: 1.1;
  }

  h2.section-title .dim { color: var(--text3); }

  .section-desc {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text2);
    max-width: 600px;
    margin-bottom: 48px;
    line-height: 1.8;
  }

  
  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border2), transparent);
    margin: 80px 0;
  }

  section { padding: 20px 0 60px; }

  
  .code-block {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin: 24px 0;
    position: relative;
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    letter-spacing: 0.08em;
  }

  .code-block-header .lang {
    color: var(--fg);
    font-weight: 600;
  }

  .code-block pre {
    padding: 24px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--text);
    tab-size: 2;
  }

  .code-block pre .comment { color: var(--text3); font-style: italic; }
  .code-block pre .section { color: #ffffff; font-weight: 700; }
  .code-block pre .key { color: var(--text); }
  .code-block pre .arrow { color: var(--text3); }
  .code-block pre .str { color: #d6d6d6; }
  .code-block pre .num { color: #ffffff; font-style: italic; }
  .code-block pre .bool { color: #ffffff; font-weight: 600; }
  .code-block pre .blue { color: #ffffff; }
  .code-block pre .interpol { color: #000000; background: #ffffff; border-radius: 2px; padding: 0 3px; font-weight: 600; }
  .code-block pre .url { color: #ffffff; text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); }
  .code-block pre .dash { color: #ffffff; font-weight: 700; }
  .code-block pre .err { color: #ffffff; font-weight: 700; text-decoration: underline dotted; text-underline-offset: 3px; }

  
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin: 32px 0;
  }

  .feature-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--fg), transparent);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .feature-card:hover { border-color: var(--border2); background: var(--panel2); }
  .feature-card:hover::before { opacity: 1; }

  .feature-icon {
    font-family: var(--font-mono);
    font-size: 20px;
    margin-bottom: 14px;
    color: var(--fg);
  }

  .feature-card h3 {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .feature-card p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text2);
    line-height: 1.7;
  }

  
  .syntax-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
    margin: 24px 0;
  }

  .syntax-table th {
    text-align: left;
    padding: 10px 16px;
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--text2);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .syntax-table td {
    padding: 12px 16px;
    border: 1px solid var(--border);
    vertical-align: top;
    background: var(--bg2);
    transition: background 0.15s;
  }

  .syntax-table tr:hover td { background: var(--panel); }

  .syntax-table td:first-child { color: var(--fg); font-weight: 600; }
  .syntax-table td:nth-child(2) { color: var(--g2); }
  .syntax-table td:nth-child(3) { color: var(--text2); font-size: 12px; }

  
  .error-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 24px 0;
  }

  @media (max-width: 700px) { .error-grid { grid-template-columns: 1fr; } }

  .error-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 18px 20px;
    border-left: 3px solid;
  }

  .error-card.parse { border-left-color: var(--g3); }
  .error-card.type { border-left-color: var(--g2); }
  .error-card.ref { border-left-color: var(--g1); }
  .error-card.cyclic { border-left-color: var(--g4); }
  .error-card.conflict { border-left-color: var(--g5); }
  .error-card.missing { border-left-color: var(--text3); }

  .error-card .err-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 6px;
    letter-spacing: 0.05em;
  }

  .error-card.parse .err-name { color: var(--g3); }
  .error-card.type .err-name { color: var(--g2); }
  .error-card.ref .err-name { color: var(--g1); }
  .error-card.cyclic .err-name { color: var(--g4); }
  .error-card.conflict .err-name { color: var(--g5); }
  .error-card.missing .err-name { color: var(--text3); }

  .error-card p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text2);
    line-height: 1.6;
  }

  
  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 1px 7px;
    border-radius: 3px;
    color: var(--fg);
  }

  
  .callout {
    display: flex;
    gap: 16px;
    padding: 18px 20px;
    border-radius: 4px;
    margin: 20px 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }

  .callout.info {
    background: var(--g1-dim);
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--text);
  }

  .callout.warn {
    background: var(--g2-dim);
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--text);
  }

  .callout.tip {
    background: var(--fg-dim);
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--text);
  }

  .callout-icon { font-size: 18px; flex-shrink: 0; line-height: 1.7; }
  .callout.info .callout-icon { color: var(--g1); }
  .callout.warn .callout-icon { color: var(--g2); }
  .callout.tip .callout-icon { color: var(--fg); }

  
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 24px 0;
  }

  @media (max-width: 700px) { .compare { grid-template-columns: 1fr; } }

  .compare-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .compare-panel-header {
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
  }

  .compare-panel.hk .compare-panel-header { color: var(--fg); background: var(--fg-dim); }
  .compare-panel.yaml .compare-panel-header { color: var(--text2); background: var(--bg2); }

  .compare-panel pre {
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    overflow-x: auto;
  }

  
  .hacker-section {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin: 24px 0;
  }

  .hacker-header {
    padding: 14px 20px;
    background: var(--g2-dim);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--g2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hacker-header::before {
    content: '◈';
  }

  .hacker-body {
    padding: 24px;
  }

  .version-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }

  .vtab {
    padding: 10px 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    color: var(--text2);
    transition: color 0.2s;
    letter-spacing: 0.06em;
  }

  .vtab.active { color: var(--g2); border-bottom-color: var(--g2); }
  .vtab:hover:not(.active) { color: var(--text); }

  .vtab-content { display: none; padding: 24px; }
  .vtab-content.active { display: block; }

  
  .type-badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .type-badge.str { background: rgba(255,255,255,0.12); color: var(--g2); border: 1px solid rgba(255,255,255,0.25); }
  .type-badge.num { background: rgba(255,255,255,0.12); color: var(--g4); border: 1px solid rgba(255,255,255,0.25); }
  .type-badge.bool { background: rgba(255,255,255,0.12); color: var(--g5); border: 1px solid rgba(255,255,255,0.25); }
  .type-badge.arr { background: rgba(255,255,255,0.12); color: var(--g1); border: 1px solid rgba(255,255,255,0.25); }
  .type-badge.map { background: rgba(255,255,255,0.12); color: var(--fg); border: 1px solid rgba(255,255,255,0.25); }

  
  .api-grid {
    display: grid;
    gap: 12px;
    margin: 24px 0;
  }

  .api-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 18px 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .api-sig {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    font-weight: 600;
    min-width: 180px;
    flex-shrink: 0;
  }

  .api-desc {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text2);
    line-height: 1.7;
  }

  .api-ret {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--g4);
    margin-top: 4px;
  }

  
  footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    margin-top: 80px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  footer .footer-brand { color: var(--fg); font-weight: 600; }

  
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--text3); }

  
  .toc {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px;
    margin-bottom: 48px;
    display: inline-block;
    min-width: 280px;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .toc ol {
    list-style: none;
    counter-reset: toc;
    padding-left: 0;
  }

  .toc li {
    counter-increment: toc;
    margin-bottom: 8px;
  }

  .toc li::before {
    content: counter(toc, decimal-leading-zero) '. ';
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
  }

  .toc a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .toc a:hover { color: var(--fg); }

  .toc .sub { margin-left: 20px; margin-top: 4px; counter-reset: toc-sub; }
  .toc .sub li { counter-increment: toc-sub; }
  .toc .sub li::before { content: counter(toc-sub, lower-alpha) '. '; }
  .toc .sub a { font-size: 12px; }

  p { color: var(--text2); font-size: 14px; line-height: 1.8; margin-bottom: 12px; }
  p strong { color: var(--text); }

  h3 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 32px 0 12px;
    color: var(--text);
  }

  h3 .dim { color: var(--text3); }

  ::selection { background: #ffffff; color: #000000; }

  .syntax-table td:nth-child(2) { color: var(--g2); }
  .syntax-table td:nth-child(3) { color: var(--text2); }
  .syntax-table td a.plain-link { word-break: break-all; }

  .error-card.io { border-left-color: var(--g1); }
  .error-card.io .err-name { color: var(--g1); }
  .error-card.parse { border-left-style: solid; }
  .error-card.type { border-left-style: dashed; }
  .error-card.ref { border-left-style: dotted; }
  .error-card.cyclic { border-left-style: double; }

  /* .hero: linki do bibliotek */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    animation: fadeUp 0.6s 0.3s ease both;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #000000;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 2px;
    padding: 8px 16px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .hero-links a:hover { background: #000000; color: #ffffff; }

  a.plain-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255,255,255,0.4);
    text-underline-offset: 3px;
  }

  a.plain-link:hover { text-decoration-color: #ffffff; }

  /* karty bibliotek */
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin: 24px 0;
  }

  .lib-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--panel);
    border: 1px solid var(--border2);
    border-radius: 4px;
    padding: 22px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }

  .lib-card:hover { background: #ffffff; border-color: #ffffff; transform: translateY(-2px); }
  .lib-card:hover .lib-title,
  .lib-card:hover .lib-desc,
  .lib-card:hover .lib-desc strong,
  .lib-card:hover .lib-desc code,
  .lib-card:hover .lib-url { color: #000000; }
  .lib-card:hover .lib-desc code { background: transparent; border-color: #000000; }
  .lib-card:hover .lib-tag { background: #000000; color: #ffffff; }

  .lib-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: #ffffff;
    color: #000000;
    padding: 2px 10px;
    border-radius: 2px;
  }

  .lib-title { font-size: 18px; font-weight: 800; letter-spacing: -0.01em; color: var(--text); }

  .lib-desc {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text2);
  }

  .lib-desc strong { color: var(--text); }

  .lib-url {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text);
    word-break: break-all;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }

  /* listy regul */
  ul.rules {
    list-style: none;
    margin: 16px 0 24px;
    padding: 0;
  }

  ul.rules li {
    position: relative;
    padding: 8px 0 8px 26px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
    color: var(--text2);
  }

  ul.rules li:last-child { border-bottom: none; }

  ul.rules li::before {
    content: '▸';
    position: absolute;
    left: 4px;
    color: var(--fg);
  }

  ul.rules li strong { color: var(--text); }

  h3[id] { scroll-margin-top: 72px; }
  div[id] { scroll-margin-top: 72px; }

  @media (max-width: 700px) {
    .wrapper { padding: 0 18px; }
    .nav-links a { padding: 0 10px; }
    .api-item { flex-direction: column; gap: 8px; }
    .api-sig { min-width: 0; }
    .syntax-table { display: block; overflow-x: auto; }
    footer { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
}

let PAGE_BODY: Str = "<nav>\n  <div class=\"wrapper nav-inner\">\n    <a href=\"#\" class=\"nav-logo\">HackerOS Docs</a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#hk\" class=\"active\">.hk</a></li>\n      <li><a href=\"#hacker\">.hacker</a></li>\n      <li><a href=\"#api\">API</a></li>\n    </ul>\n  </div>\n</nav>\n\n<div class=\"wrapper\">\n\n  \n  <div class=\"hero\">\n    <div class=\"hero-glow\"></div>\n    <div class=\"hero-badge\">HackerOS · Dokumentacja Formatów</div>\n    <h1>\n      <span class=\"accent\">.hk</span> &amp;<br>\n      <span class=\"dim\">.hacker</span>\n    </h1>\n    <p class=\"hero-sub\">\n      Formaty plików konfiguracyjnych i metadanych ekosystemu <strong>HackerOS</strong>.<br>\n      <code>.hk</code> jest głównym formatem konfiguracji — potężnym zamiennikiem YAML.<br>\n      <code>.hacker</code> służy do opisu modułów i narzędzi w ekosystemie.\n    </p>\n    <div class=\"hero-links\">\n      <a href=\"#hk-lib\">hk-parser: Rust · Lua · H# →</a>\n      <a href=\"#hacker-lib\">hacker: Rust · H# →</a>\n    </div>\n  </div>\n\n  \n  <div class=\"toc\">\n    <div class=\"toc-title\">// spis treści</div>\n    <ol>\n      <li><a href=\"#hk\">Format .hk</a>\n        <ol class=\"sub\">\n          <li><a href=\"#hk-intro\">Wprowadzenie</a></li>\n          <li><a href=\"#hk-lib\">Biblioteka hk-parser (Rust, Lua, H#)</a></li>\n          <li><a href=\"#hk-syntax\">Składnia</a></li>\n          <li><a href=\"#hk-types\">Typy wartości</a></li>\n          <li><a href=\"#hk-detect\">Wykrywanie typu</a></li>\n          <li><a href=\"#hk-arrays\">Tablice</a></li>\n          <li><a href=\"#hk-nesting\">Zagnieżdżanie</a></li>\n          <li><a href=\"#hk-nesting-rules\">Zasady zagnieżdżania</a></li>\n          <li><a href=\"#hk-interpol\">Interpolacja</a></li>\n          <li><a href=\"#hk-interpol-notes\">Interpolacja — szczegóły</a></li>\n          <li><a href=\"#hk-errors\">Błędy</a></li>\n          <li><a href=\"#hk-messages\">Komunikaty parsera</a></li>\n          <li><a href=\"#hk-serialize\">Serializacja</a></li>\n          <li><a href=\"#hk-real\">Przykłady z praktyki</a></li>\n          <li><a href=\"#hk-best\">Dobre praktyki</a></li>\n          <li><a href=\"#hk-vs-yaml\">Porównanie z YAML i innymi</a></li>\n        </ol>\n      </li>\n      <li><a href=\"#hacker\">Format .hacker</a>\n        <ol class=\"sub\">\n          <li><a href=\"#hacker-lib\">Biblioteka hacker (Rust, H#)</a></li>\n        </ol>\n      </li>\n      <li><a href=\"#api\">API</a>\n        <ol class=\"sub\">\n          <li><a href=\"#api-rust\">Rust — hk-parser</a></li>\n          <li><a href=\"#api-lua\">Lua — hk-parser</a></li>\n          <li><a href=\"#api-hsharp\">H# — hk-parser</a></li>\n          <li><a href=\"#api-hacker\">Rust — hacker-parser</a></li>\n        </ol>\n      </li>\n    </ol>\n  </div>\n\n  \n  \n  \n\n  <section id=\"hk\">\n    <div class=\"section-label\"><span class=\"tag\">01</span> format główny</div>\n    <h2 class=\"section-title\">Format <span class=\"dim\">.hk</span></h2>\n    <p class=\"section-desc\">\n      Czytelny, hierarchiczny format konfiguracji dla ekosystemu HackerOS.\n      Zastępuje YAML wszędzie tam gdzie potrzebna jest jasna struktura, silne typowanie i wsparcie dla interpolacji.\n    </p>\n\n    \n    <div id=\"hk-intro\">\n      <h3>Wprowadzenie</h3>\n      <p>\n        Pliki <code>.hk</code> składają się z <strong>sekcji</strong> (odpowiedniki tabel w TOML) zawierających\n        klucze i wartości. Każda sekcja tworzy zagnieżdżoną mapę. Format jest czytelny dla ludzi,\n        obsługuje komentarze, wielopoziomowe zagnieżdżanie i interpolację zmiennych.\n      </p>\n\n      <div class=\"callout tip\">\n        <span class=\"callout-icon\">◆</span>\n        <div>Format <code>.hk</code> jest używany jako główny plik konfiguracyjny\n        narzędzi, menedżera pakietów <strong>hpm</strong> oraz repozytoriów bibliotek HackerOS.</div>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">.hk</span>\n          <span>przykład podstawowy</span>\n        </div>\n        <pre><span class=\"comment\">! To jest komentarz — zaczyna się od '!'</span>\n\n<span class=\"section\">[metadata]</span>\n<span class=\"dash\">-></span> <span class=\"key\">name</span>    <span class=\"arrow\">=></span> <span class=\"str\">Hacker Lang</span>\n<span class=\"dash\">-></span> <span class=\"key\">version</span> <span class=\"arrow\">=></span> <span class=\"num\">1.5</span>\n<span class=\"dash\">-></span> <span class=\"key\">stable</span>  <span class=\"arrow\">=></span> <span class=\"bool\">true</span>\n<span class=\"dash\">-></span> <span class=\"key\">tags</span>    <span class=\"arrow\">=></span> [<span class=\"str\">\"lang\"</span>, <span class=\"str\">\"compiler\"</span>, <span class=\"str\">\"hacker\"</span>]\n\n<span class=\"section\">[build]</span>\n<span class=\"dash\">-></span> <span class=\"key\">output</span>  <span class=\"arrow\">=></span> <span class=\"str\">\"./dist\"</span>\n<span class=\"dash\">-></span> <span class=\"key\">target</span>  <span class=\"arrow\">=></span> <span class=\"str\">linux-x86_64</span>\n<span class=\"dash\">-></span> <span class=\"key\">debug</span>   <span class=\"arrow\">=></span> <span class=\"bool\">false</span></pre>\n      </div>\n    </div>\n\n    \n    <div id=\"hk-lib\">\n      <h3>Biblioteka hk-parser</h3>\n      <p>\n        Parser i serializer formatu <code>.hk</code> jest dostępny jako biblioteka w trzech językach.\n        Wszystkie wersje korzystają z tego samego parsera napisanego w Rust (Lua i H# wołają go natywnie),\n        więc plik <code>.hk</code> zachowuje się identycznie niezależnie od tego, skąd go czytasz.\n      </p>\n\n      <div class=\"lib-grid\">\n        <a class=\"lib-card\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hk-parser\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"lib-tag\">H#</span>\n          <span class=\"lib-title\">bit.io / H#</span>\n          <span class=\"lib-desc\">Biblioteka do projektów H#, instalowana przez menedżer <strong>bit</strong>. Strona zawiera aktualną wersję i instrukcję.</span>\n          <span class=\"lib-url\">hackeros-linux-system.github.io/bit — hk-parser ↗</span>\n        </a>\n        <a class=\"lib-card\" href=\"https://luarocks.org/modules/michal92299/hk-parser\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"lib-tag\">Lua</span>\n          <span class=\"lib-title\">luarocks / Lua</span>\n          <span class=\"lib-desc\">Pakiet LuaRocks z natywnym modułem (Lua 5.1–5.4 i LuaJIT) oraz małą nakładką w czystym Lua.</span>\n          <span class=\"lib-url\">luarocks.org/modules/michal92299/hk-parser ↗</span>\n        </a>\n        <a class=\"lib-card\" href=\"https://crates.io/crates/hk-parser\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"lib-tag\">Rust</span>\n          <span class=\"lib-title\">crates.io / Rust</span>\n          <span class=\"lib-desc\">Crate <code>hk-parser</code> — pełne API: parsowanie, interpolacje, edycja po ścieżkach, serializacja.</span>\n          <span class=\"lib-url\">crates.io/crates/hk-parser ↗</span>\n        </a>\n      </div>\n\n      <table class=\"syntax-table\">\n        <thead><tr><th>Język</th><th>Gdzie znaleźć</th><th>Adres</th></tr></thead>\n        <tbody>\n          <tr><td>bit.io / H#</td><td>strona biblioteki w <code>bit</code></td><td><a class=\"plain-link\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hk-parser\" target=\"_blank\" rel=\"noopener\">https://hackeros-linux-system.github.io/bit/lib.html?name=hk-parser</a></td></tr>\n          <tr><td>luarocks / Lua</td><td>moduł <code>michal92299/hk-parser</code></td><td><a class=\"plain-link\" href=\"https://luarocks.org/modules/michal92299/hk-parser\" target=\"_blank\" rel=\"noopener\">https://luarocks.org/modules/michal92299/hk-parser</a></td></tr>\n          <tr><td>crates.io / Rust</td><td>crate <code>hk-parser</code></td><td><a class=\"plain-link\" href=\"https://crates.io/crates/hk-parser\" target=\"_blank\" rel=\"noopener\">https://crates.io/crates/hk-parser</a></td></tr>\n        </tbody>\n      </table>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">shell</span><span>instalacja — Rust i Lua</span></div>\n        <pre><span class=\"comment\"># Rust — dodaj crate do projektu</span>\ncargo add hk-parser\n\n<span class=\"comment\"># Lua — potrzebny jest cargo (Rust &gt;= 1.85), bo moduł jest kompilowany przy instalacji</span>\nluarocks install luarocks-build-rust-mlua\nluarocks install hk-parser</pre>\n      </div>\n\n      <div class=\"callout info\">\n        <span class=\"callout-icon\">ℹ</span>\n        <div>Instalację w H# opisuje strona biblioteki w <code>bit</code> (link powyżej). Pełny opis\n        interfejsu wszystkich trzech wersji znajdziesz w sekcji <a class=\"plain-link\" href=\"#api\">API</a>.</div>\n      </div>\n    </div>\n\n    <div id=\"hk-syntax\">\n      <h3>Składnia</h3>\n\n      <table class=\"syntax-table\">\n        <thead>\n          <tr>\n            <th>Element</th>\n            <th>Składnia</th>\n            <th>Opis</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Komentarz</td>\n            <td>! treść</td>\n            <td>Linia zaczynająca się od <code>!</code> jest ignorowana</td>\n          </tr>\n          <tr>\n            <td>Sekcja</td>\n            <td>[nazwa]</td>\n            <td>Najwyższy poziom hierarchii, tworzy mapę klucz-wartość</td>\n          </tr>\n          <tr>\n            <td>Klucz L1</td>\n            <td>-> klucz => wartość</td>\n            <td>Klucz na pierwszym poziomie zagnieżdżenia</td>\n          </tr>\n          <tr>\n            <td>Klucz L2</td>\n            <td>--> klucz => wartość</td>\n            <td>Klucz na drugim poziomie zagnieżdżenia</td>\n          </tr>\n          <tr>\n            <td>Klucz L3</td>\n            <td>---> klucz => wartość</td>\n            <td>Klucz na trzecim poziomie (i głębiej)</td>\n          </tr>\n          <tr>\n            <td>Mapa inline</td>\n            <td>-> nazwa_mapy</td>\n            <td>Linia bez <code>=></code> — tworzy podmapy</td>\n          </tr>\n          <tr>\n            <td>Klucz kropkowy</td>\n            <td>-> a.b.c => val</td>\n            <td>Skrót tworzący zagnieżdżone mapy: <code>a → b → c</code></td>\n          </tr>\n          <tr>\n            <td>Tablica inline</td>\n            <td>-> k => [1, 2, 3]</td>\n            <td>Lista wartości w jednej linii, rozdzielona przecinkami</td>\n          </tr>\n          <tr>\n            <td>Tablica wieloliniowa</td>\n            <td>-> k => [ ⏎ \"a\" ⏎ \"b\" ⏎ ]</td>\n            <td>Jeden element na linię, zamknięta linią z <code>]</code></td>\n          </tr>\n          <tr>\n            <td>Klucz w cudzysłowie</td>\n            <td>-> \"a.b\" => val</td>\n            <td>Klucz literalny — kropka nie tworzy zagnieżdżenia</td>\n          </tr>\n          <tr>\n            <td>Interpolacja</td>\n            <td>${sekcja.klucz}</td>\n            <td>Referencja do innej wartości lub <code>${env:ZMIENNA}</code></td>\n          </tr>\n        </tbody>\n      </table>\n\n      <div class=\"callout info\">\n        <span class=\"callout-icon\">ℹ</span>\n        <div>Klucze mogą zawierać litery, cyfry, <code>_</code>, <code>-</code> i <code>.</code> (kropki\n        tworzą automatyczne zagnieżdżenie). Klucz w cudzysłowach (<code>\"klucz\"</code>) jest traktowany\n        jako literał — kropki wewnątrz nie powodują zagnieżdżenia.</div>\n      </div>\n\n      <h3>Reguły ogólne</h3>\n      <ul class=\"rules\">\n        <li>Plik składa się z <strong>sekcji</strong>. Przed pierwszym nagłówkiem <code>[sekcja]</code> mogą stać tylko komentarze i puste linie — inna treść to błąd <code>Expected section header</code>.</li>\n        <li>Nazwa sekcji nie może być pusta, a nagłówek musi być zamknięty znakiem <code>]</code>.</li>\n        <li>Każda niepusta linia wewnątrz sekcji jest albo komentarzem (<code>!</code>), albo zaczyna się od myślników i <code>&gt;</code>.</li>\n        <li>Komentarz zajmuje <strong>całą linię</strong>. Wykrzyknik po wartości nie jest komentarzem — staje się częścią wartości.</li>\n        <li>Białe znaki na początku linii i wokół klucza oraz wartości są pomijane, więc wcięcia nie mają znaczenia (można je stosować dla czytelności).</li>\n        <li>Między myślnikami a <code>&gt;</code> mogą stać spacje (<code>- &gt; klucz</code>), ale standardowy zapis to <code>-&gt;</code>, <code>--&gt;</code>, <code>---&gt;</code>.</li>\n        <li>Wartość nie może być pusta: <code>-&gt; klucz =&gt;</code> kończy się błędem <code>Empty value</code>.</li>\n        <li>Pusta sekcja (sam nagłówek) jest poprawna i daje pustą mapę.</li>\n      </ul>\n    </div>\n\n    \n    <div id=\"hk-types\">\n      <h3>Typy wartości</h3>\n      <p>\n        Parser automatycznie wykrywa typ wartości. Dostępne typy:\n      </p>\n\n      <div class=\"feature-grid\">\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\"><span class=\"type-badge str\">string</span></div>\n          <h3>Ciąg znaków</h3>\n          <p>\n            Z cudzysłowami lub bez. Wersja cytowana obsługuje sekwencje ucieczki:\n            <code>\\n</code> <code>\\t</code> <code>\\r</code> <code>\\\"</code> <code>\\\\</code>\n          </p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\"><span class=\"type-badge num\">number</span></div>\n          <h3>Liczba</h3>\n          <p>Liczby całkowite i zmiennoprzecinkowe. Parsowane jako <code>f64</code>. Przykłady: <code>42</code>, <code>3.14</code>, <code>-1.5</code></p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\"><span class=\"type-badge bool\">bool</span></div>\n          <h3>Boolean</h3>\n          <p>Wartości <code>true</code> / <code>false</code> (bez rozróżniania wielkości liter). Np. <code>True</code>, <code>FALSE</code> są poprawne.</p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\"><span class=\"type-badge arr\">array</span></div>\n          <h3>Tablica</h3>\n          <p>Lista wartości oddzielonych przecinkami w nawiasach kwadratowych. Elementy mogą być różnych typów. Np. <code>[1, \"dwa\", true]</code></p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\"><span class=\"type-badge map\">map</span></div>\n          <h3>Mapa</h3>\n          <p>Zagnieżdżona struktura klucz-wartość. Tworzona przez podwójne strzałki lub klucze z kropkami.</p>\n        </div>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">.hk</span>\n          <span>wszystkie typy</span>\n        </div>\n        <pre><span class=\"section\">[types]</span>\n<span class=\"dash\">-></span> <span class=\"key\">tekst_plain</span>   <span class=\"arrow\">=></span> <span class=\"str\">hello world</span>\n<span class=\"dash\">-></span> <span class=\"key\">tekst_quoted</span>  <span class=\"arrow\">=></span> <span class=\"str\">\"hello, world\\nwith newline\"</span>\n<span class=\"dash\">-></span> <span class=\"key\">liczba_int</span>    <span class=\"arrow\">=></span> <span class=\"num\">42</span>\n<span class=\"dash\">-></span> <span class=\"key\">liczba_float</span>  <span class=\"arrow\">=></span> <span class=\"num\">3.14</span>\n<span class=\"dash\">-></span> <span class=\"key\">flaga</span>         <span class=\"arrow\">=></span> <span class=\"bool\">true</span>\n<span class=\"dash\">-></span> <span class=\"key\">tablica</span>       <span class=\"arrow\">=></span> [<span class=\"num\">1</span>, <span class=\"num\">2.5</span>, <span class=\"bool\">true</span>, <span class=\"str\">\"cztery\"</span>]</pre>\n      </div>\n    </div>\n\n    \n\n    <div id=\"hk-detect\">\n      <h3>Wykrywanie typu</h3>\n      <p>\n        Typ wartości nie jest zapisywany w pliku — parser ustala go sam, sprawdzając wartość\n        <strong>w stałej kolejności</strong>. Pierwsza pasująca reguła wygrywa.\n      </p>\n\n      <table class=\"syntax-table\">\n        <thead><tr><th>#</th><th>Reguła</th><th>Wynik</th></tr></thead>\n        <tbody>\n          <tr><td>1</td><td>zaczyna się od <code>[</code> i kończy <code>]</code></td><td>tablica (<code>array</code>)</td></tr>\n          <tr><td>2</td><td><code>true</code> / <code>false</code> w dowolnej wielkości liter</td><td><code>bool</code></td></tr>\n          <tr><td>3</td><td>da się sparsować jako liczba (<code>f64</code>)</td><td><code>number</code></td></tr>\n          <tr><td>4</td><td>ujęta w cudzysłowy <code>\"...\"</code></td><td><code>string</code> (z sekwencjami ucieczki)</td></tr>\n          <tr><td>5</td><td>cokolwiek innego</td><td><code>string</code> (bez zmian)</td></tr>\n        </tbody>\n      </table>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>przykłady wykrywania</span></div>\n        <pre>[detect]\n-&gt; port        =&gt; <span class=\"num\">8080</span>            <span class=\"comment\">! number</span>\n-&gt; ulamek      =&gt; <span class=\"num\">0.5</span>             <span class=\"comment\">! number</span>\n-&gt; flaga       =&gt; <span class=\"bool\">TRUE</span>            <span class=\"comment\">! bool (wielkość liter bez znaczenia)</span>\n-&gt; kod         =&gt; <span class=\"str\">v8080</span>            <span class=\"comment\">! string (nie jest liczbą)</span>\n-&gt; tekst_liczb =&gt; <span class=\"str\">\"8080\"</span>          <span class=\"comment\">! string — cudzysłów wymusza tekst</span>\n-&gt; tekst_bool  =&gt; <span class=\"str\">\"true\"</span>          <span class=\"comment\">! string</span>\n-&gt; opis        =&gt; <span class=\"str\">Biblioteka do plików konfiguracyjnych</span>   <span class=\"comment\">! string ze spacjami</span></pre>\n      </div>\n\n      <div class=\"callout warn\">\n        <span class=\"callout-icon\">⚠</span>\n        <div>Liczby są czytane przez parser <code>f64</code> z Rust, więc jako liczby traktowane są także\n        zapisy takie jak <code>1e3</code>, <code>+5</code>, <code>inf</code> czy <code>nan</code>. Jeżeli taki napis ma\n        pozostać tekstem (np. nazwa pakietu), ujmij go w cudzysłowy.</div>\n      </div>\n    </div>\n\n    <div id=\"hk-arrays\">\n      <h3>Tablice</h3>\n      <p>\n        Tablice mają dwa równoważne zapisy. Oba dają dokładnie ten sam wynik (<code>HkValue::Array</code>),\n        a elementy mogą mieć różne typy, także zagnieżdżone tablice.\n      </p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>zapis jednoliniowy</span></div>\n        <pre>[arrays]\n-&gt; authors  =&gt; [<span class=\"str\">\"Alice\"</span>, <span class=\"str\">\"Bob\"</span>]\n-&gt; numbers  =&gt; [<span class=\"num\">1</span>, <span class=\"num\">2</span>, <span class=\"num\">3</span>]\n-&gt; mixed    =&gt; [<span class=\"num\">42</span>, <span class=\"str\">\"text\"</span>, <span class=\"bool\">true</span>, <span class=\"num\">3.14</span>, [<span class=\"str\">\"nested\"</span>, <span class=\"str\">\"array\"</span>]]\n-&gt; quoted   =&gt; [<span class=\"str\">\"hello, world\"</span>, <span class=\"str\">\"quote\\\"escape\"</span>, <span class=\"str\">\"  spaced  \"</span>]</pre>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>zapis wieloliniowy (od v3.2)</span></div>\n        <pre>[arrays]\n-&gt; tags =&gt; [\n    <span class=\"str\">\"desktop\"</span>\n    <span class=\"str\">\"environment\"</span>\n    <span class=\"comment\">! komentarz w środku tablicy jest pomijany</span>\n    <span class=\"str\">\"gui\"</span>\n]\n\n<span class=\"comment\">! tablica tablic</span>\n-&gt; groups =&gt; [\n    [<span class=\"str\">\"admins\"</span>, <span class=\"str\">\"root\"</span>]\n    [<span class=\"str\">\"users\"</span>, <span class=\"str\">\"guest\"</span>]\n]</pre>\n      </div>\n\n      <ul class=\"rules\">\n        <li>W zapisie wieloliniowym przecinek na końcu linii jest <strong>opcjonalny</strong> — <code>\"gui\",</code> i <code>\"gui\"</code> działają tak samo, więc linie można swobodnie przestawiać.</li>\n        <li>Przecinki wewnątrz zagnieżdżonej tablicy oraz wewnątrz cudzysłowów nie dzielą tablicy zewnętrznej.</li>\n        <li>Elementy odczytujesz po indeksie liczonym <strong>od zera</strong>: <code>${arrays.numbers[0]}</code>, <code>${arrays.mixed[4][0]}</code>.</li>\n        <li>Niezamknięta tablica kończy się błędem <code>Unclosed array</code> (parser dochodzi do końca sekcji bez pasującego <code>]</code>).</li>\n        <li>Linia zaczynająca się od <code>[</code> wewnątrz otwartej tablicy nie jest uznawana za nagłówek nowej sekcji.</li>\n      </ul>\n    </div>\n\n    <div id=\"hk-nesting\">\n      <h3>Zagnieżdżanie</h3>\n      <p>\n        Głębokość zagnieżdżenia określa liczba myślników przed <code>></code>.\n        Każdy dodatkowy myślnik to jeden poziom głębiej. Alternatywnie można użyć\n        <strong>kropek w kluczu</strong> jako skrótu.\n      </p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">.hk</span>\n          <span>zagnieżdżanie — styl myślnikowy</span>\n        </div>\n        <pre><span class=\"section\">[libraries]</span>\n<span class=\"comment\">! Mapa L1: \"obsidian\"</span>\n<span class=\"dash\">-></span> <span class=\"key\">obsidian</span>\n<span class=\"comment\">!   Klucze L2 wewnątrz \"obsidian\"</span>\n<span class=\"dash\">--></span> <span class=\"key\">version</span>     <span class=\"arrow\">=></span> <span class=\"num\">0.2</span>\n<span class=\"dash\">--></span> <span class=\"key\">description</span> <span class=\"arrow\">=></span> <span class=\"str\">Biblioteka inspirowana zenity.</span>\n<span class=\"dash\">--></span> <span class=\"key\">authors</span>     <span class=\"arrow\">=></span> [<span class=\"str\">\"HackerOS Team &lt;hackeros068@gmail.com&gt;\"</span>]\n<span class=\"dash\">--></span> <span class=\"key\">so-download</span> <span class=\"arrow\">=></span> <span class=\"url\">https://github.com/Bytes-Repository/obsidian-lib/releases/download/v0.2/libobsidian_lib.so</span>\n\n<span class=\"dash\">-></span> <span class=\"key\">yuy</span>\n<span class=\"dash\">--></span> <span class=\"key\">version</span>     <span class=\"arrow\">=></span> <span class=\"num\">0.2</span>\n<span class=\"dash\">--></span> <span class=\"key\">description</span> <span class=\"arrow\">=></span> <span class=\"str\">Twórz ładne interfejsy CLI</span></pre>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">.hk</span>\n          <span>zagnieżdżanie — klucze z kropką</span>\n        </div>\n        <pre><span class=\"section\">[config]</span>\n<span class=\"comment\">! Tworzy config → database → host</span>\n<span class=\"dash\">-></span> <span class=\"key\">database.host</span>     <span class=\"arrow\">=></span> <span class=\"str\">localhost</span>\n<span class=\"dash\">-></span> <span class=\"key\">database.port</span>     <span class=\"arrow\">=></span> <span class=\"num\">5432</span>\n<span class=\"dash\">-></span> <span class=\"key\">database.ssl</span>      <span class=\"arrow\">=></span> <span class=\"bool\">true</span>\n\n<span class=\"comment\">! Trzy poziomy głębokości</span>\n<span class=\"dash\">-></span> <span class=\"key\">server.tls.cert</span>   <span class=\"arrow\">=></span> <span class=\"str\">/etc/ssl/cert.pem</span>\n<span class=\"dash\">-></span> <span class=\"key\">server.tls.key</span>    <span class=\"arrow\">=></span> <span class=\"str\">/etc/ssl/key.pem</span></pre>\n      </div>\n\n      <div class=\"callout warn\">\n        <span class=\"callout-icon\">⚠</span>\n        <div>\n          Nie można mieszać klucza prostego i klucza z kropką wskazujących na to samo miejsce w drzewie.\n          <code>-> a => 1</code> a potem <code>-> a.b => 2</code> spowoduje błąd <strong>KeyConflict</strong>.\n        </div>\n      </div>\n    </div>\n\n    \n\n    <div id=\"hk-nesting-rules\">\n      <h3>Zasady zagnieżdżania</h3>\n      <ul class=\"rules\">\n        <li>Linia bez <code>=&gt;</code> otwiera <strong>mapę</strong>. Wszystkie kolejne linie o większej liczbie myślników należą do tej mapy.</li>\n        <li>Głębokość musi rosnąć o <strong>dokładnie jeden</strong> myślnik na poziom. Przeskoczenie poziomu (np. z <code>--&gt;</code> od razu na <code>----&gt;</code>) daje błąd <code>Inconsistent nesting level</code>.</li>\n        <li>Powrót do płytszego poziomu zamyka bieżące mapy.</li>\n        <li>Zagnieżdżenie jest nieograniczone — przykładowy plik w repozytorium używa czterech poziomów.</li>\n        <li>Dwa razy ten sam klucz w jednej mapie to <code>KeyConflict</code>.</li>\n      </ul>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>cztery poziomy zagnieżdżenia</span></div>\n        <pre>[global]\n-&gt; database\n--&gt; host =&gt; localhost\n--&gt; port =&gt; <span class=\"num\">5432</span>\n--&gt; credentials\n---&gt; username =&gt; admin\n---&gt; password =&gt; <span class=\"interpol\">${env:DB_PASSWORD}</span>\n--&gt; ssl =&gt; <span class=\"bool\">true</span>\n\n-&gt; features\n--&gt; compression =&gt; <span class=\"bool\">true</span>\n--&gt; logging\n---&gt; level =&gt; debug\n---&gt; file  =&gt; /var/log/app.log</pre>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>błędne — pominięty poziom</span></div>\n        <pre>[broken]\n-&gt; a\n--&gt; b =&gt; <span class=\"num\">1</span>\n<span class=\"err\">----&gt; c =&gt; 2</span>   <span class=\"comment\">! brak poziomu \"--->\": Inconsistent nesting level</span></pre>\n      </div>\n\n      <p>\n        Dostęp do zagnieżdżonych wartości odbywa się po <strong>ścieżce z kropkami</strong>:\n        <code>global.database.credentials.username</code>. Ta sama notacja działa w interpolacji\n        i w funkcjach <code>get</code> / <code>set</code> wszystkich bibliotek.\n      </p>\n    </div>\n\n    <div id=\"hk-interpol\">\n      <h3>Interpolacja</h3>\n      <p>\n        Wartości tekstowe mogą zawierać <strong>referencje</strong> do innych kluczy lub zmiennych środowiskowych,\n        używając składni <code>${...}</code>. Parser automatycznie rozwiązuje referencje, wykrywa cykle i błędne odwołania.\n      </p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">.hk</span>\n          <span>interpolacja — referencje i env</span>\n        </div>\n        <pre><span class=\"section\">[project]</span>\n<span class=\"dash\">-></span> <span class=\"key\">name</span>     <span class=\"arrow\">=></span> <span class=\"str\">MyApp</span>\n<span class=\"dash\">-></span> <span class=\"key\">version</span>  <span class=\"arrow\">=></span> <span class=\"num\">1.0</span>\n\n<span class=\"section\">[paths]</span>\n<span class=\"comment\">! Referencja do klucza z innej sekcji</span>\n<span class=\"dash\">-></span> <span class=\"key\">base</span>     <span class=\"arrow\">=></span> <span class=\"str\">/opt/</span><span class=\"interpol\">${project.name}</span>\n<span class=\"dash\">-></span> <span class=\"key\">config</span>   <span class=\"arrow\">=></span> <span class=\"interpol\">${paths.base}</span><span class=\"str\">/config</span>\n<span class=\"dash\">-></span> <span class=\"key\">logs</span>     <span class=\"arrow\">=></span> <span class=\"interpol\">${paths.base}</span><span class=\"str\">/logs</span>\n\n<span class=\"comment\">! Zmienna środowiskowa (prefix \"env:\")</span>\n<span class=\"dash\">-></span> <span class=\"key\">home</span>     <span class=\"arrow\">=></span> <span class=\"interpol\">${env:HOME}</span>\n<span class=\"dash\">-></span> <span class=\"key\">user</span>     <span class=\"arrow\">=></span> <span class=\"interpol\">${env:USER}</span>\n\n<span class=\"section\">[data]</span>\n<span class=\"dash\">-></span> <span class=\"key\">numbers</span>  <span class=\"arrow\">=></span> [<span class=\"num\">10</span>, <span class=\"num\">20</span>, <span class=\"num\">30</span>]\n<span class=\"comment\">! Indeksowanie tablicy</span>\n<span class=\"dash\">-></span> <span class=\"key\">first</span>    <span class=\"arrow\">=></span> <span class=\"interpol\">${data.numbers[0]}</span></pre>\n      </div>\n\n      <table class=\"syntax-table\">\n        <thead>\n          <tr><th>Składnia</th><th>Przykład</th><th>Opis</th></tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>${sekcja.klucz}</td>\n            <td>${project.name}</td>\n            <td>Referencja do klucza w innej sekcji</td>\n          </tr>\n          <tr>\n            <td>${sekcja.mapa.klucz}</td>\n            <td>${build.opts.level}</td>\n            <td>Referencja głęboko zagnieżdżona</td>\n          </tr>\n          <tr>\n            <td>${sekcja.tablica[n]}</td>\n            <td>${data.list[0]}</td>\n            <td>Indeksowanie elementu tablicy (od 0)</td>\n          </tr>\n          <tr>\n            <td>${env:NAZWA}</td>\n            <td>${env:HOME}</td>\n            <td>Zmienna środowiskowa; pusta jeśli nieustawiona</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    \n\n    <div id=\"hk-interpol-notes\">\n      <h3>Interpolacja — szczegóły</h3>\n      <ul class=\"rules\">\n        <li>Interpolacje rozwiązuje się <strong>jawnie</strong> — po wczytaniu pliku wywołaj <code>resolve_interpolations</code> (Rust), <code>resolve = true</code> / <code>cfg:resolve()</code> (Lua) albo <code>cfg.resolve()</code> (H#). Samo parsowanie zostawia <code>${...}</code> w tekście.</li>\n        <li>Interpolacja działa w wartościach tekstowych, także w elementach tablic i w wielu miejscach jednej wartości: <code>${a}/${b}.conf</code>.</li>\n        <li>Referencja może wskazywać na wartość, która sama zawiera interpolację — parser rozwija łańcuch rekurencyjnie.</li>\n        <li>Wynik interpolacji jest zawsze <strong>tekstem</strong>: <code>${data.numbers[0]}</code> daje <code>\"10\"</code>, a nie liczbę.</li>\n        <li><code>${env:NAZWA}</code> dla nieustawionej zmiennej daje pusty tekst (to nie jest błąd).</li>\n        <li>Odwołanie do nieistniejącego klucza to <code>InvalidReference</code>, a pętla <code>a → b → a</code> to <code>CyclicReference</code>.</li>\n        <li>Ścieżka referencji jest zawsze liczona od <strong>nazwy sekcji</strong> (<code>sekcja.klucz</code>), niezależnie od tego, w której sekcji stoi odwołanie.</li>\n      </ul>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">.hk</span><span>łańcuch referencji</span></div>\n        <pre>[project]\n-&gt; name =&gt; hackeros\n\n[paths]\n-&gt; root   =&gt; /opt/<span class=\"interpol\">${project.name}</span>\n-&gt; bin    =&gt; <span class=\"interpol\">${paths.root}</span>/bin\n-&gt; tool   =&gt; <span class=\"interpol\">${paths.bin}</span>/hpm\n\n<span class=\"comment\">! po resolve: paths.tool == \"/opt/hackeros/bin/hpm\"</span></pre>\n      </div>\n    </div>\n\n    <div id=\"hk-errors\">\n      <h3>Błędy parsowania</h3>\n      <p>Parser zwraca precyzyjne błędy z numerem linii i kolumny. Każdy błąd ma wbudowany hint wyświetlany w terminalu.</p>\n\n      <div class=\"error-grid\">\n        <div class=\"error-card parse\">\n          <div class=\"err-name\">Parse { line, column, message }</div>\n          <p>Błąd składni. Zawiera numer linii i kolumny oraz opis problemu. Terminal pokazuje wskaźnik <code>^</code> w odpowiednim miejscu.</p>\n        </div>\n        <div class=\"error-card type\">\n          <div class=\"err-name\">TypeMismatch { expected, found }</div>\n          <p>Próba odczytu wartości jako nieodpowiedni typ. Np. odczyt liczby z klucza który jest mapą.</p>\n        </div>\n        <div class=\"error-card ref\">\n          <div class=\"err-name\">InvalidReference(path)</div>\n          <p>Interpolacja wskazuje na nieistniejący klucz. Sprawdź, czy ścieżka <code>sekcja.klucz</code> istnieje.</p>\n        </div>\n        <div class=\"error-card cyclic\">\n          <div class=\"err-name\">CyclicReference(path)</div>\n          <p>Dwie wartości interpolują się nawzajem. Np. <code>a => ${b}</code> i <code>b => ${a}</code>.</p>\n        </div>\n        <div class=\"error-card conflict\">\n          <div class=\"err-name\">KeyConflict(key)</div>\n          <p>Duplikat klucza lub konflikt między kluczem prostym a kluczem z kropką wskazującym to samo miejsce.</p>\n        </div>\n        <div class=\"error-card missing\">\n          <div class=\"err-name\">MissingField(name)</div>\n          <p>Wymagane pole nie zostało znalezione podczas deserializacji struktury.</p>\n        </div>\n        <div class=\"error-card io\">\n          <div class=\"err-name\">Io(error)</div>\n          <p>Plik nie istnieje albo nie da się go odczytać. Występuje przy <code>load_hk_file</code> i odczycie z dysku.</p>\n        </div>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\">\n          <span class=\"lang\">terminal</span>\n          <span>przykładowy output błędu</span>\n        </div>\n        <pre><span class=\"err\">error: parse error</span>\n  → at 4:3\n\n  -< klucz => wartość\n    <span class=\"err\">^</span>\n  <span class=\"err\">Expected '>' after dashes</span>\n\n<span class=\"bool\">Hint:</span> Try: key => value</pre>\n      </div>\n    </div>\n\n    \n\n    <div id=\"hk-messages\">\n      <h3>Komunikaty parsera</h3>\n      <p>Najczęstsze błędy <code>Parse</code> i ich typowa przyczyna:</p>\n\n      <table class=\"syntax-table\">\n        <thead><tr><th>Komunikat</th><th>Przyczyna</th><th>Naprawa</th></tr></thead>\n        <tbody>\n          <tr><td>Expected section header</td><td>Treść poza sekcją (np. klucz przed pierwszym <code>[nagłówkiem]</code>)</td><td>Dodaj <code>[sekcja]</code> nad kluczem</td></tr>\n          <tr><td>Unclosed section header</td><td><code>[nazwa</code> bez <code>]</code></td><td>Zamknij nawias</td></tr>\n          <tr><td>Empty section name</td><td><code>[]</code></td><td>Nadaj sekcji nazwę</td></tr>\n          <tr><td>Expected key or map header</td><td>Linia w sekcji nie zaczyna się od myślnika</td><td>Zacznij od <code>-&gt;</code> lub dodaj <code>!</code> dla komentarza</td></tr>\n          <tr><td>Expected '&gt;' after dashes</td><td>Np. <code>-&lt; klucz</code> albo <code>-- klucz</code></td><td>Użyj <code>-&gt; klucz =&gt; wartość</code></td></tr>\n          <tr><td>Missing key after '&gt;'</td><td>Sama strzałka bez klucza</td><td>Dodaj nazwę klucza</td></tr>\n          <tr><td>Empty key / Empty map key</td><td>Pusty klucz przed <code>=&gt;</code> lub nagłówek mapy bez nazwy</td><td>Podaj nazwę</td></tr>\n          <tr><td>Empty value</td><td><code>-&gt; k =&gt;</code> bez wartości</td><td>Wpisz wartość</td></tr>\n          <tr><td>Unclosed array</td><td>Tablica otwarta <code>[</code> bez <code>]</code> do końca sekcji</td><td>Dodaj zamykający <code>]</code></td></tr>\n          <tr><td>Inconsistent nesting level</td><td>Poziom zagnieżdżenia wzrósł o więcej niż jeden myślnik</td><td>Dodaj brakujący poziom</td></tr>\n        </tbody>\n      </table>\n\n      <h3>Ładne komunikaty (od 3.2.1)</h3>\n      <p>\n        <code>HkError::render(&amp;źródło)</code> zwraca komunikat w stylu <code>rustc</code>: fragment pliku, numery linii,\n        znacznik <code>^</code> pod błędną kolumną i podpowiedź. <code>pretty_print</code> wypisuje to samo na stderr.\n        Wersja Lua zwraca ten tekst w <code>info.rendered</code>.\n      </p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">Rust</span><span>wyświetlanie błędu</span></div>\n        <pre><span class=\"bool\">match</span> parse_hk(&amp;contents) {\n    Ok(config) =&gt; { <span class=\"comment\">/* ... */</span> }\n    Err(e) =&gt; {\n        eprint!(<span class=\"str\">\"{}\"</span>, e.render(&amp;contents)); <span class=\"comment\">// albo: e.pretty_print(&amp;contents);</span>\n        std::process::exit(<span class=\"num\">1</span>);\n    }\n}</pre>\n      </div>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">terminal</span><span>wynik</span></div>\n        <pre>error: Expected key or map header\n  --&gt; line 4, column 1\n  3 | -&gt; ok =&gt; 1\n  4 | oops\n    | ^\n  hint: every non-blank, non-comment line must start with one or more '-' followed by '&gt;', e.g. \"-&gt; key =&gt; value\"</pre>\n      </div>\n    </div>\n\n    <div id=\"hk-serialize\">\n      <h3>Serializacja</h3>\n      <p>\n        Konfigurację można zapisać z powrotem do tekstu <code>.hk</code>. Kolejność sekcji i kluczy jest zachowana,\n        a zagnieżdżone mapy są zapisywane strzałkami o rosnącej głębokości.\n      </p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">Rust</span><span>parsowanie → zmiana → zapis</span></div>\n        <pre><span class=\"bool\">use</span> hk_parser::{load_hk_file, set_value_by_path, write_hk_file, HkValue};\n\n<span class=\"bool\">let mut</span> cfg = load_hk_file(<span class=\"str\">\"config.hk\"</span>)?;\nset_value_by_path(&amp;mut cfg, <span class=\"str\">\"global.version\"</span>, HkValue::Number(<span class=\"num\">3.0</span>))?;\nwrite_hk_file(<span class=\"str\">\"config.hk\"</span>, &amp;cfg)?;</pre>\n      </div>\n\n      <ul class=\"rules\">\n        <li>Komentarze <strong>nie są zachowywane</strong> — nie trafiają do struktury danych, więc po zapisie ich nie będzie.</li>\n        <li>Tekst zawierający spację, przecinek, <code>]</code>, cudzysłów lub nową linię jest zapisywany w cudzysłowach.</li>\n        <li>Wartość mapy zagnieżdżonej jest zapisywana jako nagłówek (linia bez <code>=&gt;</code>) i podrzędne klucze.</li>\n        <li>W Lua tabela jest zapisywana z kluczami w kolejności alfabetycznej (tabele Lua nie mają kolejności). Gdy kolejność ma znaczenie, buduj dokument przez <code>new()</code> i <code>set()</code>.</li>\n      </ul>\n    </div>\n\n    <div id=\"hk-real\">\n      <h3>Przykłady z praktyki</h3>\n      <p>Pliki <code>.hk</code> w repozytoriach HackerOS, np. manifest biblioteki dla <code>bit</code> (<code>Bit.hk</code>):</p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">Bit.hk</span><span>manifest biblioteki H#</span></div>\n        <pre>[package]\n-&gt; name        =&gt; hk-parser\n-&gt; version     =&gt; 0.3.2\n-&gt; description =&gt; H# bindings for hk-parser\n-&gt; authors     =&gt; [<span class=\"str\">\"HackerOS Team &lt;hackeros068@gmail.com&gt;\"</span>]\n-&gt; license     =&gt; MIT\n-&gt; lang        =&gt; h#\n\n[layout]\n-&gt; lib-entry =&gt; src/bit-io/main.h#\n\n[build]\n-&gt; link =&gt; static\n-&gt; native =&gt; cargo build --release --lib\n\n[commands]\n-&gt; rust-test\n--&gt; run         =&gt; cargo test\n--&gt; description =&gt; Run the Rust test-suite of the parser</pre>\n      </div>\n\n      <p>Środowisko kontenerowe dla polecenia <code>hacker env create</code> (fragment):</p>\n\n      <div class=\"code-block\">\n        <div class=\"code-block-header\"><span class=\"lang\">pentest.hk</span><span>konfiguracja środowiska</span></div>\n        <pre>[env]\n-&gt; name  =&gt; pentest-env\n-&gt; image =&gt; fedora:latest\n-&gt; shell =&gt; zsh\n\n[sync_tools]\n-&gt; flatpak =&gt; [<span class=\"str\">\"com.brave.Browser\"</span>]\n-&gt; system  =&gt; [<span class=\"str\">\"~/go/bin/subfinder\"</span>]</pre>\n      </div>\n    </div>\n\n    <div id=\"hk-best\">\n      <h3>Dobre praktyki</h3>\n      <ul class=\"rules\">\n        <li>Grupuj powiązane ustawienia w jednej sekcji i używaj map zamiast długich kluczy z kropkami, gdy pod jednym kluczem jest więcej niż kilka wartości.</li>\n        <li>Powtarzające się fragmenty (ścieżki, nazwy) wynoś do osobnej sekcji i odwołuj się do nich przez <code>${sekcja.klucz}</code>.</li>\n        <li>Sekrety czytaj ze zmiennych środowiskowych (<code>${env:HASLO}</code>), nie zapisuj ich w pliku.</li>\n        <li>Dłuższe listy zapisuj wieloliniowo — jedna pozycja na linię, łatwiej o czytelny diff.</li>\n        <li>Komentarz pisz zawsze w osobnej linii; po wartości nie jest on obsługiwany.</li>\n        <li>Po wczytaniu pliku obsłuż błąd przez <code>render</code> — pokazuje linię i kolumnę, więc użytkownik od razu widzi, co poprawić.</li>\n        <li>Nie zakładaj, że komentarze przetrwają zapis — przed edycją programową zrób kopię pliku, jeśli komentarze są ważne.</li>\n      </ul>\n    </div>\n\n    <div id=\"hk-vs-yaml\">\n      <h3>Porównanie z YAML i innymi formatami</h3>\n\n      <div class=\"compare\">\n        <div class=\"compare-panel hk\">\n          <div class=\"compare-panel-header\">.hk</div>\n          <pre style=\"color: var(--text); font-size:12.5px; line-height:1.8;\"><span class=\"section\">[server]</span>\n<span class=\"dash\">-></span> <span class=\"key\">host</span>    <span class=\"arrow\">=></span> <span class=\"str\">localhost</span>\n<span class=\"dash\">-></span> <span class=\"key\">port</span>    <span class=\"arrow\">=></span> <span class=\"num\">8080</span>\n<span class=\"dash\">-></span> <span class=\"key\">ssl</span>     <span class=\"arrow\">=></span> <span class=\"bool\">true</span>\n<span class=\"dash\">-></span> <span class=\"key\">tls</span>\n<span class=\"dash\">--></span> <span class=\"key\">cert</span>  <span class=\"arrow\">=></span> <span class=\"str\">/etc/cert.pem</span>\n<span class=\"dash\">--></span> <span class=\"key\">key</span>   <span class=\"arrow\">=></span> <span class=\"str\">/etc/key.pem</span>\n<span class=\"dash\">-></span> <span class=\"key\">allowed</span> <span class=\"arrow\">=></span> [<span class=\"str\">\"GET\"</span>, <span class=\"str\">\"POST\"</span>]</pre>\n        </div>\n        <div class=\"compare-panel yaml\">\n          <div class=\"compare-panel-header\">YAML (równoważny)</div>\n          <pre style=\"color: var(--text2); font-size:12.5px; line-height:1.8;\">server:\n  host: localhost\n  port: 8080\n  ssl: true\n  tls:\n    cert: /etc/cert.pem\n    key: /etc/key.pem\n  allowed:\n    - GET\n    - POST</pre>\n        </div>\n      </div>\n\n      <table class=\"syntax-table\">\n        <thead>\n          <tr><th>Cecha</th><th>.hk</th><th>YAML</th><th>TOML</th><th>INI</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>Zagnieżdżenie</td><td>strzałki <code>-&gt;</code> / <code>--&gt;</code></td><td>wcięcia</td><td>tabele <code>[a.b]</code></td><td>brak</td></tr>\n          <tr><td>Typy</td><td>string, number, bool, array, map</td><td>wiele</td><td>wiele</td><td>tylko tekst</td></tr>\n          <tr><td>Interpolacja</td><td>wbudowana <code>${...}</code></td><td>brak (kotwice)</td><td>brak</td><td>zależna od parsera</td></tr>\n          <tr><td>Kolejność kluczy</td><td>zachowana</td><td>zależna od parsera</td><td>zależna od parsera</td><td>zwykle zachowana</td></tr>\n          <tr><td>Błędy</td><td>linia, kolumna, podpowiedź</td><td>różnie</td><td>linia, kolumna</td><td>różnie</td></tr>\n          <tr><td>Wrażliwość na wcięcia</td><td>nie</td><td>tak</td><td>nie</td><td>nie</td></tr>\n        </tbody>\n      </table>\n\n\n      <div class=\"feature-grid\">\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">✓</div>\n          <h3>Brak znaczących wcięć</h3>\n          <p>Zagnieżdżenie przez myślniki — nie przez spacje. Brak błędów wynikających z tabów vs spacji.</p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">✓</div>\n          <h3>Wbudowana interpolacja</h3>\n          <p>Natywne <code>${ref}</code> i <code>${env:VAR}</code> bez zewnętrznych narzędzi. YAML nie ma tego wbudowanego.</p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">✓</div>\n          <h3>Precyzyjne błędy</h3>\n          <p>Błąd wskazuje linię, kolumnę i daje hint naprawczy. YAML-owe błędy bywają kryptyczne.</p>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">✓</div>\n          <h3>Zachowana kolejność</h3>\n          <p>Parser używa <code>IndexMap</code> — kolejność kluczy w pliku jest zachowana przy serializacji.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"divider\"></div>\n\n  \n  \n  \n\n  <section id=\"hacker\">\n    <div class=\"section-label\"><span class=\"tag\">02</span> format pomocniczy</div>\n    <h2 class=\"section-title\">Format <span class=\"dim\">.hacker</span></h2>\n    <p class=\"section-desc\">\n      Lekki format metadanych dla modułów, aplikacji i narzędzi w ekosystemie HackerOS.\n      Obsługuje trzy wersje o różnym poziomie szczegółowości.\n    </p>\n\n    <p>\n      Każdy plik <code>.hacker</code> to zawartość ujęta w nawiasy kwadratowe <code>[ ... ]</code>.\n      Parser automatycznie wykrywa wersję na podstawie struktury zawartości.\n    </p>\n\n    <div class=\"hacker-section\">\n      <div class=\"hacker-header\">Wersje formatu .hacker</div>\n      <div class=\"version-tabs\">\n        <div class=\"vtab active\" onclick=\"showTab('v1')\">v1 — prosty</div>\n        <div class=\"vtab\" onclick=\"showTab('v2')\">v2 — sekcje</div>\n        <div class=\"vtab\" onclick=\"showTab('v3')\">v3 — metadane</div>\n      </div>\n\n      <div class=\"vtab-content active\" id=\"tab-v1\">\n        <p style=\"margin-bottom:16px;\">Wersja 1 to fallback — dowolny tekst między nawiasami. Używana np. do oznaczenia numeru wersji lub krótkiego opisu.</p>\n        <div class=\"code-block\" style=\"margin:0\">\n          <div class=\"code-block-header\"><span class=\"lang\">.hacker v1</span><span>składnia</span></div>\n          <pre><span class=\"section\">[ 0.2 ]</span>\n\n<span class=\"comment\">! lub wieloliniowo:</span>\n<span class=\"section\">[\n  dowolny tekst\n  w kilku liniach\n]</span></pre>\n        </div>\n      </div>\n\n      <div class=\"vtab-content\" id=\"tab-v2\">\n        <p style=\"margin-bottom:16px;\">Wersja 2 zawiera nagłówek i sekcje z listami wartości. Używana np. w plikach repozytorium opisujących dostępne kernele, narzędzia, wersje.</p>\n        <div class=\"code-block\" style=\"margin:0\">\n          <div class=\"code-block-header\"><span class=\"lang\">.hacker v2</span><span>składnia</span></div>\n          <pre><span class=\"section\">[</span>\n <span class=\"key\">Nazwa projektu</span>         <span class=\"comment\">! nagłówek — linie przed pierwszą sekcją</span>\n\n <span class=\"bool\">jadro:</span>                  <span class=\"comment\">! nazwa sekcji + dwukropek</span>\n <span class=\"str\">= xanmod</span>               <span class=\"comment\">! wartość sekcji — prefix \"= \"</span>\n <span class=\"str\">= liquorix</span>\n\n <span class=\"bool\">narzedzia:</span>\n <span class=\"str\">= hpm</span>\n <span class=\"str\">= hl</span>\n\n <span class=\"bool\">wersje:</span>\n <span class=\"str\">= 0.1</span>\n <span class=\"str\">= 0.2</span>\n <span class=\"str\">= 1.1</span>\n<span class=\"section\">]</span></pre>\n        </div>\n      </div>\n\n      <div class=\"vtab-content\" id=\"tab-v3\">\n        <p style=\"margin-bottom:16px;\">Wersja 3 opisuje konkretny moduł lub aplikację przez cztery wymagane pola. Używana jako główny plik opisu aplikacji HackerOS.</p>\n        <div class=\"code-block\" style=\"margin:0\">\n          <div class=\"code-block-header\"><span class=\"lang\">.hacker v3</span><span>składnia</span></div>\n          <pre><span class=\"section\">[</span>\n <span class=\"str\">= application</span>           <span class=\"comment\">! nagłówek (= )</span>\n <span class=\"blue\">=> gui</span>                   <span class=\"comment\">! typ aplikacji (=> )</span>\n <span class=\"dash\">-> aplication for cybersecurity</span>  <span class=\"comment\">! opis (-> )</span>\n <span class=\"dash\">--> main.hacker</span>          <span class=\"comment\">! ścieżka pliku (--> )</span>\n<span class=\"section\">]</span></pre>\n        </div>\n        <table class=\"syntax-table\" style=\"margin-top:20px\">\n          <thead><tr><th>Prefix</th><th>Pole</th><th>Opis</th></tr></thead>\n          <tbody>\n            <tr><td>= </td><td>header</td><td>Nazwa / nagłówek modułu</td></tr>\n            <tr><td>=> </td><td>type</td><td>Typ: <code>gui</code>, <code>cli</code>, <code>lib</code>, itd.</td></tr>\n            <tr><td>-> </td><td>description</td><td>Krótki opis modułu</td></tr>\n            <tr><td>--> </td><td>file</td><td>Ścieżka do głównego pliku</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <h3>Wykrywanie wersji</h3>\n    <p>\n      Parser próbuje wersje w kolejności: <strong>v2 → v3 → v1</strong>.\n      V1 jest zawsze akceptowany jako fallback — jeśli plik nie pasuje do v2 ani v3,\n      cała zawartość trafia do pola <code>content</code>.\n    </p>\n\n    <div class=\"callout info\">\n      <span class=\"callout-icon\">ℹ</span>\n      <div>\n        Każdy plik <code>.hacker</code> musi zaczynać się od <code>[</code> i kończyć na <code>]</code> (z opcjonalnymi białymi znakami).\n        Pusty plik (<code>[]</code>) zwraca błąd <code>EmptyContent</code>.\n      </div>\n    </div>\n    <div id=\"hacker-lib\">\n      <h3>Biblioteka hacker</h3>\n      <p>Parser formatu <code>.hacker</code> znajdziesz w następujących miejscach:</p>\n\n      <div class=\"lib-grid\">\n        <a class=\"lib-card\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hacker\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"lib-tag\">H#</span>\n          <span class=\"lib-title\">bit.io / H#</span>\n          <span class=\"lib-desc\">Biblioteka <code>hacker</code> dla projektów H#, dostępna przez menedżer <strong>bit</strong>.</span>\n          <span class=\"lib-url\">hackeros-linux-system.github.io/bit — hacker ↗</span>\n        </a>\n        <a class=\"lib-card\" href=\"https://crates.io/crates/hacker\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"lib-tag\">Rust</span>\n          <span class=\"lib-title\">crates.io / Rust</span>\n          <span class=\"lib-desc\">Crate <code>hacker</code> — parsowanie plików <code>.hacker</code> w wersjach v1, v2 i v3.</span>\n          <span class=\"lib-url\">crates.io/crates/hacker ↗</span>\n        </a>\n      </div>\n\n      <table class=\"syntax-table\">\n        <thead><tr><th>Język</th><th>Adres</th></tr></thead>\n        <tbody>\n          <tr><td>bit.io / H#</td><td><a class=\"plain-link\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hacker\" target=\"_blank\" rel=\"noopener\">https://hackeros-linux-system.github.io/bit/lib.html?name=hacker</a></td></tr>\n          <tr><td>crates.io / Rust</td><td><a class=\"plain-link\" href=\"https://crates.io/crates/hacker\" target=\"_blank\" rel=\"noopener\">https://crates.io/crates/hacker</a></td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <div class=\"divider\"></div>\n\n  \n  \n  \n\n  <section id=\"api\">\n    <div class=\"section-label\"><span class=\"tag\">03</span> programowe użycie</div>\n    <h2 class=\"section-title\">Rust <span class=\"dim\">API</span></h2>\n    <p class=\"section-desc\">\n      Interfejs biblioteki <code>hk-parser</code> w Rust, Lua i H# oraz parsera <code>.hacker</code>.\n    </p>\n\n    <h3 id=\"api-rust\">Rust — hk-parser</h3>\n\n    <div class=\"api-grid\">\n      <div class=\"api-item\">\n        <div class=\"api-sig\">parse_hk(input)</div>\n        <div>\n          <div class=\"api-desc\">Parsuje string jako plik <code>.hk</code>. Zwraca <code>HkConfig</code> (IndexMap sekcji).</div>\n          <div class=\"api-ret\">→ Result&lt;HkConfig, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">load_hk_file(path)</div>\n        <div>\n          <div class=\"api-desc\">Wczytuje plik z dysku i parsuje. Obsługuje <code>BufReader</code> wewnętrznie.</div>\n          <div class=\"api-ret\">→ Result&lt;HkConfig, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">resolve_interpolations(config)</div>\n        <div>\n          <div class=\"api-desc\">Rozwiązuje wszystkie <code>${...}</code> w miejscu. Modyfikuje config. Wykrywa cykle.</div>\n          <div class=\"api-ret\">→ Result&lt;(), HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">serialize_hk(config)</div>\n        <div>\n          <div class=\"api-desc\">Serializuje <code>HkConfig</code> z powrotem do stringa w formacie <code>.hk</code>. Zachowuje kolejność.</div>\n          <div class=\"api-ret\">→ String</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">write_hk_file(path, config)</div>\n        <div>\n          <div class=\"api-desc\">Zapisuje zserializowany config do pliku na dysku.</div>\n          <div class=\"api-ret\">→ io::Result&lt;()&gt;</div>\n        </div>\n      </div>\n    </div>\n\n    <h3>Enum <code>HkValue</code> — metody</h3>\n\n    <div class=\"api-grid\">\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.as_string()</div>\n        <div>\n          <div class=\"api-desc\">Konwertuje String, Number lub Bool na <code>String</code>. Błąd dla Array/Map.</div>\n          <div class=\"api-ret\">→ Result&lt;String, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.as_number()</div>\n        <div>\n          <div class=\"api-desc\">Zwraca wartość jako <code>f64</code>. Błąd jeśli wartość nie jest typu Number.</div>\n          <div class=\"api-ret\">→ Result&lt;f64, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.as_bool()</div>\n        <div>\n          <div class=\"api-desc\">Zwraca wartość jako <code>bool</code>. Błąd jeśli wartość nie jest typu Bool.</div>\n          <div class=\"api-ret\">→ Result&lt;bool, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.as_array()</div>\n        <div>\n          <div class=\"api-desc\">Zwraca referencję do <code>Vec&lt;HkValue&gt;</code>. Błąd jeśli to nie tablica.</div>\n          <div class=\"api-ret\">→ Result&lt;&amp;Vec&lt;HkValue&gt;, HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.as_map()</div>\n        <div>\n          <div class=\"api-desc\">Zwraca referencję do <code>IndexMap&lt;String, HkValue&gt;</code>. Błąd jeśli to nie mapa.</div>\n          <div class=\"api-ret\">→ Result&lt;&amp;IndexMap&lt;String, HkValue&gt;, HkError&gt;</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"code-block\">\n      <div class=\"code-block-header\"><span class=\"lang\">Rust</span><span>przykład użycia API</span></div>\n      <pre><span class=\"bool\">use</span> hk_parser::{load_hk_file, resolve_interpolations};\n\n<span class=\"bool\">fn</span> <span class=\"key\">main</span>() -> Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {\n    <span class=\"bool\">let mut</span> config = load_hk_file(<span class=\"str\">\"config.hk\"</span>)?;\n    \n    <span class=\"comment\">// Rozwiąż interpolacje (env vars, referencje)</span>\n    resolve_interpolations(&amp;mut config)?;\n    \n    <span class=\"comment\">// Odczyt zagnieżdżonej wartości</span>\n    <span class=\"bool\">let</span> server = config[<span class=\"str\">\"server\"</span>].as_map()?;\n    <span class=\"bool\">let</span> host   = server[<span class=\"str\">\"host\"</span>].as_string()?;\n    <span class=\"bool\">let</span> port   = server[<span class=\"str\">\"port\"</span>].as_number()? as u16;\n    \n    println!(<span class=\"str\">\"Connecting to {}:{}\"</span>, host, port);\n    Ok(())\n}</pre>\n    </div>\n\n\n    <h3>Edycja po ścieżkach</h3>\n    <p>\n      Ścieżka ma postać <code>sekcja.klucz</code>, z opcjonalnym indeksem tablicy <code>lista[2]</code>\n      (łańcuch <code>a[1][0]</code> działa przy odczycie).\n    </p>\n\n    <div class=\"api-grid\">\n      <div class=\"api-item\">\n        <div class=\"api-sig\">get_value_by_path(path, &amp;config)</div>\n        <div>\n          <div class=\"api-desc\">Zwraca referencję do wartości pod ścieżką, np. <code>\"global.database.port\"</code>.</div>\n          <div class=\"api-ret\">→ Option&lt;&amp;HkValue&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">get_value_by_keys(&amp;config, &amp;[..])</div>\n        <div>\n          <div class=\"api-desc\">Odczyt po gotowej liście kluczy — bez interpretacji kropek i nawiasów, więc działa dla dowolnych nazw (np. <code>.hl-download</code>).</div>\n          <div class=\"api-ret\">→ Option&lt;&amp;HkValue&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">set_value_by_path(&amp;mut config, path, value)</div>\n        <div>\n          <div class=\"api-desc\">Ustawia wartość, tworząc brakujące mapy pośrednie (nigdy tablice). Istniejący klucz zachowuje pozycję, nowy trafia na koniec. <code>lista[i]</code> zastępuje element lub dopisuje, gdy <code>i == len</code>.</div>\n          <div class=\"api-ret\">→ Result&lt;(), HkError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">remove_value_by_path(&amp;mut config, path)</div>\n        <div>\n          <div class=\"api-desc\">Usuwa wartość pod ścieżką i zwraca ją, jeśli istniała.</div>\n          <div class=\"api-ret\">→ Option&lt;HkValue&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">set_value_by_segments / remove_value_by_segments</div>\n        <div>\n          <div class=\"api-desc\">Warianty przyjmujące gotowe segmenty <code>PathSeg</code> (klucz + opcjonalny indeks), do adresowania kluczy zawierających kropkę lub nawias.</div>\n          <div class=\"api-ret\">→ Result&lt;(), HkError&gt; / Option&lt;HkValue&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">parse_path(path)</div>\n        <div>\n          <div class=\"api-desc\">Rozbija <code>\"a.b[2].c\"</code> na kroki <code>PathSeg</code> — dokładnie tą samą tokenizacją, której używa odczyt.</div>\n          <div class=\"api-ret\">→ Vec&lt;PathSeg&gt;</div>\n        </div>\n      </div>\n    </div>\n\n    <h3>Błędy — <code>HkError</code></h3>\n    <div class=\"api-grid\">\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.render(source)</div>\n        <div>\n          <div class=\"api-desc\">Komunikat w stylu <code>rustc</code> z fragmentem pliku, znacznikiem <code>^</code> i podpowiedzią (od 3.2.1).</div>\n          <div class=\"api-ret\">→ String</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">.pretty_print(source)</div>\n        <div>\n          <div class=\"api-desc\">Wypisuje wynik <code>render</code> na stderr.</div>\n          <div class=\"api-ret\">→ ()</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">warianty</div>\n        <div>\n          <div class=\"api-desc\"><code>Io</code>, <code>Parse { line, column, message }</code>, <code>TypeMismatch</code>, <code>MissingField</code>, <code>InvalidReference</code>, <code>CyclicReference</code>, <code>KeyConflict</code>.</div>\n          <div class=\"api-ret\">→ enum HkError</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">HkValue::type_name()</div>\n        <div>\n          <div class=\"api-desc\">Nazwa typu wartości: <code>string</code>, <code>number</code>, <code>bool</code>, <code>array</code>, <code>map</code>.</div>\n          <div class=\"api-ret\">→ &amp;'static str</div>\n        </div>\n      </div>\n    </div>\n\n    <h3 id=\"api-lua\">Lua — hk-parser</h3>\n    <p>\n      Pakiet LuaRocks: <a class=\"plain-link\" href=\"https://luarocks.org/modules/michal92299/hk-parser\" target=\"_blank\" rel=\"noopener\">luarocks.org/modules/michal92299/hk-parser</a>.\n      Działa na Lua 5.1–5.4 i LuaJIT (Linux); Lua 5.5 jest przygotowana, ale nieprzetestowana.\n      Instalacja wymaga <code>cargo</code> (Rust &gt;= 1.85), bo natywny moduł jest kompilowany podczas instalacji.\n    </p>\n\n    <div class=\"code-block\">\n      <div class=\"code-block-header\"><span class=\"lang\">Lua</span><span>podstawowe użycie</span></div>\n      <pre><span class=\"bool\">local</span> hk = require(<span class=\"str\">\"hk_parser\"</span>)\n\n<span class=\"bool\">local</span> cfg, err, info = hk.load(<span class=\"str\">\"config.hk\"</span>, { resolve = <span class=\"bool\">true</span> })\n<span class=\"bool\">if not</span> cfg <span class=\"bool\">then</span>\n  io.stderr:write(info.rendered <span class=\"bool\">or</span> err, <span class=\"str\">\"\\n\"</span>)\n  os.exit(1)\n<span class=\"bool\">end</span>\n\nprint(cfg:get_string(<span class=\"str\">\"global.name\"</span>))\nprint(cfg:get_number(<span class=\"str\">\"global.database.port\"</span>, <span class=\"num\">5432</span>))\nprint(cfg:get(<span class=\"str\">\"global.tags[0]\"</span>))        <span class=\"comment\">-- indeksy tablic liczone od 0</span>\n\n<span class=\"bool\">for</span> key, value <span class=\"bool\">in</span> cfg:each(<span class=\"str\">\"global.database\"</span>) <span class=\"bool\">do</span> print(key, value) <span class=\"bool\">end</span>\n\ncfg:set(<span class=\"str\">\"global.version\"</span>, <span class=\"num\">3</span>):delete(<span class=\"str\">\"global.production\"</span>)\nassert(cfg:write_file(<span class=\"str\">\"config.hk\"</span>))</pre>\n    </div>\n\n    <h3>Funkcje modułu <code>hk_parser</code></h3>\n    <table class=\"syntax-table\">\n      <thead><tr><th>Funkcja</th><th>Zwraca</th></tr></thead>\n      <tbody>\n        <tr><td>parse(tekst [, opts]) / parse_file(ścieżka [, opts])</td><td><code>Config</code> albo <code>nil, err, info</code> (alias: <code>load</code>)</td></tr>\n        <tr><td>new()</td><td>pusty <code>Config</code></td></tr>\n        <tr><td>from_table(tbl)</td><td><code>Config</code> albo <code>nil, err, info</code></td></tr>\n        <tr><td>decode(tekst) / decode_file(ścieżka)</td><td>zwykła tabela albo <code>nil, err, info</code></td></tr>\n        <tr><td>encode(tbl)</td><td>tekst <code>.hk</code> albo <code>nil, err, info</code></td></tr>\n        <tr><td>encode_file(tbl, ścieżka)</td><td><code>true</code> albo <code>nil, err, info</code></td></tr>\n        <tr><td>is_config(x), VERSION, core</td><td>test typu, wersja, surowy moduł natywny</td></tr>\n      </tbody>\n    </table>\n    <p><code>opts = { resolve = true }</code> rozwija interpolacje od razu po wczytaniu.</p>\n\n    <h3>Metody obiektu <code>Config</code></h3>\n    <table class=\"syntax-table\">\n      <thead><tr><th>Metoda</th><th>Opis</th></tr></thead>\n      <tbody>\n        <tr><td>get(ścieżka [, domyślna])</td><td>Dowolna wartość; mapy i tablice wracają jako zwykłe tabele</td></tr>\n        <tr><td>get_string / get_number / get_bool</td><td>Typowane odczyty z wartością domyślną; <strong>rzucają błąd</strong>, gdy wartość istnieje, ale ma inny typ</td></tr>\n        <tr><td>expect(ścieżka)</td><td>Jak <code>get</code>, ale brak wartości to błąd <code>missing field</code></td></tr>\n        <tr><td>has(ścieżka), type_of(ścieżka)</td><td><code>type_of</code> → <code>\"string\" \"number\" \"bool\" \"array\" \"map\"</code> lub <code>nil</code></td></tr>\n        <tr><td>keys([ścieżka]), sections(), len([ścieżka])</td><td>Klucze w kolejności z pliku; bez ścieżki — sekcje</td></tr>\n        <tr><td>each([ścieżka])</td><td>Iterator: <code>klucz, wartość</code> dla map, <code>indeks, wartość</code> dla tablic</td></tr>\n        <tr><td>to_table()</td><td>Cały dokument jako zwykłe tabele (kolejność map jest tracona)</td></tr>\n        <tr><td>set(ścieżka, wartość)</td><td>Tworzy brakujące sekcje i mapy; <code>nil</code> usuwa; zwraca <code>self</code> (łańcuchowanie)</td></tr>\n        <tr><td>delete(ścieżka)</td><td><code>true</code>, jeśli coś usunięto</td></tr>\n        <tr><td>resolve()</td><td>Rozwija interpolacje w miejscu</td></tr>\n        <tr><td>clone(), serialize(), write_file(ścieżka)</td><td>Kopia, tekst <code>.hk</code> (= <code>tostring(cfg)</code>), zapis do pliku</td></tr>\n      </tbody>\n    </table>\n\n    <h3>Ścieżki, typy i błędy w Lua</h3>\n    <ul class=\"rules\">\n      <li>Ścieżka: <code>\"sekcja.klucz\"</code>, <code>\"sekcja.lista[2]\"</code>. Indeksy w ścieżkach są od 0 (tak jak w <code>.hk</code>), a zwracane tabele Lua mają zwykłe indeksy od 1.</li>\n      <li>Dla kluczy zawierających kropkę lub nawias podaj ścieżkę jako listę: <code>{\"libs\", \".hl-download\"}</code>.</li>\n      <li>Liczby <code>.hk</code> to <code>f64</code>; wartości całkowite wracają jako liczby całkowite Lua (5.3+): <code>8080</code>, nie <code>8080.0</code>.</li>\n      <li>Błędy danych (składnia, plik, cykl w <code>${...}</code>) zwracają <code>nil, komunikat, info</code>. <code>info = { kind, message, line, column, detail, rendered }</code>, a <code>kind</code> to jedno z: <code>parse io type missing reference cycle conflict</code>.</li>\n      <li>Błędy programisty (zły typ argumentu, typowany getter na wartości innego typu) rzucają zwykły błąd z pozycją wywołania.</li>\n      <li>Tabela Lua z kluczami <code>1..n</code> jest zapisywana jako tablica, każda inna — jako mapa (klucze alfabetycznie); pusta tabela to pusta tablica.</li>\n      <li><code>#cfg</code> i <code>pairs(cfg)</code> wymagają Lua &gt;= 5.2; wszędzie bezpieczniej używać <code>cfg:len()</code> i <code>cfg:each()</code>.</li>\n    </ul>\n\n    <h3 id=\"api-hsharp\">H# — hk-parser</h3>\n    <p>\n      Biblioteka dla H#: <a class=\"plain-link\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hk-parser\" target=\"_blank\" rel=\"noopener\">strona w bit</a>.\n      Cienka nakładka na natywny parser Rust — składnia, interpolacje i serializacja działają tak samo jak w pozostałych wersjach.\n      Zbudowana biblioteka natywna <code>libhk_parser.so</code> musi być w ścieżce ładowania.\n    </p>\n\n    <div class=\"code-block\">\n      <div class=\"code-block-header\"><span class=\"lang\">H#</span><span>przykład</span></div>\n      <pre><span class=\"bool\">use</span> <span class=\"str\">\"bytes-io\"</span> <span class=\"bool\">from</span> <span class=\"str\">\"hk\"</span>\n\n<span class=\"bool\">let</span> cfg = hk::parse_file(<span class=\"str\">\"config.hk\"</span>)\n<span class=\"bool\">if</span> !cfg.is_valid() <span class=\"bool\">is</span>\n    write(<span class=\"str\">\"hk error: \"</span> + hk::last_error())\n<span class=\"bool\">else is</span>\n    cfg.resolve()                         <span class=\"comment\">;; rozwiń ${...} w miejscu</span>\n    write(cfg.get(<span class=\"str\">\"metadata.name\"</span>))\n    <span class=\"bool\">for</span> author <span class=\"bool\">in</span> cfg.array(<span class=\"str\">\"metadata.authors\"</span>) <span class=\"bool\">is</span>\n        write(author)\n    <span class=\"bool\">end</span>\n    cfg.free()\n<span class=\"bool\">end</span></pre>\n    </div>\n\n    <div class=\"callout warn\">\n      <span class=\"callout-icon\">⚠</span>\n      <div>Nazwa importu w H# zależy od wersji pakietu. Zawsze sprawdź aktualny zapis <code>use</code>\n      na <a class=\"plain-link\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hk-parser\" target=\"_blank\" rel=\"noopener\">stronie biblioteki w bit</a> —\n      powyższy przykład pokazuje sposób użycia, a nie gwarantowaną nazwę modułu.</div>\n    </div>\n\n    <table class=\"syntax-table\">\n      <thead><tr><th>Funkcja / metoda</th><th>Opis</th></tr></thead>\n      <tbody>\n        <tr><td>parse(tekst), parse_file(ścieżka)</td><td>Zwraca <code>HkConfig</code>; po błędzie <code>is_valid()</code> jest <code>false</code></td></tr>\n        <tr><td>last_error()</td><td>Ostatni komunikat błędu z natywnej strony (<code>\"\"</code>, jeśli brak)</td></tr>\n        <tr><td>cfg.is_valid(), cfg.free()</td><td>Sprawdzenie uchwytu i zwolnienie pamięci</td></tr>\n        <tr><td>cfg.resolve()</td><td><code>true</code> po sukcesie; <code>false</code> przy cyklu lub błędnej referencji</td></tr>\n        <tr><td>cfg.has(klucz)</td><td>Czy ścieżka istnieje (np. <code>\"metadata.authors[0]\"</code>)</td></tr>\n        <tr><td>cfg.get(klucz), cfg.get_or(klucz, domyślna)</td><td>Wartość jako tekst; <code>\"\"</code>, gdy brak lub to tablica/mapa</td></tr>\n        <tr><td>cfg.get_number(klucz), cfg.get_int(klucz), cfg.get_bool(klucz)</td><td>Odczyty typowane; <code>0.0</code> / <code>0</code> / <code>false</code>, gdy brak</td></tr>\n        <tr><td>cfg.type_of(klucz)</td><td><code>\"string\" \"number\" \"bool\" \"array\" \"map\" \"none\"</code></td></tr>\n        <tr><td>cfg.array_len(klucz), cfg.array_get(klucz, i), cfg.array_get_number(klucz, i), cfg.array(klucz)</td><td>Praca z tablicami; <code>array_len</code> daje <code>-1</code>, gdy to nie tablica</td></tr>\n      </tbody>\n    </table>\n\n    <h3 id=\"api-hacker\">Rust — hacker-parser</h3>\n\n    <div class=\"api-grid\">\n      <div class=\"api-item\">\n        <div class=\"api-sig\">parse(input)</div>\n        <div>\n          <div class=\"api-desc\">Parsuje string jako plik <code>.hacker</code>. Zwraca enum z wariantem V1, V2 lub V3.</div>\n          <div class=\"api-ret\">→ Result&lt;HackerFile, ParseError&gt;</div>\n        </div>\n      </div>\n      <div class=\"api-item\">\n        <div class=\"api-sig\">parse_file(path)</div>\n        <div>\n          <div class=\"api-desc\">Wczytuje plik z dysku i parsuje jako <code>.hacker</code>.</div>\n          <div class=\"api-ret\">→ Result&lt;HackerFile, ParseError&gt;</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"code-block\">\n      <div class=\"code-block-header\"><span class=\"lang\">Rust</span><span>dopasowanie wariantu</span></div>\n      <pre><span class=\"bool\">use</span> hacker_parser::{parse_file, HackerFile};\n\n<span class=\"bool\">let</span> file = parse_file(<span class=\"str\">\"app.hacker\"</span>)?;\n\n<span class=\"bool\">match</span> file {\n    HackerFile::V1(v) => println!(<span class=\"str\">\"v1 content: {}\"</span>, v.content),\n    HackerFile::V2(v) => {\n        println!(<span class=\"str\">\"header: {}\"</span>, v.header);\n        <span class=\"bool\">for</span> (section, values) in &amp;v.sections {\n            println!(<span class=\"str\">\"  {}: {:?}\"</span>, section, values);\n        }\n    }\n    HackerFile::V3(v) => {\n        println!(<span class=\"str\">\"app: {} ({})\"</span>, v.header, v.ty);\n        println!(<span class=\"str\">\"desc: {}\"</span>, v.description);\n        println!(<span class=\"str\">\"entry: {}\"</span>, v.file);\n    }\n}</pre>\n    </div>\n\n    <p>Biblioteki parsera <code>.hacker</code>: <a class=\"plain-link\" href=\"https://hackeros-linux-system.github.io/bit/lib.html?name=hacker\" target=\"_blank\" rel=\"noopener\">bit.io / H#</a>, <a class=\"plain-link\" href=\"https://crates.io/crates/hacker\" target=\"_blank\" rel=\"noopener\">crates.io / Rust</a>.</p>\n  </section>\n\n</div>\n\n<div class=\"wrapper\">\n  <footer>\n    <span><span class=\"footer-brand\">HackerOS</span> · dokumentacja formatów .hk i .hacker</span>\n    <span style=\"font-family: var(--font-mono); font-size: 10px; color: var(--text3);\">hk-parser · hacker-parser · Rust · Lua · H#</span>\n  </footer>\n</div>"

fun main() [
    boot_begin("pl", "HackerOS — Dokumentacja Formatów")
    set_viewport("width=device-width, initial-scale=1.0")
    head_tag("link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"])
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "../HackerOS.png"])
    head_tag("link", ["href", "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,800;1,300&family=Syne:wght@400;600;800&display=swap", "rel", "stylesheet"])
    boot_body(PAGE_BODY)
    offline_init("../")
    hk_init()
    scrollspy("section[id]", ".nav-links a", "", 0.3)
]
