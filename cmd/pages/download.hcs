use <mode:website>

include <../shared/offline>
include <../logic/download>

style {
#app { display: none; }
*{margin:0;padding:0;box-sizing:border-box;font-family:'Arial',sans-serif;}
body{background-color:#1C2526;color:#FFF;line-height:1.6;}
header{background-color:#121212;padding:20px 0;position:fixed;width:100%;top:0;z-index:1000;box-shadow:0 4px 10px rgba(0,0,0,.7);transition:background-color .3s;}
header:hover{background-color:#1A1A1A;}
nav{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:0 20px;}
nav .logo img{height:40px;width:auto;}
nav ul{list-style:none;display:flex;gap:25px;align-items:center;}
nav ul li a{color:#FFF;text-decoration:none;font-size:17px;transition:color .3s,transform .3s;position:relative;}
nav ul li a::after{content:'';position:absolute;width:0;height:2px;bottom:-5px;left:0;background-color:#B0B0B0;transition:width .3s;}
nav ul li a:hover::after{width:100%;}
nav ul li a:hover{color:#B0B0B0;transform:translateY(-2px);}
.download-section{max-width:1200px;margin:120px auto 50px;padding:20px;text-align:center;}
.download-section h1{font-size:36px;margin-bottom:20px;text-shadow:2px 2px 4px rgba(0,0,0,.5);}
.quick-download{background-color:#3A4A55;border:2px solid #B0B0B0;padding:30px;margin-bottom:50px;border-radius:15px;box-shadow:0 6px 12px rgba(0,0,0,.4);}
.quick-download h2{font-size:28px;margin-bottom:20px;}
.quick-download p.description{font-size:18px;margin-bottom:25px;color:#D0D0D0;}
.quick-download label{display:block;font-size:18px;font-weight:bold;margin-bottom:10px;color:#E0E0E0;}
.quick-download .select-wrapper{position:relative;max-width:400px;margin:0 auto 20px;}
.quick-download select{width:100%;background-color:#121212;color:#FFF;border:1px solid #B0B0B0;padding:12px 40px 12px 15px;border-radius:5px;font-size:16px;appearance:none;cursor:pointer;transition:border-color .3s,box-shadow .3s;}
.quick-download select:hover,.quick-download select:focus{border-color:#FFF;box-shadow:0 0 8px rgba(255,255,255,.2);outline:none;}
.quick-download .select-wrapper::after{content:'▼';position:absolute;right:15px;top:50%;transform:translateY(-50%);color:#B0B0B0;font-size:16px;pointer-events:none;}
.btn{display:inline-block;padding:12px 24px;background-color:#B0B0B0;color:#121212;text-decoration:none;border-radius:5px;font-weight:bold;margin:10px;transition:background-color .3s,transform .3s,box-shadow .3s;border:none;cursor:pointer;font-size:16px;font-family:inherit;}
.btn:hover{background-color:#FFF;transform:scale(1.05);box-shadow:0 4px 10px rgba(255,255,255,.2);}
.quick-download .btn{margin-top:20px;padding:14px 28px;font-size:18px;}

.editions-heading{font-size:28px;margin:0 0 8px;text-align:left;}
.editions-sub{color:#B0B0B0;font-size:15px;text-align:left;margin-bottom:28px;}
.edition-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;text-align:left;}
.edition-card{background-color:#2F3A44;border-radius:12px;overflow:hidden;box-shadow:0 4px 10px rgba(0,0,0,.3);transition:transform .3s,box-shadow .3s;display:flex;flex-direction:column;position:relative;}
.edition-card:hover{transform:translateY(-5px);box-shadow:0 6px 18px rgba(0,0,0,.45);}
.edition-thumb{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#121212;border-bottom:1px solid #1c2530;}
.edition-thumb-fallback{width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a232b,#0f151a);border-bottom:1px solid #1c2530;color:#3a4558;font-size:42px;font-weight:bold;letter-spacing:2px;}
.edition-body{padding:18px 20px 22px;display:flex;flex-direction:column;flex:1;}
.edition-body h2{font-size:20px;margin-bottom:6px;}
.edition-new-badge{display:inline-block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#00d4ff;background:rgba(0,212,255,.12);border:1px solid rgba(0,212,255,.35);padding:2px 8px;border-radius:3px;margin-bottom:10px;align-self:flex-start;}
.edition-actions{margin-top:auto;position:relative;}
.dl-trigger{width:100%;text-align:center;background-color:#B0B0B0;color:#121212;padding:12px 20px;border-radius:6px;font-weight:bold;border:none;cursor:pointer;font-size:15px;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;transition:background-color .2s,transform .2s;}
.dl-trigger:hover{background-color:#FFF;}
.dl-trigger .caret{font-size:11px;transition:transform .2s;}
.dl-trigger.open .caret{transform:rotate(180deg);}
.dl-menu{position:absolute;left:0;right:0;bottom:calc(100% + 8px);background:#121212;border:1px solid #3a4558;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.5);overflow:hidden;z-index:50;opacity:0;visibility:hidden;transform:translateY(6px);transition:opacity .18s,transform .18s,visibility .18s;}
.dl-menu.open{opacity:1;visibility:visible;transform:translateY(0);}
.dl-menu-title{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#6b7f99;padding:10px 14px 8px;border-bottom:1px solid #1f2733;}
.dl-menu a,.dl-menu span.dl-disabled{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px;color:#E0E0E0;text-decoration:none;font-size:14px;border-bottom:1px solid #1c2430;transition:background-color .15s;}
.dl-menu a:last-child,.dl-menu span.dl-disabled:last-child{border-bottom:none;}
.dl-menu a:hover{background-color:#1e2833;color:#FFF;}
.dl-menu span.dl-disabled{color:#3a4558;cursor:not-allowed;}
.dl-menu .soon-tag{font-size:9px;letter-spacing:1px;text-transform:uppercase;background:rgba(255,208,0,.1);border:1px solid rgba(255,208,0,.3);color:#ffd000;padding:2px 6px;border-radius:3px;}

footer{background-color:#121212;padding:20px;text-align:center;color:#B0B0B0;width:100%;box-shadow:0 -2px 5px rgba(0,0,0,.5);margin-top:60px;}
@media(max-width:600px){.edition-grid{grid-template-columns:1fr;}}

.edition-thumb,.edition-thumb-fallback,.edition-body h2{cursor:pointer;}
.edition-thumb:hover,.edition-thumb-fallback:hover{filter:brightness(1.12);}
.edition-body h2:hover{color:#FFF;text-decoration:underline;}

.info-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;z-index:2000;padding:20px;}
.info-modal-overlay.open{display:flex;}
.info-modal{background:#1C2526;border:1px solid #3a4558;border-radius:12px;max-width:640px;width:100%;max-height:80vh;overflow-y:auto;padding:28px 30px;box-shadow:0 12px 40px rgba(0,0,0,.6);position:relative;}
.info-modal h3{font-size:24px;margin-bottom:16px;padding-right:30px;}
.info-modal .info-modal-body{font-size:15px;line-height:1.75;color:#D8D8D8;}
.info-modal .info-modal-body a{color:#4a9eff;}
.info-modal .info-modal-body strong{color:#FFF;}
.info-modal-close{position:absolute;top:18px;right:20px;background:none;border:none;color:#B0B0B0;font-size:22px;cursor:pointer;line-height:1;padding:4px;}
.info-modal-close:hover{color:#FFF;}
}

let PAGE_BODY: Str = "<div class=\"info-modal-overlay\" id=\"info-modal-overlay\">\n  <div class=\"info-modal\">\n    <button class=\"info-modal-close\" id=\"info-modal-close\" aria-label=\"Close\">&times;</button>\n    <h3 id=\"info-modal-title\"></h3>\n    <div class=\"info-modal-body\" id=\"info-modal-body\"></div>\n  </div>\n</div>\n<header><nav><div class=\"logo\"><img src=\"HackerOS.png\" alt=\"HackerOS Logo\"></div><ul><li><a id=\"nav-home\" href=\"Home-page.html\">Home</a></li><li><a id=\"nav-download\" href=\"download.html\">Download</a></li><li><a id=\"nav-releases\" href=\"releases.html\">Releases</a></li><li><a id=\"nav-team\" href=\"hackeros-team.html\">HackerOS Team</a></li><li><a id=\"nav-docs\" href=\"hackeros-documentation.html\">Documentation</a></li><li><a id=\"nav-articles\" href=\"articles.html\">Artykuły</a></li></ul></nav></header>\n\n<section class=\"download-section\">\n<h1 id=\"section-h1\">Pobierz HackerOS</h1>\n\n<div class=\"quick-download\">\n<h2 id=\"quick-title\">Szybkie pobieranie systemu</h2>\n<p class=\"description\" id=\"quick-desc\">Wybierz edycję HackerOS i pobierz bezpośrednio z SourceForge.</p>\n<label id=\"select-label\" for=\"edition-select\">Wybierz edycję:</label>\n<div class=\"select-wrapper\"><select id=\"edition-select\">\n<option id=\"select-default\" value=\"\">-- Wybierz edycję --</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/OFFICIAL/HackerOS-V5.0.iso/download\">HackerOS Official</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/NVIDIA/HackerOS-V4.9-NVIDIA.iso/download\">HackerOS NVIDIA</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/CYBERSECURITY/HackerOS-V4.9-Cybersecurity.iso/download\">HackerOS Cybersecurity</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/OFFICIAL/GNOME/HackerOS-V5.0-Gnome.iso/download\">HackerOS Official: Gnome</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/OFFICIAL/XFCE/HackerOS-V5.0-Xfce.iso/download\">HackerOS Official: Xfce</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/OFFICIAL/HYDRA/HackerOS-V5.0-Hydra.iso/download\">HackerOS Official: Hydra</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/OFFICIAL/BLUE/HackerOS-V5.1-Blue.iso/download\">HackerOS Official: Blue</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/GAMING/HackerOS-V4.7-Gaming.iso/download\">HackerOS Gaming</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/LTS/HackerOS-V5.0-LTS.iso/download\">HackerOS LTS</option>\n<option value=\"https://sourceforge.net/projects/hackeros/files/ATOMIC/HackerOS-Atomic-Testing-DEV-V4.9.iso/download\">HackerOS Atomic</option>\n</select></div>\n<a id=\"download-link\" class=\"btn\" href=\"#\" style=\"display:none;\">Pobierz</a>\n</div>\n\n<h2 class=\"editions-heading\" id=\"editions-heading\">Wszystkie edycje</h2>\n<p class=\"editions-sub\" id=\"editions-sub\">Kliknij „Pobierz” przy wybranej edycji, aby wybrać źródło pobierania.</p>\n<div class=\"edition-grid\" id=\"edition-grid\"></div>\n\n</section>\n<footer><p id=\"footer-copy\">© 2026 HackerOS. Wszelkie prawa zastrzeżone.</p></footer>"

fun main() [
    boot_begin("pl", "HackerOS - Download")
    set_viewport("width=device-width,initial-scale=1.0")
    head_tag("link", ["rel", "icon", "type", "image/png", "href", "HackerOS.png"])
    boot_body(PAGE_BODY)
    offline_init("")
    download_init()
]
