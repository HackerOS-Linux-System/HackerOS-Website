de", "Penetration Mode", "cybersecurity-mode", "Cybersecurity Mode", "hacker-term", "Hacker Term", "hackerdeck", "HackerDeck", "ghostfs", "GhostFS", "hexai", "HexAI", "hnm", "HNM", "hacker-mode", "Hacker Mode", "isolator", "Isolator", "hackeros-steam", "HackerOS Steam", "hackeros-games", "HackerOS Games", "hackeros-kernel", "HackerOS Kernel", "hacker-launcher", "Hacker Launcher", "hackeros-store", "HackerOS Store", "blue-environment", "Blue Environment"]), "langDropLinks", mkobj(["hsharp", "H# – ドキュメント", "hackerLang", "Hacker Lang – ドキュメント", "hackerScript", "HackerScript – ドキュメント"]), "slides", [mkobj(["title", "gaming-cli", "desc", "A CLI tool available exclusively in HackerOS Gaming Edition. Its primary function is seamlessly switching the desktop environment between KDE Plasma and Game Mode. It also provides a range of additional features designed to streamline gaming environment management."]), mkobj(["title", "HPM", "desc", "HackerOS Package Manager – community repository for HackerOS. Any user can create, share and install packages, building an open, dynamic ecosystem."]), mkobj(["title", "HackerOS Containers", "desc", "Custom container system designed for lightweight isolation, high performance and easy application environment management. Fully integrated with the HackerOS kernel."]), mkobj(["title", "HackerOS Builder", "desc", "A tool for building OCI images inspired by bootc. Can be used as an overlay for live-build, as a fully independent standalone builder, or as a tool for creating configurable live environments and deployment images."]), mkobj(["title", "hammer", "desc", "Tool for atomic package installation and updates. Used exclusively in the HackerOS Atomic edition – guarantees non-destructive updates and the ability to restore previous system states."]), mkobj(["title", "hacker", "desc", "hacker – the heart of the system. Advanced tool for real-time monitoring, process and configuration management. It forms the foundation of kernel interaction and improves diagnostics."]), mkobj(["title", ".hk", "desc", "The .hk file format used for system and application configuration. Provides a readable, hierarchical syntax, native support in HackerOS tools and extensibility through built-in schemas."]), mkobj(["title", "hsh", "desc", "hsh – modern system shell, advanced alternative to ZSH and Bash. Offers extended scripting capabilities, better autocomplete, built-in container support and native .hk integrations."]), mkobj(["title", "HexAI", "desc", "HexAI – Integrated AI assistant for HackerOS, requiring a powerful computer. Offers local inference, source code analysis, script generation and intelligent administration support with full privacy."]), mkobj(["title", "GhostFS", "desc", "GhostFS – Advanced file system for HackerOS, available in two editions: Cybersecurity (encryption, trace hiding, steganography) and Normal (speed, reliability and full application compatibility). Ideal for data management."]), mkobj(["title", "HackerDeck", "desc", "HackerDeck – environmental overlay for Waydroid, allowing Android apps to run in HackerOS with full integration, performance optimization and dedicated settings for gamers and developers."]), mkobj(["title", "hedit", "desc", "hedit – text editor inspired by classic nano, fully integrated with HackerOS. Combines ease of use with advanced features such as syntax highlighting, macro support and direct system file editing in text mode."]), mkobj(["title", "hdev", "desc", "hdev – TUI and GUI editor for HackerOS. Advanced development environment with text (TUI) and graphical (GUI) interface. Supports multi-language projects, debugging, integration terminal and built-in version control system."]), mkobj(["title", "ngt", "desc", "ngt – file management tool inspired by Midnight Commander (MC). Offers dual-panel interface, fast navigation, advanced file operations (copy, move, permissions) and built-in file and archive preview – essential for daily administrator work."]), mkobj(["title", "Penetration Mode", "desc", "Session with custom penetration testing tools. It is an application built into HackerOS Cybersecurity Edition that launches a dedicated environment with frameworks (Metasploit, Nmap, Burp Suite, custom scripts) – ideal for ethical hackers and Red Teams."]), mkobj(["title", "Cybersecurity Mode", "desc", "Tool for both defense and offense. Runs in a lightweight container, used and built into HackerOS Cybersecurity Edition as an application and session. Combines threat monitoring, IDS/IPS, vulnerability scanning and adversary emulation tactics – all in an isolated environment."]), mkobj(["title", "Hacker Term", "desc", "Terminal for the HackerOS Linux distribution. Modern shell with advanced autocomplete, multiple windows, native HackerOS container support, .hk scripts and pentesting tool integration. Provides full control over the system and development environment."]), mkobj(["title", "HackerOS Nix Manager", "desc", "Nix overlay – package and environment management in HackerOS using Nix. Enables declarative system configuration, reproducible development environments and integration with the Nixpkgs ecosystem."]), mkobj(["title", "Hacker Mode", "desc", "Gaming session inspired by GameHub / Steam GamePadUI. Launches a special environment optimized for controllers, large screens and easy access to game libraries. Perfect for Steam, emulators and native titles."]), mkobj(["title", "Isolator", "desc", "Podman overlay with its own package list. Specifies which container each package should be installed in. This makes it easy to manage applications in isolated environments, ensuring separation and security."]), mkobj(["title", "HackerOS Steam", "desc", "Run Steam in an Arch Linux container. Thanks to isolation and full compatibility with Steam libraries, you can play your favorite titles on HackerOS while keeping the main system clean."]), mkobj(["title", "HackerOS Games", "desc", "HackerOS Games is a platform for launching and managing games, fully integrated with the system. It provides easy access to native and emulated game libraries, offering a user-friendly interface and performance optimization."]), mkobj(["title", "HackerOS Kernel", "desc", "HackerOS by default uses the custom HackerOS Kernel in the cybersecurity edition, which is specially tailored for that edition's requirements. There are also plans to adopt HackerOS Kernel as the default kernel in the official version, replacing the standard Debian kernel."]), mkobj(["title", "Hacker Launcher", "desc", "Hacker Launcher は、ネイティブの Linux ゲームおよび（Proton経由の）Windowsゲームを1つのアプリケーションで実行できるアプリです。"]), mkobj(["title", "HackerOS Store", "desc", "HackerOS Store は HackerOS で利用可能なすべてのプログラムのストアです。アプリやアドオンの閲覧・インストール・更新を行える一元化された便利な場所です。"]), mkobj(["title", "Blue Environment", "desc", "Blue Environment は LegendaryOS が開発するグラフィカル環境で、HackerOS ツールエコシステムの一部として利用できます。"]), mkobj(["title", "bit", "desc", "bit – a package manager for all programming languages in HackerOS. One tool to install, update and manage dependencies regardless of the language you use."]), mkobj(["title", "getit", "desc", "getit – an alternative to curl and git, and a tool for downloading directories from GitHub, GitLab and Codeberg. Fetch only the directory you need, without cloning the whole repository."]), mkobj(["title", "chker", "desc", "chker – a tool for changing the Linux kernel in HackerOS. It lets you easily switch between the available system kernels."]), mkobj(["title", "HDM", "desc", "HDM – HackerOS Display Manager, the login manager for HackerOS."])]])])
]
