include <../shared/core>

fun hs_sec_async() -> Str [
    end "\n<div class=\"section\" id=\"spawn\">\n<div class=\"sec-header\"><span class=\"sec-num\">20</span><h2>Biblioteka standardowa — std</h2></div>\n<p>H# posiada bogatą bibliotekę std. Import: <code>use \"std -> moduł\" from \"alias\"</code>. Wszystkie moduły wbudowane w binarkę.</p>\n\n<h3>std -> io</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">std_io.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> io\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"io\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; Odczyt linii ze stdin</span>\n    <span class=\"t-kw\">let</span> input: string = io::read_line(<span class=\"t-str\">\"Podaj cel (IP/host): \"</span>)\n    write(<span class=\"t-str\">\"Cel: \"</span> + input)\n\n    <span class=\"t-comment\">;; Wbudowane bez importu</span>\n    write(<span class=\"t-str\">\"output z nową linią\"</span>)\n    to_string(<span class=\"t-num\">42</span>)\n    len(<span class=\"t-str\">\"hello\"</span>)               <span class=\"t-comment\">;; = 5</span>\n    parse_int(<span class=\"t-str\">\"42\"</span>)           <span class=\"t-comment\">;; string → int?</span>\n    assert(<span class=\"t-kw\">true</span>, <span class=\"t-str\">\"msg\"</span>)     <span class=\"t-comment\">;; guard clause</span>\n    panic(<span class=\"t-str\">\"nieoczekiwany błąd\"</span>)\n    exit(<span class=\"t-num\">0</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>std -> crypto</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">std_crypto.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto -> hex\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hex\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto -> hash\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hash\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sec\"</span>            <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sec\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; Hex encode/decode</span>\n    <span class=\"t-kw\">let</span> raw: string = <span class=\"t-str\">\"deadbeef\"</span>\n    <span class=\"t-kw\">let</span> decoded: bytes = hex::decode(raw)\n    <span class=\"t-kw\">let</span> encoded: string = hex::encode(decoded)\n\n    <span class=\"t-comment\">;; Hash FNV-1a</span>\n    <span class=\"t-kw\">let</span> h: u64 = hash::fnv1a(<span class=\"t-str\">\"hello\"</span>)\n    write(<span class=\"t-str\">\"hash: \"</span> + to_string(h))\n\n    <span class=\"t-comment\">;; sec — cybersec utils</span>\n    <span class=\"t-kw\">let</span> xored: string = sec::xor_hex(<span class=\"t-str\">\"4865\"</span>, <span class=\"t-str\">\"AABB\"</span>)\n    <span class=\"t-kw\">let</span> rot: string   = sec::rot13(<span class=\"t-str\">\"Hello\"</span>)\n    <span class=\"t-kw\">let</span> open: bool    = sec::scan_port(<span class=\"t-str\">\"127.0.0.1\"</span>, <span class=\"t-num\">80</span>, <span class=\"t-num\">200</span>)\n    write(<span class=\"t-str\">\"ROT13: \"</span> + rot)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>std -> json / yaml / toml_fmt</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">std_json.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> yaml\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"yaml\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> raw: string = <span class=\"t-str\">\"{{\"host\":\"192.168.1.1\",\"port\":443}}\"</span>\n    <span class=\"t-kw\">let</span> doc = json::parse(raw)\n    write(<span class=\"t-str\">\"host: \"</span> + json::get_str(doc, <span class=\"t-str\">\"host\"</span>))\n    write(<span class=\"t-str\">\"port: \"</span> + to_string(json::get_int(doc, <span class=\"t-str\">\"port\"</span>)))\n\n    <span class=\"t-kw\">let</span> out: string = json::stringify(doc)\n    write(out)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>std -> http</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">std_http.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> http\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"http\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> resp: string = http::get(<span class=\"t-str\">\"https://example.com/api\"</span>)\n    write(resp)\n\n    <span class=\"t-kw\">let</span> body: string = <span class=\"t-str\">\"{{\"key\":\"value\"}}\"</span>\n    <span class=\"t-kw\">let</span> r: string = http::post(<span class=\"t-str\">\"https://api.example.com\"</span>, body)\n    write(r)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>std -> gtk — GTK4</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">std_gtk.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> gtk\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"gtk\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">on_click</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"kliknięto!\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> app = gtk::App.new(<span class=\"t-str\">\"Moja Apka\"</span>, <span class=\"t-num\">640</span>, <span class=\"t-num\">480</span>)\n    app.run(|| <span class=\"t-kw\">is</span>\n        gtk::label(<span class=\"t-str\">\"H# GTK4\"</span>)\n        gtk::button(<span class=\"t-str\">\"Kliknij\"</span>, <span class=\"t-str\">\"on_click\"</span>)\n        gtk::entry(<span class=\"t-str\">\"IP target...\"</span>)\n    <span class=\"t-kw\">end</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Pełna tabela modułów std</h3>\n<table class=\"ref-table\">\n<tr><th>Moduł</th><th>Import</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">io</td><td class=\"td-note\">std -> io</td><td class=\"td-desc\">read_line, write, file I/O</td></tr>\n<tr><td class=\"td-syntax\">crypto -> hex</td><td class=\"td-note\">std -> crypto -> hex</td><td class=\"td-desc\">encode/decode hex</td></tr>\n<tr><td class=\"td-syntax\">crypto -> hash</td><td class=\"td-note\">std -> crypto -> hash</td><td class=\"td-desc\">FNV-1a hash</td></tr>\n<tr><td class=\"td-syntax\">sec</td><td class=\"td-note\">std -> sec</td><td class=\"td-desc\">xor_hex, rot13, scan_port, caesar</td></tr>\n<tr><td class=\"td-syntax\">net -> tcp</td><td class=\"td-note\">std -> net -> tcp</td><td class=\"td-desc\">TcpStream, connect</td></tr>\n<tr><td class=\"td-syntax\">net -> udp</td><td class=\"td-note\">std -> net -> udp</td><td class=\"td-desc\">UDP socket, bind</td></tr>\n<tr><td class=\"td-syntax\">http</td><td class=\"td-note\">std -> http</td><td class=\"td-desc\">GET, POST (no deps)</td></tr>\n<tr><td class=\"td-syntax\">json</td><td class=\"td-note\">std -> json</td><td class=\"td-desc\">parse, stringify, get_str/int</td></tr>\n<tr><td class=\"td-syntax\">yaml</td><td class=\"td-note\">std -> yaml</td><td class=\"td-desc\">parse, stringify (minimal)</td></tr>\n<tr><td class=\"td-syntax\">toml_fmt</td><td class=\"td-note\">std -> toml_fmt</td><td class=\"td-desc\">parse TOML</td></tr>\n<tr><td class=\"td-syntax\">math</td><td class=\"td-note\">std -> math</td><td class=\"td-desc\">sin, cos, PI, sqrt, abs, pow</td></tr>\n<tr><td class=\"td-syntax\">strings</td><td class=\"td-note\">std -> strings</td><td class=\"td-desc\">trim, split, join, pad, contains</td></tr>\n<tr><td class=\"td-syntax\">path</td><td class=\"td-note\">std -> path</td><td class=\"td-desc\">join, parent, filename, exists</td></tr>\n<tr><td class=\"td-syntax\">fs</td><td class=\"td-note\">std -> fs</td><td class=\"td-desc\">read, write, exists, mkdir</td></tr>\n<tr><td class=\"td-syntax\">os</td><td class=\"td-note\">std -> os</td><td class=\"td-desc\">platform, hostname, username</td></tr>\n<tr><td class=\"td-syntax\">env</td><td class=\"td-note\">std -> env</td><td class=\"td-desc\">get, set, args, cwd</td></tr>\n<tr><td class=\"td-syntax\">time</td><td class=\"td-note\">std -> time</td><td class=\"td-desc\">now_unix(), sleep_ms()</td></tr>\n<tr><td class=\"td-syntax\">process</td><td class=\"td-note\">std -> process</td><td class=\"td-desc\">run, spawn, exit_code</td></tr>\n<tr><td class=\"td-syntax\">collections</td><td class=\"td-note\">std -> collections</td><td class=\"td-desc\">HashMap, HashSet, VecDeque</td></tr>\n<tr><td class=\"td-syntax\">encoding -> base64</td><td class=\"td-note\">std -> encoding -> base64</td><td class=\"td-desc\">encode/decode</td></tr>\n<tr><td class=\"td-syntax\">encoding -> url</td><td class=\"td-note\">std -> encoding -> url</td><td class=\"td-desc\">percent-encode/decode</td></tr>\n<tr><td class=\"td-syntax\">regex</td><td class=\"td-note\">std -> regex</td><td class=\"td-desc\">is_match(pattern, text)</td></tr>\n<tr><td class=\"td-syntax\">gtk</td><td class=\"td-note\">std -> gtk</td><td class=\"td-desc\">GTK4 GUI (HackerOS)</td></tr>\n</table>\n</div>\n"
]

fun hs_sec_examples_extra() -> Str [
    end ""
]

fun hs_sec_gramatyka() -> Str [
    end "\n<div class=\"section\" id=\"gramatyka\">\n<div class=\"sec-header\"><span class=\"sec-num\">29</span><h2>Gramatyka H# 0.1</h2></div>\n<p>H# używa <strong>parsera Pratt</strong> dla wyrażeń i <strong>rekurencyjnego descent</strong> dla deklaracji. Bloki otwiera <code>is</code>, zamyka <code>end</code>.</p>\n\n<h3>Tokeny</h3>\n<table class=\"ref-table\">\n<tr><th>Token</th><th>Wzorzec</th><th>Przykład</th></tr>\n<tr><td class=\"td-syntax\">ident</td><td class=\"td-desc\"><code>(alpha|_)(alnum|_)*</code></td><td class=\"td-note\">main, my_func</td></tr>\n<tr><td class=\"td-syntax\">integer</td><td class=\"td-desc\"><code>digit+ | 0x[hex]+ | 0b[01]+</code></td><td class=\"td-note\">42, 0xFF, 0b1010, 1_000</td></tr>\n<tr><td class=\"td-syntax\">float</td><td class=\"td-desc\"><code>digit+.digit+([eE][+-]?digit+)?</code></td><td class=\"td-note\">3.14, 2.5e10</td></tr>\n<tr><td class=\"td-syntax\">string</td><td class=\"td-desc\"><code>\"...\" z \n \t \\ \"</code></td><td class=\"td-note\">\"hello\n\"</td></tr>\n<tr><td class=\"td-syntax\">comment</td><td class=\"td-desc\"><code>;; .*</code> do końca linii</td><td class=\"td-note\">;; komentarz</td></tr>\n<tr><td class=\"td-syntax\">doc_comment</td><td class=\"td-desc\"><code>/// .*</code></td><td class=\"td-note\">/// doc</td></tr>\n<tr><td class=\"td-syntax\">block_comment</td><td class=\"td-desc\"><code>// ... \\</code></td><td class=\"td-note\">// blok \\</td></tr>\n</table>\n\n<h3>Słowa kluczowe H# 0.1</h3>\n<div class=\"grid3\">\n<div class=\"card\"><div class=\"card-title\">Bloki</div><div class=\"card-body\"><code>is</code> <code>end</code> <code>fn</code> <code>struct</code> <code>enum</code> <code>impl</code> <code>trait</code></div></div>\n<div class=\"card\"><div class=\"card-title\">Sterowanie</div><div class=\"card-body\"><code>if</code> <code>elsif</code> <code>else</code> <code>match</code> <code>while</code> <code>for</code> <code>in</code> <code>return</code> <code>break</code> <code>continue</code></div></div>\n<div class=\"card\"><div class=\"card-title\">Pozostałe</div><div class=\"card-body\"><code>let</code> <code>mut</code> <code>pub</code> <code>use</code> <code>from</code> <code>as</code> <code>unsafe</code> <code>arena</code> <code>manual</code> <code>nil</code> <code>true</code> <code>false</code></div></div>\n</div>\n\n<h3>Priorytety operatorów</h3>\n<table class=\"ref-table\">\n<tr><th>Poziom</th><th>Operatory</th><th>Łączność</th></tr>\n<tr><td class=\"td-note\">1 (najniższy)</td><td class=\"td-syntax\">= += -= *= /=</td><td class=\"td-desc\">prawa</td></tr>\n<tr><td class=\"td-note\">2</td><td class=\"td-syntax\">||</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">3</td><td class=\"td-syntax\">&amp;&amp;</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">4-6</td><td class=\"td-syntax\">| ^ &amp;</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">7</td><td class=\"td-syntax\">== !=</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">8</td><td class=\"td-syntax\">&lt; &gt; &lt;= &gt;=</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">9</td><td class=\"td-syntax\">&lt;&lt; &gt;&gt;</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">10</td><td class=\"td-syntax\">+ -</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">11</td><td class=\"td-syntax\">* / %</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">12</td><td class=\"td-syntax\">as</td><td class=\"td-desc\">lewa</td></tr>\n<tr><td class=\"td-note\">13 (najwyższy)</td><td class=\"td-syntax\">. [] () ?</td><td class=\"td-desc\">lewa</td></tr>\n</table>\n\n<h3>Najczęstsze błędy składni</h3>\n<table class=\"ref-table\">\n<tr><th>Błąd</th><th>Poprawka</th></tr>\n<tr><td class=\"td-syntax\">fn foo() do...end</td><td class=\"td-desc\">fn foo() <strong>is</strong>...end</td></tr>\n<tr><td class=\"td-syntax\">import \"std:io\"</td><td class=\"td-desc\">use \"std -> io\" from \"io\"</td></tr>\n<tr><td class=\"td-syntax\">println(\"x\")</td><td class=\"td-desc\"><strong>write</strong>(\"x\")</td></tr>\n<tr><td class=\"td-syntax\"># komentarz</td><td class=\"td-desc\"><strong>;;</strong> komentarz</td></tr>\n<tr><td class=\"td-syntax\">struct S { ... }</td><td class=\"td-desc\">struct S <strong>is</strong> ... <strong>end</strong></td></tr>\n<tr><td class=\"td-syntax\">match x { ... }</td><td class=\"td-desc\">match x <strong>is</strong> ... <strong>end</strong></td></tr>\n</table>\n</div>\n\n<div class=\"section\" id=\"bledy\">\n<div class=\"sec-header\"><span class=\"sec-num\">30</span><h2>Błędy — diagnostyka Elm-like</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">terminal</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre>-- SYNTAX ERROR (src/main.h#) -------\n--> src/main.h#:4:5\n\n3 | fn main() is\n4 |     println(\"hello\")\n          ^^^^^^^\n5 | end\n\nError: unexpected token `println`\n\nHint: write `write` instead of `println`</pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_install() -> Str [
    end "\n<div class=\"section\" id=\"install\">\n<div class=\"sec-header\"><span class=\"sec-num\">01</span><h2>Instalacja &amp; narzędzia</h2></div>\n<p>Ekosystem H# składa się z narzędzia: <strong>h#</strong> (kompilator + interpreter CLI).</p>\n\n<div class=\"grid2\">\n<div class=\"card\"><div class=\"card-title\">h#</div><div class=\"card-body\">Główne CLI. Kompiluje przez <strong>LLVM 21 O3+AVX2</strong> (produkcja), uruchamia interpreter (preview), sprawdza składnię i typy, tworzy projekty z szablonami (<code>app</code>, <code>web</code>, <code>tui</code>, <code>wasm</code>, <code>lib</code>, <code>cybersec</code>).</div></div>\n</div>\n\n<h3>Instalacja na HackerOS</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">terminal</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Przez package manager HackerOS</span>\nhacker unpack h#\nhacker unpack h#-utils</pre></div></div>\n</div>\n\n<h3>Komendy h#</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">terminal — h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Interpreter — natychmiastowy podgląd</span>\nh# preview src/main.h#\n\n<span class=\"t-comment\">;; Kompilacja LLVM (natywna binarka)</span>\nh# compile src/main.h#\nh# compile src/main.h# --release -o myapp\nh# compile src/main.h# --target linux-aarch64\nh# compile src/main.h# --target wasm32 -o module.wasm\n\n<span class=\"t-comment\">;; Sprawdź składnię i typy</span>\nh# check src/main.h#\nh# check a.h# b.h# c.h#\n\n<span class=\"t-comment\">;; Nowy projekt</span>\nh# new myapp\nh# new myapp --template cybersec\nh# new myapp --template web\nh# new myapp --template tui\nh# new myapp --template wasm\nh# new myapp --template lib\n\n<span class=\"t-comment\">;; Dostępne targety kompilacji</span>\nh# targets</pre></div></div>\n</div>\n\n<h3>Rozszerzenia plików</h3>\n<table class=\"ref-table\">\n<tr><th>Rozszerzenie</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">.h#</td><td class=\"td-desc\">Główny format kodu źródłowego H#</td></tr>\n<tr><td class=\"td-syntax\">.hsp</td><td class=\"td-desc\">Alternatywne rozszerzenie (H# script)</td></tr>\n<tr><td class=\"td-syntax\">.hsl</td><td class=\"td-desc\">H# Library — skompilowana biblioteka</td></tr>\n</table>\n</div>\n"
]

fun hs_sec_intro() -> Str [
    end "\n<div class=\"hero\" id=\"intro\">\n<div class=\"hero-tag\">H# Language &middot; HackerOS-first compiled language</div>\n<h1>H<span class=\"accent\">#</span><br><span class=\"accent2\">Dokumentacja</span> v0.6</h1>\n<p class=\"hero-desc\">\nH# to kompilowany, statycznie typowany język programowania stworzony dla HackerOS.\nZastępuje Pythona w narzędziach CLI, GUI, cybersec i codziennych skryptach.\nKompiluje do natywnych binarek przez <strong>LLVM 21</strong> (produkcja, O3+AVX2)\nlub uruchamia się od razu przez interpreter (<strong>h# preview</strong>, szybki loop deweloperski).\nSkładnia inspirowana Ruby/Python, bezpieczeństwo pamięci z opcjonalnymi trybami <code>@safety</code>/<code>@arc</code>/<code>@arena</code>/<code>@pointers</code>.\n</p>\n<div class=\"badges\">\n<span class=\"badge b-red\">v0.6</span>\n<span class=\"badge b-cyan\">HackerOS-first</span>\n<span class=\"badge b-green\">LLVM 21</span>\n<span class=\"badge b-blue\">84 std modules</span>\n</div>\n\n<div class=\"divider\"></div>\n\n<div class=\"grid2\" style=\"margin-top:20px\">\n<div class=\"card\">\n<div class=\"card-title\">h# preview</div>\n<div class=\"card-body\">Interpreter — natychmiastowe uruchomienie bez kompilacji. Idealny do skryptowania i debugowania. Pełna obsługa closures, async/await, string interpolation.</div>\n</div>\n<div class=\"card\">\n<div class=\"card-title\">h# compile</div>\n<div class=\"card-body\">LLVM 21 O3+AVX2 — produkcyjna kompilacja do natywnej binarki. Zero transpilacji do C. AST → LLVM IR → obiekt → link. Cross-compilation: linux-x86_64, linux-aarch64, wasm32.</div>\n</div>\n</div>\n\n<div class=\"divider\"></div>\n\n<h3>Kompilatory H#</h3>\n<table class=\"ref-table\">\n<tr><th>Narzędzie</th><th>Backend</th><th>Użycie</th><th>Wydajność</th></tr>\n<tr><td class=\"td-syntax\">h# preview</td><td class=\"td-desc\">Interpreter</td><td class=\"td-note\">Szybki dev loop, zero kompilacji</td><td class=\"td-desc\">~5-15% C</td></tr>\n<tr><td class=\"td-syntax\">h# compile</td><td class=\"td-desc\">LLVM 21 O3+AVX2</td><td class=\"td-note\">Produkcja, natywna binarka</td><td class=\"td-desc\">~85-95% C</td></tr>\n<tr><td class=\"td-syntax\">h# compile --target wasm32</td><td class=\"td-desc\">LLVM → WASM</td><td class=\"td-note\">WebAssembly moduł</td><td class=\"td-desc\">~70-80% native</td></tr>\n</table>\n</div>\n"
]

fun hs_sec_modules() -> Str [
    end "\n<div class=\"section\" id=\"modules\">\n<div class=\"sec-header\"><span class=\"sec-num\">23</span><h2>Moduły <span class=\"nav-new\">v0.6</span></h2></div>\n<p>H# obsługuje moduły inline (<code>mod ... is ... end</code>) oraz ładowanie plików zewnętrznych przez <code>use</code>. Moduły tworzą własną przestrzeń nazw dostępną przez <code>nazwamod::funkcja</code>.</p>\n\n<h3>Moduł inline</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">src/main.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Moduł zdefiniowany inline w tym samym pliku</span>\n<span class=\"t-kw\">mod</span> math_utils <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub fn</span> <span class=\"t-fn\">gcd</span>(a: int, b: int) -> int <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">if</span> b == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span> return a <span class=\"t-kw\">end</span>\n        return gcd(b, a % b)\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">pub fn</span> <span class=\"t-fn\">lcm</span>(a: int, b: int) -> int = a / gcd(a, b) * b\n\n    <span class=\"t-kw\">pub fn</span> <span class=\"t-fn\">is_prime</span>(n: int) -> bool <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">if</span> n < <span class=\"t-num\">2</span> <span class=\"t-kw\">is</span> return <span class=\"t-kw\">false</span> <span class=\"t-kw\">end</span>\n        <span class=\"t-kw\">let mut</span> i: int = <span class=\"t-num\">2</span>\n        <span class=\"t-kw\">while</span> i * i <= n <span class=\"t-kw\">is</span>\n            <span class=\"t-kw\">if</span> n % i == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span> return <span class=\"t-kw\">false</span> <span class=\"t-kw\">end</span>\n            i += <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">end</span>\n        return <span class=\"t-kw\">true</span>\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-comment\">;; Prywatna — niedostępna z zewnątrz</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-fn\">internal_sqrt</span>(n: f64) -> f64 = n  <span class=\"t-comment\">;; uproszczone</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    write(to_string(math_utils::gcd(<span class=\"t-num\">48</span>, <span class=\"t-num\">18</span>)))   <span class=\"t-comment\">;; 6</span>\n    write(to_string(math_utils::lcm(<span class=\"t-num\">4</span>, <span class=\"t-num\">6</span>)))    <span class=\"t-comment\">;; 12</span>\n    write(to_string(math_utils::is_prime(<span class=\"t-num\">17</span>))) <span class=\"t-comment\">;; true</span>\n    <span class=\"t-comment\">;; math_utils::internal_sqrt — błąd: niedostępna</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Import zewnętrznego pliku</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">src/main.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Import z biblioteki standardowej</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> collections\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"col\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto\"</span>      <span class=\"t-kw\">from</span> <span class=\"t-str\">\"crypto\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net_http\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"http\"</span>\n\n<span class=\"t-comment\">;; Import lokalnego pliku (src/utils.h#)</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"local -> utils\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"utils\"</span>\n\n<span class=\"t-comment\">;; Import z GitHub (bytes add github.com/user/repo)</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"github.com/user/mylib\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"mylib\"</span>\n\n<span class=\"t-comment\">;; Python interop (bytes python numpy)</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"python -> numpy\"</span>       <span class=\"t-kw\">from</span> <span class=\"t-str\">\"np\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"python -> cryptography\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"pycrypto\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> raw = <span class=\"t-str\">\"{{\"name\":\"H#\",\"version\":\"0.6\"}}\"</span>\n    <span class=\"t-kw\">let</span> obj = json::parse(raw)\n    write(json::get_str(obj, <span class=\"t-str\">\"name\"</span>))    <span class=\"t-comment\">;; H#</span>\n\n    <span class=\"t-kw\">let mut</span> map = col::HashMap::new()\n    map.insert(<span class=\"t-str\">\"lang\"</span>, <span class=\"t-str\">\"H#\"</span>)\n\n    <span class=\"t-kw\">let</span> hash = crypto::sha256(<span class=\"t-str\">\"hackeros\"</span>)\n    write(hash[<span class=\"t-num\">0</span>..<span class=\"t-num\">16</span>])\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Widoczność — pub</h3>\n<table class=\"ref-table\">\n<tr><th>Słowo kluczowe</th><th>Zasięg</th></tr>\n<tr><td class=\"td-syntax\">fn foo()</td><td class=\"td-desc\">Prywatna — dostępna tylko w tym samym pliku / module</td></tr>\n<tr><td class=\"td-syntax\">pub fn foo()</td><td class=\"td-desc\">Publiczna — eksportowana, dostępna po imporcie</td></tr>\n<tr><td class=\"td-syntax\">pub struct Foo</td><td class=\"td-desc\">Struct publiczny — widoczny z zewnątrz</td></tr>\n<tr><td class=\"td-syntax\">pub x: int</td><td class=\"td-desc\">Pole struct publiczne — dostępne przez dot access</td></tr>\n</table>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">src/utils.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Publiczne API modułu</span>\n<span class=\"t-kw\">pub fn</span> <span class=\"t-fn\">format_bytes</span>(n: int) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> n < <span class=\"t-num\">1024</span> <span class=\"t-kw\">is</span>        return to_string(n) + <span class=\"t-str\">\" B\"</span>  <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">if</span> n < <span class=\"t-num\">1048576</span> <span class=\"t-kw\">is</span>    return to_string(n / <span class=\"t-num\">1024</span>) + <span class=\"t-str\">\" KB\"</span> <span class=\"t-kw\">end</span>\n    return to_string(n / <span class=\"t-num\">1048576</span>) + <span class=\"t-str\">\" MB\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">pub fn</span> <span class=\"t-fn\">clamp</span>(v: int, lo: int, hi: int) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> v < lo <span class=\"t-kw\">is</span> return lo <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">if</span> v > hi <span class=\"t-kw\">is</span> return hi <span class=\"t-kw\">end</span>\n    return v\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">pub</span> struct Config <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> debug:   bool\n    <span class=\"t-kw\">pub</span> timeout: int\n    <span class=\"t-kw\">pub</span> host:    string\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Prywatna — nieeksportowana</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">internal</span>(x: int) -> int = x * <span class=\"t-num\">2</span></pre></div></div>\n</div>\n\n<h3>Struktura projektu z modułami</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">struktura</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre>myapp/\n  bytes.hk\n  src/\n    main.h#           <span class=\"t-comment\">;; use \"local -> utils\" from \"utils\"</span>\n    utils.h#          <span class=\"t-comment\">;; moduł utils</span>\n    crypto.h#         <span class=\"t-comment\">;; moduł crypto</span>\n    net.h#            <span class=\"t-comment\">;; moduł sieciowy</span>\n  tests/\n    utils_test.h#\n    crypto_test.h#</pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_organizacja() -> Str [
    end "\n<div class=\"section\" id=\"funkcje\">\n<div class=\"sec-header\"><span class=\"sec-num\">11</span><h2>Funkcje</h2></div>\n<p>Blok funkcji: <code>fn nazwa(params) -> typ is...end</code>. Jednolinijkowa: <code>fn nazwa() -> typ = wyrażenie</code>.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">funkcje.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Prosta funkcja</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">greet</span>(name: string) -> string <span class=\"t-kw\">is</span>\n    return <span class=\"t-str\">\"Hello, \"</span> + name + <span class=\"t-str\">\"!\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Jednolinijkowa</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">square</span>(n: int) -> int = n * n\n\n<span class=\"t-comment\">;; Rekurencja</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">factorial</span>(n: int) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> n <= <span class=\"t-num\">1</span> <span class=\"t-kw\">is</span>\n        return <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">end</span>\n    return n * factorial(n - <span class=\"t-num\">1</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Publiczna</span>\n<span class=\"t-kw\">pub</span> <span class=\"t-kw\">fn</span> <span class=\"t-func\">xor_bytes</span>(data: bytes, key: bytes) -> bytes <span class=\"t-kw\">is</span>\n    return data\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(greet(<span class=\"t-str\">\"H#\"</span>))\n    write(<span class=\"t-str\">\"5! = \"</span> + to_string(factorial(<span class=\"t-num\">5</span>)))\n    write(<span class=\"t-str\">\"7^2 = \"</span> + to_string(square(<span class=\"t-num\">7</span>)))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"struktury\">\n<div class=\"sec-header\"><span class=\"sec-num\">12</span><h2>Structs &amp; Impl</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">structs.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">struct</span> Packet <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> src_ip:  string\n    <span class=\"t-kw\">pub</span> dst_ip:  string\n    <span class=\"t-kw\">pub</span> port:    int\n    <span class=\"t-kw\">pub</span> payload: bytes\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">impl</span> Packet <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> <span class=\"t-kw\">fn</span> <span class=\"t-func\">new</span>(src: string, dst: string, port: int) -> Packet <span class=\"t-kw\">is</span>\n        return Packet { src_ip: src, dst_ip: dst, port: port, payload: [] }\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">pub</span> <span class=\"t-kw\">fn</span> <span class=\"t-func\">summary</span>(self) -> string <span class=\"t-kw\">is</span>\n        return self.src_ip + <span class=\"t-str\">\" -> \"</span> + self.dst_ip + <span class=\"t-str\">\":\"</span> + to_string(self.port)\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">pub</span> <span class=\"t-kw\">fn</span> <span class=\"t-func\">is_encrypted</span>(self) -> bool = self.port == <span class=\"t-num\">443</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> pkt = Packet.new(<span class=\"t-str\">\"10.0.0.1\"</span>, <span class=\"t-str\">\"192.168.1.1\"</span>, <span class=\"t-num\">443</span>)\n    write(pkt.summary())\n    write(<span class=\"t-str\">\"TLS: \"</span> + to_string(pkt.is_encrypted()))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"traits\">\n<div class=\"sec-header\"><span class=\"sec-num\">13</span><h2>Traits</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">traits.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">trait</span> Scanner <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">scan</span>(self, target: string) -> bool\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">name</span>(self) -> string\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">desc</span>(self) -> string <span class=\"t-kw\">is</span>\n        return <span class=\"t-str\">\"Scanner: \"</span> + self.name()\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">struct</span> TcpScanner <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> timeout: int\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">impl</span> TcpScanner: Scanner <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">scan</span>(self, target: string) -> bool <span class=\"t-kw\">is</span>\n        return <span class=\"t-kw\">true</span>\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">name</span>(self) -> string = <span class=\"t-str\">\"TCP Scanner\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> s = TcpScanner { timeout: <span class=\"t-num\">5000</span> }\n    write(s.desc())\n    write(to_string(s.scan(<span class=\"t-str\">\"192.168.1.1\"</span>)))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_playground() -> Str [
    end "\n<div class=\"section\" id=\"playground\">\n<div class=\"sec-header\"><span class=\"sec-num\">31</span><h2>Playground <span class=\"sec-badge\">wasm</span></h2></div>\n<p>Uruchom H# bezpośrednio w przeglądarce — bez instalacji, bez terminala. Kod jest kompilowany do <strong>WebAssembly</strong> raz (z repo <a href=\"https://github.com/HackerOS-Linux-System/H-Sharp\" target=\"_blank\">H-Sharp</a>) i wykonywany lokalnie w Twojej przeglądarce, w osobnym wątku (Web Worker) z limitem czasu — nic nie jest wysyłane na żaden serwer.</p>\n\n<div class=\"pg-wrap\" id=\"pg-root\">\n  <div class=\"pg-panes\">\n    <div class=\"pg-pane\">\n      <div class=\"pg-pane-header\">\n        <span class=\"pg-pane-title\">▸ main.h#</span>\n        <button class=\"pg-run-btn\" id=\"pg-run\">Run ▶ (Ctrl+Enter)</button>\n      </div>\n      <textarea id=\"pg-source\" spellcheck=\"false\">fn main() is\n    let name = \"H#\"\n    write(\"Hello from \" + name + \"!\")\n\n    let n = 10\n    let a = 0\n    let b = 1\n    let i = 0\n    while i < n is\n        write(to_string(a))\n        let next = a + b\n        a = b\n        b = next\n        i = i + 1\n    end\nend</textarea>\n    </div>\n    <div class=\"pg-pane\">\n      <div class=\"pg-pane-header\">\n        <span class=\"pg-pane-title\">▸ output</span>\n        <span class=\"pg-status\" id=\"pg-status\">gotowy</span>\n      </div>\n      <pre id=\"pg-output\"></pre>\n    </div>\n  </div>\n  <div class=\"pg-note\">Pierwsze uruchomienie pobiera moduł WASM kompilatora (<code>hsharp-playground.wasm</code>) z <a href=\"https://github.com/HackerOS-Linux-System/H-Sharp/releases\" target=\"_blank\">wydań H-Sharp na GitHubie</a> — kilkaset KB, cache'owane przez przeglądarkę, więc kolejne uruchomienia (i kolejne wizyty na tej stronie) nic już nie pobierają. Program ma limit ok. 200 000 kroków interpretera oraz twardy limit czasu 5s — nieskończona pętla zostanie bezpiecznie przerwana.</div>\n</div>\n\n<h3>Jak to działa</h3>\n<p>Playground używa <strong>interpretera H#</strong> (nie pełnej kompilacji LLVM) skompilowanego do WASM przez <code>wasm-pack</code> z paczki <code>hsharp-playground</code> w repozytorium H#. Ten sam kod, który widzisz tutaj, możesz uruchomić lokalnie przez:</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">terminal — h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Interpreter — dokładnie to, co robi ten playground</span>\nh# preview main.h#\n\n<span class=\"t-comment\">;; Pełna kompilacja LLVM — do prawdziwej binarki</span>\nh# compile main.h#</pre></div></div>\n</div>\n\n<p>Interaktywne narzędzia w tej samej rodzinie co playground: <code>h# repl</code> (REPL linia-po-linii w terminalu) i <code>h# fmt</code> (formatter). Zobacz sekcję <a href=\"#install\">Instalacja &amp; narzędzia</a>.</p>\n</div>\n"
]

fun hs_sec_podstawy() -> Str [
    end "\n<div class=\"section\" id=\"komentarze\">\n<div class=\"sec-header\"><span class=\"sec-num\">03</span><h2>Komentarze</h2></div>\n<p>H# 0.1 używa <code>;;</code> jako komentarza liniowego, <code>///</code> jako dokumentacyjnego, i <code>// ... \\</code> jako blokowego.</p>\n<table class=\"ref-table\">\n<tr><th>Składnia</th><th>Typ</th><th>Opis</th></tr>\n<tr><td><span class=\"td-syntax\">;; tekst</span></td><td><span class=\"pill p-cyan\">liniowy</span></td><td class=\"td-desc\">Komentarz do końca linii</td></tr>\n<tr><td><span class=\"td-syntax\">/// tekst</span></td><td><span class=\"pill p-purple\">dokumentacyjny</span></td><td class=\"td-desc\">Generowany do doc</td></tr>\n<tr><td><span class=\"td-syntax\">// ... \\</span></td><td><span class=\"pill p-amber\">blokowy</span></td><td class=\"td-desc\">Wieloliniowy blok komentarza</td></tr>\n</table>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">komentarze.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Komentarz liniowy</span>\n\n<span class=\"t-comment\">/// Dokumentacja funkcji main — pojawi się w docs</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> x: int = <span class=\"t-num\">42</span>  <span class=\"t-comment\">;; inline komentarz</span>\n    write(to_string(x))\n\n    <span class=\"t-comment\">// blok komentarza\n    to jest zignorowane przez kompilator\n    \\</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"zmienne\">\n<div class=\"sec-header\"><span class=\"sec-num\">04</span><h2>Zmienne i typy podstawowe</h2></div>\n<p>H# jest <strong>statycznie typowany</strong>. Deklaracja: <code>let</code> (niemutowalna) lub <code>let mut</code> (mutowalna). Typy można pominąć gdy kompilator je wywnioskuje.</p>\n<div class=\"grid3\">\n<div class=\"card\"><div class=\"card-title\">let</div><div class=\"card-body\">Niemutowalna. Domyślna. Bezpieczna — brak przypadkowych modyfikacji.</div></div>\n<div class=\"card\"><div class=\"card-title\">let mut</div><div class=\"card-body\">Mutowalna. Wymagana dla liczników, akumulatorów, zmiennych w pętlach.</div></div>\n<div class=\"card\"><div class=\"card-title\">Typy</div><div class=\"card-body\"><code>int</code>, <code>uint</code>, <code>i8..i128</code>, <code>u8..u128</code>, <code>f32</code>, <code>f64</code>, <code>bool</code>, <code>string</code>, <code>bytes</code></div></div>\n</div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">zmienne.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Niemutowalne</span>\n<span class=\"t-kw\">let</span> x: int    = <span class=\"t-num\">42</span>\n<span class=\"t-kw\">let</span> s: string = <span class=\"t-str\">\"hacker\"</span>\n<span class=\"t-kw\">let</span> r: f64    = <span class=\"t-num\">3.14</span>\n<span class=\"t-kw\">let</span> b: bool   = <span class=\"t-kw\">true</span>\n\n<span class=\"t-comment\">;; Mutowalne</span>\n<span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> licznik: int = <span class=\"t-num\">0</span>\n<span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> wynik: string = <span class=\"t-str\">\"\"</span>\n\n<span class=\"t-comment\">;; Wnioskowanie typów</span>\n<span class=\"t-kw\">let</span> a = <span class=\"t-num\">10</span>          <span class=\"t-comment\">;; int</span>\n<span class=\"t-kw\">let</span> c = <span class=\"t-str\">\"tekst\"</span>     <span class=\"t-comment\">;; string</span>\n\n<span class=\"t-comment\">;; Typy całkowite</span>\n<span class=\"t-kw\">let</span> port: u16 = <span class=\"t-num\">8080</span>\n<span class=\"t-kw\">let</span> bajt: u8  = <span class=\"t-num\">0xFF</span>\n\n<span class=\"t-comment\">;; Bytes — surowe dane binarne</span>\n<span class=\"t-kw\">let</span> data: bytes = [<span class=\"t-num\">0xDE</span>, <span class=\"t-num\">0xAD</span>, <span class=\"t-num\">0xBE</span>, <span class=\"t-num\">0xEF</span>]\n\n<span class=\"t-comment\">;; Separatory liczbowe i hex/binary</span>\n<span class=\"t-kw\">let</span> big: int = <span class=\"t-num\">1_000_000</span>\n<span class=\"t-kw\">let</span> h: int   = <span class=\"t-num\">0xFF</span>\n<span class=\"t-kw\">let</span> bin: int = <span class=\"t-num\">0b1010</span>\n\n<span class=\"t-comment\">;; Tablica i tuple</span>\n<span class=\"t-kw\">let</span> porty: [int]        = [<span class=\"t-num\">22</span>, <span class=\"t-num\">80</span>, <span class=\"t-num\">443</span>]\n<span class=\"t-kw\">let</span> addr: (string, int) = (<span class=\"t-str\">\"localhost\"</span>, <span class=\"t-num\">8080</span>)\n\n<span class=\"t-comment\">;; Optional</span>\n<span class=\"t-kw\">let</span> opt: int? = <span class=\"t-kw\">nil</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"importy\">\n<div class=\"sec-header\"><span class=\"sec-num\">05</span><h2>System importów — use/from</h2></div>\n<p>H# 0.1 używa składni <code>use \"ścieżka\" from \"alias\"</code>. Strzałka <code>-></code> rozdziela moduły.</p>\n<table class=\"ref-table\">\n<tr><th>Schemat</th><th>Opis</th><th>Przykład</th></tr>\n<tr><td class=\"td-syntax\">std -> mod -> sub</td><td class=\"td-desc\">Biblioteka standardowa</td><td class=\"td-note\">use \"std -> io\" from \"io\"</td></tr>\n<tr><td class=\"td-syntax\">bit -> pkg</td><td class=\"td-desc\">Bit.io (repozytorium bibliotek)</td><td class=\"td-note\">use \"bit -> exploit-db\" from \"edb\"</td></tr>\n<tr><td class=\"td-syntax\">github.com/u/r</td><td class=\"td-desc\">Git repo bezpośrednio</td><td class=\"td-note\">use \"github.com/user/lib\" from \"lib\"</td></tr>\n<tr><td class=\"td-syntax\">mod plik</td><td class=\"td-desc\">Lokalny plik</td><td class=\"td-note\">mod utils</td></tr>\n</table>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">importy.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Standardowa biblioteka</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> io\"</span>             <span class=\"t-kw\">from</span> <span class=\"t-str\">\"io\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net -> tcp\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"tcp\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto -> hex\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hex\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span>           <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> math\"</span>           <span class=\"t-kw\">from</span> <span class=\"t-str\">\"math\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> gtk\"</span>            <span class=\"t-kw\">from</span> <span class=\"t-str\">\"gtk\"</span>\n\n<span class=\"t-comment\">;; Bit.io (repozytorium bibliotek dla H#, HackerScript, Hacker Lang)</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"bit -> exploit-db\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"edb\"</span>\n\n<span class=\"t-comment\">;; Git repo bezpośrednio (jak Go)</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"github.com/user/mylib\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"mylib\"</span>\n\n<span class=\"t-comment\">;; Lokalny plik</span>\n<span class=\"t-kw\">mod</span> plik</pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"output\">\n<div class=\"sec-header\"><span class=\"sec-num\">06</span><h2>Wyjście — write() i builtiny</h2></div>\n<p>Funkcja <code>write()</code> to główny sposób wypisywania w H# 0.1 (zastępuje Python <code>print</code>). Dostępna bez importów.</p>\n<table class=\"ref-table\">\n<tr><th>Funkcja</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">write(s: string)</td><td class=\"td-desc\">Wypisuje string z nową linią</td></tr>\n<tr><td class=\"td-syntax\">to_string(v: any) -> string</td><td class=\"td-desc\">Konwertuje wartość na string</td></tr>\n<tr><td class=\"td-syntax\">len(c) -> int</td><td class=\"td-desc\">Długość stringa, tablicy lub bytes</td></tr>\n<tr><td class=\"td-syntax\">panic(msg: string)</td><td class=\"td-desc\">Zatrzymuje program z błędem</td></tr>\n<tr><td class=\"td-syntax\">assert(cond: bool, msg: string)</td><td class=\"td-desc\">Guard clause</td></tr>\n<tr><td class=\"td-syntax\">exit(code: int)</td><td class=\"td-desc\">Wychodzi z kodem</td></tr>\n<tr><td class=\"td-syntax\">parse_int(s: string) -> int?</td><td class=\"td-desc\">Parsuje string → int (optional)</td></tr>\n</table>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">output.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"Hello from H#!\"</span>)\n\n    <span class=\"t-kw\">let</span> port: int = <span class=\"t-num\">8080</span>\n    write(<span class=\"t-str\">\"Port: \"</span> + to_string(port))\n\n    <span class=\"t-kw\">let</span> n: int = <span class=\"t-num\">10</span>\n    assert(n > <span class=\"t-num\">0</span>, <span class=\"t-str\">\"n musi być dodatnie\"</span>)\n\n    exit(<span class=\"t-num\">0</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_przyklady() -> Str [
    end "\n<div class=\"section\" id=\"ex1\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-1</span><h2>Hello World</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">hello.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# Hello World — uruchom: hsharp build hello.h#</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">greet</span>(name: string) -> string <span class=\"t-kw\">is</span>\n    return <span class=\"t-str\">\"Hello, \"</span> + name + <span class=\"t-str\">\"!\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(greet(<span class=\"t-str\">\"H#\"</span>))\n    write(greet(<span class=\"t-str\">\"HackerOS\"</span>))\n\n    <span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> sum: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">1</span>..=<span class=\"t-num\">5</span> <span class=\"t-kw\">is</span>\n        sum += i\n    <span class=\"t-kw\">end</span>\n    write(<span class=\"t-str\">\"Sum 1..5 = \"</span> + to_string(sum))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex2\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-2</span><h2>Port Scanner</h2><span class=\"sec-badge\">struct · match · for · unsafe arena</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">port_scanner.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# Port Scanner — cybersec narzędzie</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sec\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sec\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net -> tcp\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"tcp\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">classify_port</span>(port: int) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> port <span class=\"t-kw\">is</span>\n        <span class=\"t-num\">22</span>   => <span class=\"t-str\">\"SSH\"</span>\n        <span class=\"t-num\">80</span>   => <span class=\"t-str\">\"HTTP\"</span>\n        <span class=\"t-num\">443</span>  => <span class=\"t-str\">\"HTTPS\"</span>\n        <span class=\"t-num\">445</span>  => <span class=\"t-str\">\"SMB\"</span>\n        <span class=\"t-num\">3306</span> => <span class=\"t-str\">\"MySQL\"</span>\n        <span class=\"t-num\">5432</span> => <span class=\"t-str\">\"PostgreSQL\"</span>\n        <span class=\"t-num\">6379</span> => <span class=\"t-str\">\"Redis\"</span>\n        _    => <span class=\"t-str\">\"Unknown\"</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">scan_range</span>(host: string, start: int, end_p: int) <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"Scanning \"</span> + host + <span class=\"t-str\">\" ports \"</span> + to_string(start) + <span class=\"t-str\">\"..\"</span> + to_string(end_p))\n    <span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> found: int = <span class=\"t-num\">0</span>\n\n    <span class=\"t-kw\">for</span> port <span class=\"t-kw\">in</span> start..=end_p <span class=\"t-kw\">is</span>\n        <span class=\"t-comment\">;; sec::scan_port(host, port, 200) w pełnej implementacji</span>\n        <span class=\"t-kw\">let</span> open: bool = port == <span class=\"t-num\">22</span> || port == <span class=\"t-num\">80</span> || port == <span class=\"t-num\">443</span>\n        <span class=\"t-kw\">if</span> open <span class=\"t-kw\">is</span>\n            found += <span class=\"t-num\">1</span>\n            write(<span class=\"t-str\">\"[OPEN] \"</span> + to_string(port) + <span class=\"t-str\">\"/tcp (\"</span> + classify_port(port) + <span class=\"t-str\">\")\"</span>)\n        <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">end</span>\n    write(<span class=\"t-str\">\"Znaleziono: \"</span> + to_string(found) + <span class=\"t-str\">\" portów\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"H# Port Scanner v0.1\"</span>)\n    <span class=\"t-kw\">unsafe</span> arena(<span class=\"t-num\">65536</span>) <span class=\"t-kw\">is</span>\n        scan_range(<span class=\"t-str\">\"192.168.1.1\"</span>, <span class=\"t-num\">1</span>, <span class=\"t-num\">1024</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex3\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-3</span><h2>XOR Cipher</h2><span class=\"sec-badge\">bytes · crypto · encoding</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">xor_cipher.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# XOR Cipher</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto -> hex\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hex\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> encoding -> base64\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"b64\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sec\"</span>                  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sec\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">xor_encrypt</span>(data: string, key: string) -> string <span class=\"t-kw\">is</span>\n    return sec::xor_hex(data, key)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"H# XOR Cipher\"</span>)\n    write(<span class=\"t-str\">\"══════════════\"</span>)\n\n    <span class=\"t-kw\">let</span> plaintext: string = <span class=\"t-str\">\"48656C6C6F\"</span>   <span class=\"t-comment\">;; \"Hello\" hex</span>\n    <span class=\"t-kw\">let</span> key:       string = <span class=\"t-str\">\"AABBCCDDEE\"</span>\n\n    write(<span class=\"t-str\">\"Plaintext:  \"</span> + plaintext)\n    write(<span class=\"t-str\">\"Key:        \"</span> + key)\n\n    <span class=\"t-kw\">let</span> cipher: string = xor_encrypt(plaintext, key)\n    write(<span class=\"t-str\">\"Ciphertext: \"</span> + cipher)\n\n    <span class=\"t-kw\">let</span> decoded: string = xor_encrypt(cipher, key)\n    write(<span class=\"t-str\">\"Decrypted:  \"</span> + decoded)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex4\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-4</span><h2>Struct + Trait + Enum</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">network_adt.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# Network ADT — typy danych sieciowych</span>\n\n<span class=\"t-kw\">enum</span> PortStatus <span class=\"t-kw\">is</span>\n    Open\n    Closed\n    Filtered(string)\n    Error(int, string)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">struct</span> Packet <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> src:     string\n    <span class=\"t-kw\">pub</span> dst:     string\n    <span class=\"t-kw\">pub</span> port:    u16\n    <span class=\"t-kw\">pub</span> payload: bytes\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">trait</span> Analyzer <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">analyze</span>(self, pkt: Packet) -> PortStatus\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">name</span>(self) -> string\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">struct</span> TcpAnalyzer <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> timeout_ms: int\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">impl</span> TcpAnalyzer: Analyzer <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">analyze</span>(self, pkt: Packet) -> PortStatus <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">if</span> pkt.port == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span>\n            return PortStatus::Error(<span class=\"t-num\">1</span>, <span class=\"t-str\">\"port 0 niedozwolony\"</span>)\n        <span class=\"t-kw\">end</span>\n        return PortStatus::Open\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-func\">name</span>(self) -> string = <span class=\"t-str\">\"TCP Analyzer\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> a   = TcpAnalyzer { timeout_ms: <span class=\"t-num\">5000</span> }\n    <span class=\"t-kw\">let</span> pkt = Packet { src: <span class=\"t-str\">\"10.0.0.1\"</span>, dst: <span class=\"t-str\">\"192.168.1.1\"</span>, port: <span class=\"t-num\">443</span>, payload: [] }\n\n    <span class=\"t-kw\">match</span> a.analyze(pkt) <span class=\"t-kw\">is</span>\n        Open         => write(<span class=\"t-str\">\"OTWARTY\"</span>)\n        Closed       => write(<span class=\"t-str\">\"zamknięty\"</span>)\n        Filtered(m)  => write(<span class=\"t-str\">\"filtr: \"</span> + m)\n        Error(c, m)  => write(<span class=\"t-str\">\"błąd \"</span> + to_string(c) + <span class=\"t-str\">\": \"</span> + m)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex5\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-5</span><h2>GUI App — GTK4</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">gui_app.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# GTK4 App — HackerOS desktop narzędzie</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> gtk\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"gtk\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">on_scan</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"Skanowanie...\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> app = gtk::App.new(<span class=\"t-str\">\"H# Network Tool\"</span>, <span class=\"t-num\">640</span>, <span class=\"t-num\">480</span>)\n    app.run(|| <span class=\"t-kw\">is</span>\n        gtk::label(<span class=\"t-str\">\"H# CyberSec Tool\"</span>)\n        gtk::entry(<span class=\"t-str\">\"Target IP...\"</span>)\n        gtk::button(<span class=\"t-str\">\"Skanuj\"</span>, <span class=\"t-str\">\"on_scan\"</span>)\n    <span class=\"t-kw\">end</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex6\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-6</span><h2>Python Interop (bytes PM)</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">python_interop.h#  (bytes run)</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; H# + Python interop — tylko bytes PM</span>\n<span class=\"t-comment\">;; bytes.hk: [python] -> packages = numpy,cryptography</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"python -> numpy\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"np\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"python -> cryptography\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"crypto\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"H# + Python interop\"</span>)\n\n    <span class=\"t-comment\">;; Wywołaj numpy przez H# FFI</span>\n    <span class=\"t-kw\">let</span> result: string = np_call(<span class=\"t-str\">\"mean\"</span>, <span class=\"t-str\">\"[1,2,3,4,5]\"</span>)\n    write(<span class=\"t-str\">\"numpy mean: \"</span> + result)\n\n    <span class=\"t-comment\">;; Python venv jest w ~/.hackeros/H#/libs/session-PID/pyenv/</span>\n    write(<span class=\"t-str\">\"Pakiety Python instalowane do RAM (tmpfs)\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex7\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-7</span><h2>Odczyt configu JSON</h2><span class=\"sec-badge\">fs · json · Optional</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">config_reader.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">read_port</span>(path: string) -> int? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> raw: string? = fs::read_to_string(path)?\n    <span class=\"t-kw\">let</span> parsed: any?  = json::parse(raw)?\n    <span class=\"t-kw\">return</span> parsed[<span class=\"t-str\">\"server\"</span>][<span class=\"t-str\">\"port\"</span>]?\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> port = read_port(<span class=\"t-str\">\"config.json\"</span>)\n    <span class=\"t-kw\">if</span> port == nil <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"nie udało się wczytać portu\"</span>)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"port: \"</span> + to_string(port))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex8\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-8</span><h2>Fibonacci z memoizacją</h2><span class=\"sec-badge\">HashMap · rekurencja</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">fib_memo.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> collections\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"col\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">fib</span>(n: int, cache: col::HashMap&lt;int, int&gt;) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> n &lt;= <span class=\"t-num\">1</span> <span class=\"t-kw\">is</span> <span class=\"t-kw\">return</span> n <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> hit: int? = cache.get(n)\n    <span class=\"t-kw\">if</span> hit != nil <span class=\"t-kw\">is</span> <span class=\"t-kw\">return</span> hit <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">let</span> result: int = fib(n - <span class=\"t-num\">1</span>, cache) + fib(n - <span class=\"t-num\">2</span>, cache)\n    cache.insert(n, result)\n    <span class=\"t-kw\">return</span> result\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> cache: col::HashMap&lt;int, int&gt; = col::HashMap::new()\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..=<span class=\"t-num\">30</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"fib(\"</span> + to_string(i) + <span class=\"t-str\">\") = \"</span> + to_string(fib(i, cache)))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex9\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-9</span><h2>Prosty klient HTTP</h2><span class=\"sec-badge\">http · async</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">http_get.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> http\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"http\"</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">fetch_status</span>(url: string) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> resp = <span class=\"t-kw\">await</span> http::get(url)\n    <span class=\"t-kw\">return</span> resp.status\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> urls: [string] = [<span class=\"t-str\">\"https://example.com\"</span>, <span class=\"t-str\">\"https://hackeros.dev\"</span>]\n    <span class=\"t-kw\">for</span> u <span class=\"t-kw\">in</span> urls <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> code: int = <span class=\"t-kw\">await</span> fetch_status(u)\n        write(u + <span class=\"t-str\">\" -> \"</span> + to_string(code))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex10\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-10</span><h2>Producer / Consumer</h2><span class=\"sec-badge\">async · task</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">producer_consumer.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">async fn</span> <span class=\"t-func\">produce</span>(n: int) -> [int] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> items: [int] = []\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..n <span class=\"t-kw\">is</span>\n        items = array_push(items, i * i)\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> items\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">consume</span>(items: [int]) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> total: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> it <span class=\"t-kw\">in</span> items <span class=\"t-kw\">is</span> total += it <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> total\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> items = <span class=\"t-kw\">await</span> produce(<span class=\"t-num\">10</span>)\n    <span class=\"t-kw\">let</span> total = <span class=\"t-kw\">await</span> consume(items)\n    write(<span class=\"t-str\">\"suma kwadratów: \"</span> + to_string(total))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex11\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-11</span><h2>Binary Search</h2><span class=\"sec-badge\">algorytmy · tablice</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">binary_search.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">binary_search</span>(arr: [int], target: int) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> lo: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">let mut</span> hi: int = array_len(arr) - <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">while</span> lo &lt;= hi <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> mid: int = (lo + hi) / <span class=\"t-num\">2</span>\n        <span class=\"t-kw\">if</span> arr[mid] == target <span class=\"t-kw\">is</span> <span class=\"t-kw\">return</span> mid\n        <span class=\"t-kw\">elsif</span> arr[mid] &lt; target <span class=\"t-kw\">is</span> lo = mid + <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span> hi = mid - <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> -<span class=\"t-num\">1</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> sorted: [int] = [<span class=\"t-num\">1</span>, <span class=\"t-num\">3</span>, <span class=\"t-num\">5</span>, <span class=\"t-num\">7</span>, <span class=\"t-num\">9</span>, <span class=\"t-num\">11</span>, <span class=\"t-num\">13</span>]\n    write(<span class=\"t-str\">\"index(7) = \"</span> + to_string(binary_search(sorted, <span class=\"t-num\">7</span>)))\n    write(<span class=\"t-str\">\"index(4) = \"</span> + to_string(binary_search(sorted, <span class=\"t-num\">4</span>)))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex12\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-12</span><h2>Parser argumentów CLI</h2><span class=\"sec-badge\">env · string</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">arg_parser.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> env\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"env\"</span>\n\n<span class=\"t-kw\">struct</span> Flags <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> verbose: bool\n    <span class=\"t-kw\">pub</span> output:  string\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">parse_flags</span>(args: [string]) -> Flags <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> f: Flags = Flags { verbose: false, output: <span class=\"t-str\">\"a.out\"</span> }\n    <span class=\"t-kw\">let mut</span> i: int = <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">while</span> i &lt; array_len(args) <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">if</span> args[i] == <span class=\"t-str\">\"-v\"</span> <span class=\"t-kw\">is</span> f.verbose = true\n        <span class=\"t-kw\">elsif</span> args[i] == <span class=\"t-str\">\"-o\"</span> && i + <span class=\"t-num\">1</span> &lt; array_len(args) <span class=\"t-kw\">is</span>\n            i += <span class=\"t-num\">1</span>\n            f.output = args[i]\n        <span class=\"t-kw\">end</span>\n        i += <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> f\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> flags = parse_flags(env::args())\n    write(<span class=\"t-str\">\"verbose=\"</span> + to_string(flags.verbose) + <span class=\"t-str\">\" output=\"</span> + flags.output)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex13\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-13</span><h2>Key-Value Store z zapisem</h2><span class=\"sec-badge\">fs · HashMap · json</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">kv_store.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>         <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> collections\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"col\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">save</span>(store: col::HashMap&lt;string, string&gt;, path: string) <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> lines: string = <span class=\"t-str\">\"\"</span>\n    <span class=\"t-kw\">for</span> key <span class=\"t-kw\">in</span> store.keys() <span class=\"t-kw\">is</span>\n        lines = lines + key + <span class=\"t-str\">\"=\"</span> + store.get(key) + <span class=\"t-str\">\"\n\"</span>\n    <span class=\"t-kw\">end</span>\n    fs::write_string(path, lines)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> store: col::HashMap&lt;string, string&gt; = col::HashMap::new()\n    store.insert(<span class=\"t-str\">\"host\"</span>, <span class=\"t-str\">\"127.0.0.1\"</span>)\n    store.insert(<span class=\"t-str\">\"port\"</span>, <span class=\"t-str\">\"8080\"</span>)\n    save(store, <span class=\"t-str\">\"store.db\"</span>)\n    write(<span class=\"t-str\">\"zapisano \"</span> + to_string(store.len()) + <span class=\"t-str\">\" kluczy\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex14\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-14</span><h2>Operacje na macierzach</h2><span class=\"sec-badge\">tablice 2D</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">matrix.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">mat_mul</span>(a: [[int]], b: [[int]]) -> [[int]] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> n: int = array_len(a)\n    <span class=\"t-kw\">let</span> m: int = array_len(b[<span class=\"t-num\">0</span>])\n    <span class=\"t-kw\">let</span> k: int = array_len(b)\n    <span class=\"t-kw\">let mut</span> result: [[int]] = []\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..n <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let mut</span> row: [int] = []\n        <span class=\"t-kw\">for</span> j <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..m <span class=\"t-kw\">is</span>\n            <span class=\"t-kw\">let mut</span> sum: int = <span class=\"t-num\">0</span>\n            <span class=\"t-kw\">for</span> x <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..k <span class=\"t-kw\">is</span> sum += a[i][x] * b[x][j] <span class=\"t-kw\">end</span>\n            row = array_push(row, sum)\n        <span class=\"t-kw\">end</span>\n        result = array_push(result, row)\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> result\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> a: [[int]] = [[<span class=\"t-num\">1</span>, <span class=\"t-num\">2</span>], [<span class=\"t-num\">3</span>, <span class=\"t-num\">4</span>]]\n    <span class=\"t-kw\">let</span> b: [[int]] = [[<span class=\"t-num\">5</span>, <span class=\"t-num\">6</span>], [<span class=\"t-num\">7</span>, <span class=\"t-num\">8</span>]]\n    <span class=\"t-kw\">let</span> c = mat_mul(a, b)\n    write(<span class=\"t-str\">\"c[0][0] = \"</span> + to_string(c[<span class=\"t-num\">0</span>][<span class=\"t-num\">0</span>]))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex15\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-15</span><h2>Parser logów (regex)</h2><span class=\"sec-badge\">regex · fs</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">log_parser.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> regex\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"re\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">count_errors</span>(path: string) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> content: string = fs::read_to_string(path) ?? <span class=\"t-str\">\"\"</span>\n    <span class=\"t-kw\">let</span> pattern = re::compile(<span class=\"t-str\">\"ERROR \\[(\\d+)\\]\"</span>)\n    <span class=\"t-kw\">let</span> matches = pattern.find_all(content)\n    <span class=\"t-kw\">return</span> array_len(matches)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> n: int = count_errors(<span class=\"t-str\">\"server.log\"</span>)\n    write(to_string(n) + <span class=\"t-str\">\" błędów znalezionych w logu\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex16\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-16</span><h2>Maszyna stanów</h2><span class=\"sec-badge\">enum · match</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">state_machine.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">enum</span> Light <span class=\"t-kw\">is</span> Red, Yellow, Green <span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">next</span>(l: Light) -> Light <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> l <span class=\"t-kw\">is</span>\n        Light::Red    => Light::Green\n        Light::Green  => Light::Yellow\n        Light::Yellow => Light::Red\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">name</span>(l: Light) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> l <span class=\"t-kw\">is</span>\n        Light::Red    => <span class=\"t-str\">\"czerwone\"</span>\n        Light::Yellow => <span class=\"t-str\">\"żółte\"</span>\n        Light::Green  => <span class=\"t-str\">\"zielone\"</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> l: Light = Light::Red\n    <span class=\"t-kw\">for</span> _ <span class=\"t-kw\">in</span> <span class=\"t-num\">0</span>..<span class=\"t-num\">5</span> <span class=\"t-kw\">is</span>\n        write(name(l))\n        l = next(l)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex17\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-17</span><h2>Result-podobna obsługa błędów</h2><span class=\"sec-badge\">enum · pattern matching</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">result_enum.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">enum</span> DivResult <span class=\"t-kw\">is</span>\n    Ok(int)\n    Err(string)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">safe_div</span>(a: int, b: int) -> DivResult <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> b == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">return</span> DivResult::Err(<span class=\"t-str\">\"division by zero\"</span>)\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">return</span> DivResult::Ok(a / b)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">for</span> pair <span class=\"t-kw\">in</span> [[<span class=\"t-num\">10</span>, <span class=\"t-num\">2</span>], [<span class=\"t-num\">5</span>, <span class=\"t-num\">0</span>]] <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">match</span> safe_div(pair[<span class=\"t-num\">0</span>], pair[<span class=\"t-num\">1</span>]) <span class=\"t-kw\">is</span>\n            DivResult::Ok(v)  => write(<span class=\"t-str\">\"wynik: \"</span> + to_string(v))\n            DivResult::Err(m) => write(<span class=\"t-str\">\"błąd: \"</span> + m)\n        <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex18\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-18</span><h2>Kolejka zadań (async)</h2><span class=\"sec-badge\">async · closures</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">task_queue.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">struct</span> Task <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> name:     string\n    <span class=\"t-kw\">pub</span> priority: int\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">run_task</span>(t: Task) -> string <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"uruchamiam: \"</span> + t.name)\n    <span class=\"t-kw\">return</span> t.name + <span class=\"t-str\">\" done\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">async fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> tasks: [Task] = [\n        Task { name: <span class=\"t-str\">\"build\"</span>,  priority: <span class=\"t-num\">1</span> },\n        Task { name: <span class=\"t-str\">\"test\"</span>,   priority: <span class=\"t-num\">2</span> },\n        Task { name: <span class=\"t-str\">\"deploy\"</span>, priority: <span class=\"t-num\">3</span> },\n    ]\n    <span class=\"t-kw\">for</span> t <span class=\"t-kw\">in</span> tasks <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> result = <span class=\"t-kw\">await</span> run_task(t)\n        write(result)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex19\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-19</span><h2>Silnik szablonów</h2><span class=\"sec-badge\">@arena · string</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">template_engine.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Renderowanie robi mnóstwo tymczasowych stringów — @arena zwalnia</span>\n<span class=\"t-comment\">;; je wszystkie naraz przy wyjściu zamiast po jednym za każdym razem.</span>\n<span class=\"t-kw\">@arena</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">render</span>(template: string, name: string, count: int) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> out: string = string_replace(template, <span class=\"t-str\">\"{{name}}\"</span>, name)\n    out = string_replace(out, <span class=\"t-str\">\"{{count}}\"</span>, to_string(count))\n    <span class=\"t-kw\">return</span> out\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> tpl: string = <span class=\"t-str\">\"Cześć {{name}}, masz {{count}} nowych wiadomości.\"</span>\n    write(render(tpl, <span class=\"t-str\">\"Michał\"</span>, <span class=\"t-num\">7</span>))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"ex20\">\n<div class=\"sec-header\"><span class=\"sec-num\">EX-20</span><h2>Parser binarnego nagłówka</h2><span class=\"sec-badge\">@pointers · struct</span></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">binary_header.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">struct</span> Header <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> magic:   int\n    <span class=\"t-kw\">pub</span> version: int\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ptr_field_offset liczy przesunięcie pola za Ciebie — bez ręcznego</span>\n<span class=\"t-comment\">;; liczenia bajtów jak w poprzednich wersjach @pointers.</span>\n<span class=\"t-kw\">@pointers</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">read_header</span>(buf: any) -> bool <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> magic_off: int   = ptr_field_offset(Header, <span class=\"t-str\">\"magic\"</span>)\n    <span class=\"t-kw\">let</span> version_off: int = ptr_field_offset(Header, <span class=\"t-str\">\"version\"</span>)\n    <span class=\"t-kw\">let</span> magic: int   = ptr_read_i32(buf, magic_off)\n    <span class=\"t-kw\">let</span> version: int = ptr_read_i32(buf, version_off)\n    <span class=\"t-kw\">return</span> magic == <span class=\"t-num\">0x48534821</span> && version &gt;= <span class=\"t-num\">1</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">@arc</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> buf = arc_alloc(<span class=\"t-num\">8</span>)\n    ptr_write_i32(buf, <span class=\"t-num\">0</span>, <span class=\"t-num\">0x48534821</span>)\n    ptr_write_i32(buf, <span class=\"t-num\">4</span>, <span class=\"t-num\">2</span>)\n    write(<span class=\"t-str\">\"valid header: \"</span> + to_string(read_header(buf)))\n    arc_release(buf)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"cheatsheet\">\n<div class=\"sec-header\"><span class=\"sec-num\">★</span><h2>Cheat Sheet — H# 0.1</h2></div>\n<div class=\"grid2\">\n<div>\n<h3>Podstawy</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">;; komentarz</td><td class=\"td-desc\">Liniowy</td></tr>\n<tr><td class=\"td-syntax\">/// doc</td><td class=\"td-desc\">Dokumentacyjny</td></tr>\n<tr><td class=\"td-syntax\">let x: int = 42</td><td class=\"td-desc\">Niemutowalna</td></tr>\n<tr><td class=\"td-syntax\">let mut x = 0</td><td class=\"td-desc\">Mutowalna</td></tr>\n<tr><td class=\"td-syntax\">write(\"tekst\")</td><td class=\"td-desc\">Wypisz z \\n</td></tr>\n<tr><td class=\"td-syntax\">to_string(n)</td><td class=\"td-desc\">int/bool → string</td></tr>\n</table>\n<h3>Importy</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">use \"std -> io\" from \"io\"</td><td class=\"td-desc\">Std lib</td></tr>\n<tr><td class=\"td-syntax\">use \"github.com/user/pkg\" from \"p\"</td><td class=\"td-desc\">bytes registry / GitHub</td></tr>\n<tr><td class=\"td-syntax\">use \"bytes -> pkg\" from \"p\"</td><td class=\"td-desc\">Bytes repo</td></tr>\n<tr><td class=\"td-syntax\">use \"python -> np\" from \"np\"</td><td class=\"td-desc\">Python interop</td></tr>\n<tr><td class=\"td-syntax\">use \"github.com/u/r\" from \"r\"</td><td class=\"td-desc\">Git repo</td></tr>\n</table>\n<h3>Bloki</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">fn f() is...end</td><td class=\"td-desc\">Funkcja</td></tr>\n<tr><td class=\"td-syntax\">struct S is...end</td><td class=\"td-desc\">Struktura</td></tr>\n<tr><td class=\"td-syntax\">impl S is...end</td><td class=\"td-desc\">Metody</td></tr>\n<tr><td class=\"td-syntax\">trait T is...end</td><td class=\"td-desc\">Trait</td></tr>\n<tr><td class=\"td-syntax\">enum E is...end</td><td class=\"td-desc\">Wyliczenie</td></tr>\n<tr><td class=\"td-syntax\">if c is...end</td><td class=\"td-desc\">Warunek</td></tr>\n<tr><td class=\"td-syntax\">match x is...end</td><td class=\"td-desc\">Pattern match</td></tr>\n<tr><td class=\"td-syntax\">for i in r is...end</td><td class=\"td-desc\">Pętla for</td></tr>\n<tr><td class=\"td-syntax\">while c is...end</td><td class=\"td-desc\">Pętla while</td></tr>\n</table>\n</div>\n<div>\n<h3>Unsafe</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">unsafe is...end</td><td class=\"td-desc\">Blok unsafe</td></tr>\n<tr><td class=\"td-syntax\">unsafe arena is...end</td><td class=\"td-desc\">Arena 1MB</td></tr>\n<tr><td class=\"td-syntax\">unsafe arena(N) is...end</td><td class=\"td-desc\">Arena N bajtów</td></tr>\n<tr><td class=\"td-syntax\">unsafe manual is...end</td><td class=\"td-desc\">malloc/free</td></tr>\n</table>\n<h3>Narzędzia</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">hsharp preview f.h#</td><td class=\"td-desc\">Interpreter</td></tr>\n<tr><td class=\"td-syntax\">hsharp build f.h#</td><td class=\"td-desc\">LLVM O3+AVX2</td></tr>\n<tr><td class=\"td-syntax\">hsharp check f.h#</td><td class=\"td-desc\">Syntax + types</td></tr>\n<tr><td class=\"td-syntax\">bytes build</td><td class=\"td-desc\">Build z bytes.hk (LLVM)</td></tr>\n<tr><td class=\"td-syntax\">bytes run</td><td class=\"td-desc\">Build + uruchom</td></tr>\n<tr><td class=\"td-syntax\">bytes python numpy</td><td class=\"td-desc\">Python pkg</td></tr>\n</table>\n<h3>Std</h3>\n<table class=\"ref-table\">\n<tr><td class=\"td-syntax\">use \"std -> io\"</td><td class=\"td-desc\">write, keyboard</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> json\"</td><td class=\"td-desc\">parse, stringify</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> sec\"</td><td class=\"td-desc\">xor, scan_port, hex</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> math\"</td><td class=\"td-desc\">sin, cos, PI, sqrt</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> gtk\"</td><td class=\"td-desc\">GTK4 GUI</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> http\"</td><td class=\"td-desc\">GET, POST</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> fs\"</td><td class=\"td-desc\">read, write, exists</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> os\"</td><td class=\"td-desc\">platform, hostname</td></tr>\n<tr><td class=\"td-syntax\">use \"std -> env\"</td><td class=\"td-desc\">get, set, args</td></tr>\n</table>\n</div>\n</div>\n</div>\n\n<div class=\"divider\"></div>\n</div>\n</div>\n</div>\n\n<div class=\"section\" id=\"examples-extra\">\n<div class=\"sec-header\"><span class=\"sec-num\">21b</span><h2>Więcej przykładów</h2></div>\n\n<h3>JSON API Client</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">json_api.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net_http\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"http\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fmt\"</span>      <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fmt\"</span>\n\nstruct User <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> id:    int\n    <span class=\"t-kw\">pub</span> name:  string\n    <span class=\"t-kw\">pub</span> email: string\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">fetch_user</span>(id: int) -> User? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> url  = <span class=\"t-str\">\"https://api.example.com/users/{id}\"</span>\n    <span class=\"t-kw\">let</span> resp = http::get(url)\n    <span class=\"t-kw\">if</span> resp.status != <span class=\"t-num\">200</span> <span class=\"t-kw\">is</span> return nil <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> obj = json::parse(resp.body)<span class=\"t-op\">?</span>\n    return User {\n        id:    json::get_int(obj, <span class=\"t-str\">\"id\"</span>),\n        name:  json::get_str(obj, <span class=\"t-str\">\"name\"</span>),\n        email: json::get_str(obj, <span class=\"t-str\">\"email\"</span>)\n    }\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> user = fetch_user(<span class=\"t-num\">1</span>)\n    <span class=\"t-kw\">if</span> user == nil <span class=\"t-kw\">is</span>\n        write(fmt::red(<span class=\"t-str\">\"User not found\"</span>))\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(fmt::bold(<span class=\"t-str\">\"User #{user.id}: {user.name}\"</span>))\n        write(<span class=\"t-str\">\"Email: {user.email}\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>XOR Cipher + Hex</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">xor_cipher.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sec\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sec\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> hex\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hex\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> cli\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"cli\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> plain  = cli::prompt(<span class=\"t-str\">\"Message: \"</span>)\n    <span class=\"t-kw\">let</span> key    = cli::prompt(<span class=\"t-str\">\"Key:     \"</span>)\n\n    <span class=\"t-kw\">let</span> enc    = sec::xor(plain, key)\n    <span class=\"t-kw\">let</span> enc_hex = hex::encode(enc)\n    write(<span class=\"t-str\">\"Encrypted (hex): {enc_hex}\"</span>)\n\n    <span class=\"t-kw\">let</span> dec    = sec::xor(enc, key)\n    write(<span class=\"t-str\">\"Decrypted:       {dec}\"</span>)\n\n    <span class=\"t-comment\">;; Verify roundtrip</span>\n    <span class=\"t-kw\">if</span> dec == plain <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"✓ Roundtrip OK\"</span>)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"✗ Roundtrip FAILED\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Async HTTP Scraper</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">scraper.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net_http\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"http\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> async_\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"async\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> regex\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"re\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fmt\"</span>      <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fmt\"</span>\n\nasync <span class=\"t-kw\">fn</span> <span class=\"t-fn\">fetch_title</span>(url: string) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> resp = http::get(url)\n    <span class=\"t-kw\">if</span> resp.status != <span class=\"t-num\">200</span> <span class=\"t-kw\">is</span>\n        return <span class=\"t-str\">\"[{resp.status}] {url}\"</span>\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> title = re::find(resp.body, <span class=\"t-str\">\"&lt;title&gt;([^&lt;]+)&lt;/title&gt;\"</span>)\n    <span class=\"t-kw\">if</span> title == <span class=\"t-str\">\"\"</span> <span class=\"t-kw\">is</span> return <span class=\"t-str\">\"(no title)\"</span> <span class=\"t-kw\">end</span>\n    return title\n<span class=\"t-kw\">end</span>\n\nasync <span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> urls = [\n        <span class=\"t-str\">\"https://hackeros.dev\"</span>,\n        <span class=\"t-str\">\"https://example.com\"</span>,\n        <span class=\"t-str\">\"https://httpbin.org\"</span>\n    ]\n\n    <span class=\"t-kw\">let mut</span> tasks: [any] = []\n    <span class=\"t-kw\">for</span> url <span class=\"t-kw\">in</span> urls <span class=\"t-kw\">is</span>\n        tasks.push(async::spawn(|| -> string <span class=\"t-kw\">is</span>\n            return await fetch_title(url)\n        <span class=\"t-kw\">end</span>))\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">let mut</span> i: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> task <span class=\"t-kw\">in</span> tasks <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> title = await task\n        write(fmt::green(<span class=\"t-str\">\"[{i}]\"</span>) + <span class=\"t-str\">\" {urls[i]}\"</span>)\n        write(<span class=\"t-str\">\"     Title: {title}\"</span>)\n        i += <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Iterator pipeline — przetwarzanie danych</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">pipeline.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> iter\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"iter\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sort\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sort\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fmt\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fmt\"</span>\n\nstruct Student <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> name:  string\n    <span class=\"t-kw\">pub</span> score: int\n    <span class=\"t-kw\">pub</span> grade: string\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">letter_grade</span>(score: int) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> score >= <span class=\"t-num\">90</span> <span class=\"t-kw\">is</span> return <span class=\"t-str\">\"A\"</span> <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">if</span> score >= <span class=\"t-num\">80</span> <span class=\"t-kw\">is</span> return <span class=\"t-str\">\"B\"</span> <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">if</span> score >= <span class=\"t-num\">70</span> <span class=\"t-kw\">is</span> return <span class=\"t-str\">\"C\"</span> <span class=\"t-kw\">end</span>\n    return <span class=\"t-str\">\"F\"</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> scores = [<span class=\"t-num\">88</span>, <span class=\"t-num\">92</span>, <span class=\"t-num\">74</span>, <span class=\"t-num\">65</span>, <span class=\"t-num\">95</span>, <span class=\"t-num\">83</span>, <span class=\"t-num\">71</span>, <span class=\"t-num\">50</span>]\n\n    <span class=\"t-comment\">;; Pipeline: filtruj zdanych → oblicz oceny → stats</span>\n    <span class=\"t-kw\">let</span> passing = iter::filter(scores, |s: int| -> bool <span class=\"t-kw\">is</span> s >= <span class=\"t-num\">60</span> <span class=\"t-kw\">end</span>)\n    <span class=\"t-kw\">let</span> total   = iter::reduce(passing, <span class=\"t-num\">0</span>, |a: int, x: int| -> int <span class=\"t-kw\">is</span> a + x <span class=\"t-kw\">end</span>)\n    <span class=\"t-kw\">let</span> avg     = total / passing.len()\n    <span class=\"t-kw\">let</span> highest = sort::max_int(scores)\n\n    write(fmt::bold(<span class=\"t-str\">\"=== Wyniki ===\"</span>))\n    write(<span class=\"t-str\">\"Zdanych:  {passing.len()}/{scores.len()}\"</span>)\n    write(<span class=\"t-str\">\"Średnia:  {avg}\"</span>)\n    write(<span class=\"t-str\">\"Najwyższy: {highest} ({letter_grade(highest)})\"</span>)\n\n    write(<span class=\"t-str\">\"\"</span>)\n    write(fmt::bold(<span class=\"t-str\">\"Rozkład ocen:\"</span>))\n    <span class=\"t-kw\">for</span> s <span class=\"t-kw\">in</span> scores <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> g    = letter_grade(s)\n        <span class=\"t-kw\">let</span> bar  = iter::repeat(<span class=\"t-str\">\"█\"</span>, s / <span class=\"t-num\">10</span>)\n        <span class=\"t-kw\">let</span> line = iter::join(bar, <span class=\"t-str\">\"\"</span>)\n        write(<span class=\"t-str\">\"{s} [{g}] {line}\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>TCP Port Scanner</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">port_scanner.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> net_tcp\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"tcp\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> async_\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"async\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fmt\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fmt\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> time\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"t\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> cli\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"cli\"</span>\n\n<span class=\"t-kw\">let</span> COMMON_PORTS: [int] = [\n    <span class=\"t-num\">21</span>, <span class=\"t-num\">22</span>, <span class=\"t-num\">23</span>, <span class=\"t-num\">25</span>, <span class=\"t-num\">53</span>, <span class=\"t-num\">80</span>, <span class=\"t-num\">110</span>, <span class=\"t-num\">143</span>,\n    <span class=\"t-num\">443</span>, <span class=\"t-num\">445</span>, <span class=\"t-num\">3306</span>, <span class=\"t-num\">5432</span>, <span class=\"t-num\">6379</span>, <span class=\"t-num\">8080</span>, <span class=\"t-num\">8443</span>\n]\n\n<span class=\"t-kw\">let</span> PORT_NAMES: any = {\n    <span class=\"t-num\">21</span>: <span class=\"t-str\">\"FTP\"</span>, <span class=\"t-num\">22</span>: <span class=\"t-str\">\"SSH\"</span>, <span class=\"t-num\">23</span>: <span class=\"t-str\">\"Telnet\"</span>,\n    <span class=\"t-num\">25</span>: <span class=\"t-str\">\"SMTP\"</span>, <span class=\"t-num\">80</span>: <span class=\"t-str\">\"HTTP\"</span>, <span class=\"t-num\">443</span>: <span class=\"t-str\">\"HTTPS\"</span>,\n    <span class=\"t-num\">3306</span>: <span class=\"t-str\">\"MySQL\"</span>, <span class=\"t-num\">5432</span>: <span class=\"t-str\">\"PostgreSQL\"</span>,\n    <span class=\"t-num\">6379</span>: <span class=\"t-str\">\"Redis\"</span>, <span class=\"t-num\">8080</span>: <span class=\"t-str\">\"HTTP-Alt\"</span>\n}\n\nasync <span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> target = cli::prompt(<span class=\"t-str\">\"Target host: \"</span>)\n    write(fmt::bold(<span class=\"t-str\">\"Scanning {target}...\"</span>))\n    write(fmt::dim(<span class=\"t-str\">\"─────────────────────────\"</span>))\n\n    <span class=\"t-kw\">let</span> start  = t::now_unix()\n    <span class=\"t-kw\">let mut</span> found: int = <span class=\"t-num\">0</span>\n\n    <span class=\"t-kw\">for</span> port <span class=\"t-kw\">in</span> COMMON_PORTS <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> open = await tcp::is_open_async(target, port, <span class=\"t-num\">500</span>)\n        <span class=\"t-kw\">if</span> open <span class=\"t-kw\">is</span>\n            <span class=\"t-kw\">let</span> svc = PORT_NAMES[port]\n            write(fmt::green(<span class=\"t-str\">\" OPEN\"</span>) + <span class=\"t-str\">\" {port}/tcp  {svc}\"</span>)\n            found += <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">let</span> elapsed = t::now_unix() - start\n    write(fmt::dim(<span class=\"t-str\">\"─────────────────────────\"</span>))\n    write(<span class=\"t-str\">\"Found {found} open port(s) in {elapsed}ms\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>SHA-256 File Hasher</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">hasher.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>     <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> crypto\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"crypto\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> env\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"env\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fmt\"</span>    <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fmt\"</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">hash_file</span>(path: string) -> string? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> !fs::exists(path) <span class=\"t-kw\">is</span>\n        return nil\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> data = fs::read_bytes(path)\n    return crypto::sha256_bytes(data)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> args = env::args()\n    <span class=\"t-kw\">if</span> args.len() < <span class=\"t-num\">2</span> <span class=\"t-kw\">is</span>\n        write(fmt::red(<span class=\"t-str\">\"Usage: hasher &lt;file&gt; [file2 ...]\"</span>))\n        return\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-kw\">for</span> path <span class=\"t-kw\">in</span> args[<span class=\"t-num\">1</span>..] <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> hash = hash_file(path)\n        <span class=\"t-kw\">if</span> hash == nil <span class=\"t-kw\">is</span>\n            write(fmt::red(<span class=\"t-str\">\"NOT FOUND: {path}\"</span>))\n        <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n            write(<span class=\"t-str\">\"{hash}  {path}\"</span>)\n        <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Generyczny stos + trait bound</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">generic_stack.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Generyczna struktura + funkcja z ograniczeniem T: Debug, żeby móc</span>\n<span class=\"t-comment\">;; wypisać zawartość niezależnie od typu elementów.</span>\n<span class=\"t-kw\">trait</span> Debug <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> debug(<span class=\"t-kw\">self</span>) -> <span class=\"t-type\">string</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">struct</span> Stack&lt;T&gt; <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> items: [T]\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">impl</span>&lt;T&gt; Stack&lt;T&gt; <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-fn\">new</span>() -> Stack&lt;T&gt; <span class=\"t-kw\">is</span>\n        return Stack { items: [] }\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-fn\">push</span>(<span class=\"t-kw\">mut self</span>, item: T) <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">self</span>.items = array_push(<span class=\"t-kw\">self</span>.items, item)\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">fn</span> <span class=\"t-fn\">pop</span>(<span class=\"t-kw\">mut self</span>) -> T? <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">if</span> <span class=\"t-kw\">self</span>.items.len() == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span> return nil <span class=\"t-kw\">end</span>\n        <span class=\"t-kw\">let</span> last = <span class=\"t-kw\">self</span>.items[<span class=\"t-kw\">self</span>.items.len() - <span class=\"t-num\">1</span>]\n        <span class=\"t-kw\">self</span>.items = array_remove(<span class=\"t-kw\">self</span>.items, <span class=\"t-kw\">self</span>.items.len() - <span class=\"t-num\">1</span>)\n        return last\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">dump</span>&lt;T: Debug&gt;(stack: Stack&lt;T&gt;) <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">for</span> item <span class=\"t-kw\">in</span> stack.items <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"  - \"</span> + item.debug())\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">#[derive(Debug)]</span>\n<span class=\"t-kw\">struct</span> Job <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> name: <span class=\"t-type\">string</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> jobs: Stack&lt;Job&gt; = Stack::new()\n    jobs.push(Job { name: <span class=\"t-str\">\"build\"</span> })\n    jobs.push(Job { name: <span class=\"t-str\">\"test\"</span> })\n    jobs.push(Job { name: <span class=\"t-str\">\"deploy\"</span> })\n\n    dump(jobs)\n    write(<span class=\"t-str\">\"---\"</span>)\n    <span class=\"t-kw\">let</span> next = jobs.pop()\n    <span class=\"t-kw\">if</span> next != nil <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"next up: \"</span> + next.debug())\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Optional &amp; łańcuchowanie <code>?</code> — wczytywanie configu</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">config_chain.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> env\"</span>  <span class=\"t-kw\">from</span> <span class=\"t-str\">\"env\"</span>\n\n<span class=\"t-comment\">;; Każde ? przerywa całą funkcję i zwraca nil w miejscu wywołania,</span>\n<span class=\"t-comment\">;; jeśli krok po lewej dał nil — nie trzeba ręcznie sprawdzać każdego</span>\n<span class=\"t-comment\">;; kroku osobno.</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">read_port</span>(path: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">int</span>? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> raw: <span class=\"t-type\">string</span>? = fs::read_to_string(path)?\n    <span class=\"t-kw\">let</span> parsed: any? = json::parse(raw)?\n    <span class=\"t-kw\">let</span> port: <span class=\"t-type\">int</span>? = parsed[<span class=\"t-str\">\"server\"</span>][<span class=\"t-str\">\"port\"</span>]?\n    return port\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> path = env::args()[<span class=\"t-num\">1</span>]\n    <span class=\"t-kw\">let</span> port = read_port(path)\n    <span class=\"t-kw\">if</span> port == nil <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"could not read a valid port from \"</span> + path)\n        return\n    <span class=\"t-kw\">end</span>\n    write(<span class=\"t-str\">\"server port: {port}\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>@arena + @arc razem — pula buforów</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">buffer_pool.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; parse_chunk robi dużo tymczasowych alokacji (string, array) które</span>\n<span class=\"t-comment\">;; są potrzebne tylko wewnątrz tej jednej funkcji — @arena zwalnia je</span>\n<span class=\"t-comment\">;; wszystkie naraz na wyjściu. shared z kolei musi przeżyć dłużej niż</span>\n<span class=\"t-comment\">;; jedno wywołanie, więc jest ręcznie zarządzany przez @arc.</span>\n<span class=\"t-kw\">@arena</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">parse_chunk</span>(raw: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">int</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> parts: [<span class=\"t-type\">string</span>] = string_split(raw, <span class=\"t-str\">\",\"</span>)\n    <span class=\"t-kw\">let mut</span> total: <span class=\"t-type\">int</span> = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> p <span class=\"t-kw\">in</span> parts <span class=\"t-kw\">is</span>\n        total = total + string_to_int(string_trim(p))\n    <span class=\"t-kw\">end</span>\n    return total\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">@arc</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">shared_running_total</span>(existing: <span class=\"t-type\">int</span>, delta: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">int</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> buf = arc_alloc(<span class=\"t-num\">8</span>)\n    ptr_write_i64(buf, <span class=\"t-num\">0</span>, existing + delta)\n    <span class=\"t-kw\">let</span> result: <span class=\"t-type\">int</span> = ptr_read_i64(buf, <span class=\"t-num\">0</span>)\n    arc_release(buf)\n    return result\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> chunks: [<span class=\"t-type\">string</span>] = [<span class=\"t-str\">\"1, 2, 3\"</span>, <span class=\"t-str\">\"10, 20\"</span>, <span class=\"t-str\">\"100\"</span>]\n    <span class=\"t-kw\">let mut</span> running: <span class=\"t-type\">int</span> = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> chunk <span class=\"t-kw\">in</span> chunks <span class=\"t-kw\">is</span>\n        running = shared_running_total(running, parse_chunk(chunk))\n    <span class=\"t-kw\">end</span>\n    write(<span class=\"t-str\">\"total: {running}\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_sterowanie() -> Str [
    end "\n<div class=\"section\" id=\"if\">\n<div class=\"sec-header\"><span class=\"sec-num\">07</span><h2>If / Elsif / Else</h2></div>\n<p>Warunek zapisuje się jako <code>if warunek is...end</code>. Blok zaczyna się słowem <code>is</code>, a kończy <code>end</code>.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">if.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> port: int = <span class=\"t-num\">443</span>\n\n    <span class=\"t-kw\">if</span> port == <span class=\"t-num\">443</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"HTTPS\"</span>)\n    <span class=\"t-kw\">elsif</span> port == <span class=\"t-num\">80</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"HTTP\"</span>)\n    <span class=\"t-kw\">elsif</span> port == <span class=\"t-num\">22</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"SSH\"</span>)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Other: \"</span> + to_string(port))\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-comment\">;; Złożone warunki</span>\n    <span class=\"t-kw\">let</span> open: bool = <span class=\"t-kw\">true</span>\n    <span class=\"t-kw\">if</span> open && port > <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"port otwarty\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"match\">\n<div class=\"sec-header\"><span class=\"sec-num\">08</span><h2>Match — pattern matching</h2></div>\n<p>Pełne pattern matching: literały, warianty enum, wildcard <code>_</code>, OR-pattern <code>a | b</code>. Blok: <code>match x is...end</code>.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">match.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">classify</span>(port: int) -> string <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> port <span class=\"t-kw\">is</span>\n        <span class=\"t-num\">22</span>         => <span class=\"t-str\">\"SSH\"</span>\n        <span class=\"t-num\">80</span>         => <span class=\"t-str\">\"HTTP\"</span>\n        <span class=\"t-num\">443</span>        => <span class=\"t-str\">\"HTTPS\"</span>\n        <span class=\"t-num\">3306</span>       => <span class=\"t-str\">\"MySQL\"</span>\n        <span class=\"t-num\">5432</span>       => <span class=\"t-str\">\"PostgreSQL\"</span>\n        <span class=\"t-num\">6379</span>       => <span class=\"t-str\">\"Redis\"</span>\n        <span class=\"t-num\">8080</span>       => <span class=\"t-str\">\"HTTP-Alt\"</span>\n        _          => <span class=\"t-str\">\"Unknown\"</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">enum</span> Status <span class=\"t-kw\">is</span>\n    Open\n    Closed\n    Filtered(string)\n    Error(int, string)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">handle</span>(r: Status) <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> r <span class=\"t-kw\">is</span>\n        Open           => write(<span class=\"t-str\">\"otwarty\"</span>)\n        Closed         => write(<span class=\"t-str\">\"zamknięty\"</span>)\n        Filtered(msg)  => write(<span class=\"t-str\">\"filtr: \"</span> + msg)\n        Error(c, m)    => write(<span class=\"t-str\">\"błąd \"</span> + to_string(c) + <span class=\"t-str\">\": \"</span> + m)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    write(classify(<span class=\"t-num\">443</span>))\n    handle(Status::Open)\n    handle(Status::Filtered(<span class=\"t-str\">\"firewall\"</span>))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"while\">\n<div class=\"sec-header\"><span class=\"sec-num\">09</span><h2>While</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">while.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> i: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">while</span> i < <span class=\"t-num\">10</span> <span class=\"t-kw\">is</span>\n        write(to_string(i))\n        i += <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"for\">\n<div class=\"sec-header\"><span class=\"sec-num\">10</span><h2>For i zakresy</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">for.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; Zakres wyłączny (1..10 = 1,2,..,9)</span>\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">1</span>..<span class=\"t-num\">10</span> <span class=\"t-kw\">is</span>\n        write(to_string(i))\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-comment\">;; Zakres włączny (1..=5 = 1,2,3,4,5)</span>\n    <span class=\"t-kw\">let</span> <span class=\"t-kw2\">mut</span> sum: int = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">for</span> i <span class=\"t-kw\">in</span> <span class=\"t-num\">1</span>..=<span class=\"t-num\">100</span> <span class=\"t-kw\">is</span>\n        sum += i\n    <span class=\"t-kw\">end</span>\n    write(<span class=\"t-str\">\"Sum: \"</span> + to_string(sum))\n\n    <span class=\"t-comment\">;; Iteracja po tablicy</span>\n    <span class=\"t-kw\">let</span> ports: [int] = [<span class=\"t-num\">22</span>, <span class=\"t-num\">80</span>, <span class=\"t-num\">443</span>, <span class=\"t-num\">8080</span>]\n    <span class=\"t-kw\">for</span> port <span class=\"t-kw\">in</span> ports <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Port: \"</span> + to_string(port))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_struktura() -> Str [
    end "\n<div class=\"section\" id=\"struktura\">\n<div class=\"sec-header\"><span class=\"sec-num\">02</span><h2>Struktura projektu</h2></div>\n<h3>using — deklaracja edycji <span class=\"nav-new\">v0.8</span></h3>\n<p><code>using \"edycja\"</code> to opcjonalna dyrektywa na samej pierwszej linii pliku (przed jakimikolwiek <code>use</code>), deklarująca którą <strong>edycję języka</strong> ten plik zakłada — dokładny odpowiednik <code>edition = \"2021\"</code> w <code>Cargo.toml</code> Rusta.</p>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">składnia</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">using</span> <span class=\"t-str\">\"2026\"</span>\n\n<span class=\"t-comment\">;; reszta pliku — importy, typy, funkcje...</span></pre></div></div>\n</div>\n\n<div class=\"callout c-info\"><div class=\"ci\">ℹ</div><div class=\"cb\"><strong>Stan dzisiaj:</strong> <code>using</code> jest parsowane i zapisywane w metadanych modułu, ale kompilator jeszcze niczego na tej podstawie nie zmienia — żadna wersja edycji nie włącza ani nie wyłącza żadnego zachowania. To zarezerwowana składnia pod przyszłe, potencjalnie łamiące zmiany języka (patrz plan rozwoju: edycje 2026, 2027...), analogicznie do tego jak nowe edycje Rusta pozwalają wprowadzać breaking changes bez psucia starego kodu. Dziś to czysta, nieszkodliwa metadana — możesz jej używać już teraz (nic nie popsuje), ale nie zmieni jeszcze zachowania Twojego programu.</div></div>\n\n<h3>Struktura pliku .h#</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">szablon.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; 0. using — opcjonalna deklaracja edycji (zawsze pierwsza linia)</span>\n<span class=\"t-kw\">using</span> <span class=\"t-str\">\"2026\"</span>\n\n<span class=\"t-comment\">;; 1. Importy</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> io\"</span>       <span class=\"t-kw\">from</span> <span class=\"t-str\">\"io\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sec\"</span>      <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sec\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"bytes -> scanner\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sc\"</span>\n\n<span class=\"t-comment\">;; 2. Typy: struct, enum, trait</span>\n<span class=\"t-kw\">struct</span> Config <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> host: string\n    <span class=\"t-kw\">pub</span> port: int\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; 3. Implementacje + funkcje</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">init</span>() <span class=\"t-kw\">is</span>\n    write(<span class=\"t-str\">\"Start!\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; 4. fn main() — punkt wejścia</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    init()\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_tests() -> Str [
    end "\n<div class=\"section\" id=\"tests\">\n<div class=\"sec-header\"><span class=\"sec-num\">22</span><h2>System testów <span class=\"nav-new\">v0.6</span></h2></div>\n<p>H# ma wbudowany system testów. Funkcje oznaczone <code>#[test]</code> są wykrywane automatycznie i uruchamiane przez <code>bytes test</code>. Nie wymagają main — runner zbiera je sam.</p>\n\n<h3>Pisanie testów</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">tests/arithmetic_test.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> test\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"test\"</span>\n\n<span class=\"t-comment\">;; Funkcja pomocnicza — dostępna w testach</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">add</span>(a: int, b: int) -> int = a + b\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">factorial</span>(n: int) -> int <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> n <= <span class=\"t-num\">1</span> <span class=\"t-kw\">is</span> return <span class=\"t-num\">1</span> <span class=\"t-kw\">end</span>\n    return n * factorial(n - <span class=\"t-num\">1</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_add_basic</span>() <span class=\"t-kw\">is</span>\n    test::assert_eq(add(<span class=\"t-num\">2</span>, <span class=\"t-num\">3</span>), <span class=\"t-num\">5</span>)\n    test::assert_eq(add(<span class=\"t-num\">-1</span>, <span class=\"t-num\">1</span>), <span class=\"t-num\">0</span>)\n    test::assert_eq(add(<span class=\"t-num\">0</span>, <span class=\"t-num\">0</span>), <span class=\"t-num\">0</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_factorial</span>() <span class=\"t-kw\">is</span>\n    test::assert_eq(factorial(<span class=\"t-num\">0</span>), <span class=\"t-num\">1</span>)\n    test::assert_eq(factorial(<span class=\"t-num\">5</span>), <span class=\"t-num\">120</span>)\n    test::assert_eq(factorial(<span class=\"t-num\">10</span>), <span class=\"t-num\">3628800</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_float_approx</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> pi: f64 = <span class=\"t-num\">3.14159</span>\n    test::assert_approx(pi, <span class=\"t-num\">3.14</span>, <span class=\"t-num\">0.01</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_string_ops</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> s = <span class=\"t-str\">\"hello\"</span>\n    test::assert_eq(s.len(), <span class=\"t-num\">5</span>)\n    test::assert_true(s.contains(<span class=\"t-str\">\"ell\"</span>))\n    test::assert_true(s.starts_with(<span class=\"t-str\">\"hel\"</span>))\n    test::assert_eq(s.to_upper(), <span class=\"t-str\">\"HELLO\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_interpolation</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> name = <span class=\"t-str\">\"H#\"</span>\n    <span class=\"t-kw\">let</span> msg  = <span class=\"t-str\">\"Hello, {name}!\"</span>\n    test::assert_eq(msg, <span class=\"t-str\">\"Hello, H#!\"</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_optional_nil</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> r: int? = nil\n    test::assert_nil(r)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_skip_example</span>() <span class=\"t-kw\">is</span>\n    test::skip(<span class=\"t-str\">\"not implemented yet\"</span>)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<h3>Uruchamianie testów</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">terminal</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Wszystkie testy w projekcie</span>\nbytes test\n\n<span class=\"t-comment\">;; Konkretny katalog</span>\nbytes test tests/core/\n\n<span class=\"t-comment\">;; Konkretny plik</span>\nbytes test tests/core/arithmetic_test.h#\n\n<span class=\"t-comment\">;; Verbose — pokaż każdy assert</span>\nbytes test --verbose\n\n<span class=\"t-comment\">;; Sprawdzanie składni bez uruchamiania</span>\nh# check tests/</pre></div></div>\n</div>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">output</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre>  bytes test  H# Test Runner v0.6\n\n  tests/core/arithmetic_test.h#\n    ✓ test_add_basic        (0.3ms)\n    ✓ test_factorial        (0.1ms)\n    ✓ test_float_approx     (0.1ms)\n    ✓ test_string_ops       (0.2ms)\n    ✓ test_interpolation    (0.1ms)\n    ✓ test_optional_nil     (0.1ms)\n    ⊘ test_skip_example     (skipped: not implemented yet)\n\n  ──────────────────────────────────────────────\n  ✓ 6 passed  ⊘ 1 skipped  ✗ 0 failed   0.9ms</pre></div></div>\n</div>\n\n<h3>Wszystkie asercje</h3>\n<table class=\"ref-table\">\n<tr><th>Funkcja</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">assert_eq(actual, expected)</td><td class=\"td-desc\">Wartości muszą być równe — drukuje obie przy niepowodzeniu</td></tr>\n<tr><td class=\"td-syntax\">assert_ne(actual, unexpected)</td><td class=\"td-desc\">Wartości muszą być różne</td></tr>\n<tr><td class=\"td-syntax\">assert_true(cond)</td><td class=\"td-desc\">Warunek musi być true</td></tr>\n<tr><td class=\"td-syntax\">assert_false(cond)</td><td class=\"td-desc\">Warunek musi być false</td></tr>\n<tr><td class=\"td-syntax\">assert_nil(val)</td><td class=\"td-desc\">Wartość musi być nil</td></tr>\n<tr><td class=\"td-syntax\">assert_not_nil(val)</td><td class=\"td-desc\">Wartość nie może być nil</td></tr>\n<tr><td class=\"td-syntax\">assert_approx(actual, expected, delta)</td><td class=\"td-desc\">Float w przedziale ±delta — do porównań zmiennoprzecinkowych</td></tr>\n<tr><td class=\"td-syntax\">assert_contains(s, sub)</td><td class=\"td-desc\">String zawiera podstring</td></tr>\n<tr><td class=\"td-syntax\">assert_starts_with(s, prefix)</td><td class=\"td-desc\">String zaczyna się od prefix</td></tr>\n<tr><td class=\"td-syntax\">assert_len(arr, n)</td><td class=\"td-desc\">Tablica ma dokładnie n elementów</td></tr>\n<tr><td class=\"td-syntax\">fail(msg)</td><td class=\"td-desc\">Ręczne niepowodzenie z wiadomością</td></tr>\n<tr><td class=\"td-syntax\">skip(reason)</td><td class=\"td-desc\">Pomiń test (oznaczony ⊘, nie ✗)</td></tr>\n</table>\n\n<h3>Test z kolekcjami i std</h3>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">tests/std_test.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> test\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"test\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> collections\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"col\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> sort\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"sort\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> iter\"</span>        <span class=\"t-kw\">from</span> <span class=\"t-str\">\"iter\"</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_hashmap</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> map = col::HashMap::new()\n    map.insert(<span class=\"t-str\">\"key\"</span>, <span class=\"t-num\">42</span>)\n    map.insert(<span class=\"t-str\">\"other\"</span>, <span class=\"t-num\">99</span>)\n    test::assert_eq(map.get(<span class=\"t-str\">\"key\"</span>), <span class=\"t-num\">42</span>)\n    test::assert_eq(map.len(), <span class=\"t-num\">2</span>)\n    test::assert_true(map.contains_key(<span class=\"t-str\">\"key\"</span>))\n    test::assert_true(!map.contains_key(<span class=\"t-str\">\"missing\"</span>))\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_sort_and_search</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> arr = [<span class=\"t-num\">5</span>, <span class=\"t-num\">1</span>, <span class=\"t-num\">8</span>, <span class=\"t-num\">3</span>, <span class=\"t-num\">9</span>, <span class=\"t-num\">2</span>]\n    sort::sort_ints(arr)\n    test::assert_eq(arr[<span class=\"t-num\">0</span>], <span class=\"t-num\">1</span>)\n    test::assert_eq(arr[<span class=\"t-num\">5</span>], <span class=\"t-num\">9</span>)\n    test::assert_eq(sort::binary_search(arr, <span class=\"t-num\">8</span>), <span class=\"t-num\">4</span>)\n    test::assert_eq(sort::binary_search(arr, <span class=\"t-num\">99</span>), <span class=\"t-num\">-1</span>)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-attr\">#[test]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">test_iter_pipeline</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> nums  = [<span class=\"t-num\">1</span>, <span class=\"t-num\">2</span>, <span class=\"t-num\">3</span>, <span class=\"t-num\">4</span>, <span class=\"t-num\">5</span>, <span class=\"t-num\">6</span>]\n    <span class=\"t-kw\">let</span> evens = iter::filter(nums, |x: int| -> bool <span class=\"t-kw\">is</span> x % <span class=\"t-num\">2</span> == <span class=\"t-num\">0</span> <span class=\"t-kw\">end</span>)\n    <span class=\"t-kw\">let</span> sq    = iter::map(evens, |x: int| -> int <span class=\"t-kw\">is</span> x * x <span class=\"t-kw\">end</span>)\n    <span class=\"t-kw\">let</span> sum   = iter::reduce(sq, <span class=\"t-num\">0</span>, |a: int, x: int| -> int <span class=\"t-kw\">is</span> a + x <span class=\"t-kw\">end</span>)\n    test::assert_eq(sum, <span class=\"t-num\">56</span>)  <span class=\"t-comment\">;; 4 + 16 + 36 = 56</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_typy() -> Str [
    end "\n<div class=\"section\" id=\"enum\">\n<div class=\"sec-header\"><span class=\"sec-num\">14</span><h2>Enum</h2></div>\n<p>Wyliczenia z opcjonalnymi polami. Blok: <code>enum Nazwa is...end</code>. Używane z <code>match</code>.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">enum.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Prosta enum</span>\n<span class=\"t-kw\">enum</span> Status <span class=\"t-kw\">is</span>\n    Running\n    Stopped\n    Error\n    Pending\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Enum z danymi</span>\n<span class=\"t-kw\">enum</span> ScanResult <span class=\"t-kw\">is</span>\n    Open\n    Closed\n    Filtered(string)\n    Error(int, string)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">handle</span>(r: ScanResult) <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">match</span> r <span class=\"t-kw\">is</span>\n        Open           => write(<span class=\"t-str\">\"otwarty\"</span>)\n        Closed         => write(<span class=\"t-str\">\"zamknięty\"</span>)\n        Filtered(msg)  => write(<span class=\"t-str\">\"filtr: \"</span> + msg)\n        Error(c, m)    => write(<span class=\"t-str\">\"błąd \"</span> + to_string(c) + <span class=\"t-str\">\": \"</span> + m)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> s = Status::Running\n    <span class=\"t-kw\">match</span> s <span class=\"t-kw\">is</span>\n        Running => write(<span class=\"t-str\">\"✓ Działa\"</span>)\n        Stopped => write(<span class=\"t-str\">\"✗ Stop\"</span>)\n        Error   => write(<span class=\"t-str\">\"! Błąd\"</span>)\n        Pending => write(<span class=\"t-str\">\"... Czeka\"</span>)\n    <span class=\"t-kw\">end</span>\n    handle(ScanResult::Filtered(<span class=\"t-str\">\"firewall\"</span>))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"typy-prim\">\n<div class=\"sec-header\"><span class=\"sec-num\">15</span><h2>Typy wbudowane i operatory</h2></div>\n<table class=\"ref-table\">\n<tr><th>Typ</th><th>Opis</th><th>Rozmiar</th><th>Literał</th></tr>\n<tr><td class=\"td-syntax\">int</td><td class=\"td-desc\">Całkowity (alias i64)</td><td class=\"td-note\">64-bit</td><td class=\"td-note\">42, -7, 1_000</td></tr>\n<tr><td class=\"td-syntax\">uint</td><td class=\"td-desc\">Bez znaku (alias u64)</td><td class=\"td-note\">64-bit</td><td class=\"td-note\">255, 0xFF</td></tr>\n<tr><td class=\"td-syntax\">i8..i128 / u8..u128</td><td class=\"td-desc\">Precyzyjne typy całkowite</td><td class=\"td-note\">8-128 bit</td><td class=\"td-note\">42i8, 0xFFu8</td></tr>\n<tr><td class=\"td-syntax\">f32, f64</td><td class=\"td-desc\">Zmiennoprzecinkowe</td><td class=\"td-note\">32/64 bit</td><td class=\"td-note\">3.14, 2.71f32</td></tr>\n<tr><td class=\"td-syntax\">bool</td><td class=\"td-desc\">Logiczny</td><td class=\"td-note\">1 bit</td><td class=\"td-note\">true, false</td></tr>\n<tr><td class=\"td-syntax\">string</td><td class=\"td-desc\">UTF-8 tekst</td><td class=\"td-note\">heap</td><td class=\"td-note\">\"tekst\"</td></tr>\n<tr><td class=\"td-syntax\">bytes</td><td class=\"td-desc\">Surowe bajty</td><td class=\"td-note\">heap</td><td class=\"td-note\">[0xDE, 0xAD]</td></tr>\n<tr><td class=\"td-syntax\">void</td><td class=\"td-desc\">Brak wartości</td><td class=\"td-note\">—</td><td class=\"td-note\">—</td></tr>\n<tr><td class=\"td-syntax\">[T]</td><td class=\"td-desc\">Tablica jednorodna</td><td class=\"td-note\">heap</td><td class=\"td-note\">[1, 2, 3]</td></tr>\n<tr><td class=\"td-syntax\">(T, U)</td><td class=\"td-desc\">Tuple</td><td class=\"td-note\">stack</td><td class=\"td-note\">(\"a\", 1)</td></tr>\n<tr><td class=\"td-syntax\">T?</td><td class=\"td-desc\">Optional (nil-able)</td><td class=\"td-note\">—</td><td class=\"td-note\">nil lub wartość</td></tr>\n</table>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">typy.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Rzutowanie</span>\n<span class=\"t-kw\">let</span> n: int  = <span class=\"t-num\">42</span>\n<span class=\"t-kw\">let</span> f: f64  = n <span class=\"t-kw\">as</span> f64\n<span class=\"t-kw\">let</span> b: u8   = n <span class=\"t-kw\">as</span> u8\n<span class=\"t-kw\">let</span> s: string = to_string(n)\n\n<span class=\"t-comment\">;; Optional</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">find</span>(id: int) -> string? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> id <= <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span> return <span class=\"t-kw\">nil</span> <span class=\"t-kw\">end</span>\n    return <span class=\"t-str\">\"user_\"</span> + to_string(id)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-func\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> u: string? = find(<span class=\"t-num\">5</span>)\n    <span class=\"t-kw\">if</span> u != <span class=\"t-kw\">nil</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Znaleziono: \"</span> + u)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Brak\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hs_sec_zaawansowane() -> Str [
    end "\n<div class=\"section\" id=\"unsafe\">\n<div class=\"sec-header\"><span class=\"sec-num\">16</span><h2>Unsafe &amp; Arena Allocator</h2></div>\n<p>Bloki <code>unsafe is...end</code> wyłączają borrow checker i sprawdzanie granic. Mają pięć trybów, każdy z inną semantyką zarządzania pamięcią.</p>\n\n<h3>Wszystkie tryby unsafe</h3>\n<table class=\"ref-table\">\n<tr><th>Składnia</th><th>Tryb</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">unsafe is...end</td><td class=\"td-note\">plain</td><td class=\"td-desc\">Brak areny. Niskopoziomowe operacje na wskaźnikach, surowe adresy, bezpośredni dostęp do pamięci. Brak automatycznego zwalniania.</td></tr>\n<tr><td class=\"td-syntax\">unsafe arena is...end</td><td class=\"td-note\">arena general</td><td class=\"td-desc\">Domyślna arena 1 MB. Wszystkie alokacje wewnątrz bloku wychodzą z tej puli i są zwalniane en-bloc po wyjściu z bloku.</td></tr>\n<tr><td class=\"td-syntax\">unsafe arena(N) is...end</td><td class=\"td-note\">arena fixed</td><td class=\"td-desc\">Arena o rozmiarze dokładnie N bajtów. Próba przekroczenia → panic. Idealna gdy znasz górną granicę (np. maksymalny pakiet sieciowy).</td></tr>\n<tr><td class=\"td-syntax\">unsafe pool(N) is...end</td><td class=\"td-note\">arena pool</td><td class=\"td-desc\">Pool allocator — N bajtów dzielonych na równe chunki. Szybkie alokacje stałego rozmiaru (np. tysiące małych struct naraz).</td></tr>\n<tr><td class=\"td-syntax\">unsafe page is...end</td><td class=\"td-note\">arena page</td><td class=\"td-desc\">Alokator stronnicowy (page-aligned). Każda alokacja zaokrąglona do 4096 B. Używane przy mmap / DMA / interfejsach kernela.</td></tr>\n<tr><td class=\"td-syntax\">unsafe ring(N) is...end</td><td class=\"td-note\">arena ring</td><td class=\"td-desc\">Ring buffer N bajtów. Gdy pełny — nadpisuje najstarsze dane. Używane w network capture, logowaniu, strumieniach audio.</td></tr>\n<tr><td class=\"td-syntax\">unsafe manual is...end</td><td class=\"td-note\">manual modern</td><td class=\"td-desc\">Ręczne malloc/free przez mem::alloc / mem::free_ptr. Styl nowoczesny — funkcje z std -> mem.</td></tr>\n<tr><td class=\"td-syntax\">unsafe classic is...end</td><td class=\"td-note\">manual classic</td><td class=\"td-desc\">Ręczne malloc/free via FFI extern C. Styl C — bezpośrednie wywołanie libc malloc.</td></tr>\n</table>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">unsafe_modes.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> mem\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"mem\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> hex\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"hex\"</span>\n\n<span class=\"t-comment\">;; ── 1. plain unsafe — surowe wskaźniki ───────────────────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">raw_ptr_ops</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> addr: u64 = <span class=\"t-num\">0xDEADBEEF</span>\n        write(<span class=\"t-str\">\"raw: 0x\"</span> + hex::encode(to_string(addr)))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 2. arena(N) — pula N bajtów, en-bloc free ────────────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">process_packet</span>(data: bytes) <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> arena(<span class=\"t-num\">65536</span>) <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> buf: string = hex::encode(data)\n        write(<span class=\"t-str\">\"Packet: \"</span> + buf)\n    <span class=\"t-kw\">end</span>\n    <span class=\"t-comment\">;; buf automatycznie zwolniony po wyjściu z bloku</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 3. pool — równe chunki, tysiące alokacji ─────────────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">batch_alloc</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> pool(<span class=\"t-num\">1048576</span>) <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let mut</span> i: int = <span class=\"t-num\">0</span>\n        <span class=\"t-kw\">while</span> i < <span class=\"t-num\">10000</span> <span class=\"t-kw\">is</span>\n            <span class=\"t-kw\">let</span> chunk: string = to_string(i)\n            i += <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">end</span>\n        write(<span class=\"t-str\">\"Allocated 10000 pool chunks\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 4. page — wyrównanie do 4096 B (DMA / mmap) ─────────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">dma_buffer</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> page <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> dma: bytes = [<span class=\"t-num\">0</span>; <span class=\"t-num\">4096</span>]   <span class=\"t-comment\">;; page-aligned</span>\n        write(<span class=\"t-str\">\"DMA buf @ page boundary, len=\"</span> + to_string(dma.len()))\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 5. ring(N) — nadpisuje najstarsze gdy pełny ──────────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">capture_stream</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> ring(<span class=\"t-num\">8192</span>) <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let mut</span> seq: int = <span class=\"t-num\">0</span>\n        <span class=\"t-kw\">while</span> seq < <span class=\"t-num\">1000</span> <span class=\"t-kw\">is</span>\n            <span class=\"t-kw\">let</span> frame: string = <span class=\"t-str\">\"frame_\"</span> + to_string(seq)\n            seq += <span class=\"t-num\">1</span>\n        <span class=\"t-kw\">end</span>\n        write(<span class=\"t-str\">\"Captured 1000 frames in 8KB ring\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 6. manual modern — mem::alloc / mem::free_ptr ───────────────</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">manual_modern</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> manual <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> ptr: int = mem::alloc(<span class=\"t-num\">1024</span>)\n        write(<span class=\"t-str\">\"allocated 1024 B at 0x\"</span> + hex::encode(to_string(ptr)))\n        mem::free_ptr(ptr)\n        write(<span class=\"t-str\">\"freed\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 7. classic — libc malloc / free via FFI ──────────────────────</span>\n<span class=\"t-kw\">extern</span> static [c] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> malloc(size: int) -> int\n    <span class=\"t-kw\">fn</span> free(ptr: int)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">manual_classic</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">unsafe</span> classic <span class=\"t-kw\">is</span>\n        <span class=\"t-kw\">let</span> ptr: int = malloc(<span class=\"t-num\">256</span>)\n        write(<span class=\"t-str\">\"libc malloc: 0x\"</span> + hex::encode(to_string(ptr)))\n        free(ptr)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    raw_ptr_ops()\n    process_packet([<span class=\"t-num\">0xDE</span>, <span class=\"t-num\">0xAD</span>, <span class=\"t-num\">0xBE</span>, <span class=\"t-num\">0xEF</span>])\n    batch_alloc()\n    dma_buffer()\n    capture_stream()\n    manual_modern()\n    manual_classic()\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n<div class=\"callout c-danger\"><div class=\"ci\">⚠</div><div class=\"cb\"><strong>Uwaga:</strong> Bloki <code>unsafe</code> wyłączają borrow checker, sprawdzanie granic i ownership. Używaj tylko przy FFI z C/kernela lub przy krytycznej optymalizacji. Nigdy nie mieszaj arena i manual w jednym bloku.</div></div>\n</div>\n\n<div class=\"section\" id=\"mem-modes\">\n<div class=\"sec-header\"><span class=\"sec-num\">24</span><h2>@ Adnotacje trybu pamięci <span class=\"nav-new\">v0.7</span></h2></div>\n<p>Adnotacja <code>@tryb</code> przed <code>fn</code> zmienia sposób zarządzania pamięcią <strong>tylko dla tej jednej funkcji</strong> — reszta programu może swobodnie mieszać różne tryby. Brak <code>@</code> w ogóle to dokładnie to samo co <code>@default</code>. W przeciwieństwie do bloków <code>unsafe is...end</code> (poprzednia sekcja), które są zagnieżdżane wewnątrz funkcji, adnotacja <code>@</code> dotyczy całego ciała funkcji na raz.</p>\n\n<h3>@: tryb — dyrektywa całego pliku <span class=\"nav-new\">nowość</span></h3>\n<p>Pisanie <code>@tryb</code> nad każdą pojedynczą funkcją robi się uciążliwe, gdy cały plik ma być np. <code>@safety</code>. Pierwsza linijka pliku może zamiast tego zawierać <code>@: tryb</code> (zauważ dwukropek — odróżnia to od adnotacji pojedynczej funkcji) — ustawia domyślny tryb dla <strong>każdej</strong> funkcji w tym pliku, która nie ma własnej adnotacji <code>@tryb</code>.</p>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">safe_module.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">@:</span> safety\n\n<span class=\"t-comment\">;; Ta funkcja jest teraz automatycznie @safety, mimo że nie ma</span>\n<span class=\"t-comment\">;; własnej adnotacji — dziedziczy tryb z dyrektywy powyżej.</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">parse_line</span>(line: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">string</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> owner: <span class=\"t-type\">string</span> = line\n    return owner\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Własna adnotacja funkcji zawsze wygrywa z dyrektywą pliku.</span>\n<span class=\"t-kw\">@arena</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">build_report</span>() -> <span class=\"t-type\">string</span> <span class=\"t-kw\">is</span>\n    return <span class=\"t-str\">\"...\"</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<p>Kolejność ważności (od najsilniejszej): własna adnotacja <code>@tryb</code> na funkcji &gt; dyrektywa <code>@: tryb</code> w pierwszej linijce pliku &gt; flaga <code>--mem-mode tryb</code> przekazana do <code>hsharp compile</code>/<code>build</code> (np. przez <code>mem-mode</code> w <code>bytes.hk</code> — patrz sekcja Instalacja &amp; narzędzia) &gt; <code>@default</code>, jeśli nic innego nie ustawiono. Działa identycznie w <code>hsharp build</code> (LLVM) i <code>hsharp run</code> (interpreter), oraz dla plików dociąganych przez <code>use</code> — każdy plik stosuje własną dyrektywę <code>@:</code>, nie tylko plik wejściowy.</p>\n\n<div class=\"callout c-info\"><div class=\"ci\">ℹ</div><div class=\"cb\"><strong>Backend:</strong> te cztery adnotacje działają w pełni tylko przy kompilacji przez <code>hsharp build</code> (LLVM). Interpreter (<code>hsharp run</code>) wykonuje <code>@safety</code>/<code>@arena</code> tak samo jak <code>@default</code> (drukując jednorazową notatkę na stderr, żeby ta różnica nie była cicha), a wywołanie builtina specyficznego dla <code>@arc</code>/<code>@pointers</code> (np. <code>arc_alloc</code>) w interpreterze kończy się jasnym błędem zamiast cichego <code>nil</code>.</div></div>\n\n<h3>Wszystkie tryby @</h3>\n<table class=\"ref-table\">\n<tr><th>Adnotacja</th><th>Status</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">@default</td><td class=\"td-note\">stabilny</td><td class=\"td-desc\">Domyślny — zwykła alokacja na stercie, bez dodatkowych sprawdzeń. Dokładnie to co dostajesz bez żadnego <code>@</code>.</td></tr>\n<tr><td class=\"td-syntax\">@safety</td><td class=\"td-note\" style=\"color:var(--c-amber)\">basic v2</td><td class=\"td-desc\">Ostrzega (nigdy nie blokuje kompilacji) o użyciu zmiennej string/array po tym jak <code>let y = x</code> ją przeniosło. Analiza rekurencyjnie wchodzi w if/while/match/for/do/unsafe i łączy gałęzie — zmienna liczy się jako \"na pewno przeniesiona\" tylko jeśli przeniesiona na każdej gałęzi.</td></tr>\n<tr><td class=\"td-syntax\">@arc</td><td class=\"td-note\" style=\"color:var(--c-amber)\">basic v2</td><td class=\"td-desc\"><code>arc_alloc(n)</code> alokuje realny blok z atomowym licznikiem referencji. Zwykłe <code>let x = arc_alloc(n)</code> / <code>let y = x</code> na najwyższym poziomie funkcji są automatycznie retain/release'owane. <code>arc_retain</code>/<code>arc_release</code>/<code>arc_count</code> dalej dostępne ręcznie.</td></tr>\n<tr><td class=\"td-syntax\">@arena</td><td class=\"td-note\" style=\"color:var(--c-green)\">kompletny</td><td class=\"td-desc\">Wszystko co ta funkcja alokuje pochodzi z jednej areny bump-allocatora, zwalnianej za jednym razem na każdej ścieżce wyjścia (włącznie z każdym <code>return</code>). Jedyny tryb w pełni ukończony end-to-end — dobry wzór referencyjny dla pozostałych.</td></tr>\n<tr><td class=\"td-syntax\">@pointers</td><td class=\"td-note\" style=\"color:var(--c-amber)\">basic v3</td><td class=\"td-desc\">Surowy, niesprawdzany dostęp do pamięci: <code>ptr_read_*</code>/<code>ptr_write_*</code> dla i8/i16/i32/i64/f32/f64/ptr, <code>ptr_add</code>/<code>ptr_is_null</code>, plus <code>ptr_alloc_size</code> (rozmiar alokacji arc_alloc), <code>ptr_field_offset</code> (przesunięcie pola struktury liczone w compile-time), <code>ptr_copy</code>/<code>ptr_compare</code> (memcpy/memcmp). Zero bounds-checkingu — celowo, ten sam model zaufania co surowe wskaźniki w C.</td></tr>\n</table>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">mem_modes.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; ── @arena — bump-alloc, wszystko zwolnione naraz ────────────────</span>\n<span class=\"t-kw\">@arena</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">build_report</span>(rows: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">string</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let mut</span> report: <span class=\"t-type\">string</span> = <span class=\"t-str\">\"Report:\n\"</span>\n    <span class=\"t-kw\">let mut</span> i: <span class=\"t-type\">int</span> = <span class=\"t-num\">0</span>\n    <span class=\"t-kw\">while</span> i < rows <span class=\"t-kw\">is</span>\n        report = report + <span class=\"t-str\">\"  row \"</span> + to_string(i) + <span class=\"t-str\">\"\n\"</span>\n        i += <span class=\"t-num\">1</span>\n    <span class=\"t-kw\">end</span>\n    return report\n<span class=\"t-kw\">end</span> <span class=\"t-comment\">;; cała arena zwolniona tutaj, na każdej ścieżce wyjścia</span>\n\n<span class=\"t-comment\">;; ── @arc — ręczny atomowy refcounting ────────────────────────────</span>\n<span class=\"t-kw\">@arc</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">shared_counter</span>(start: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">int</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> counter = arc_alloc(<span class=\"t-num\">8</span>)      <span class=\"t-comment\">;; count = 1</span>\n    ptr_write_i64(counter, <span class=\"t-num\">0</span>, start)\n    <span class=\"t-kw\">let</span> alias = counter               <span class=\"t-comment\">;; auto-retain — count = 2</span>\n    return ptr_read_i64(alias, <span class=\"t-num\">0</span>) + <span class=\"t-num\">1</span>\n    <span class=\"t-comment\">;; counter i alias auto-release'owane tutaj</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── @pointers — surowy dostęp, każda szerokość ───────────────────</span>\n<span class=\"t-kw\">@pointers</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">pack_two_i32</span>(a: <span class=\"t-type\">int</span>, b: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">string</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> buf = arc_alloc(<span class=\"t-num\">8</span>)\n    ptr_write_i32(buf, <span class=\"t-num\">0</span>, a)\n    ptr_write_i32(buf, <span class=\"t-num\">4</span>, b)\n    <span class=\"t-kw\">let</span> packed: <span class=\"t-type\">string</span> = to_string(ptr_read_i32(buf, <span class=\"t-num\">0</span>)) + <span class=\"t-str\">\",\"</span> + to_string(ptr_read_i32(buf, <span class=\"t-num\">4</span>))\n    arc_release(buf)\n    return packed\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── @pointers basic v3 — alloc_size / field_offset / copy / compare ─</span>\n<span class=\"t-kw\">struct</span> Header <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> magic:   <span class=\"t-type\">int</span>\n    <span class=\"t-kw\">pub</span> version: <span class=\"t-type\">int</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">@pointers</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">duplicate_buffer</span>(src: <span class=\"t-type\">any</span>) -> <span class=\"t-type\">any</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; ptr_alloc_size tylko dla wskaźników z arc_alloc — czyta nagłówek</span>\n    <span class=\"t-comment\">;; refcountu, który hsh_rc_alloc zapisał tuż przed src.</span>\n    <span class=\"t-kw\">let</span> n: <span class=\"t-type\">int</span> = ptr_alloc_size(src)\n    <span class=\"t-kw\">let</span> dst = arc_alloc(n)\n    ptr_copy(dst, src, n)     <span class=\"t-comment\">;; memcpy/memmove semantics</span>\n    return dst\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">@pointers</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">buffers_equal</span>(a: <span class=\"t-type\">any</span>, b: <span class=\"t-type\">any</span>, n: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">bool</span> <span class=\"t-kw\">is</span>\n    return ptr_compare(a, b, n) == <span class=\"t-num\">0</span>   <span class=\"t-comment\">;; memcmp semantics</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">@pointers</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">read_version</span>(buf: <span class=\"t-type\">any</span>) -> <span class=\"t-type\">int</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; przesunięcie pola liczone raz, w compile-time — nie trzeba już</span>\n    <span class=\"t-comment\">;; ręcznie liczyć bajtów jak w poprzednich wersjach @pointers.</span>\n    <span class=\"t-kw\">let</span> offset: <span class=\"t-type\">int</span> = ptr_field_offset(Header, <span class=\"t-str\">\"version\"</span>)\n    return ptr_read_i32(buf, offset)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── @safety — ostrzeżenie move-after-use ──────────────────────────</span>\n<span class=\"t-kw\">@safety</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">describe</span>(name: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">string</span> <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> owner: <span class=\"t-type\">string</span> = name     <span class=\"t-comment\">;; przenosi name do owner</span>\n    return <span class=\"t-str\">\"owner: \"</span> + owner       <span class=\"t-comment\">;; OK — czyta owner, nie name</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<div class=\"callout c-warn\"><div class=\"ci\">⚠</div><div class=\"cb\"><strong>Granice:</strong> <code>ptr_*</code> i <code>arc_*</code> są dostępne tylko wewnątrz funkcji z odpowiednią adnotacją (<code>@pointers</code> / <code>@arc</code>) albo wewnątrz bloku <code>unsafe is...end</code> — typechecker to teraz realnie egzekwuje (błąd kompilacji, nie tylko dokumentacja). <code>@safety</code> nigdy nie blokuje kompilacji — to zawsze tylko ostrzeżenie.</div></div>\n</div>\n\n<div class=\"section\" id=\"extern\">\n<div class=\"sec-header\"><span class=\"sec-num\">25</span><h2>extern — FFI z C / C++ / Rust / Python</h2></div>\n<p>Blok <code>extern</code> deklaruje funkcje z innego języka, żeby H# mógł je bezpośrednio wywołać. Kompilator generuje odpowiednie prototypy/trampoliny w zależności od <code>lang</code> i linkuje z podaną biblioteką.</p>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">składnia</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">extern</span> [static|dynamic] [lang, <span class=\"t-str\">\"nazwa_biblioteki\"</span>] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> nazwa_funkcji(param: <span class=\"t-type\">typ</span>, ...) -> <span class=\"t-type\">TypZwracany</span>\n    ...\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n\n<table class=\"ref-table\">\n<tr><th>Część</th><th>Wartości</th><th>Domyślnie</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">static / dynamic</td><td class=\"td-desc\">static, dynamic</td><td class=\"td-note\">static</td><td class=\"td-desc\">Linkowanie statyczne (.a / wbudowane w binarkę) vs dynamiczne (.so, rozwiązywane w runtime).</td></tr>\n<tr><td class=\"td-syntax\">lang</td><td class=\"td-desc\">c, c++/cpp, rust, python/py</td><td class=\"td-note\">c</td><td class=\"td-desc\">C i C++ dzielą tę samą składnię prototypu (C++ jest kompatybilny wstecz z linkowaniem C). Rust generuje sygnaturę <code>extern \"C\"</code>. Python przechodzi przez trampolinę <code>hsh_py_call</code> — wszystko po drugiej stronie mostu to stringi.</td></tr>\n<tr><td class=\"td-syntax\">\"biblioteka\"</td><td class=\"td-desc\">nazwa .so/.dll lub nazwa modułu Python</td><td class=\"td-note\">—</td><td class=\"td-desc\">Pomijalne dla funkcji już widocznych linkerowi (np. libc).</td></tr>\n<tr><td class=\"td-syntax\">..</td><td class=\"td-desc\">ostatni parametr</td><td class=\"td-note\">—</td><td class=\"td-desc\">Oznacza funkcję wariadyczną (np. <code>printf</code>-style).</td></tr>\n</table>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">ffi_examples.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; ── 1. libc, bez podanej biblioteki (już zlinkowana) ─────────────</span>\n<span class=\"t-kw\">extern</span> static [c] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> malloc(size: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">int</span>\n    <span class=\"t-kw\">fn</span> free(ptr: <span class=\"t-type\">int</span>)\n    <span class=\"t-kw\">fn</span> strlen(s: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">int</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 2. dynamiczna biblioteka .so ──────────────────────────────────</span>\n<span class=\"t-kw\">extern</span> dynamic [c, <span class=\"t-str\">\"libmylib.so\"</span>] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> mylib_init() -> <span class=\"t-type\">int</span>\n    <span class=\"t-kw\">fn</span> mylib_process(data: <span class=\"t-type\">bytes</span>, len: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">int</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; ── 3. Python — trampolina, wszystko jako string ─────────────────</span>\n<span class=\"t-kw\">extern</span> [python, <span class=\"t-str\">\"numpy\"</span>] <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">fn</span> array(values: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">string</span>\n    <span class=\"t-kw\">fn</span> mean(arr: <span class=\"t-type\">string</span>) -> <span class=\"t-type\">string</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> n: <span class=\"t-type\">int</span> = strlen(<span class=\"t-str\">\"hello\"</span>)\n    write(<span class=\"t-str\">\"strlen: \"</span> + to_string(n))\n\n    <span class=\"t-kw\">let</span> avg = mean(array(<span class=\"t-str\">\"[1, 2, 3, 4, 5]\"</span>))\n    write(<span class=\"t-str\">\"numpy mean: \"</span> + avg)\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n<div class=\"callout c-danger\"><div class=\"ci\">⚠</div><div class=\"cb\"><strong>Uwaga:</strong> H# ufa deklarowanym sygnaturom bez weryfikacji wobec nagłówków biblioteki — literówka w typie parametru to niezdefiniowane zachowanie w runtime, nie błąd kompilacji. Sprawdź sygnatury z dokumentacją biblioteki (<code>man 3 strlen</code>, nagłówek .h, itp.) przed użyciem.</div></div>\n</div>\n\n<div class=\"section\" id=\"attributes\">\n<div class=\"sec-header\"><span class=\"sec-num\">26</span><h2>Atrybuty <span class=\"nav-new\">#[...]</span></h2></div>\n<p>Atrybuty w stylu <code>#[nazwa]</code> poprzedzają <code>fn</code> lub <code>struct</code> i włączają zachowanie sprawdzane przez typechecker albo generowane automatycznie.</p>\n<table class=\"ref-table\">\n<tr><th>Atrybut</th><th>Cel</th><th>Opis</th></tr>\n<tr><td class=\"td-syntax\">#[test]</td><td class=\"td-desc\">fn</td><td class=\"td-desc\">Rejestruje funkcję jako test uruchamiany przez <code>h# test</code> (zobacz sekcję Testy).</td></tr>\n<tr><td class=\"td-syntax\">#[inline] / #[always_inline]</td><td class=\"td-desc\">fn</td><td class=\"td-desc\">Podpowiedź dla codegenu, żeby wstawić ciało funkcji w miejscu wywołania zamiast generować osobne wywołanie.</td></tr>\n<tr><td class=\"td-syntax\">#[deprecated(note=\"...\")]</td><td class=\"td-desc\">fn</td><td class=\"td-desc\">Typechecker ostrzega przy każdym wywołaniu takiej funkcji, dołączając podaną notatkę.</td></tr>\n<tr><td class=\"td-syntax\">#[must_use]</td><td class=\"td-desc\">fn</td><td class=\"td-desc\">Typechecker ostrzega, jeśli zwracana wartość zostanie zignorowana (wywołanie jako samodzielny statement).</td></tr>\n<tr><td class=\"td-syntax\">#[derive(...)]</td><td class=\"td-desc\">struct</td><td class=\"td-desc\">Generuje metody automatycznie. Wspierane: <code>Debug</code> (metoda <code>debug()</code> → string), <code>Clone</code> (<code>clone()</code>), <code>PartialEq</code> / <code>Eq</code> (<code>eq()</code>, porównanie pole-po-polu), <code>Default</code> (<code>default()</code>).</td></tr>\n</table>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">attributes.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">#[derive(Debug, Clone, PartialEq, Default)]</span>\n<span class=\"t-kw\">struct</span> Point <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> x: <span class=\"t-type\">int</span>\n    <span class=\"t-kw\">pub</span> y: <span class=\"t-type\">int</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">#[deprecated(note=\"use Point::origin() instead\")]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">zero_point</span>() -> Point <span class=\"t-kw\">is</span>\n    return Point { x: <span class=\"t-num\">0</span>, y: <span class=\"t-num\">0</span> }\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">#[must_use]</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">compute</span>(a: <span class=\"t-type\">int</span>, b: <span class=\"t-type\">int</span>) -> <span class=\"t-type\">int</span> = a * b + <span class=\"t-num\">1</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> p1 = Point { x: <span class=\"t-num\">1</span>, y: <span class=\"t-num\">2</span> }\n    <span class=\"t-kw\">let</span> p2 = p1.clone()\n    write(<span class=\"t-str\">\"equal: \"</span> + to_string(p1.eq(p2)))\n    write(p1.debug())\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"optional\">\n<div class=\"sec-header\"><span class=\"sec-num\">17</span><h2>Optional &amp; propagacja nil</h2></div>\n\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">optional.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-fn\">find_user</span>(id: int) -> string? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> id <= <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span>\n        return <span class=\"t-kw\">nil</span>\n    <span class=\"t-kw\">end</span>\n    return <span class=\"t-str\">\"user_\"</span> + to_string(id)\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> u: string? = find_user(<span class=\"t-num\">5</span>)\n    <span class=\"t-kw\">if</span> u != <span class=\"t-kw\">nil</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Znaleziono: \"</span> + u)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Brak użytkownika\"</span>)\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-comment\">;; Propagacja nil — operator ?</span>\n    <span class=\"t-kw\">let</span> n: int? = parse_int(<span class=\"t-str\">\"42\"</span>)\n    <span class=\"t-kw\">let</span> val = n?   <span class=\"t-comment\">;; jeśli nil — funkcja zwraca nil</span>\n    write(to_string(val))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"generics\">\n<div class=\"sec-header\"><span class=\"sec-num\">18</span><h2>Generics</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">generics.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-comment\">;; Generyczna struct</span>\n<span class=\"t-kw\">struct</span> Pair&lt;A, B&gt; <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">pub</span> first:  A\n    <span class=\"t-kw\">pub</span> second: B\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Generyczna funkcja z constraintem</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">first</span>&lt;T&gt;(arr: [T]) -> T? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> arr.len() == <span class=\"t-num\">0</span> <span class=\"t-kw\">is</span> return <span class=\"t-kw\">nil</span> <span class=\"t-kw\">end</span>\n    return arr[<span class=\"t-num\">0</span>]\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">max_val</span>&lt;T&gt;(a: T, b: T) -> T <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">if</span> a > b <span class=\"t-kw\">is</span> return a <span class=\"t-kw\">end</span>\n    return b\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">swap</span>&lt;T&gt;(a: T, b: T) -> (T, T) = (b, a)\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> addr: Pair&lt;string, int&gt; = Pair {\n        first:  <span class=\"t-str\">\"192.168.1.1\"</span>,\n        second: <span class=\"t-num\">8080</span>\n    }\n    write(addr.first + <span class=\"t-str\">\":\"</span> + to_string(addr.second))\n    write(to_string(max_val(<span class=\"t-num\">3</span>, <span class=\"t-num\">7</span>)))   <span class=\"t-comment\">;; 7</span>\n    <span class=\"t-kw\">let</span> (b, a) = swap(<span class=\"t-num\">1</span>, <span class=\"t-num\">2</span>)\n    write(to_string(a) + <span class=\"t-str\">\" \"</span> + to_string(b))\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"closures\">\n<div class=\"sec-header\"><span class=\"sec-num\">19</span><h2>Closures</h2></div>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">closures.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-comment\">;; Prosta closure</span>\n    <span class=\"t-kw\">let</span> double = |x: int| -> int <span class=\"t-kw\">is</span>\n        return x * <span class=\"t-num\">2</span>\n    <span class=\"t-kw\">end</span>\n    write(to_string(double(<span class=\"t-num\">21</span>)))  <span class=\"t-comment\">;; 42</span>\n\n    <span class=\"t-comment\">;; Domknięcie zmiennej zewnętrznej</span>\n    <span class=\"t-kw\">let</span> mult: int = <span class=\"t-num\">3</span>\n    <span class=\"t-kw\">let</span> triple = |x: int| -> int <span class=\"t-kw\">is</span>\n        return x * mult\n    <span class=\"t-kw\">end</span>\n    write(to_string(triple(<span class=\"t-num\">7</span>)))  <span class=\"t-comment\">;; 21</span>\n\n    <span class=\"t-comment\">;; Higher-order functions</span>\n    <span class=\"t-kw\">let</span> square = |x: int| -> int <span class=\"t-kw\">is</span> x * x <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> nums   = [<span class=\"t-num\">1</span>, <span class=\"t-num\">2</span>, <span class=\"t-num\">3</span>, <span class=\"t-num\">4</span>, <span class=\"t-num\">5</span>]\n    <span class=\"t-kw\">for</span> n <span class=\"t-kw\">in</span> nums <span class=\"t-kw\">is</span>\n        write(to_string(square(n)))\n    <span class=\"t-kw\">end</span>\n\n    <span class=\"t-comment\">;; Closure zwrócona z funkcji</span>\n    <span class=\"t-kw\">let</span> add10 = make_adder(<span class=\"t-num\">10</span>)\n    write(to_string(add10(<span class=\"t-num\">5</span>)))   <span class=\"t-comment\">;; 15</span>\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">make_adder</span>(n: int) -> <span class=\"t-kw\">fn</span>(int) -> int <span class=\"t-kw\">is</span>\n    return |x: int| -> int <span class=\"t-kw\">is</span> x + n <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"string-interp\">\n<div class=\"sec-header\"><span class=\"sec-num\">20</span><h2>String Interpolation <span class=\"nav-new\">v0.6</span></h2></div>\n<p>Stringi mogą zawierać wyrażenia H# w klamrach <code>{...}</code>. Tokenizowane w lexerze do <code>InterpPart</code>, ewaluowane w interpreterze i kodegenie LLVM.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">interpolacja.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> name = <span class=\"t-str\">\"HackerOS\"</span>\n    <span class=\"t-kw\">let</span> ver: <span class=\"t-type\">int</span> = <span class=\"t-num\">6</span>\n    write(<span class=\"t-str\">\"Witaj w {name}! H# v0.{ver}\"</span>)\n    <span class=\"t-comment\">;; → \"Witaj w HackerOS! H# v0.6\"</span>\n\n    <span class=\"t-comment\">;; Wyrażenia arytmetyczne</span>\n    <span class=\"t-kw\">let</span> a = <span class=\"t-num\">10</span>\n    <span class=\"t-kw\">let</span> b = <span class=\"t-num\">5</span>\n    write(<span class=\"t-str\">\"{a} + {b} = {a + b}\"</span>)     <span class=\"t-comment\">;; \"10 + 5 = 15\"</span>\n    write(<span class=\"t-str\">\"{a} * {b} = {a * b}\"</span>)     <span class=\"t-comment\">;; \"10 * 5 = 50\"</span>\n\n    <span class=\"t-comment\">;; Wywołania metod w interpolacji</span>\n    <span class=\"t-kw\">let</span> arr = [<span class=\"t-num\">1</span>, <span class=\"t-num\">2</span>, <span class=\"t-num\">3</span>]\n    write(<span class=\"t-str\">\"Len: {arr.len()}, First: {arr[0]}\"</span>)\n\n    <span class=\"t-comment\">;; Zagnieżdżone wywołania</span>\n    <span class=\"t-kw\">let</span> s = <span class=\"t-str\">\"hello\"</span>\n    write(<span class=\"t-str\">\"Upper: {s.to_upper()}, Len: {s.len()}\"</span>)\n\n    <span class=\"t-comment\">;; Escape klamry</span>\n    write(<span class=\"t-str\">\"Literal: {{klucz: wartość}}\"</span>)\n    <span class=\"t-comment\">;; → \"Literal: {klucz: wartość}\"</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n\n<div class=\"section\" id=\"try-op\">\n<div class=\"sec-header\"><span class=\"sec-num\">21</span><h2>Operator ? <span class=\"nav-new\">v0.6</span></h2></div>\n<p>Operator <code>?</code> propaguje nil z funkcji — jeśli wyrażenie jest nil, funkcja natychmiast zwraca nil. Analogia do <code>?</code> z Rust.</p>\n<div class=\"code-block\">\n<div class=\"code-header\"><span class=\"code-filename\">try_op.h#</span><button class=\"copy-btn\">Copy</button></div>\n<div class=\"code-body\"><div class=\"code-inner\"><pre><span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> fs\"</span>   <span class=\"t-kw\">from</span> <span class=\"t-str\">\"fs\"</span>\n<span class=\"t-kw\">use</span> <span class=\"t-str\">\"std -> json\"</span> <span class=\"t-kw\">from</span> <span class=\"t-str\">\"json\"</span>\n\n<span class=\"t-comment\">;; Bez ? — ręczna obsługa nil</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">load_verbose</span>(path: string) -> any? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> content = fs::read(path)\n    <span class=\"t-kw\">if</span> content == nil <span class=\"t-kw\">is</span> return nil <span class=\"t-kw\">end</span>\n    <span class=\"t-kw\">let</span> obj = json::parse(content)\n    <span class=\"t-kw\">if</span> obj == nil <span class=\"t-kw\">is</span> return nil <span class=\"t-kw\">end</span>\n    return obj\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Z ? — identyczna semantyka, zwięzła</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">load_config</span>(path: string) -> any? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> content = fs::read(path)<span class=\"t-op\">?</span>\n    <span class=\"t-kw\">let</span> obj     = json::parse(content)<span class=\"t-op\">?</span>\n    return obj\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-comment\">;; Łańcuch ? przez wiele warstw</span>\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">get_port</span>(cfg_path: string) -> int? <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> cfg     = load_config(cfg_path)<span class=\"t-op\">?</span>\n    <span class=\"t-kw\">let</span> server  = json::get_obj(cfg, <span class=\"t-str\">\"server\"</span>)<span class=\"t-op\">?</span>\n    <span class=\"t-kw\">let</span> port    = json::get_int(server, <span class=\"t-str\">\"port\"</span>)<span class=\"t-op\">?</span>\n    return port\n<span class=\"t-kw\">end</span>\n\n<span class=\"t-kw\">fn</span> <span class=\"t-fn\">main</span>() <span class=\"t-kw\">is</span>\n    <span class=\"t-kw\">let</span> port = get_port(<span class=\"t-str\">\"config.json\"</span>)\n    <span class=\"t-kw\">if</span> port == nil <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Config missing or invalid\"</span>)\n    <span class=\"t-kw\">else</span> <span class=\"t-kw\">is</span>\n        write(<span class=\"t-str\">\"Server port: {port}\"</span>)\n    <span class=\"t-kw\">end</span>\n<span class=\"t-kw\">end</span></pre></div></div>\n</div>\n</div>\n"
]

fun hsharp_sections() -> Any [
    end mkobj(["async", hs_sec_async(), "examples-extra", hs_sec_examples_extra(), "gramatyka", hs_sec_gramatyka(), "install", hs_sec_install(), "intro", hs_sec_intro(), "modules", hs_sec_modules(), "organizacja", hs_sec_organizacja(), "playground", hs_sec_playground(), "podstawy", hs_sec_podstawy(), "przyklady", hs_sec_przyklady(), "sterowanie", hs_sec_sterowanie(), "struktura", hs_sec_struktura(), "tests", hs_sec_tests(), "typy", hs_sec_typy(), "zaawansowane", hs_sec_zaawansowane()])
]
