include <../shared/core>

fun docs_tools_html(en: Bool) -> Str [
    if en [
        end "<h2>9. Tools and Applications</h2><p>Full list of HackerOS custom tools and applications:</p>\n<table><thead><tr><th>Tool / Application</th><th>Description</th><th>Installation / Notes</th></tr></thead>\n<tbody><tr><td><code>ngt</code></td><td>File manager inspired by Midnight Commander, written in GoLang.</td><td>built-in all editions</td></tr><tr><td><code>hedit</code></td><td>Text editor inspired by nano, written in GoLang.</td><td>built-in all editions</td></tr><tr><td><code>hdev</code></td><td>TUI code editor.</td><td>built-in all editions</td></tr><tr><td><code>hacker</code></td><td>Main HackerOS tool: install, remove, repair, quick update.</td><td>built-in all editions</td></tr><tr><td><code>HackerOS-Steam</code></td><td>Run Steam in an isolated container.</td><td>built-in all editions</td></tr><tr><td><code>hackeros-builder</code></td><td>Tool for building OCI images inspired by bootc. Can be used as an overlay for live-build, as a fully independent standalone builder, or to create configurable live environments and deployment images.</td><td><code>hacker unpack hackeros-builder</code></td></tr><tr><td><code>h#</code></td><td>Own programming language H# for general use in HackerOS.</td><td><code>hacker unpack h#</code></td></tr><tr><td><code>bit</code></td><td>Package manager for HackerOS programming languages.</td><td><code>hacker unpack bit</code></td></tr><tr><td><code>hl</code></td><td>Hacker Lang – shell alternative / successor.</td><td>built-in all editions</td></tr><tr><td><code>hexai</code></td><td>AI for HackerOS – local assistant based on language models.</td><td><code>hacker unpack hexai</code></td></tr><tr><td><code>hammer</code></td><td>Atomic package manager and successor to apt, used in the Atomic edition.</td><td>Built-in – Atomic edition</td></tr><tr><td><code>isolator</code></td><td>Package manager overlay for distrobox/podman.</td><td>Atomic built-in; others: <code>hacker unpack isolator</code></td></tr><tr><td><code>Hacker-Mode</code></td><td>Gaming session inspired by gamescope / Steam.</td><td><code>hacker unpack hacker-mode</code></td></tr><tr><td><code>bph</code></td><td>CLI educational penetration testing tool.</td><td>Cybersecurity edition only</td></tr><tr><td><code>Hacker-Term</code></td><td>Custom HackerOS terminal with additional features.</td><td>built-in all editions</td></tr><tr><td><code>HackerOS-App</code></td><td>Mobile application for Android phones.</td><td><a href=\"https://github.com/HackerOS-Linux-System/HackerOS-App/releases/download/v0.4/HackerOS-App-0.4.apk\" target=\"_blank\" style=\"color:#FFF\">APK v0.4</a></td></tr><tr><td><code>hsh</code></td><td>Custom HackerOS shell (replaces bash/zsh).</td><td>built-in all editions</td></tr><tr><td><code>hpm</code></td><td>Community package manager repository.</td><td>built-in all editions</td></tr><tr><td><code>hnm</code></td><td>Nix overlay – integration with Nixpkgs repository.</td><td>built-in all editions</td></tr><tr><td><code>Hacker Launcher</code></td><td>Application for running Windows games via Proton.</td><td>built-in all editions</td></tr><tr><td><code>HackerOS-Games</code></td><td>App to launch HackerOS games: StarBlaster, Bit Jump, The Racer, Bark Squadron.</td><td>built-in all editions</td></tr><tr><td><code>getit</code></td><td>git + wget + custom GitHub/GitLab directory downloader.</td><td>built-in all editions</td></tr><tr><td><code>chker</code></td><td>CLI tool to change the system kernel (Debian → XanMod or Liquorix).</td><td>built-in all editions</td></tr><tr><td><code>Cybersecurity Mode</code></td><td>Session/app overlay for cybersecurity tools (runs in container). Also serves as the graphical environment for the Cybersecurity edition.</td><td>Cybersecurity edition only</td></tr><tr><td><code>Penetration Mode</code></td><td>App with custom penetration testing tools (educational only).</td><td>Cybersecurity edition only</td></tr><tr><td><code>HackerOS-Store</code></td><td>HackerOS store with programs and add-ons.</td><td>built-in all editions</td></tr><tr><td><code>HackerOS-Containers</code></td><td>Custom container system – lightweight isolated environments.</td><td><code>hacker unpack hackeros-containers</code></td></tr><tr><td><code>HackerOS-Game-Mode</code></td><td>System overlay optimizing for gaming, shows FPS.</td><td><code>hacker unpack hackeros-game-mode</code></td></tr><tr><td><code>.hk</code></td><td>Configuration format used mainly in HackerOS, supported in H#/Hacker Lang and Rust.</td><td>H#/Hacker Lang/Rust libs</td></tr><tr><td><code>a</code></td><td>Simple CLI tool for quick system updates, written in Hacker Lang.</td><td>built-in all editions</td></tr><tr><td><code>GhostFS</code></td><td>Custom file system (Beta) – work in progress.</td><td>Not available yet</td></tr><tr><td><code>HackerOS Cockpit</code></td><td>System control panel in the browser.</td><td>built-in all editions</td></tr><tr><td><code>hackerc</code></td><td>Transpiler for the HackerScript language.</td><td><code>hacker unpack hackerscript</code></td></tr><tr><td><code>hack3rc</code></td><td>Compiler for the HackerScript language.</td><td><code>hacker unpack hackerscript</code></td></tr><tr><td><code>Blue Environment</code></td><td>HackerOS graphical environment.</td><td><code>hacker unpack blue-environment</code> / built-in in the Blue edition</td></tr><tr><td><code>HackerOS Installer</code></td><td>Installer for the HackerOS ecosystem.</td><td><code>hacker unpack hackeros-installer</code> / built-in in the Server/Atomic editions</td></tr><tr><td><code>HackerOS Educator</code></td><td>Cybersecurity learning tool, strongly inspired by TryHackMe. It is used not only for learning cybersecurity.</td><td><code>hacker unpack hackeros-educator</code></td></tr><tr><td><code>HDM</code></td><td>Display manager for the HackerOS ecosystem.</td><td><code>hacker unpack hdm</code></td></tr><tr><td><code>gaming-cli</code> / <code>gaming</code> / <code>gamescope-manager</code></td><td>Suite of CLI tools exclusive to HackerOS Gaming Edition. Manages Game Mode and handles seamless switching between KDE Plasma and gamescope-based Game Mode.</td><td>Built-in – HackerOS Gaming Edition only</td></tr></tbody></table><p>Full advanced tools documentation <a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/index.html\" target=\"_blank\" style=\"color:#4a9eff\">here</a>.</p>"
    ]
    end "<h2>9. Narzędzia i aplikacje</h2><p>Pełna lista autorskich narzędzi i aplikacji HackerOS:</p>\n<table><thead><tr><th>Narzędzie / Aplikacja</th><th>Opis</th><th>Instalacja / Uwagi</th></tr></thead>\n<tbody><tr><td><code>ngt</code></td><td>Narzędzie inspirowane mc (Midnight Commander), napisane w GoLang.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>hedit</code></td><td>Edytor tekstu inspirowany nano, napisane w GoLang.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>hdev</code></td><td>TUI edytor kodu.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>hacker</code></td><td>Główne narzędzie HackerOS: instaluj, usuwaj, napraw, szybka aktualizacja.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>HackerOS-Steam</code></td><td>Uruchom Steam w izolowanym środowisku (kontener).</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>hackeros-builder</code></td><td>Narzędzie do budowania obrazów OCI inspirowane bootc. Może działać jako nakładka dla live-build, jako samodzielny niezależny builder lub służyć do tworzenia konfigurowalnych środowisk live i obrazów wdrożeniowych.</td><td><code>hacker unpack hackeros-builder</code></td></tr><tr><td><code>h#</code></td><td>Własny język programowania H# do ogólnego zastosowania w HackerOS.</td><td><code>hacker unpack h#</code></td></tr><tr><td><code>bit</code></td><td>Manager pakietów dla języków programowania HackerOS.</td><td><code>hacker unpack bit</code></td></tr><tr><td><code>hl</code></td><td>Hacker Lang – następca shella (lub alternatywa).</td><td>wbudowany w każdej edycji</td></tr><tr><td><code>hexai</code></td><td>AI dla HackerOS – lokalny asystent oparty na modelach językowych.</td><td><code>hacker unpack hexai</code></td></tr><tr><td><code>hammer</code></td><td>Atomowy manager pakietów oraz następca apt, używany w edycji Atomic.</td><td>Wbudowany w edycji Atomic</td></tr><tr><td><code>isolator</code></td><td>Manager pakietów / nakładka dla distrobox.</td><td>Wbudowane w Atomic; inne: <code>hacker unpack isolator</code></td></tr><tr><td><code>Hacker-Mode</code></td><td>Sesja inspirowana gamescope / Steam (tryb gry na pełnym ekranie).</td><td><code>hacker unpack hacker-mode</code></td></tr><tr><td><code>bph</code></td><td>Narzędzie CLI edukacyjne do testów penetracyjnych.</td><td>Tylko edycja Cybersecurity</td></tr><tr><td><code>Hacker-Term</code></td><td>Własny terminal HackerOS (z dodatkowymi funkcjami).</td><td>wbudowany w każdej edycji</td></tr><tr><td><code>HackerOS-App</code></td><td>Aplikacja mobilna dla telefonów Android.</td><td><a href=\"https://github.com/HackerOS-Linux-System/HackerOS-App/releases/download/v0.4/HackerOS-App-0.4.apk\" target=\"_blank\" style=\"color:#FFF\">APK v0.4</a></td></tr><tr><td><code>hsh</code></td><td>Własna powłoka HackerOS (zastępuje bash/zsh).</td><td>wbudowana w każdej edycji</td></tr><tr><td><code>hpm</code></td><td>Manager pakietów z repozytorium community.</td><td>wbudowany w każdej edycji</td></tr><tr><td><code>hnm</code></td><td>Nakładka dla Nix – integracja z repozytorium Nixpkgs.</td><td>wbudowany we wszystkich edycjach</td></tr><tr><td><code>Hacker Launcher</code></td><td>Aplikacja do uruchamiania gier Windowsowych (Proton).</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>HackerOS-Games</code></td><td>Aplikacja do uruchamiania gier od HackerOS: StarBlaster, Bit Jump, The Racer, Bark Squadron.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>getit</code></td><td>Połączenie git + wget + własnego systemu pobierania katalogów z GitHub/GitLab.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>chker</code></td><td>Narzędzie CLI do zmiany jądra systemowego (Debian → XanMod lub Liquorix).</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>Cybersecurity Mode</code></td><td>Sesja/aplikacja nakładka dla narzędzi cyberbezpieczeństwa (działa w kontenerze). Jest to również środowisko graficzne edycji Cybersecurity.</td><td>Tylko edycja Cybersecurity</td></tr><tr><td><code>Penetration Mode</code></td><td>Aplikacja z własnymi narzędziami do testów penetracyjnych (tylko do celów edukacyjnych).</td><td>Tylko edycja Cybersecurity</td></tr><tr><td><code>HackerOS-Store</code></td><td>Sklep HackerOS z programami i dodatkami.</td><td>wbudowany we wszystkich edycjach</td></tr><tr><td><code>HackerOS-Containers</code></td><td>Własny system kontenerów – lekka, zintegrowana platforma izolowanych środowisk.</td><td><code>hacker unpack hackeros-containers</code></td></tr><tr><td><code>HackerOS-Game-Mode</code></td><td>Nakładka optymalizująca system pod kątem grania, wyświetla FPS.</td><td><code>hacker unpack hackeros-game-mode</code></td></tr><tr><td><code>.hk</code></td><td>Format konfiguracyjny stosowany głównie w HackerOS – dostępny w H#/Hacker Lang i bibliotekach Rust.</td><td>H#/Hacker Lang/biblioteki Rust</td></tr><tr><td><code>a</code></td><td>Proste narzędzie CLI do prostych aktualizacji systemu napisane w Hacker Lang.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>GhostFS</code></td><td>Autorski system plików (Beta) – trwają prace.</td><td>Niedostępne (w trakcie prac)</td></tr><tr><td><code>HackerOS Cockpit</code></td><td>Panel sterowania systemu w przeglądarce.</td><td>wbudowane we wszystkich edycjach</td></tr><tr><td><code>hackerc</code></td><td>Transpilator języka HackerScript.</td><td><code>hacker unpack hackerscript</code></td></tr><tr><td><code>hack3rc</code></td><td>Kompilator języka HackerScript.</td><td><code>hacker unpack hackerscript</code></td></tr><tr><td><code>Blue Environment</code></td><td>Środowisko graficzne HackerOS.</td><td><code>hacker unpack blue-environment</code> / wbudowane w edycji Blue</td></tr><tr><td><code>HackerOS Installer</code></td><td>Instalator dla ekosystemu HackerOS.</td><td><code>hacker unpack hackeros-installer</code> / wbudowany w edycji Server/Atomic</td></tr><tr><td><code>HackerOS Educator</code></td><td>Narzędzie do nauki cyberbezpieczeństwa, silnie inspirowane serwisem TryHackMe. Służy nie tylko do nauki cyberbezpieczeństwa.</td><td><code>hacker unpack hackeros-educator</code></td></tr><tr><td><code>HDM</code></td><td>Display manager dla ekosystemu HackerOS.</td><td><code>hacker unpack hdm</code></td></tr><tr><td><code>gaming-cli</code> / <code>gaming</code> / <code>gamescope-manager</code></td><td>Zestaw narzędzi CLI dostępny wyłącznie w edycji HackerOS Gaming Edition. Zarządza trybem Game Mode oraz obsługuje przełączanie pomiędzy środowiskiem KDE Plasma a trybem Game Mode opartym na Gamescope.</td><td>Wbudowane w edycji HackerOS Gaming Edition</td></tr></tbody></table><p>Dla tych zaawansowanych narzędzi jest specjalna dokumentacja (<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/index.html\" target=\"_blank\" style=\"color:#4a9eff\">tutaj</a>).</p>"
]

fun docs_programming_html(en: Bool) -> Str [
    if en [
        end "<h2>10. Programming Languages</h2>\n<h3>Hacker Lang</h3>\n<p>An efficient alternative to the shell with a unique syntax and its own shell environment. <em>(It works only on HackerOS — if you want to use Hacker Lang everywhere, use Hacker Lang++.)</em></p>\n<p><strong>Hacker Lang tools:</strong></p>\n<ul>\n<li><code>hl</code> – the Hacker Lang interpreter. It has two run modes:\n<ul>\n<li><strong>JIT</strong> – compiles to JIT (efficient execution): <code>hl --jit program</code></li>\n<li><strong>Tree-walk</strong> – walks the syntax tree (default mode): <code>hl program</code> or <code>hl run program</code></li>\n</ul></li>\n</ul>\n<pre><span>hl --jit program</span><button class=\"copy-button\" data-command=\"hl --jit program\">@@COPY@@</button></pre>\n<pre><span>hl program</span><button class=\"copy-button\" data-command=\"hl program\">@@COPY@@</button></pre>\n<pre><span>hl run program</span><button class=\"copy-button\" data-command=\"hl run program\">@@COPY@@</button></pre>\n<p>More info about the syntax and tools of Hacker Lang in the\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/hacker-lang/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\nofficial Hacker Lang documentation</a>.</p>\n\n<h3>H#</h3>\n<p>HackerOS has its own fully integrated programming language called <strong>H#</strong>. Its main goal is use in HackerOS tools and the cybersecurity ecosystem.</p>\n<p><strong>Run modes:</strong></p>\n<ul>\n<li><strong>Compiled</strong> – compiles H# programs to native binary code.</li>\n<li><strong>Interpreted (efficient - JIT)</strong> – efficient JIT execution.</li>\n<li><strong>Interpreted (preview)</strong> – quick results preview.</li>\n</ul>\n<p><strong>H# CLI tools:</strong></p>\n<ul>\n<li><code>hhc</code> – the H# compiler built from source on GCC, as an H# frontend.</li>\n<li><code>h#</code> – LLVM compilation / fast compilation / efficient JIT preview / quick preview.</li>\n</ul>\n<p>More info in the\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/h-sharp/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\nofficial H# documentation</a>.</p>\n\n<h3>HackerScript</h3>\n<p>HackerScript is an experimental, hobby programming language (not only for HackerOS), transpiled to Rust and Python in a single file, with support for a wide range of ecosystems. All websites of the HackerOS and LegendaryOS Linux distributions are written entirely in HackerScript.</p>\n<p><strong>HackerScript tools:</strong></p>\n<ul>\n<li><code>hackerc</code> – the HackerScript transpiler, by default to Rust and Python, but other target languages are available too. Change the target with <code>use &lt;lang:language&gt;</code>, or for websites with <code>use &lt;mode:website&gt;</code>.</li>\n</ul>\n<p>More information can be found in the\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/HackerScript/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\nofficial HackerScript documentation</a>.</p>\n"
    ]
    end "<h2>10. Języki programowania</h2>\n<h3>Hacker Lang</h3>\n<p>Jest to wydajna alternatywa dla shella z wyjątkową składnią. Hacker Lang ma zarówno własną unikalną składnię, jak i własną powłokę. <em>(Działa tylko na HackerOS — jeśli chcesz używać Hacker Lang wszędzie, użyj Hacker Lang++.)</em></p>\n<p><strong>Narzędzia Hacker Lang:</strong></p>\n<ul>\n<li><code>hl</code> – interpreter Hacker Lang. Ma dwa tryby uruchamiania:\n<ul>\n<li><strong>JIT</strong> – kompilacja do JIT (wydajne wykonanie): <code>hl --jit program</code></li>\n<li><strong>Tree-walk</strong> – interpretacja drzewa składni (domyślny tryb): <code>hl program</code> lub <code>hl run program</code></li>\n</ul></li>\n</ul>\n<pre><span>hl --jit program</span><button class=\"copy-button\" data-command=\"hl --jit program\">@@COPY@@</button></pre>\n<pre><span>hl program</span><button class=\"copy-button\" data-command=\"hl program\">@@COPY@@</button></pre>\n<pre><span>hl run program</span><button class=\"copy-button\" data-command=\"hl run program\">@@COPY@@</button></pre>\n<p>Więcej informacji o składni i narzędziach Hacker Lang znajdziesz w\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/hacker-lang/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\noficjalnej dokumentacji Hacker Lang</a>.</p>\n\n<h3>H#</h3>\n<p>HackerOS posiada własny, w pełni zintegrowany z systemem język programowania o nazwie <strong>H#</strong>. Jego głównym celem jest zastosowanie w ogólnych narzędziach HackerOS oraz ekosystemie cybersecurity.</p>\n<p><strong>Możliwości uruchomienia:</strong></p>\n<ul>\n<li><strong>Kompilowany</strong> – kompilacja do natywnego kodu binarnego.</li>\n<li><strong>Interpretowany (wydajny - JIT)</strong> – wydajne uruchomienie JIT.</li>\n<li><strong>Interpretowany (podgląd)</strong> – szybki podgląd efektów.</li>\n</ul>\n<p><strong>Narzędzia CLI H#:</strong></p>\n<ul>\n<li><code>hhc</code> – kompilator H# zbudowany ze źródeł na GCC pod frontend H#.</li>\n<li><code>h#</code> – kompilacja LLVM / szybka kompilacja / wydajny podgląd JIT / szybki podgląd.</li>\n</ul>\n<p>Więcej informacji znajdziesz w\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/h-sharp/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\noficjalnej dokumentacji H#</a>.</p>\n\n<h3>HackerScript</h3>\n<p>HackerScript to eksperymentalny, hobbystyczny język programowania (nie tylko dla HackerOS), transpilowany do Rust i Python w jednym pliku, obsługujący masę ekosystemów. Wszystkie strony w dystrybucjach Linuksa HackerOS i LegendaryOS są napisane w całości w HackerScript.</p>\n<p><strong>Narzędzia HackerScript:</strong></p>\n<ul>\n<li><code>hackerc</code> – transpilator kodu HackerScript, domyślnie do Rusta i Pythona, ale są też inne opcje (inne języki). Język docelowy zmienisz przez <code>use &lt;lang:język&gt;</code>, a dla stron przez <code>use &lt;mode:website&gt;</code>.</li>\n</ul>\n<p>Więcej informacji znajdziesz w\n<a href=\"https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/HackerScript/docs.html\" target=\"_blank\" style=\"color:#4a9eff\">\noficjalnej dokumentacji HackerScript</a>.</p>\n"
]
