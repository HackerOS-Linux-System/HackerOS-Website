!! ── bezpieczny dostep do localStorage (JSON) ───────────────────────────
fun ls_get_json(k: Str) -> Any [
    let v = localStorage.getItem(k)
    if v == null or v == "" [
        end null
    ]
    end JSON.parse(v)
]

fun ls_set_json(k: Str, v: Any) -> Bool [
    localStorage.setItem(k, JSON.stringify(v))
    end true
]

fun build_payload() -> Any [
    let p = js_obj()
    p.v = OFF_VERSION
    p.base = OFF_BASE
    p.savedAt = Date.now()
    p.html = OFF_TEMPLATE_HTML
    p.css = OFF_TEMPLATE_CSS
    p.i18n = off_i18n()
    end p
]

fun persist_dialog() -> Any [
    let cur = ls_get_json(OFF_KEY)
    if cur != null and cur.v == OFF_VERSION and cur.base == OFF_BASE and cur.html and cur.css and cur.i18n [
        end cur
    ]
    let p = build_payload()
    ls_set_json(OFF_KEY, p)
    end p
]

fun get_payload() -> Any [
    let p = ls_get_json(OFF_KEY)
    if p != null and p.html and p.css and p.i18n [
        end p
    ]
    end build_payload()
]

!! ── stan: ostatnia strona, ostatni moment online, licznik rozlaczen ────
fun get_state() -> Any [
    let s = ls_get_json(OFF_STATE_KEY)
    if s != null [
        end s
    ]
    let n = js_obj()
    n.lastOnline = 0
    n.lastPage = ""
    n.lastTitle = ""
    n.offlineCount = 0
    n.lastOffline = 0
    n.visits = 0
    end n
]

fun save_state(s: Any) [
    ls_set_json(OFF_STATE_KEY, s)
]

fun touch_online(new_visit: Bool) [
    let s = get_state()
    s.lastOnline = Date.now()
    s.lastPage = location.href
    s.lastTitle = document.title or ""
    if new_visit [
        s.visits = (s.visits or 0) + 1
    ]
    save_state(s)
]

!! ── jezyk ──────────────────────────────────────────────────────────────
fun off_lang() -> Str [
    let i = off_i18n()
    let l = localStorage.getItem(OFF_LANG_KEY)
    if l == null or l == "" or not jhas(i, l) [
        l = (navigator.language or "pl").slice(0, 2).toLowerCase()
    ]
    if jhas(i, l) [
        end l
    ]
    end "pl"
]

!! ── renderowanie dialogu z zapisanych danych ───────────────────────────
fun fmt_ago(ts: Any, lang: Str, never: Str) -> Str [
    if ts == null or ts == 0 [
        end never
    ]
    let diff = Math.round((ts - Date.now()) / 1000)
    let abs = Math.abs(diff)
    let rel = ""
    let opts = js_obj()
    opts.numeric = "auto"
    let rtf = Reflect.construct(Intl.RelativeTimeFormat, [lang, opts])
    if abs < 60 [
        rel = rtf.format(diff, "second")
    ] elif abs < 3600 [
        rel = rtf.format(Math.round(diff / 60), "minute")
    ] elif abs < 86400 [
        rel = rtf.format(Math.round(diff / 3600), "hour")
    ] else [
        rel = rtf.format(Math.round(diff / 86400), "day")
    ]
    let abs2 = Reflect.construct(Date, [ts]).toLocaleString(lang)
    if rel != "" [
        end abs2 + " (" + rel + ")"
    ]
    end abs2
]

fun fill_one(el: Any) [
    let t = off_fill_t
    el.textContent = jget(t, el.getAttribute("data-i18n")) or ""
]

let off_fill_t: Any = null

fun fill(root: Any, payload: Any, lang: Str) -> Any [
    let t = jget(payload.i18n, lang) or payload.i18n.pl or js_obj()
    let s = get_state()
    off_fill_t = t
    root.querySelectorAll("[data-i18n]").forEach(fill_one)
    let lo = root.querySelector("[data-slot=\"lastOnline\"]")
    if lo != null [
        lo.textContent = fmt_ago(s.lastOnline, lang, t.never)
    ]
    let lp = root.querySelector("[data-slot=\"lastPage\"]")
    if lp != null [
        if s.lastPage [
            let title_part = ""
            if s.lastTitle [
                title_part = s.lastTitle + " – "
            ]
            lp.textContent = title_part + rx_replace(s.lastPage, rx("^https?:\\/\\/[^/]+"), "")
        ] else [
            lp.textContent = t.never
        ]
    ]
    let home = root.querySelector("[data-act=\"home\"]")
    if home != null [
        home.setAttribute("href", (payload.base or OFF_BASE) + "Home-page.html")
    ]
    end t
]

!! ── sprawdzanie realnej lacznosci (navigator.onLine bywa mylace) ───────
!! Zwraca Promise<bool>; zapytanie HEAD do sw.js nie jest przechwytywane przez Service Workera.
fun ping() -> Any [
    end Reflect.construct(Promise, [ping_executor])
]

fun ping_executor(resolve: Any) [
    let done = false
    let ctrl = Reflect.construct(AbortController, [])
    fun on_timeout() [
        ctrl.abort()
        if not done [
            done = true
            resolve(false)
        ]
    ]
    let to = setTimeout(on_timeout, 4000)
    fun on_ok(r: Any) [
        clearTimeout(to)
        if not done [
            done = true
            resolve(r != null and r.status < 500)
        ]
    ]
    fun on_err(e: Any) [
        clearTimeout(to)
        if not done [
            done = true
            resolve(false)
        ]
    ]
    let opts = js_obj()
    opts.method = "HEAD"
    opts.cache = "no-store"
    opts.signal = ctrl.signal
    fetch(OFF_BASE + "sw.js?_=" + Date.now(), opts).then(on_ok).catch(on_err)
]

!! ── overlay na otwartej stronie ────────────────────────────────────────
fun off_visible(n: Any) -> Bool [
    end n.offsetParent != null
]

fun off_on_click(e: Any) [
    let b = e.target.closest("[data-act]")
    if b == null [
        end
    ]
    let act = b.getAttribute("data-act")
    if act == "retry" [
        e.preventDefault()
        recheck()
    ] elif act == "dismiss" [
        e.preventDefault()
        off_dismissed = true
        hide()
    ]
]

fun off_on_keydown(e: Any) [
    if e.key == "Escape" [
        off_dismissed = true
        hide()
        end
    ]
    if e.key != "Tab" [
        end
    ]
    let f = Array.prototype.filter.call(off_root.querySelectorAll("button,a[href]"), off_visible)
    if f.length == 0 [
        end
    ]
    let first = f[0]
    let last = f[f.length - 1]
    if e.shiftKey and document.activeElement == first [
        e.preventDefault()
        last.focus()
    ] elif not e.shiftKey and document.activeElement == last [
        e.preventDefault()
        first.focus()
    ]
]

fun ensure_overlay() -> Any [
    if off_root != null [
        end off_root
    ]
    let payload = get_payload()
    let style_el = document.createElement("style")
    style_el.id = "hos-off-style"
    style_el.textContent = payload.css
    (document.head or document.documentElement).appendChild(style_el)

    off_root = document.createElement("div")
    off_root.id = "hos-off-root"
    off_root.className = "hos-off-backdrop"
    off_root.setAttribute("role", "alertdialog")
    off_root.setAttribute("aria-modal", "true")
    off_root.setAttribute("aria-labelledby", "hos-off-title")
    off_root.setAttribute("data-mode", "overlay")
    off_root.hidden = true
    off_root.innerHTML = payload.html
    (document.body or document.documentElement).appendChild(off_root)

    off_root.addEventListener("click", off_on_click)
    off_root.addEventListener("keydown", off_on_keydown)
    end off_root
]

fun set_status(txt: Any, cls: Str) [
    if off_root == null [
        end
    ]
    let el = off_root.querySelector("[data-slot=\"status\"]")
    if el != null [
        el.textContent = txt or ""
        el.className = "hos-off-status"
        if cls != "" [
            el.className = "hos-off-status " + cls
        ]
    ]
]

fun show() -> Any [
    if OFF_NO_OVERLAY or off_dismissed [
        end null
    ]
    let r = ensure_overlay()
    let lang = off_lang()
    let t = fill(r, get_payload(), lang)
    cl_rm(r.querySelector(".hos-off-card"), "ok")
    set_status("", "")
    r.lang = lang
    if r.hidden [
        off_prev_focus = document.activeElement
        off_prev_overflow = document.documentElement.style.overflow
        document.documentElement.style.overflow = "hidden"
        r.hidden = false
        let btn = r.querySelector("[data-act=\"retry\"]")
        if btn != null [
            btn.focus()
        ]
    ]
    end t
]

fun hide() [
    if off_root == null or off_root.hidden [
        end
    ]
    off_root.hidden = true
    document.documentElement.style.overflow = off_prev_overflow
    if off_prev_focus != null and not nil(off_prev_focus.focus) [
        off_prev_focus.focus()
    ]
]

fun off_after_restored() [
    off_dismissed = false
    hide()
]

let off_recheck_t: Any = null

fun off_on_ping(ok: Any) [
    off_checking = false
    let t = off_recheck_t
    if ok [
        touch_online(false)
        if off_root != null [
            off_root.querySelector(".hos-off-card").classList.add("ok")
        ]
        set_status(t.restored, "good")
        setTimeout(off_after_restored, 1200)
    ] else [
        set_status(t.still, "bad")
        if off_root == null or off_root.hidden [
            show()
        ]
    ]
]

fun recheck() [
    if off_checking [
        end
    ]
    off_checking = true
    let t = jget(get_payload().i18n, off_lang()) or js_obj()
    off_recheck_t = t
    set_status(t.checking, "")
    ping().then(off_on_ping)
]

!! ── zdarzenia sieci ────────────────────────────────────────────────────
fun off_on_offline(e: Any) [
    let s = get_state()
    s.offlineCount = (s.offlineCount or 0) + 1
    s.lastOffline = Date.now()
    save_state(s)
    off_dismissed = false
    show()
]

fun off_on_online(e: Any) [
    if off_root != null and not off_root.hidden [
        recheck()
    ] else [
        touch_online(false)
    ]
]

!! tetno: gdy uzytkownik jest online, odswiezamy "ostatnio online"
fun off_heartbeat() [
    if navigator.onLine and (off_root == null or off_root.hidden) [
        touch_online(false)
    ]
]

fun off_on_visibility(e: Any) [
    if document.visibilityState == "visible" and not navigator.onLine [
        show()
    ]
]

fun off_on_load(e: Any) [
    navigator.serviceWorker.register(OFF_BASE + "sw.js", off_sw_opts()).catch(sw_ignore)
]

fun off_sw_opts() -> Any [
    let o = js_obj()
    o.scope = OFF_BASE
    end o
]

!! Publiczne API (np. do testow w konsoli: HackerOffline.show())
fun off_api_show() [
    off_dismissed = false
    show()
]

fun off_api_hide() [
    hide()
]

fun off_api_check() [
    recheck()
]

fun off_expose_api() [
    let api = js_obj()
    api.show = off_api_show
    api.hide = off_api_hide
    api.check = off_api_check
    api.ping = ping
    api.key = OFF_KEY
    api.stateKey = OFF_STATE_KEY
    window.HackerOffline = api
]

!! ── start ──────────────────────────────────────────────────────────────
fun offline_no_overlay() [
    OFF_NO_OVERLAY = true
]

!! root_rel: sciezka od strony do korzenia serwisu ("" | "../" | "../../")
fun offline_init(root_rel: Str) [
    OFF_BASE = Reflect.construct(URL, [root_rel + ".", location.href]).pathname
    if navigator.onLine [
        persist_dialog()   !! zapis dialogu w localStorage (jeszcze przed reszta strony)
        touch_online(true) !! zapis stanu
    ] else [
        show()             !! strona z cache przegladarki otwarta bez sieci
    ]
    window.addEventListener("offline", off_on_offline)
    window.addEventListener("online", off_on_online)
    setInterval(off_heartbeat, 20000)
    document.addEventListener("visibilitychange", off_on_visibility)
    if not nil(navigator.serviceWorker) and location.protocol.indexOf("http") == 0 [
        window.addEventListener("load", off_on_load)
    ]
    off_expose_api()
]
